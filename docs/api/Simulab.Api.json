  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": [
              "null",
              "string"
            ]
          },
          "newPassword": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "A signed-in user changes the password with the current one (F-7 UC6)."
      },
      "ConfirmTotpRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "The first code from the authenticator app, which turns two-factor on (F-11 BR2)."
      },
      "DataExportRequest": {
        "required": [
          "currentPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "A signed-in user downloads their own data (F-16 UC2). The account is the token subject (BR1), so the body\r\ncarries only the proof that the person at the keyboard owns it (BR2)."
      },
      "DisableTotpRequest": {
        "required": [
          "currentPassword",
          "code"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Turning two-factor off needs the current password and a code or recovery code (F-11 BR8)."
      },
      "EraseAccountRequest": {
        "required": [
          "currentPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "A signed-in user erases their own account (F-10 UC2). The account is the token subject (BR1), so the\r\nbody carries only the proof that the person at the keyboard owns it (BR2)."
      },
      "PasswordResetTokenCheckRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Asks whether a reset link still works, without using it (F-7, decision: the page checks on load)."
      },
      "RegenerateRecoveryCodesRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "A current code or a recovery code, which proves the second factor before new codes replace the old ones (F-11 BR7)."
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password",
          "declaresAdult",
          "acceptsTerms",
          "acceptsPrivacy",
          "termsVersion",
          "privacyVersion"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The address that identifies the account."
          },
          "password": {
            "type": "string",
            "description": "The chosen password; the policy is checked by the server (BR2)."
          },
          "declaresAdult": {
            "type": "boolean",
            "description": "The 18+ self-declaration (BR1)."
          },
          "acceptsTerms": {
            "type": "boolean",
            "description": "Acceptance of the terms of use."
          },
          "acceptsPrivacy": {
            "type": "boolean",
            "description": "Acceptance of the privacy policy."
          },
          "termsVersion": {
            "type": "string",
            "description": "The terms version the page showed."
          },
          "privacyVersion": {
            "type": "string",
            "description": "The privacy version the page showed."
          },
          "fullName": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional display name."
          }
        },
        "description": "What the sign-up form sends. The document versions are the ones the page showed, so the server can\r\nrefuse a form filled against texts that have since changed (BR5)."
      },
      "RequestPasswordResetRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Asks for a reset link (F-7 UC1). The answer never says whether the address exists."
      },
      "ResendVerificationRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "description": "Asks for a new verification link. The answer is always the same, whatever the address is (BR11)."
      },
      "ResetPasswordRequest": {
        "required": [
          "token",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": [
              "null",
              "string"
            ]
          },
          "newPassword": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Chooses a new password with the token from the reset email (F-7 UC2)."
      },
      "SaveRoleRequest": {
        "required": [
          "name",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "permissions": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "description": "Creates or replaces a role (F-9, UC2-UC3): the whole permission set, never a patch (BR4)."
      },
      "SetUserRolesRequest": {
        "required": [
          "roleIds"
        ],
        "type": "object",
        "properties": {
          "roleIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "description": "The whole set of roles a user holds after the call (F-9, BR6); an empty set is allowed."
      },
      "SystemInfoResponse": {
        "required": [
          "name",
          "version",
          "environment"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          }
        }
      },
      "UpdatePreferredLanguageRequest": {
        "required": [
          "preferredLanguage"
        ],
        "type": "object",
        "properties": {
          "preferredLanguage": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "F-8 UC3: the header language switch saves the language alone, so it never touches the name (BR6)."
      },
      "UpdateProfileRequest": {
        "required": [
          "fullName",
          "preferredLanguage"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "type": [
              "null",
              "string"
            ]
          },
          "preferredLanguage": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "F-8 UC2: the whole editable profile. A blank name clears it (BR2)."
      },
      "VerifyEmailRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "description": "The raw token from the verification link. It is posted, never sent as a query string to the API."
      }
    }
  },
  "tags": [
    {
      "name": "TokenEndpoints"
    },
    {
      "name": "Simulab.Api"
