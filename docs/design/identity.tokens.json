      "$description": "Dividers between sections (decorative).",
      "$value": { "colorSpace": "srgb", "components": [0.8157, 0.8471, 0.9176], "hex": "#D0D8EA" },
      "$extensions": { "mode": { "dark": { "colorSpace": "srgb", "components": [0.149, 0.2, 0.3216], "hex": "#263352" } } }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "$value": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"]
    },
    "h1": {
      "fontSize": { "$type": "dimension", "$value": { "value": 1.75, "unit": "rem" } },
      "fontWeight": { "$type": "fontWeight", "$value": 700 },
      "lineHeight": { "$type": "number", "$value": 1.2 }
    },
    "h2": {
      "fontSize": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
      "fontWeight": { "$type": "fontWeight", "$value": 600 },
      "lineHeight": { "$type": "number", "$value": 1.3 }
    },
    "body1": {
      "fontSize": { "$type": "dimension", "$value": { "value": 0.9375, "unit": "rem" } },
      "lineHeight": { "$type": "number", "$value": 1.65 }
    },
    "body2": {
      "fontSize": { "$type": "dimension", "$value": { "value": 0.8125, "unit": "rem" } },
      "lineHeight": { "$type": "number", "$value": 1.5 }
    },
    "caption": {
      "fontSize": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } }
    }
  },
  "shape": {
    "borderRadius": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } }
  },
  "$extensions": {
    "agile": {
      "iconFamily": "Material Outlined",
      "source": "file",
      "sourceRef": "src/Hosts/Simulab.Web/Theme/SimulabTheme.cs",
      "date": "2026-10-06"
    }
  }
}
