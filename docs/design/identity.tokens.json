      "$value": { "colorSpace": "srgb", "components": [0.2902, 0.3529, 0.4784], "hex": "#4A5A7A" },
      "$extensions": { "mode": { "dark": { "colorSpace": "srgb", "components": [0.4784, 0.5569, 0.6902], "hex": "#7A8EB0" } } }
    },
