      "$value": { "colorSpace": "srgb", "components": [0.1412, 0.6824, 0.6039], "hex": "#24AE9A" },
      "$extensions": { "mode": { "dark": { "colorSpace": "srgb", "components": [0.1412, 0.6824, 0.6039], "hex": "#24AE9A" } } }
