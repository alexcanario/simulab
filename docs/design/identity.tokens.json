      "$extensions": { "mode": { "dark": { "colorSpace": "srgb", "components": [0.2784, 0.6275, 0.9216], "hex": "#47A0EB" } } }
    },
    "primaryContrastText": {
      "$description": "Text on a filled primary surface.",
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" },
      "$extensions": { "mode": { "dark": { "colorSpace": "srgb", "components": [0.0431, 0.1059, 0.1804], "hex": "#0B1B2E" } } }
    },
    "primaryDarken": {
