{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Simulab visual identity, recorded from SimulabTheme (F-63). IdentityTokensTests keeps it equal to the theme.",
  "color": {
    "$type": "color",
    "primary": {
      "$description": "Brand blue: links, outlined buttons, the app name, the focus ring.",
      "$value": { "colorSpace": "srgb", "components": [0.1294, 0.4275, 0.7098], "hex": "#216DB5" },
      "$extensions": { "mode": { "dark": { "colorSpace": "srgb", "components": [0.3922, 0.6353, 0.8902], "hex": "#64A2E3" } } }
    },
    "primaryContrastText": {
      "$description": "Text and icons on a filled primary surface.",
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" },
      "$extensions": { "mode": { "dark": { "colorSpace": "srgb", "components": [0.098, 0.1412, 0.2431], "hex": "#19243E" } } }
    },
    "primaryDarken": {
      "$description": "Hover tone of a filled primary surface.",
      "$value": { "colorSpace": "srgb", "components": [0.0941, 0.3451, 0.6275], "hex": "#1858A0" },
      "$extensions": { "mode": { "dark": { "colorSpace": "srgb", "components": [0.3137, 0.5882, 0.8627], "hex": "#5096DC" } } }
    },
    "primaryLighten": {
      "$description": "Quiet tint of the primary: the role badge background.",
      "$value": { "colorSpace": "srgb", "components": [0.9216, 0.9529, 0.9922], "hex": "#EBF3FD" },
      "$extensions": { "mode": { "dark": { "colorSpace": "srgb", "components": [0.0863, 0.1451, 0.251], "hex": "#162540" } } }
    },
    "secondary": {
      "$description": "Teal accent: secondary filled buttons.",
      "$value": { "colorSpace": "srgb", "components": [0.102, 0.6196, 0.549], "hex": "#1A9E8C" },
      "$extensions": { "mode": { "dark": { "colorSpace": "srgb", "components": [0.102, 0.6196, 0.549], "hex": "#1A9E8C" } } }
    },
