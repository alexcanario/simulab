      "$value": { "colorSpace": "srgb", "components": [0.949, 0.9608, 0.9843], "hex": "#F2F5FB" },
      "$extensions": { "mode": { "dark": { "colorSpace": "srgb", "components": [0.0549, 0.0941, 0.1569], "hex": "#0E1828" } } }
    },
    "surface": {
      "$description": "Cards, dialogs, menus and form panels.",
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" },
      "$extensions": { "mode": { "dark": { "colorSpace": "srgb", "components": [0.0902, 0.1255, 0.2078], "hex": "#172035" } } }
    },
