      "$description": "The navigation drawer.",
      "$value": { "colorSpace": "srgb", "components": [0.0588, 0.1961, 0.4], "hex": "#0F3266" },
      "$extensions": { "mode": { "dark": { "colorSpace": "srgb", "components": [0.0353, 0.0784, 0.1333], "hex": "#091422" } } }
    },
