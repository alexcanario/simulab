Table ai_calls {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  cost_usd numeric(18,6) [not null, note: 'What the call cost in US dollars: the tokens multiplied by the two prices on this row.']
  duration_ms integer [not null, note: 'How long the call took, in milliseconds, measured around the request.']
  error_code varchar(100) [note: 'Why the call failed, as a stable code such as ai.call_failed. Null when it succeeded.']
  input_price_per_million numeric(18,6) [not null, note: 'US dollars per million input tokens, as configured when the call was made. Kept on the row so a later price change never rewrites the past.']
  input_tokens integer [not null, note: 'Tokens the request spent, as the answer reports them. Zero on a failed call, where none are known.']
  model varchar(100) [not null, note: 'The model that was called, as the provider names it.']
  output_price_per_million numeric(18,6) [not null, note: 'US dollars per million output tokens, as configured when the call was made.']
  output_tokens integer [not null, note: 'Tokens the answer spent, as the answer reports them. Zero on a failed call, where none are known.']
  purpose varchar(50) [not null, note: 'What the call was for, such as diagnostics. Cost can be read per purpose, and a purpose can be sent to another model from configuration.']
  started_at timestamptz [not null, note: 'When the call left the app, in UTC. The monthly quota counts from the first day of the calendar month.']
  succeeded boolean [not null, note: 'False when the model answered with an error or could not be reached. Only successful calls count against the monthly quota.']
  user_id uuid [not null, note: 'Who the call is charged to. Every call belongs to a signed-in user.']

  indexes {
    (user_id, started_at) [name: 'ix_ai_calls_user_started_at']
  }

  Note: 'Entity: AiCall - standard columns: 8 (see data dictionary)'
}
