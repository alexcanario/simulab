// QuestionBank — schema. Generated from the EF model. Do not edit.
// To see the diagram, open it with the dbdiagram VS Code extension ("DBML: Open Preview to the Side").
// Tenant, audit and soft-delete columns are counted in each table note; the data dictionary lists them.

Table base_texts {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  content_language varchar(16) [not null, note: 'The language the text is written in, as a code such as pt-BR. It is never translated, and the questions that link it are in the same language.']
  normalized_title varchar(200) [not null, note: 'The title without case or accents. The list search reads it; derived on every write.']
  text_html varchar(20000) [not null, note: 'The text, as sanitized HTML.']
  title varchar(200) [not null, note: 'What the curator calls the text, trimmed. The list and the picker show it.']

  indexes {
    (content_language, normalized_title) [name: 'ix_base_texts_content_language_normalized_title']
  }

  Note: 'Entity: BaseText - standard columns: 8 (see data dictionary)'
}

Table question_images {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  blob_name varchar(100) [not null, note: 'The name of the file in the storage: question-images/ and a generated id, never the user\'s file name.']
  content_type varchar(40) [not null, note: 'The type decided from the first bytes of the file: image/png, image/jpeg, image/webp or image/gif.']
  owner_id uuid [note: 'The question or base text that holds the image, by id with no foreign key. Null while the image is pending.']
  owner_kind varchar(40) [note: 'What holds the image: Question (its statement or an option) or BaseText. Null while the image is pending.']
  size_bytes bigint [not null, note: 'The size of the file in bytes, from 1 to 2 MB (2097152).']

  indexes {
    (owner_kind, owner_id) [name: 'ix_question_images_owner']
  }

  Note: 'Entity: QuestionImage - standard columns: 8 (see data dictionary)'
}

Table question_match_items {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  match_position integer [note: 'The position of the option (right item) the item matches; the only copy of the key. Null only on a draft.']
  position integer [not null, note: 'Where the item sits, from 0. The number 1 to 8 is the position and is never stored.']
  question_id uuid [not null, note: 'The matching question the item belongs to.']
  text_html varchar(2000) [not null, note: 'The item text as sanitized HTML. Empty only on a draft.']

  indexes {
    question_id [name: 'ix_question_match_items_question']
  }

  Note: 'Entity: QuestionMatchItem - standard columns: 8 (see data dictionary)'
}

Table question_options {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  is_correct boolean [not null, note: 'True for the answer key: exactly one on a published single-choice question, two or more on a multiple-answer one, never on a matching one (its key is question_match_items.match_position).']
  position integer [not null, note: 'Where the option sits, from 0. The letter A to E is the position and is never stored.']
  question_id uuid [not null, note: 'The question the option belongs to.']
  text_html varchar(2000) [not null, note: 'The option text as sanitized HTML. Empty only on a draft.']

  indexes {
    question_id [name: 'ix_question_options_question']
  }

  Note: 'Entity: QuestionOption - standard columns: 8 (see data dictionary)'
}

Table question_review_entries {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  kind varchar(40) [not null, note: 'What happened: Submitted, Withdrawn, Approved or Rejected.']
  question_id uuid [not null, note: 'The question the entry belongs to.']
  reason varchar(500) [note: 'The reason of a rejection or the note of an approval, trimmed. Null when none was given.']

  Note: 'Entity: QuestionReviewEntry - standard columns: 8 (see data dictionary)'
}

Table question_versions {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  annulled boolean [not null, note: 'True when the question was annulled when this version was recorded. A reinstatement is the first version after an annulled one with this false.']
  answer_key_changed boolean [not null, note: 'True when the answer key differs from the previous version\'s. Never true for version 1.']
  base_text_html varchar(20000) [note: 'The base text as sanitized HTML. Empty when there was none.']
  content_language varchar(16) [not null, note: 'The language the content was written in, such as pt-BR.']
  explanation_html varchar(10000) [note: 'The explanation as sanitized HTML. Empty when there was none.']
  number integer [not null, note: '1, 2, ...; unique for the question. The latest version is the highest number.']
  question_id uuid [not null, note: 'The question the version belongs to.']
  reason varchar(500) [note: 'Why the curator changed the answer key, annulled or reinstated the question, or a note on the change. Always set when answer_key_changed or annulled is true.']
  statement_html varchar(10000) [not null, note: 'The statement as sanitized HTML, as it was when the version was recorded.']
  true_false_key boolean [note: 'The key of a true/false question: true means right (certo), false wrong (errado). Null for a single-choice question.']
  type varchar(40) [not null, note: 'How the question is answered: SingleChoice, TrueFalse, MultipleAnswer or Matching.']
  match_items jsonb [note: 'JSON: QuestionVersionMatchItem (MatchPosition, Position, TextHtml)']
  options jsonb [note: 'JSON: QuestionVersionOption (IsCorrect, Position, TextHtml)']

  indexes {
    question_id [name: 'ix_question_versions_question']
  }

  Note: 'Entity: QuestionVersion - standard columns: 8 (see data dictionary)'
}

Table questions {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  base_text_id uuid [note: 'The base text shown before the statement. A foreign key to base_texts; null when the question has none.']
  content_language varchar(16) [not null, note: 'The language the question is written in, such as pt-BR. Question content is never translated.']
  difficulty integer [note: 'From 1 (easiest) to 5 (hardest). Empty when not set.']
  exam_edition_id uuid [note: 'The past exam edition the question came from. Held by id; there is no foreign key to the catalog. Null means the question is authored.']
  explanation_html varchar(10000) [note: 'Why the key is right, as sanitized HTML. Empty when there is none.']
  normalized_statement varchar(10000) [not null, note: 'The plain statement without case or accents. The list search reads it; derived on every write.']
  notice_subject_id uuid [note: 'The notice subject of that edition the question belongs to. Held by id; optional, and only with an edition.']
  paper_number integer [note: 'The number of the question in that edition\'s paper, from 1 to 500. Set exactly when exam_edition_id is.']
  statement_html varchar(10000) [not null, note: 'The statement as sanitized HTML.']
  statement_text varchar(10000) [not null, note: 'The statement without tags. The list excerpt reads it; derived on every write.']
  status varchar(40) [not null, note: 'Where the question is in its life: Draft, InReview, Published or Annulled.']
  topic_id uuid [not null, note: 'The catalog topic the question belongs to. Held by id; there is no foreign key to the catalog.']
  true_false_key boolean [note: 'The key of a true/false question: true means right (certo), false wrong (errado), null not set yet. Always null for a single-choice question.']
  type varchar(40) [not null, note: 'How the question is answered: SingleChoice, TrueFalse, MultipleAnswer or Matching.']

  indexes {
    base_text_id [name: 'ix_questions_base_text']
    exam_edition_id [name: 'ix_questions_exam_edition']
    notice_subject_id [name: 'ix_questions_notice_subject']
    topic_id [name: 'ix_questions_topic']
  }

  Note: 'Entity: Question - standard columns: 8 (see data dictionary)'
}

Ref: question_match_items.question_id > questions.id
Ref: question_options.question_id > questions.id
Ref: question_review_entries.question_id > questions.id
Ref: question_versions.question_id > questions.id
Ref: questions.base_text_id > base_texts.id

TableGroup questions_group {
  base_texts
  question_match_items
  question_options
  question_review_entries
  question_versions
  questions
}
