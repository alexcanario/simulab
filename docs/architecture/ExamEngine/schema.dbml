// ExamEngine — schema. Generated from the EF model. Do not edit.
// To see the diagram, open it with the dbdiagram VS Code extension ("DBML: Open Preview to the Side").
// Tenant, audit and soft-delete columns are counted in each table note; the data dictionary lists them.

Table attempt_answers {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  answer json [note: 'The answer as JSON with a type member, first, that names its shape (the question type). Null while the question is blank.']
  attempt_id uuid [not null, note: 'The attempt the row belongs to.']
  paper_number integer [not null, note: 'The question\'s number in the paper, from 1 to 500; the rows of an attempt are shown in this order.']
  question_id uuid [not null, note: 'The question, a question bank question id. No foreign key: the question lives in another module.']
  question_type varchar(40) [not null, note: 'How the question is answered: SingleChoice, TrueFalse, MultipleAnswer, Matching, FillInTheBlanks, ShortAnswer, OpenAnswer or Essay.']
  version_number integer [not null, note: 'The number of the question version the student saw, fixed at the start; later edits never change it.']

  indexes {
    attempt_id [name: 'ix_attempt_answers_attempt']
  }

  Note: 'Entity: AttemptAnswer - standard columns: 8 (see data dictionary)'
}

Table attempts {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  exam_edition_id uuid [not null, note: 'The published exam edition taken, a Catalog edition id. No foreign key: the edition lives in another module.']
  started_at timestamptz [not null, note: 'When the attempt started, from the server clock.']
  status varchar(20) [not null, note: 'Where the attempt is: InProgress takes answers, Submitted never changes again.']
  student_id uuid [not null, note: 'The student who owns the attempt, an Identity user id. No foreign key: the user lives in another module.']
  submitted_at timestamptz [note: 'When the student submitted, from the server clock. Null while the attempt is in progress.']

  indexes {
    student_id [name: 'ix_attempts_student']
  }

  Note: 'Entity: Attempt - standard columns: 8 (see data dictionary)'
}

Ref: attempt_answers.attempt_id > attempts.id

TableGroup attempts_group {
  attempt_answers
  attempts
}
