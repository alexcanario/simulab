// Identity — schema. Generated from the EF model. Do not edit.
// To see the diagram, open it with the dbdiagram VS Code extension ("DBML: Open Preview to the Side").
// Tenant, audit and soft-delete columns are counted in each table note; the data dictionary lists them.

Table account_events {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  ip_address varchar(45) [note: 'The address the request came from, long enough for IPv6. Null when it could not be read.']
  method varchar(40) [note: 'How it was done, such as Password or Google. Null when the event has no method.']
  reason varchar(40) [note: 'Why it failed, such as InvalidCredentials or LockedOut. Null when nothing failed.']
  type varchar(40) [not null, note: 'What happened, such as SignInSucceeded, PasswordChanged or TwoFactorEnabled.']
  user_id uuid [note: 'Whose account it happened to. Null when the attempt named no existing account.']

  indexes {
    ip_address [name: 'ix_account_events_ip_address']
    type [name: 'ix_account_events_type']
    user_id [name: 'ix_account_events_user_id']
  }

  Note: 'Entity: AccountEvent - standard columns: 8 (see data dictionary)'
}

Table consent_records {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  accepted_at timestamptz [not null, note: 'When they accepted, in UTC.']
  declares_adult boolean [not null, note: 'The person declared they are 18 or older when accepting.']
  ip_address varchar(45) [note: 'The address the acceptance came from, long enough for IPv6. Null when it could not be read.']
  locale varchar(10) [not null, note: 'The language the documents were shown in, such as pt-BR: it is what they actually read.']
  privacy_version varchar(40) [not null, note: 'The version of the privacy policy that was shown and accepted.']
  terms_version varchar(40) [not null, note: 'The version of the terms that was shown and accepted.']
  user_id uuid [not null, note: 'Who accepted.']

  indexes {
    user_id [name: 'ix_consent_records_user_id']
  }

  Note: 'Entity: ConsentRecord - standard columns: 8 (see data dictionary)'
}

Table email_verification_tokens {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  consumed_at timestamptz [note: 'When the link was spent, in UTC. Null while it is still usable; set once, so it cannot be used twice.']
  expires_at timestamptz [not null, note: 'When the link stops working, in UTC.']
  token_hash varchar(64) [not null, note: 'The hash of the token that travelled in the link. The token itself is never stored, so a copy of this table does not let anyone in.']
  user_id uuid [not null, note: 'Whose account the link belongs to.']

  indexes {
    user_id [name: 'ix_email_verification_tokens_user_id']
    token_hash [name: 'ux_email_verification_tokens_hash', unique]
  }

  Note: 'Entity: EmailVerificationToken - standard columns: 8 (see data dictionary)'
}

Table jobs {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  attempts integer [not null, note: 'How many times a worker has started it. The first attempt makes it 1.']
  last_error varchar(2000) [note: 'The message of the last failure, kept with a failed row. Cut so one bad job cannot fill the table.']
  payload text [not null, note: 'The whole input of the job, as JSON. Cleared when the job is given up on: the message is a live link and an address, not evidence.']
  run_after timestamptz [not null, note: 'Not to be run before this instant, in UTC. Set at enqueue and pushed forward by the retry backoff.']
  started_at timestamptz [note: 'When the current attempt started, in UTC. A row stuck here is taken again by another worker.']
  status integer [not null, note: 'What the row is doing: 0 waiting for its turn, 1 a worker is running it, 2 every attempt failed. There is no value for success, because a job that succeeds leaves no row.']
  type varchar(100) [not null, note: 'Which handler runs the job. The worker matches it against the handlers registered in the host.']

  Note: 'Entity: Job - standard columns: 1 (see data dictionary)'
}

Table openiddict_applications {
  id text [pk]
  application_type varchar(50)
  client_id varchar(100)
  client_secret text
  client_type varchar(50)
  concurrency_token varchar(50)
  consent_type varchar(50)
  display_name text
  display_names text
  json_web_key_set text
  permissions text
  post_logout_redirect_uris text
  properties text
  redirect_uris text
  requirements text
  settings text

  indexes {
    client_id [name: 'ix_openiddict_applications_client_id', unique]
  }

  Note: 'Entity: OpenIddictEntityFrameworkCoreApplication'
}

Table openiddict_authorizations {
  id text [pk]
  application_id text
  concurrency_token varchar(50)
  creation_date timestamptz
  properties text
  scopes text
  status varchar(50)
  subject varchar(400)
  type varchar(50)

  indexes {
    (application_id, status, subject, type) [name: 'ix_openiddict_authorizations_application_id_status_subject_type']
  }

  Note: 'Entity: OpenIddictEntityFrameworkCoreAuthorization'
}

Table openiddict_scopes {
  id text [pk]
  concurrency_token varchar(50)
  description text
  descriptions text
  display_name text
  display_names text
  name varchar(200)
  properties text
  resources text

  indexes {
    name [name: 'ix_openiddict_scopes_name', unique]
  }

  Note: 'Entity: OpenIddictEntityFrameworkCoreScope'
}

Table openiddict_tokens {
  id text [pk]
  application_id text
  authorization_id text
  concurrency_token varchar(50)
  creation_date timestamptz
  expiration_date timestamptz
  payload text
  properties text
  redemption_date timestamptz
  reference_id varchar(100)
  status varchar(50)
  subject varchar(400)
  type varchar(150)

  indexes {
    (application_id, status, subject, type) [name: 'ix_openiddict_tokens_application_id_status_subject_type']
    authorization_id [name: 'ix_openiddict_tokens_authorization_id']
    reference_id [name: 'ix_openiddict_tokens_reference_id', unique]
  }

  Note: 'Entity: OpenIddictEntityFrameworkCoreToken'
}

Table password_reset_tokens {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  consumed_at timestamptz [note: 'When the link was spent, in UTC. Null while it is still usable; set once, so it cannot be used twice.']
  expires_at timestamptz [not null, note: 'When the link stops working, in UTC.']
  token_hash varchar(64) [not null, note: 'The hash of the token that travelled in the link. The token itself is never stored, so a copy of this table does not let anyone in.']
  user_id uuid [not null, note: 'Whose account the link belongs to.']

  indexes {
    user_id [name: 'ix_password_reset_tokens_user_id']
    token_hash [name: 'ux_password_reset_tokens_hash', unique]
  }

  Note: 'Entity: PasswordResetToken - standard columns: 8 (see data dictionary)'
}

Table permissions {
  name varchar(100) [pk, note: 'The permission name and the key of the row, such as catalog.manage. The part before the first dot is the module that declares it.']
  description varchar(500) [note: 'What the permission allows, shown to an admin choosing permissions for a role.']

  Note: 'Entity: Permission'
}

Table role_changes {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  action varchar(40) [not null, note: 'What was done, such as RoleCreated, RoleRenamed, RoleDeleted or UserRolesChanged.']
  name_after varchar(256) [note: 'The name after a rename. Null for any other action.']
  name_before varchar(256) [note: 'The name before a rename. Null for any other action.']
  role_id uuid [note: 'The role that changed. Null when the change was about a person\'s roles rather than one role.']
  role_ids "uuid[]" [not null, note: 'Every role the change touched, so a search by role finds it whichever action it was.']
  role_name varchar(256) [note: 'The role\'s name when the change happened, kept so the trail still reads after the role is deleted.']
  target_user_id uuid [note: 'Whose roles changed. Null when the change was about the role itself.']
  added jsonb [note: 'JSON: RoleChangeItem (Key, Name)']
  removed jsonb [note: 'JSON: RoleChangeItem (Key, Name)']

  indexes {
    role_ids [name: 'ix_role_changes_role_ids']
    target_user_id [name: 'ix_role_changes_target_user_id']
  }

  Note: 'Entity: RoleChange - standard columns: 8 (see data dictionary)'
}

Table role_claims {
  id integer [pk]
  claim_type text
  claim_value text
  role_id uuid [not null]

  indexes {
    role_id [name: 'ix_role_claims_role_id']
  }

  Note: 'Entity: IdentityRoleClaim'
}

Table role_permissions {
  permission_name varchar(100) [not null, note: 'The permission that is granted.']
  role_id uuid [not null, note: 'The role the permission is granted to.']

  indexes {
    (role_id, permission_name) [pk]
    permission_name [name: 'ix_role_permissions_permission_name']
  }

  Note: 'Entity: RolePermission'
}

Table roles {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  concurrency_stamp text [note: 'Changes on every save, so two admins editing the same role at once cannot overwrite each other silently.']
  is_system boolean [not null, note: 'True for a role Simulab seeds and depends on, such as Admin: it cannot be renamed or deleted.']
  name varchar(256) [note: 'The role\'s name, as it is shown and as permissions are granted to it.']
  normalized_name varchar(256) [note: 'The name upper-cased, which is what the unique index compares.']

  indexes {
    normalized_name [name: 'ux_roles_normalized_name', unique]
  }

  Note: 'Entity: Role - standard columns: 7 (see data dictionary)'
}

Table user_claims {
  id integer [pk]
  claim_type text
  claim_value text
  user_id uuid [not null]

  indexes {
    user_id [name: 'ix_user_claims_user_id']
  }

  Note: 'Entity: IdentityUserClaim'
}

Table user_logins {
  login_provider varchar(128) [not null]
  provider_key varchar(128) [not null]
  provider_display_name text
  user_id uuid [not null]

  indexes {
    (login_provider, provider_key) [pk]
    user_id [name: 'ix_user_logins_user_id']
  }

  Note: 'Entity: IdentityUserLogin'
}

Table user_roles {
  role_id uuid [not null]
  user_id uuid [not null]

  indexes {
    (user_id, role_id) [pk]
    role_id [name: 'ix_user_roles_role_id']
  }

  Note: 'Entity: IdentityUserRole'
}

Table user_tokens {
  login_provider varchar(128) [not null]
  name varchar(128) [not null]
  user_id uuid [not null]
  value text

  indexes {
    (user_id, login_provider, name) [pk]
  }

  Note: 'Entity: IdentityUserToken'
}

Table users {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  access_failed_count integer [not null, note: 'Failed sign-in attempts since the last success. It reaches the limit and locks the account, and a success clears it.']
  concurrency_stamp text [note: 'Changes on every save, so two people editing the same account at once cannot overwrite each other silently.']
  email varchar(254) [not null, note: 'The address the person signs in with and receives mail at.']
  email_confirmed boolean [not null, note: 'True once the person followed the verification link. Sign-in is refused until then.']
  email_verified_at timestamptz [note: 'When the person followed the verification link, in UTC. Null while the address is unverified.']
  full_name varchar(120) [note: 'The name the person gave, shown in the app. Cleared when the account is erased.']
  is_adult_declared boolean [not null, note: 'The person declared at sign-up that they are 18 or older. Simulab takes the declaration; it does not check an age.']
  lockout_enabled boolean [not null, note: 'True when this account can be locked out after failed sign-ins. True for everyone.']
  lockout_end timestamptz [note: 'The account refuses sign-in until this instant, after too many failed attempts. Null when it is not locked.']
  normalized_email varchar(254) [not null, note: 'The address upper-cased, which is what the unique index compares: one account per address.']
  normalized_user_name varchar(254) [note: 'The sign-in name upper-cased, which is what the unique index compares.']
  password_hash text [note: 'The password, hashed by ASP.NET Identity. The password itself is never stored and cannot be recovered from this.']
  phone_number text [note: 'Not used by Simulab: no feature collects a phone number. The column belongs to ASP.NET Identity.']
  phone_number_confirmed boolean [not null, note: 'Not used by Simulab, like the phone number itself.']
  preferred_language varchar(10) [not null, note: 'The language the app and its emails use for this person, such as pt-BR. It is the first source of the culture, before the cookie and the browser.']
  security_stamp text [note: 'Changes whenever the credentials change. Every open session that does not carry the current value is rejected, which is how a password change signs other devices out.']
  status varchar(20) [not null, note: 'Where the account stands: PendingVerification, Active or Erased.']
  totp_enabled_at timestamptz [note: 'When two-factor enrolment finished, in UTC. Null while it is off.']
  totp_last_accepted_step bigint [note: 'The last time step accepted by two-factor. A code from that step or earlier is refused, so one code cannot be used twice.']
  totp_secret_encrypted varchar(256) [note: 'The two-factor secret, encrypted with the app\'s key. Losing that key makes every enrolment unusable.']
  two_factor_enabled boolean [not null, note: 'True when the person finished enrolling in two-factor sign-in.']
  user_name varchar(254) [note: 'The sign-in name. Simulab signs in by email, so it holds the same address.']

  Note: 'Entity: User - standard columns: 8 (see data dictionary)'
}

Ref: consent_records.user_id > users.id
Ref: email_verification_tokens.user_id > users.id
Ref: openiddict_authorizations.application_id > openiddict_applications.id
Ref: openiddict_tokens.application_id > openiddict_applications.id
Ref: openiddict_tokens.authorization_id > openiddict_authorizations.id
Ref: password_reset_tokens.user_id > users.id
Ref: role_claims.role_id > roles.id
Ref: role_permissions.permission_name > permissions.name
Ref: role_permissions.role_id > roles.id
Ref: user_claims.user_id > users.id
Ref: user_logins.user_id > users.id
Ref: user_roles.role_id > roles.id
Ref: user_roles.user_id > users.id
Ref: user_tokens.user_id > users.id

TableGroup users_group {
  consent_records
  email_verification_tokens
  password_reset_tokens
  permissions
  role_claims
  role_permissions
  roles
  user_claims
  user_logins
  user_roles
  user_tokens
  users
}

TableGroup openiddict_applications_group {
  openiddict_applications
  openiddict_authorizations
  openiddict_tokens
}
