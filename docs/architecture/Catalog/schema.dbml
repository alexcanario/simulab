Table exams {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  assessment_type varchar(40) [not null, note: 'What kind of assessment it is: PublicServiceExam, Certification, UniversityEntranceExam or Enem.']
  content_language varchar(16) [not null, note: 'The language the questions are written in, such as pt-BR. Exam content is never translated.']
  issuing_authority_id uuid [not null, note: 'The body that publishes this exam\'s notices.']
  name varchar(200) [not null, note: 'The exam\'s name, unique inside its issuing authority.']
  normalized_name varchar(200) [not null, note: 'The name without case or accents, which is what the unique index compares.']
  scope varchar(40) [not null, note: 'How far the exam reaches: Federal, State, Municipal, National or International.']
  scope_detail varchar(120) [note: 'Which state or city the scope means, when it is not national.']

  indexes {
    issuing_authority_id [name: 'ix_exams_issuing_authority']
  }

  Note: 'Entity: Exam - standard columns: 8 (see data dictionary)'
}

Table issuing_authorities {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  acronym varchar(20) [not null, note: 'Short name people search by, such as TRF1 or INSS.']
  description varchar(500) [note: 'Free notes about the body, shown to whoever curates the catalog.']
  name varchar(150) [not null, note: 'Full name, as the notice writes it.']
  normalized_acronym varchar(20) [not null, note: 'The acronym without case or accents, which is what the unique index compares.']
  normalized_name varchar(150) [not null, note: 'The name without case or accents, which is what the unique index compares.']
  website varchar(300) [note: 'The body\'s own address, where its notices are published.']

  Note: 'Entity: IssuingAuthority - standard columns: 8 (see data dictionary)'
}

Table organizers {
  id uuid [pk, note: 'Identifier of the row, a UUID v7: generated by the app, ordered by creation time.']
  acronym varchar(20) [not null, note: 'Short name people search by, such as CEBRASPE or FGV.']
  description varchar(500) [note: 'Free notes about the organizer, shown to whoever curates the catalog.']
  kind varchar(40) [not null, note: 'What kind of organizer it is: ExamBoard, CertifyingBody or University.']
  name varchar(150) [not null, note: 'Full name, as the organizer writes it.']
  normalized_acronym varchar(20) [not null, note: 'The acronym without case or accents, which is what the unique index compares.']
  normalized_name varchar(150) [not null, note: 'The name without case or accents, which is what the unique index compares.']
  website varchar(300) [note: 'The organizer\'s own address, where its notices are published.']

  Note: 'Entity: Organizer - standard columns: 8 (see data dictionary)'
}

Ref: exams.issuing_authority_id > issuing_authorities.id

TableGroup issuing_authorities_group {
  exams
  issuing_authorities
}
