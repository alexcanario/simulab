<Project>

  <!--
    Central Package Management.
      1. No .csproj declares Version= on a PackageReference. The version lives here.
      2. A new package: add the PackageVersion here and the PackageReference (no version) in the project.
      3. Forbidden (ADR-0001): MassTransit, RabbitMQ clients, FluentAssertions. The architecture tests check it.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Applied to every project: turns BannedSymbols.txt into build warnings (RS0030). -->
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
  </ItemGroup>

  <!-- ASP.NET Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <!-- Aspire service defaults and observability -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
  </ItemGroup>

  <!-- Building blocks -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <!-- F-13: BackgroundService for the job worker, in a class library (a host gets it from the framework). -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
  </ItemGroup>

  <!-- Data (F-3) -->
  <ItemGroup>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql.DependencyInjection" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.5.0" />
  </ItemGroup>

  <!-- Identity (F-4) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.12" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3" />
  </ItemGroup>

  <!-- Sign-in and sign-out (F-5): OpenIddict server + Redis-backed sessions -->
  <ItemGroup>
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.1" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.7.1" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.5.4" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.5.4" />
    <PackageVersion Include="StackExchange.Redis" Version="3.3.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.15.0" />
  </ItemGroup>

  <!-- Email (F-3) -->
  <ItemGroup>
    <PackageVersion Include="MailKit" Version="4.18.0" />
  </ItemGroup>

  <!-- UI -->
  <ItemGroup>
    <PackageVersion Include="MudBlazor" Version="9.9.0" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <!-- AwesomeAssertions is the Apache-2.0 fork of FluentAssertions. Never go back to FluentAssertions (commercial license). -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="bunit" Version="2.10.3" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
