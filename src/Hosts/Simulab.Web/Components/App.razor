<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* F-125, BR10: the Control Alt Systems app icon. *@
    <link rel="icon" type="image/svg+xml" href="@Assets["brand/app-icon.svg"]" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    @* F-95: the visual editor's own styles, hosted by the app (never a CDN); app.css overrides them with the theme. *@
    <link rel="stylesheet" href="@Assets["lib/quill/quill.snow.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Simulab.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" Preferences="_preferences" VisitorAddress="@_visitorAddress" GoogleSignUpBinding="@_googleSignUpBinding" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/shell.js"]"></script>
    @* F-95: Quill 2 (hosted in wwwroot), the Blazored.TextEditor adapter and the module it registers on every
       editor (QuillBlotFormatter: createQuill throws without it and no editor is built), then the kit's own
       editor script. Found on the real page, never in bUnit, where the editor is a fake. *@
    <script src="@Assets["lib/quill/quill.js"]"></script>
    <script src="@Assets["_content/Blazored.TextEditor/quill-blot-formatter.min.js"]"></script>
    <script src="@Assets["_content/Blazored.TextEditor/Blazored-BlazorQuill.js"]"></script>
    <script src="@Assets["js/rich-text.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private ShellPreferences _preferences = ShellPreferences.Default;

    // B-4: the circuit has no request of its own; the address travels as a root parameter, which the
    // framework protects in the page, so the browser cannot change it.
    private string? _visitorAddress;

    // F-20 BR8: the HttpOnly cookie that ties a waiting Google sign-up to this browser, carried the same way.
    private string? _googleSignUpBinding;

    protected override void OnInitialized()
    {
        if (HttpContext is not null)
        {
            _preferences = ShellPreferences.From(
                HttpContext.Request.Cookies[PreferenceCookies.Theme],
                HttpContext.Request.Cookies[PreferenceCookies.Navigation]);
            _visitorAddress = HttpContext.Connection.RemoteIpAddress?.ToString();
            _googleSignUpBinding = HttpContext.Request.Cookies[Simulab.Web.Services.Auth.GoogleSignUpTicket.BindingCookie];
        }
    }
}
