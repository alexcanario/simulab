@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<SharedResources> L
@inject IStringLocalizer<IdentityResources> I
@inject ThemeState ThemeState

@* Declared exception of the ui rule (ui-project): sign-up and verification have no app menu and no
   breadcrumb. The language and theme switches stay, because the visitor chooses the language of the
   account and of the legal text they are accepting. The page renders its own card, so a form and a
   legal document can have different widths without a second layout. *@

<MudThemeProvider @ref="_themeProvider" Theme="_theme" IsDarkMode="ThemeState.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-auth">
    <header class="app-auth-bar">
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6"
                 Class="app-auth-name" aria-label="@L["Layout.HomeLink"]">@L["App.Name"]</MudLink>
        <MudSpacer />
        <ThemeSwitch />
        <LanguageSwitch />
    </header>

    <main id="main-content" tabindex="-1" class="app-auth-main">
        @Body

        <nav class="app-auth-footer" aria-label="@I["Auth.Legal.Label"]">
            <AppLink Href="/terms">@I["Auth.Legal.Terms"]</AppLink>
            <AppLink Href="/privacy">@I["Auth.Legal.Privacy"]</AppLink>
        </nav>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L["Layout.UnhandledError"]
    <a href="." class="reload">@L["Layout.Reload"]</a>
    <span class="dismiss" role="button" aria-label="@L["Layout.Dismiss"]">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = Theme.SimulabTheme.Create();
    private MudThemeProvider? _themeProvider;

    [CascadingParameter] public ShellPreferences Preferences { get; set; } = ShellPreferences.Default;

    protected override void OnInitialized()
    {
        if (Preferences.DarkMode is { } dark)
            ThemeState.SetDarkMode(dark);
        ThemeState.Changed += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Preferences.DarkMode is null && _themeProvider is not null)
            ThemeState.SetDarkMode(await _themeProvider.GetSystemDarkModeAsync());
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeState.Changed -= OnThemeChanged;
}
