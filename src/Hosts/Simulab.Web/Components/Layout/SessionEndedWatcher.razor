@using Microsoft.AspNetCore.Components.Authorization
@using Simulab.Web.Services.Auth
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ILogger<SessionEndedWatcher> Logger

@* B-3, BR5: renders nothing. When the circuit's revalidation finds the session ended, the browser goes
   through the plain sign-out endpoint (which clears the cookie) to sign in again with the alert. *@

@code {
    private bool _wasSignedIn;

    protected override async Task OnInitializedAsync()
    {
        _wasSignedIn = IsSignedIn(await AuthenticationStateProvider.GetAuthenticationStateAsync());
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    // The event fires on the revalidation loop's thread: everything runs on the circuit's own context,
    // and nothing may escape an async void handler.
    private void OnAuthenticationStateChanged(Task<AuthenticationState> state) =>
        _ = InvokeAsync(async () =>
        {
            try
            {
                var signedIn = IsSignedIn(await state);
                if (_wasSignedIn && !signedIn)
                {
                    Navigation.NavigateTo($"/account/sign-out?reason={AccountEndpoints.SessionEndedReason}", forceLoad: true);
                }

                _wasSignedIn = signedIn;
            }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                Logger.LogWarning(exception, "Following the authentication state failed.");
            }
        });

    private static bool IsSignedIn(AuthenticationState state) => state.User.Identity?.IsAuthenticated == true;

    public void Dispose() => AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
}
