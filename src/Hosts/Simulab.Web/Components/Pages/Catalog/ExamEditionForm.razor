@page "/admin/exams/{ExamId:guid}/editions/new"
@page "/admin/exams/{ExamId:guid}/editions/{Id:guid}"
@attribute [Authorize(Policy = PermissionPolicy.Prefix + CatalogPermissions.Manage)]
@layout MainLayout
@using Simulab.Catalog.Contracts
@using Simulab.Identity.Contracts
@using Simulab.QuestionBank.Contracts
@using Simulab.Web.Localization
@using Simulab.Web.Services
@inject CatalogApiClient Api
@inject Simulab.Web.Services.Auth.WebSessionTokenAccessor Tokens
@inject IStringLocalizer<SharedResources> L
@inject ISnackbar Snackbar
@inject ErrorText Errors
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TimeProvider Clock

@* F-35, Screen 2, UC2 and UC3: an edition is edited on a page of its own (rule: ui-project - a complex entity),
   reached from its exam's section. The only primary button is Save, at the bottom of the form. The Api runs
   every rule (BR3 to BR9); the checks here are for comfort. There is no delete here: an edition is deleted from
   its row, one way (rule: ui). *@
<AppPageHeader Title="@Title" Breadcrumbs="_breadcrumbs" />

@if (_loading)
{
    <AppLoadingState />
}
else if (_examNotFound)
{
    <MudPaper Class="app-form-card" Elevation="0">
        <AppAlert Severity="Severity.Error" Text="@Errors.For(CatalogErrorCodes.ExamNotFound)" Class="mb-4" />
        <AppLink Href="/admin/exams">@L["Exams.BackToList"]</AppLink>
    </MudPaper>
}
else if (_editionNotFound)
{
    <MudPaper Class="app-form-card" Elevation="0">
        <AppAlert Severity="Severity.Error" Text="@Errors.For(CatalogErrorCodes.ExamEditionNotFound)" Class="mb-4" />
        <AppLink Href="@ExamHref">@L["ExamEditions.BackToExam"]</AppLink>
    </MudPaper>
}
else
{
    <div class="app-form-layout">
        <MudPaper Class="app-form-card" Elevation="0">
            <AppErrorSummary Id="@ErrorSummaryId"
                             Title="@L["Common.ErrorSummary.Title"]"
                             Items="@(_showErrorSummary ? ErrorSummaryItems : Array.Empty<AppErrorSummaryItem>())" />

            @if (_error is not null)
            {
                <AppAlert Severity="Severity.Error" Text="@_error" Class="mb-4" />
                @if (_backHref is not null)
                {
                    <div class="mb-4">
                        <AppLink Href="@_backHref">@_backText</AppLink>
                    </div>
                }
            }

            <AppSectionCard Id="edition-section-paper"
                            Title="@L["ExamEditions.Section.Paper"]"
                            Icon="@AppIcons.Exams"
                            Subtitle="@L["ExamEditions.Section.Paper.Subtitle"]">
                <AppFormGrid Columns="2">
                    <AppLookupField Id="edition-organizer"
                                    Label="@L["ExamEditions.Field.Organizer"]"
                                    Placeholder="@L["ExamEditions.Field.Organizer.Placeholder"]"
                                    LeadingIcon="@AppIcons.Organizers"
                                    SearchAsync="SearchOrganizersAsync"
                                    Value="_organizer"
                                    ValueChanged="OnOrganizerChanged"
                                    Required="true"
                                    Hint="@L["ExamEditions.Field.Organizer.Hint"]"
                                    Error="@_organizerError" />

                    <AppTextField TValue="int?"
                                  Id="edition-notice-year"
                                  Label="@L["ExamEditions.Field.NoticeYear"]"
                                  Value="_noticeYear"
                                  ValueChanged="@((int? value) => OnNoticeYearChanged(value))"
                                  InputType="InputType.Number"
                                  Required="true"
                                  MaxLength="CatalogLimits.ExamEditionNoticeYearDigits"
                                  Autocomplete="off"
                                  Placeholder="@L["ExamEditions.Field.NoticeYear.Placeholder"]"
                                  Hint="@L["ExamEditions.Field.NoticeYear.Hint", MaxNoticeYear]"
                                  Error="@_noticeYearError" />
                </AppFormGrid>
                <AppFormGrid Columns="1">
                    <AppTextField TValue="string"
                                  Id="edition-position"
                                  Label="@L["ExamEditions.Field.Position"]"
                                  Value="@_position"
                                  ValueChanged="@((string? value) => OnPositionChanged(value))"
                                  MaxLength="CatalogLimits.ExamEditionPositionMaxLength"
                                  Autocomplete="off"
                                  Placeholder="@L["ExamEditions.Field.Position.Placeholder"]"
                                  Hint="@L["ExamEditions.Field.Position.Hint"]"
                                  Error="@_positionError" />
                </AppFormGrid>
            </AppSectionCard>

            @* F-168 UC1 to UC3: the rules the notice sets for the paper. Every one is optional (BR1); the scores are bound
               as text and read in the reader's culture. The objective total is the notice subjects' (BR4), read from the
               section below, and a cut-off above it is only a warning (BR5). *@
            <AppSectionCard Id="edition-section-rules"
                            Title="@L["ExamRules.Section.Title"]"
                            Icon="@AppIcons.Rules"
                            Subtitle="@L["ExamRules.Section.Subtitle"]">
                <AppFormGrid Columns="2">
                    <AppTextField TValue="int?"
                                  Id="edition-duration-hours"
                                  Label="@L["ExamRules.Field.DurationHours"]"
                                  Value="_durationHours"
                                  ValueChanged="@((int? value) => OnDurationHoursChanged(value))"
                                  InputType="InputType.Number"
                                  Autocomplete="off"
                                  Hint="@L["ExamRules.Field.Duration.Hint"]"
                                  Error="@_durationError" />

                    <AppTextField TValue="int?"
                                  Id="edition-duration-minutes"
                                  Label="@L["ExamRules.Field.DurationMinutes"]"
                                  Value="_durationMinutes"
                                  ValueChanged="@((int? value) => OnDurationMinutesChanged(value))"
                                  InputType="InputType.Number"
                                  Autocomplete="off" />

                    <AppTextField TValue="string"
                                  Id="edition-objective-cut-off"
                                  Label="@L["ExamRules.Field.ObjectiveCutOff"]"
                                  Value="_objectiveCutOff"
                                  ValueChanged="@((string? value) => OnObjectiveCutOffChanged(value))"
                                  Autocomplete="off"
                                  Hint="@L["ExamRules.Field.ObjectiveCutOff.Hint"]"
                                  Error="@_objectiveCutOffError" />

                    <div class="app-exam-rules-total">
                        <p id="edition-objective-total" class="app-muted">@ObjectiveTotalText</p>
                    </div>

                    <AppTextField TValue="string"
                                  Id="edition-essay-max-score"
                                  Label="@L["ExamRules.Field.EssayMaxScore"]"
                                  Value="_essayMax"
                                  ValueChanged="@((string? value) => OnEssayMaxChanged(value))"
                                  Autocomplete="off"
                                  Error="@_essayMaxError" />

                    <AppTextField TValue="string"
                                  Id="edition-essay-cut-off"
                                  Label="@L["ExamRules.Field.EssayCutOff"]"
                                  Value="_essayCutOff"
                                  ValueChanged="@((string? value) => OnEssayCutOffChanged(value))"
                                  Autocomplete="off"
                                  Hint="@L["ExamRules.Field.EssayCutOff.Hint"]"
                                  Error="@_essayCutOffError" />
                </AppFormGrid>

                @if (CutOffAboveTotal)
                {
                    <div id="edition-cut-off-above-total">
                        <AppAlert Severity="Severity.Warning" Text="@L["ExamRules.CutOffAboveTotal", ScoreText.Compact(_objectiveTotal!.Value)]" />
                    </div>
                }

                @if (MissingRules.Count > 0)
                {
                    <div id="edition-rules-missing" class="app-exam-rules-missing">
                        <AppAlert Severity="Severity.Info" Text="@($"{L["ExamRules.Missing.Title"]} {string.Join(" · ", MissingRules)}")" />
                    </div>
                }
            </AppSectionCard>

            <AppSectionCard Id="edition-section-notice"
                            Title="@L["ExamEditions.Section.Notice"]"
                            Icon="@AppIcons.Notice"
                            Subtitle="@L["ExamEditions.Section.Notice.Subtitle"]">
                <AppFormGrid Columns="2">
                    <AppTextField TValue="string"
                                  Id="edition-notice-reference"
                                  Label="@L["ExamEditions.Field.NoticeReference"]"
                                  Value="@_noticeReference"
                                  ValueChanged="@((string? value) => OnNoticeReferenceChanged(value))"
                                  MaxLength="CatalogLimits.ExamEditionNoticeReferenceMaxLength"
                                  Autocomplete="off"
                                  Placeholder="@L["ExamEditions.Field.NoticeReference.Placeholder"]"
                                  Hint="@L["ExamEditions.Field.NoticeReference.Hint"]"
                                  Error="@_noticeReferenceError" />

                    <AppUrlField Id="edition-notice-url"
                                  Label="@L["ExamEditions.Field.NoticeUrl"]"
                                  Value="@_noticeUrl"
                                  ValueChanged="@((string? value) => OnNoticeUrlChanged(value))"
                                  MaxLength="CatalogLimits.ExamEditionNoticeUrlMaxLength"
                                  Autocomplete="off"
                                  LeadingIcon="@AppIcons.Link"
                                  Placeholder="@L["ExamEditions.Field.NoticeUrl.Placeholder"]"
                                  Hint="@L["ExamEditions.Field.NoticeUrl.Hint"]"
                                  Error="@_noticeUrlError" />
                </AppFormGrid>
                <AppFormGrid Columns="2">
                    <AppDateField Id="edition-applied-on"
                                  Label="@L["ExamEditions.Field.AppliedOn"]"
                                  Value="_appliedOn"
                                  ValueChanged="OnAppliedOnChanged"
                                  Min="@AppliedOnMin"
                                  Hint="@L["ExamEditions.Field.AppliedOn.Hint"]"
                                  Error="@_appliedOnError" />
                </AppFormGrid>
                @* F-89: the notice PDF is kept in Simulab besides the official link; both are optional and independent
                   (BR1). Choosing, replacing or removing it is a change of the form, sent only by Save (BR5). *@
                <AppFormGrid Columns="1">
                    <AppFileField Id="edition-notice-document"
                                  Label="@L["ExamEditions.NoticeDocument.Label"]"
                                  Hint="@L["ExamEditions.NoticeDocument.Hint"]"
                                  Error="@_documentError"
                                  Accept=".pdf,application/pdf"
                                  StoredName="@_saved?.NoticeDocument?.FileName"
                                  StoredSizeText="@(_saved?.NoticeDocument is { } stored ? FileSizeText.Format(stored.Size) : null)"
                                  DownloadHref="@(_saved is null ? null : $"/catalog/exams/{ExamId}/editions/{_saved.Id}/notice-document")"
                                  DownloadText="@L["ExamEditions.NoticeDocument.Download"]"
                                  DownloadLabel="@(L["ExamEditions.NoticeDocument.Download.Name", _saved?.NoticeDocument?.FileName ?? string.Empty].Value)"
                                  ChosenText="@(_chosen is null ? null : L["ExamEditions.NoticeDocument.Chosen", _chosen.Name].Value)"
                                  RemovePending="_removeDocument"
                                  ChooseText="@L["ExamEditions.NoticeDocument.Choose"]"
                                  ReplaceText="@L["ExamEditions.NoticeDocument.Replace"]"
                                  RemoveText="@L["ExamEditions.NoticeDocument.Remove"]"
                                  DiscardText="@L["ExamEditions.NoticeDocument.Discard"]"
                                  RemovePendingText="@L["ExamEditions.NoticeDocument.RemovePending"]"
                                  KeepText="@L["ExamEditions.NoticeDocument.KeepFile"]"
                                  OnChosen="OnDocumentChosenAsync"
                                  OnDiscard="OnDocumentDiscarded"
                                  OnRemove="OnDocumentRemoved"
                                  OnKeep="OnDocumentKept" />
                </AppFormGrid>
            </AppSectionCard>

            <AppSectionCard Id="edition-section-publication"
                            Title="@L["ExamEditions.Section.Publication"]"
                            Icon="@AppIcons.View"
                            Subtitle="@L["ExamEditions.Section.Publication.Subtitle"]">
                <AppRadioCards TValue="ExamEditionStatus?"
                               Id="edition-status"
                               Label="@L["ExamEditions.Field.Status"]"
                               Columns="2"
                               Value="_status"
                               ValueChanged="@((ExamEditionStatus? value) => OnStatusChanged(value))"
                               Options="StatusCards"
                               Required="true"
                               Error="@_statusError" />
            </AppSectionCard>

            <AppFormActions Saving="_saving" HasChanges="HasChanges" OnSave="SaveAsync" OnCancel="Cancel" />
        </MudPaper>

        <AppFormAside Title="@L["Common.Summary.Title"]"
                      EmptyText="@L["Common.Summary.NotFilled"]"
                      Rows="AsideRows"
                      ChecklistTitle="@L["Common.Summary.Checklist"]"
                      DoneText="@L["Common.Checklist.Done"]"
                      PendingText="@L["Common.Checklist.Pending"]"
                      Checklist="AsideChecklist" />
    </div>

    @* F-74, Screen 1: the notice subjects of the edition, in a card of their own below the whole layout and outside
       the edition form - the edition's Save never saves one, and the aside keeps summarising only the edition. On a
       new edition the section only says to save the edition first (AC17). *@
    <MudPaper Class="app-form-card mt-4" Elevation="0">
        <NoticeSubjectsSection ExamId="ExamId" EditionId="@_saved?.Id" RowsChanged="OnSubjectsChanged" />
    </MudPaper>

    @* F-96, UC3: the questions that came from this edition, in paper order. Rendered only for who also holds
       questions.manage (BR12); the card is not drawn at all otherwise, so an admin with only catalog.manage sees
       no empty frame. *@
    <AuthorizeView Policy="@(PermissionPolicy.Prefix + QuestionBankPermissions.Manage)">
        <MudPaper Class="app-form-card mt-4" Elevation="0">
            <EditionQuestionsSection EditionId="@_saved?.Id" />
        </MudPaper>
    </AuthorizeView>
}

@code {
    private const string ErrorSummaryId = "edition-error-summary";

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>The exam the edition belongs to; fixed at creation, an edition never moves (BR2).</summary>
    [Parameter] public Guid ExamId { get; set; }

    /// <summary>The edition being edited; absent on the adding route.</summary>
    [Parameter] public Guid? Id { get; set; }

    private IReadOnlyList<BreadcrumbItem> _breadcrumbs = [];
    private ExamResponse? _exam;
    private ExamEditionResponse? _saved;
    private AppLookupOption? _organizer;
    private int? _noticeYear;
    private string? _position;
    private string? _noticeReference;
    private string? _noticeUrl;
    private DateOnly? _appliedOn;
    private ExamEditionStatus? _status = ExamEditionStatus.Draft;
    private string? _organizerError;
    private string? _noticeYearError;
    private string? _positionError;
    private string? _noticeReferenceError;
    private string? _noticeUrlError;
    private string? _appliedOnError;
    private string? _statusError;
    private string? _documentError;
    private int? _durationHours;
    private int? _durationMinutes;
    private string? _objectiveCutOff;
    private string? _essayMax;
    private string? _essayCutOff;
    private string? _durationError;
    private string? _objectiveCutOffError;
    private string? _essayMaxError;
    private string? _essayCutOffError;
    // F-168 UC3: the notice subjects as the section below last loaded them; null until it has.
    private IReadOnlyList<NoticeSubjectResponse>? _subjects;
    private decimal? _objectiveTotal;
    private IReadOnlyList<string> _incompleteSubjects = [];
    private ChosenDocument? _chosen;
    private bool _removeDocument;
    private string? _error;
    private string? _backHref;
    private string? _backText;
    private bool _loading;
    private bool _examNotFound;
    private bool _editionNotFound;
    private bool _saving;
    private bool _showErrorSummary;
    private bool _focusSummary;

    private bool IsEdit => _saved is not null;

    private string Title => IsEdit || Id is not null ? L["ExamEditions.Form.EditTitle"] : L["ExamEditions.Form.AddTitle"];

    private string ExamHref => $"/admin/exams/{ExamId}";

    /// <summary>BR4: the newest notice year is next year's, and the current year comes from the clock, not the machine.</summary>
    private int MaxNoticeYear => Clock.GetUtcNow().Year + 1;

    private bool NoticeYearValid =>
        _noticeYear is { } year && year >= CatalogLimits.ExamEditionNoticeYearMin && year <= MaxNoticeYear;

    // The calendar greys the days before the notice year; the rule's text stays the error code's (BR8).
    private DateOnly? AppliedOnMin => NoticeYearValid ? new DateOnly(_noticeYear!.Value, 1, 1) : null;

    // The cards carry the one line that says what each choice means: publishing decides who sees the paper.
    private IReadOnlyList<AppRadioCardOption<ExamEditionStatus?>> StatusCards =>
        [.. Enum.GetValues<ExamEditionStatus>().Select(status => new AppRadioCardOption<ExamEditionStatus?>(
            status,
            ExamEditionText.StatusName(L, status),
            L[$"ExamEditions.Status.{status}.Description"]))];

    private string? ContentLanguageSummary =>
        _exam is null
            ? null
            : SupportedCultures.All.Where(culture => culture.Name == _exam.ContentLanguage)
                .Select(SupportedCultures.NativeName)
                .FirstOrDefault() ?? _exam.ContentLanguage;

    // What the read-only aside shows beside the form, without a button of its own.
    private IReadOnlyList<AppAsideRow> AsideRows =>
    [
        new(L["ExamEditions.Field.Exam"], _exam?.Name),
        new(L["Exams.Field.ContentLanguage"], ContentLanguageSummary),
        new(L["ExamEditions.Field.Organizer"], _organizer?.Text),
        new(L["ExamEditions.Field.NoticeYear"], _noticeYear?.ToString(CultureInfo.InvariantCulture)),
        new(L["ExamEditions.Field.Position"], NullIfBlank(_position)),
        new(L["ExamEditions.Field.NoticeReference"], NullIfBlank(_noticeReference)),
        new(L["ExamEditions.Field.AppliedOn"], _appliedOn?.ToString("d", CultureInfo.CurrentCulture)),
        new(L["ExamEditions.Field.Status"], _status is { } status ? ExamEditionText.StatusName(L, status) : null),
        new(L["ExamRules.Aside.Duration"], ParsedDuration() is { } minutes ? ExamRulesText.Duration(L, minutes) : null),
        new(L["ExamRules.Aside.CutOff"], CutOffSummary)
    ];

    // "60 / 100" once the total is known, "60" before it (F-168, aside).
    private string? CutOffSummary =>
        ParsedScore(_objectiveCutOff) is not { } cutOff
            ? null
            : _objectiveTotal is { } total
                ? L["ExamRules.Aside.CutOffOfTotal", ScoreText.Compact(cutOff), ScoreText.Compact(total)]
                : ScoreText.Compact(cutOff);

    // F-168 BR4: the objective total of the section's rows, or why it is unknown.
    private string ObjectiveTotalText =>
        _objectiveTotal is { } total
            ? L["ExamRules.ObjectiveTotal", total.ToString("N2", CultureInfo.CurrentCulture)]
            : _subjects is { Count: 0 }
                ? L["ExamRules.ObjectiveTotal.NoSubjects"]
                : L["ExamRules.ObjectiveTotal.Unknown"];

    // F-168 BR5: a warning, never a refusal.
    private bool CutOffAboveTotal =>
        _objectiveTotal is { } total && ParsedScore(_objectiveCutOff) is { } cutOff && cutOff > total;

    // F-168 UC3 and AC8: what the reader may still want to fill; publishing is never blocked by it (BR1).
    private IReadOnlyList<string> MissingRules
    {
        get
        {
            List<string> missing = [];
            if (ParsedDuration() is null)
            {
                missing.Add(L["ExamRules.Missing.Duration"]);
            }

            if (ParsedScore(_objectiveCutOff) is null)
            {
                missing.Add(L["ExamRules.Missing.ObjectiveCutOff"]);
            }

            if (ParsedScore(_essayMax) is null)
            {
                missing.Add(L["ExamRules.Missing.EssayMaxScore"]);
            }

            if (_incompleteSubjects.Count > 0)
            {
                missing.Add(L["ExamRules.Missing.Subjects", string.Join(", ", _incompleteSubjects)]);
            }

            return missing;
        }
    }

    private IReadOnlyList<AppChecklistItem> AsideChecklist =>
    [
        new(L["ExamEditions.Field.Organizer"], _organizer is not null),
        new(L["ExamEditions.Field.NoticeYear"], NoticeYearValid)
    ];

    // One line per field the reader has not fixed yet, in the order the form shows them.
    private IReadOnlyList<AppErrorSummaryItem> ErrorSummaryItems =>
    [
        .. new (string? Error, string FieldId, string Label)[]
        {
            (_organizerError, "edition-organizer", L["ExamEditions.Field.Organizer"]),
            (_noticeYearError, "edition-notice-year", L["ExamEditions.Field.NoticeYear"]),
            (_positionError, "edition-position", L["ExamEditions.Field.Position"]),
            (_durationError, "edition-duration-hours", L["ExamRules.Field.Duration"]),
            (_objectiveCutOffError, "edition-objective-cut-off", L["ExamRules.Field.ObjectiveCutOff"]),
            (_essayMaxError, "edition-essay-max-score", L["ExamRules.Field.EssayMaxScore"]),
            (_essayCutOffError, "edition-essay-cut-off", L["ExamRules.Field.EssayCutOff"]),
            (_noticeReferenceError, "edition-notice-reference", L["ExamEditions.Field.NoticeReference"]),
            (_noticeUrlError, "edition-notice-url", L["ExamEditions.Field.NoticeUrl"]),
            (_appliedOnError, "edition-applied-on", L["ExamEditions.Field.AppliedOn"]),
            (_documentError, "edition-notice-document", L["ExamEditions.NoticeDocument.Label"]),
            (_statusError, "edition-status", L["ExamEditions.Field.Status"])
        }.Where(item => item.Error is not null)
         .Select(item => new AppErrorSummaryItem(item.FieldId, item.Label))
    ];

    // Against the saved edition, or the empty new form with its Draft status.
    private bool HasChanges =>
        _organizer?.Id != _saved?.OrganizerId
        || _noticeYear != _saved?.NoticeYear
        || Trimmed(_position) != (_saved?.Position ?? string.Empty)
        || Trimmed(_noticeReference) != (_saved?.NoticeReference ?? string.Empty)
        || Trimmed(_noticeUrl) != (_saved?.NoticeUrl ?? string.Empty)
        || _appliedOn != _saved?.AppliedOn
        || _status != (_saved?.Status ?? ExamEditionStatus.Draft)
        || ParsedDuration() != _saved?.DurationMinutes
        || Trimmed(_objectiveCutOff) != (ScoreText.ForField(_saved?.ObjectiveCutOffScore) ?? string.Empty)
        || Trimmed(_essayMax) != (ScoreText.ForField(_saved?.EssayMaxScore) ?? string.Empty)
        || Trimmed(_essayCutOff) != (ScoreText.ForField(_saved?.EssayCutOffScore) ?? string.Empty)
        || _chosen is not null
        || _removeDocument;

    protected override async Task OnParametersSetAsync()
    {
        BuildBreadcrumbs();

        var examChanged = _exam?.Id != ExamId;
        var editionChanged = Id is { } id && _saved?.Id != id;
        if (!examChanged && !editionChanged)
        {
            return;
        }

        _loading = true;
        _examNotFound = false;
        _editionNotFound = false;
        var token = await TokenAsync();

        if (examChanged)
        {
            var exam = token is null ? null : await Api.FindExamAsync(token, ExamId);
            if (exam is not { IsSuccess: true, Value: { } found })
            {
                _loading = false;
                _examNotFound = true;
                BuildBreadcrumbs();
                return;
            }

            _exam = found;
        }

        if (Id is { } editionId)
        {
            var edition = token is null ? null : await Api.FindExamEditionAsync(token, ExamId, editionId);
            if (edition is not { IsSuccess: true, Value: { } loaded })
            {
                _loading = false;
                _editionNotFound = true;
                BuildBreadcrumbs();
                return;
            }

            Hydrate(loaded);
        }

        _loading = false;
        BuildBreadcrumbs();
    }

    private void Hydrate(ExamEditionResponse edition)
    {
        _saved = edition;
        _organizer = new AppLookupOption(edition.OrganizerId, $"{edition.OrganizerName} ({edition.OrganizerAcronym})");
        _noticeYear = edition.NoticeYear;
        _position = edition.Position ?? string.Empty;
        _noticeReference = edition.NoticeReference ?? string.Empty;
        _noticeUrl = edition.NoticeUrl ?? string.Empty;
        _appliedOn = edition.AppliedOn;
        _status = edition.Status;
        _durationHours = edition.DurationMinutes / 60;
        _durationMinutes = edition.DurationMinutes % 60;
        _objectiveCutOff = ScoreText.ForField(edition.ObjectiveCutOffScore);
        _essayMax = ScoreText.ForField(edition.EssayMaxScore);
        _essayCutOff = ScoreText.ForField(edition.EssayCutOffScore);
    }

    // F-168 BR2: hours and minutes become whole minutes; both empty is no time limit.
    private int? ParsedDuration() =>
        _durationHours is null && _durationMinutes is null ? null : ((_durationHours ?? 0) * 60) + (_durationMinutes ?? 0);

    private static decimal? ParsedScore(string? text) => ScoreText.TryParse(text, out var value) ? value : null;

    private void OnDurationHoursChanged(int? value)
    {
        _durationHours = value;
        _durationError = DurationError();
    }

    private void OnDurationMinutesChanged(int? value)
    {
        _durationMinutes = value;
        _durationError = DurationError();
    }

    private void OnObjectiveCutOffChanged(string? value)
    {
        _objectiveCutOff = value;
        _objectiveCutOffError = ScoreError(value, CatalogErrorCodes.ExamEditionObjectiveCutOffInvalid);
    }

    private void OnEssayMaxChanged(string? value)
    {
        _essayMax = value;
        _essayMaxError = ScoreError(value, CatalogErrorCodes.ExamEditionEssayMaxScoreInvalid);
        _essayCutOffError = EssayCutOffError();
    }

    private void OnEssayCutOffChanged(string? value)
    {
        _essayCutOff = value;
        _essayCutOffError = EssayCutOffError();
    }

    // F-168 UC3: the section below reports its rows after every load; the form names the incomplete ones.
    private void OnSubjectsChanged(IReadOnlyList<NoticeSubjectResponse> rows)
    {
        _subjects = rows;
        var result = ObjectiveMaxScores.Compute([.. rows.Select(row => (row.QuestionCount, row.PointsPerQuestion))]);
        _objectiveTotal = result.Total;
        _incompleteSubjects = [.. result.IncompleteRows.Select(index => rows[index].Label)];
    }

    // Comfort only, as the other fields: the Api runs the same checks (F-168, BR2, BR5 and BR6).
    private string? DurationError() =>
        ParsedDuration() is { } minutes
        && (minutes < CatalogLimits.ExamEditionDurationMinutesMin || minutes > CatalogLimits.ExamEditionDurationMinutesMax
            || _durationHours < 0 || _durationMinutes < 0)
            ? Errors.For(CatalogErrorCodes.ExamEditionDurationInvalid)
            : null;

    private string? ScoreError(string? text, string code) =>
        !ScoreText.TryParse(text, out var value) || (value is { } score && !IsScore(score)) ? Errors.For(code) : null;

    private string? EssayCutOffError()
    {
        if (ScoreError(_essayCutOff, CatalogErrorCodes.ExamEditionEssayCutOffInvalid) is { } invalid)
        {
            return invalid;
        }

        if (ParsedScore(_essayCutOff) is not { } cutOff)
        {
            return null;
        }

        return ParsedScore(_essayMax) switch
        {
            null => Errors.For(CatalogErrorCodes.ExamEditionEssayCutOffWithoutMax),
            { } max when cutOff > max => Errors.For(CatalogErrorCodes.ExamEditionEssayCutOffAboveMax),
            _ => null
        };
    }

    private static bool IsScore(decimal value) =>
        value >= CatalogLimits.ExamEditionScoreMin
        && value <= CatalogLimits.ExamEditionScoreMax
        && decimal.Round(value, CatalogLimits.ScoreDecimalPlaces) == value;

    // Content › Exams › the exam › the edition. The last crumb shows the saved values, not the ones being typed.
    private void BuildBreadcrumbs()
    {
        List<BreadcrumbItem> crumbs =
        [
            new BreadcrumbItem(L["Nav.Section.Content"], href: null, disabled: true),
            new BreadcrumbItem(L["Exams.Title"], href: "/admin/exams")
        ];

        if (_exam is not null)
        {
            crumbs.Add(new BreadcrumbItem(_exam.Name, href: ExamHref));
        }

        crumbs.Add(new BreadcrumbItem(
            _saved is null ? L["ExamEditions.Form.AddTitle"].Value : ExamEditionText.YearAndPosition(_saved),
            href: null,
            disabled: true));
        _breadcrumbs = crumbs;
    }

    private static string Trimmed(string? value) => value?.Trim() ?? string.Empty;

    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void OnOrganizerChanged(AppLookupOption? value)
    {
        _organizer = value;
        _organizerError = OrganizerError();
    }

    private void OnNoticeYearChanged(int? value)
    {
        _noticeYear = value;
        _noticeYearError = NoticeYearError();
        // The date's rule depends on the year: it is checked again when the year changes.
        _appliedOnError = AppliedOnError();
    }

    private void OnPositionChanged(string? value)
    {
        _position = value;
        _positionError = null;
    }

    private void OnNoticeReferenceChanged(string? value)
    {
        _noticeReference = value;
        _noticeReferenceError = null;
    }

    private void OnNoticeUrlChanged(string? value)
    {
        _noticeUrl = value;
        _noticeUrlError = NoticeUrlError();
    }

    private void OnAppliedOnChanged(DateOnly? value)
    {
        _appliedOn = value;
        _appliedOnError = AppliedOnError();
    }

    private void OnStatusChanged(ExamEditionStatus? value)
    {
        _status = value;
        _statusError = null;
    }

    // Comfort only: the Api is the authority and runs the same checks (rule: ui-project).
    private string? OrganizerError() =>
        _organizer is null ? Errors.For(CatalogErrorCodes.ExamEditionOrganizerRequired) : null;

    private string? NoticeYearError() =>
        NoticeYearValid ? null : Errors.For(CatalogErrorCodes.ExamEditionNoticeYearInvalid);

    private string? NoticeUrlError()
    {
        var url = Trimmed(_noticeUrl);
        if (url.Length == 0)
        {
            return null;
        }

        var valid = url.Length <= CatalogLimits.ExamEditionNoticeUrlMaxLength
            && Uri.TryCreate(url, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

        return valid ? null : Errors.For(CatalogErrorCodes.ExamEditionNoticeUrlInvalid);
    }

    private string? AppliedOnError() =>
        _appliedOn is { } day && AppliedOnMin is { } earliest && day < earliest
            ? Errors.For(CatalogErrorCodes.ExamEditionAppliedOnBeforeNoticeYear)
            : null;

    private async Task<IReadOnlyList<AppLookupOption>> SearchOrganizersAsync(string term, CancellationToken cancellationToken)
    {
        var token = await TokenAsync() ?? throw new InvalidOperationException("No session.");
        var result = await Api.ListOrganizersAsync(
            token,
            new OrganizerListQuery(0, AppLookupField.MaxCandidates, term),
            cancellationToken);

        if (!result.IsSuccess)
        {
            throw new InvalidOperationException($"Organizers failed to load: {result.ErrorCode}.");
        }

        return [.. result.Value!.Items.Select(organizer => new AppLookupOption(
            organizer.Id,
            $"{organizer.Name} ({organizer.Acronym})"))];
    }

    private async Task SaveAsync()
    {
        _organizerError = OrganizerError();
        _noticeYearError = NoticeYearError();
        _noticeUrlError = NoticeUrlError();
        _appliedOnError = AppliedOnError();
        _statusError = _status is null ? Errors.For(CatalogErrorCodes.ExamEditionStatusInvalid) : null;
        _durationError = DurationError();
        _objectiveCutOffError = ScoreError(_objectiveCutOff, CatalogErrorCodes.ExamEditionObjectiveCutOffInvalid);
        _essayMaxError = ScoreError(_essayMax, CatalogErrorCodes.ExamEditionEssayMaxScoreInvalid);
        _essayCutOffError = EssayCutOffError();

        if (ErrorSummaryItems.Count > 0)
        {
            // One panel at the top lists every offending field, and focus moves there.
            ShowErrorSummary();
            return;
        }

        _showErrorSummary = false;
        _saving = true;
        _error = null;
        _backHref = null;

        var token = await TokenAsync();
        var request = new SaveExamEditionRequest(
            _organizer!.Id,
            _noticeYear,
            NullIfBlank(_position),
            NullIfBlank(_noticeReference),
            NullIfBlank(_noticeUrl),
            _appliedOn,
            _status!.Value.ToString(),
            ParsedDuration(),
            ParsedScore(_objectiveCutOff),
            ParsedScore(_essayMax),
            ParsedScore(_essayCutOff));

        var result = token is null
            ? ApiResult.Failed<ExamEditionResponse>(ErrorText.UnexpectedCode)
            : IsEdit
                ? await Api.UpdateExamEditionAsync(token, ExamId, _saved!.Id, request)
                : await Api.CreateExamEditionAsync(token, ExamId, request);

        if (result is { IsSuccess: true, Value: { } edition })
        {
            var wasAdd = !IsEdit;
            Hydrate(edition);
            BuildBreadcrumbs();

            // F-89 BR5: the file goes after the fields, in the same Save, to the edition they just saved. A new edition
            // exists by now, so its file has somewhere to go (AC8).
            var documentSaved = await ApplyDocumentAsync(token!);
            _saving = false;
            if (!documentSaved)
            {
                // The fields are saved and the file is not: no "saved" message, and the page stays so the choice can be sent again.
                return;
            }

            Snackbar.Add(L["ExamEditions.Saved"], Severity.Success);
            if (wasAdd)
            {
                // The page becomes the edit form of what was just saved (AC4). The render comes first, so the
                // form no longer reports unsaved changes when the navigation asks.
                StateHasChanged();
                await Task.Yield();
                Navigation.NavigateTo($"/admin/exams/{ExamId}/editions/{edition.Id}", replace: true);
            }

            return;
        }

        _saving = false;
        ShowRefusal(result.ErrorCode);
    }

    // F-89: sends the chosen file, or deletes the stored one the reader marked for removal. False when the Api refused it.
    private async Task<bool> ApplyDocumentAsync(string token)
    {
        if (_chosen is { } chosen)
        {
            var uploaded = await Api.UploadNoticeDocumentAsync(token, ExamId, _saved!.Id, chosen.Name, chosen.Content);
            if (uploaded is { IsSuccess: true, Value: { } withFile })
            {
                Hydrate(withFile);
                _chosen = null;
                _documentError = null;
                return true;
            }

            ShowDocumentRefusal(uploaded.ErrorCode);
            return false;
        }

        if (_removeDocument)
        {
            var removed = await Api.DeleteNoticeDocumentAsync(token, ExamId, _saved!.Id);
            if (removed.IsSuccess)
            {
                _saved = _saved with { NoticeDocument = null };
                _removeDocument = false;
                _documentError = null;
                return true;
            }

            ShowDocumentRefusal(removed.ErrorCode);
            return false;
        }

        return true;
    }

    private void ShowDocumentRefusal(string? code)
    {
        _documentError = Errors.For(code);
        ShowErrorSummary();
    }

    // Comfort only: a file over 20 MB is refused before it is read. The Api checks the size and the content again (BR3, BR4).
    private async Task OnDocumentChosenAsync(IBrowserFile file)
    {
        _removeDocument = false;
        _chosen = null;
        if (file.Size > CatalogLimits.ExamEditionNoticeDocumentMaxBytes)
        {
            _documentError = Errors.For(CatalogErrorCodes.ExamEditionNoticeDocumentTooLarge);
            return;
        }

        try
        {
            // Read now, here: the browser's stream is slow, and the call to the Api is made from memory (trade-off 5).
            // shortcut(F-89): the chosen PDF (up to 20 MB) is held whole in the circuit's memory until Save or Discard — revisit when several curators upload at once or the limit passes 20 MB.
            await using var stream = file.OpenReadStream(CatalogLimits.ExamEditionNoticeDocumentMaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _chosen = new ChosenDocument(file.Name, buffer.ToArray());
            _documentError = null;
        }
        catch (IOException)
        {
            _documentError = Errors.For(ErrorText.UnexpectedCode);
        }
    }

    private void OnDocumentDiscarded()
    {
        _chosen = null;
        _documentError = null;
    }

    private void OnDocumentRemoved()
    {
        _chosen = null;
        _documentError = null;
        _removeDocument = true;
    }

    private void OnDocumentKept() => _removeDocument = false;

    /// <summary>The file the reader chose and has not saved yet, read into memory.</summary>
    private sealed record ChosenDocument(string Name, byte[] Content);

    // A refusal belongs to the field that caused it, so the reader sees where to change something.
    private void ShowRefusal(string? code)
    {
        var text = Errors.For(code);
        switch (code)
        {
            case CatalogErrorCodes.ExamEditionOrganizerRequired:
                _organizerError = text;
                break;
            case CatalogErrorCodes.ExamEditionNoticeYearInvalid:
                _noticeYearError = text;
                break;
            case CatalogErrorCodes.ExamEditionPositionTooLong:
                _positionError = text;
                break;
            case CatalogErrorCodes.ExamEditionNoticeReferenceTooLong:
                _noticeReferenceError = text;
                break;
            case CatalogErrorCodes.ExamEditionNoticeUrlInvalid:
                _noticeUrlError = text;
                break;
            case CatalogErrorCodes.ExamEditionAppliedOnBeforeNoticeYear:
                _appliedOnError = text;
                break;
            case CatalogErrorCodes.ExamEditionStatusInvalid:
                _statusError = text;
                break;
            case CatalogErrorCodes.ExamEditionDurationInvalid:
                _durationError = text;
                break;
            case CatalogErrorCodes.ExamEditionObjectiveCutOffInvalid:
                _objectiveCutOffError = text;
                break;
            case CatalogErrorCodes.ExamEditionEssayMaxScoreInvalid:
                _essayMaxError = text;
                break;
            case CatalogErrorCodes.ExamEditionEssayCutOffInvalid:
            case CatalogErrorCodes.ExamEditionEssayCutOffWithoutMax:
            case CatalogErrorCodes.ExamEditionEssayCutOffAboveMax:
                _essayCutOffError = text;
                break;
            case CatalogErrorCodes.ExamEditionNoticeDocumentNotPdf:
            case CatalogErrorCodes.ExamEditionNoticeDocumentTooLarge:
                _documentError = text;
                break;
            case CatalogErrorCodes.OrganizerNotFound:
                // The board left the catalog since it was picked: clear it and make the reader choose again.
                _organizer = null;
                _organizerError = Errors.For(CatalogErrorCodes.ExamEditionOrganizerRequired);
                _error = text;
                break;
            case CatalogErrorCodes.ExamNotFound:
                _error = text;
                _backHref = "/admin/exams";
                _backText = L["Exams.BackToList"];
                break;
            case CatalogErrorCodes.ExamEditionNotFound:
                _error = text;
                _backHref = ExamHref;
                _backText = L["ExamEditions.BackToExam"];
                break;
            default:
                // exam_edition.duplicate concerns three fields at once: the alert only. Anything else too.
                _error = text;
                break;
        }

        if (ErrorSummaryItems.Count > 0)
        {
            ShowErrorSummary();
        }
    }

    // The summary is drawn first and focused after that render: a focus call sent before the render batch would
    // reach the browser while the panel does not exist yet.
    private void ShowErrorSummary()
    {
        _showErrorSummary = true;
        _focusSummary = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusSummary)
        {
            return;
        }

        _focusSummary = false;
        await JS.InvokeVoidAsync("simulabShell.focusElement", ErrorSummaryId);
    }

    private void Cancel() => Navigation.NavigateTo(ExamHref);

    // B-3: through the accessor, which refreshes the token; never from the cookie.
    private async Task<string?> TokenAsync()
    {
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        return user is null ? null : await Tokens.GetAccessTokenAsync(user);
    }
}
