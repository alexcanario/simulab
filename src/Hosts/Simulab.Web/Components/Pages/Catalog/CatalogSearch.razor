@page "/catalog"
@attribute [Authorize(Policy = PermissionPolicy.Prefix + CatalogPermissions.Browse)]
@layout MainLayout
@using Simulab.Catalog.Contracts
@using Simulab.Identity.Contracts
@using Simulab.Web.Services
@inject CatalogApiClient Api
@inject Simulab.Web.Services.Auth.WebSessionTokenAccessor Tokens
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager Navigation

@* F-36, UC1 to UC3: the published exams, one row per exam, searched, filtered and paged on the server. The search,
   the four filters, the page and the page size live in the address (BR13), so a bookmark, a shared link, Back and
   the links back from the exam page all bring the same list. A student adds nothing here: no primary action. *@
<AppPageHeader Title="@L["Catalog.Title"]" Breadcrumbs="_breadcrumbs" />

@if (_optionsFailed)
{
    <AppAlert Severity="Severity.Warning"
              Text="@L["Catalog.Filter.OptionsFailed"]"
              ActionText="@L["Common.TryAgain"]"
              OnAction="LoadOptionsAsync"
              Class="mb-4" />
}

<AppDataTable @ref="_table"
              TItem="PublishedExamResponse"
              LoadAsync="LoadAsync"
              Searchable="true"
              SearchPlaceholder="@L["Catalog.Search.Placeholder"]"
              InitialSearch="@_state.Search"
              InitialPage="@_state.Page"
              InitialPageSize="@_state.PageSize"
              EmptyMessage="@EmptyMessage"
              EmptySearchMessage="@(term => L["Catalog.Empty.Search", term].Value)"
              EmptyActionText="@(HasFilters ? L["Catalog.Filter.Clear"].Value : null)"
              EmptyActionIcon="@AppIcons.ClearFilters"
              OnEmptyAction="ClearFiltersAsync">
    <ToolBarContent>
        <div class="app-table-filters">
            <AppSelectField TValue="AssessmentType?"
                            Id="catalog-filter-type"
                            Label="@L["Exams.Filter.AssessmentType"]"
                            Value="_assessmentType"
                            ValueChanged="OnAssessmentTypeChangedAsync"
                            Options="AssessmentTypeOptions" />

            <AppSelectField TValue="ExamScope?"
                            Id="catalog-filter-scope"
                            Label="@L["Exams.Filter.Scope"]"
                            Value="_scope"
                            ValueChanged="OnScopeChangedAsync"
                            Options="ScopeOptions" />

            <AppSelectField TValue="Guid?"
                            Id="catalog-filter-organizer"
                            Label="@L["Catalog.Filter.Organizer"]"
                            Value="_organizerId"
                            ValueChanged="OnOrganizerChangedAsync"
                            Options="OrganizerOptions"
                            Disabled="@(_optionsLoading || _optionsFailed)" />

            <AppSelectField TValue="int?"
                            Id="catalog-filter-year"
                            Label="@L["Catalog.Filter.NoticeYear"]"
                            Value="_noticeYear"
                            ValueChanged="OnNoticeYearChangedAsync"
                            Options="NoticeYearOptions"
                            Disabled="@(_optionsLoading || _optionsFailed)" />

            @if (HasFilters)
            {
                <MudButton Variant="Variant.Text"
                           StartIcon="@AppIcons.ClearFilters"
                           OnClick="ClearFiltersAsync"
                           Class="mt-6"
                           id="catalog-clear-filters">@L["Catalog.Filter.Clear"]</MudButton>
            }
        </div>
    </ToolBarContent>
    <Columns>
        @* The Api has one order, name A to Z (BR2): a sort arrow that does nothing would lie, so no column sorts. *@
        <TemplateColumn T="PublishedExamResponse" Title="@L["Exams.Column.Name"]" Sortable="false">
            <CellTemplate>
                <AppTruncatedText Text="@context.Item.Name"
                                  MaxWidth="26rem"
                                  Href="@ExamHref(context.Item)"
                                  Lang="@context.Item.ContentLanguage" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="PublishedExamResponse" Title="@L["Exams.Column.IssuingAuthority"]" Sortable="false">
            <CellTemplate>
                <AppTruncatedText Text="@context.Item.IssuingAuthorityName" MaxWidth="14rem" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="PublishedExamResponse" Title="@L["Exams.Column.AssessmentType"]" Sortable="false">
            <CellTemplate>@ExamText.AssessmentTypeName(L, context.Item.AssessmentType)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="PublishedExamResponse" Title="@L["Exams.Column.Scope"]" Sortable="false">
            <CellTemplate>
                @ExamText.ScopeName(L, context.Item.Scope)
                @if (!string.IsNullOrEmpty(context.Item.ScopeDetail))
                {
                    <span class="app-cell-secondary">@context.Item.ScopeDetail</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="PublishedExamResponse" Title="@L["Catalog.Column.ContentLanguage"]" Sortable="false">
            <CellTemplate>
                <span lang="@context.Item.ContentLanguage">@ExamText.ContentLanguageName(context.Item.ContentLanguage)</span>
            </CellTemplate>
        </TemplateColumn>
        <AppNumberColumn TItem="PublishedExamResponse" TProperty="int"
                         Property="row => row.PublishedEditionCount"
                         Title="@L["Catalog.Column.Editions"]"
                         Format="N0"
                         Sortable="false" />
        <AppNumberColumn TItem="PublishedExamResponse" TProperty="int"
                         Property="row => row.LatestNoticeYear"
                         Title="@L["Catalog.Column.LatestYear"]"
                         Format="0"
                         Sortable="false" />
    </Columns>
</AppDataTable>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private AppDataTable<PublishedExamResponse> _table = default!;
    private IReadOnlyList<BreadcrumbItem> _breadcrumbs = [];
    private CatalogSearchState _state = new();
    private string _queryString = string.Empty;
    private AssessmentType? _assessmentType;
    private ExamScope? _scope;
    private Guid? _organizerId;
    private int? _noticeYear;
    private IReadOnlyList<PublishedExamOrganizerResponse> _organizers = [];
    private IReadOnlyList<int> _noticeYears = [];
    private bool _optionsLoading = true;
    private bool _optionsFailed;

    private bool HasFilters => _assessmentType is not null || _scope is not null || _organizerId is not null || _noticeYear is not null;

    // The empty state says which emptiness it is: nothing published, or nothing matching the filters. With a search
    // text the table asks for EmptySearchMessage instead.
    private string EmptyMessage => HasFilters ? L["Catalog.Empty.Filters"] : L["Catalog.Empty"];

    private IReadOnlyList<AppSelectOption<AssessmentType?>> AssessmentTypeOptions =>
        [
            new(null, L["Common.Filter.All"]),
            .. ExamText.AssessmentTypeOrder(L).Select(value =>
                new AppSelectOption<AssessmentType?>(value, ExamText.AssessmentTypeName(L, value)))
        ];

    private IReadOnlyList<AppSelectOption<ExamScope?>> ScopeOptions =>
        [
            new(null, L["Common.Filter.All"]),
            .. ExamText.ScopeOrder(L).Select(value => new AppSelectOption<ExamScope?>(value, ExamText.ScopeName(L, value)))
        ];

    // The Api's order: boards by acronym. The screen never narrows one select by the other (BR5 is the Api's).
    private IReadOnlyList<AppSelectOption<Guid?>> OrganizerOptions =>
        [
            new(null, L["Common.Filter.All"]),
            .. _organizers.Select(organizer =>
                new AppSelectOption<Guid?>(organizer.Id, $"{organizer.Acronym} — {organizer.Name}"))
        ];

    // Plain digits: 2026, never 2.026 (the number is a year, not a quantity).
    private IReadOnlyList<AppSelectOption<int?>> NoticeYearOptions =>
        [
            new(null, L["Common.Filter.All"]),
            .. _noticeYears.Select(year => new AppSelectOption<int?>(year, year.ToString(CultureInfo.InvariantCulture)))
        ];

    protected override void OnInitialized()
    {
        _breadcrumbs =
        [
            new BreadcrumbItem(L["Nav.Section.Study"], href: null, disabled: true),
            new BreadcrumbItem(L["Catalog.Title"], href: null, disabled: true)
        ];

        // BR13 and BR6: what the address says, and nothing it says wrongly.
        _state = CatalogQueryString.Parse(Navigation.Uri);
        _assessmentType = _state.AssessmentType;
        _scope = _state.Scope;
        _organizerId = _state.OrganizerId;
        _noticeYear = _state.NoticeYear;
        _queryString = CatalogQueryString.Build(_state);
    }

    // The options are asked once, beside the table's first list call (which the table starts in its own first render).
    // Prerender never reaches here, so the Api is not asked twice.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadOptionsAsync();
        }
    }

    private string ExamHref(PublishedExamResponse exam) => $"/catalog/exams/{exam.Id}{_queryString}";

    private async Task LoadOptionsAsync()
    {
        _optionsLoading = true;
        _optionsFailed = false;
        StateHasChanged();

        var token = await TokenAsync();
        var result = token is null ? null : await Api.GetPublishedExamFiltersAsync(token);
        if (result is { IsSuccess: true, Value: { } filters })
        {
            _organizers = filters.Organizers;
            _noticeYears = filters.NoticeYears;
        }
        else
        {
            _organizers = [];
            _noticeYears = [];
            _optionsFailed = true;
        }

        _optionsLoading = false;
        StateHasChanged();

        if (!_optionsFailed)
        {
            await DropUnknownFiltersAsync();
        }
    }

    // BR6: a board or a year the loaded options do not know is dropped from the address and the list reloads without it.
    private async Task DropUnknownFiltersAsync()
    {
        var changed = false;
        if (_organizerId is { } organizerId && _organizers.All(organizer => organizer.Id != organizerId))
        {
            _organizerId = null;
            changed = true;
        }

        if (_noticeYear is { } year && !_noticeYears.Contains(year))
        {
            _noticeYear = null;
            changed = true;
        }

        if (changed)
        {
            await _table.ReloadFromFirstPageAsync();
        }
    }

    private async Task<AppTablePage<PublishedExamResponse>> LoadAsync(AppTableQuery query, CancellationToken cancellationToken)
    {
        var token = await TokenAsync() ?? throw new InvalidOperationException("No session.");
        var result = await Api.ListPublishedExamsAsync(
            token,
            new PublishedExamListQuery(query.Page, query.PageSize, query.Search, _assessmentType, _scope, _organizerId, _noticeYear),
            cancellationToken);

        if (!result.IsSuccess)
        {
            throw new InvalidOperationException($"Published exams failed to load: {result.ErrorCode}.");
        }

        // BR13: after every load the address is rewritten from what was asked, without a history entry.
        _state = new CatalogSearchState(query.Search, _assessmentType, _scope, _organizerId, _noticeYear, query.Page, query.PageSize);
        _queryString = CatalogQueryString.Build(_state);
        await InvokeAsync(WriteAddress);

        return new AppTablePage<PublishedExamResponse>(result.Value!.Items, result.Value.Total);
    }

    private void WriteAddress()
    {
        var target = "catalog" + _queryString;
        if (!string.Equals(Navigation.ToBaseRelativePath(Navigation.Uri), target, StringComparison.Ordinal))
        {
            Navigation.NavigateTo("/" + target, replace: true);
        }
    }

    private Task OnAssessmentTypeChangedAsync(AssessmentType? value)
    {
        _assessmentType = value;
        return _table.ReloadFromFirstPageAsync();
    }

    private Task OnScopeChangedAsync(ExamScope? value)
    {
        _scope = value;
        return _table.ReloadFromFirstPageAsync();
    }

    private Task OnOrganizerChangedAsync(Guid? value)
    {
        _organizerId = value;
        return _table.ReloadFromFirstPageAsync();
    }

    private Task OnNoticeYearChangedAsync(int? value)
    {
        _noticeYear = value;
        return _table.ReloadFromFirstPageAsync();
    }

    // It puts the four selects back to "All". The search text stays: the search box has its own clear button.
    private Task ClearFiltersAsync()
    {
        _assessmentType = null;
        _scope = null;
        _organizerId = null;
        _noticeYear = null;
        return _table.ReloadFromFirstPageAsync();
    }

    // B-3: through the accessor, which refreshes the token; never from the cookie.
    private async Task<string?> TokenAsync()
    {
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        return user is null ? null : await Tokens.GetAccessTokenAsync(user);
    }
}
