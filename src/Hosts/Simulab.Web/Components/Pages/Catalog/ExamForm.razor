@page "/admin/exams/new"
@page "/admin/exams/{Id:guid}"
@attribute [Authorize(Policy = PermissionPolicy.Prefix + CatalogPermissions.Manage)]
@layout MainLayout
@using Simulab.Catalog.Contracts
@using Simulab.Identity.Contracts
@using Simulab.Web.Localization
@using Simulab.Web.Services
@inject CatalogApiClient Api
@inject Simulab.Web.Services.Auth.WebSessionTokenAccessor Tokens
@inject IStringLocalizer<SharedResources> L
@inject ISnackbar Snackbar
@inject ErrorText Errors
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* F-34, UC2 and UC3: the exam is edited on a page of its own (rule: ui-project), which is also where
   F-35 adds the editions. The only primary button of the page is Save, at the bottom of the form.
   F-43, BR1: the form is recomposed onto the kit's page-composition patterns - sectioned cards, a
   two-column grid inside each, and a read-only summary aside beside the form (BR4). The scope stays an
   AppSelectField rather than AppRadioCards: converting it would break the `Set<ExamScope?>` helper this
   test file's pinned tests already rely on, and the build session was asked to stop rather than edit an
   existing test to fit. See the build report for the recommendation. *@
<AppPageHeader Title="@Title" Breadcrumbs="_breadcrumbs" />

@if (_loading)
{
    <AppLoadingState />
}
else if (_notFound)
{
    <MudPaper Class="app-form-card" Elevation="0">
        <AppAlert Severity="Severity.Error" Text="@Errors.For(CatalogErrorCodes.ExamNotFound)" Class="mb-4" />
        <AppLink Href="/admin/exams">@L["Exams.BackToList"]</AppLink>
    </MudPaper>
}
else
{
    <div class="app-form-layout">
        <MudPaper Class="app-form-card" Elevation="0">
            <AppErrorSummary Id="@ErrorSummaryId"
                             Title="@L["Common.ErrorSummary.Title"]"
                             Items="@(_showErrorSummary ? ErrorSummaryItems : Array.Empty<AppErrorSummaryItem>())" />

            @if (_error is not null)
            {
                <AppAlert Severity="Severity.Error" Text="@_error" Class="mb-4" />
            }

            <AppSectionCard Id="exam-section-identification"
                            Title="@L["Exams.Section.Identification"]"
                            Icon="@AppIcons.Exams"
                            Subtitle="@L["Exams.Section.Identification.Subtitle"]">
                <AppFormGrid Columns="2">
                    <AppLookupField Id="exam-authority"
                                    Label="@L["Exams.Field.IssuingAuthority"]"
                                    Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]"
                                    LeadingIcon="@AppIcons.IssuingAuthorities"
                                    SearchAsync="SearchAuthoritiesAsync"
                                    Value="_authority"
                                    ValueChanged="OnAuthorityChanged"
                                    Required="true"
                                    Hint="@L["Exams.Field.IssuingAuthority.Hint"]"
                                    Error="@_authorityError" />

                    <AppTextField TValue="string"
                                  Id="exam-name"
                                  Label="@L["Exams.Field.Name"]"
                                  Value="@_name"
                                  ValueChanged="@((string? value) => OnNameChanged(value))"
                                  Required="true"
                                  MaxLength="CatalogLimits.ExamNameMaxLength"
                                  Autocomplete="off"
                                  LeadingIcon="@AppIcons.Exams"
                                  Placeholder="@L["Exams.Field.Name.Placeholder"]"
                                  Hint="@L["Exams.Field.Name.Hint"]"
                                  Error="@_nameError" />
                </AppFormGrid>
            </AppSectionCard>

            <AppSectionCard Id="exam-section-classification"
                            Title="@L["Exams.Section.Classification"]"
                            Icon="@AppIcons.AssessmentType"
                            Subtitle="@L["Exams.Section.Classification.Subtitle"]">
                <AppFormGrid Columns="2">
                    <AppSelectField TValue="AssessmentType?"
                                    Id="exam-assessment-type"
                                    Label="@L["Exams.Field.AssessmentType"]"
                                    Value="_assessmentType"
                                    ValueChanged="@((AssessmentType? value) => OnAssessmentTypeChanged(value))"
                                    Options="AssessmentTypeOptions"
                                    Required="true"
                                    LeadingIcon="@AppIcons.AssessmentType"
                                    Error="@_assessmentTypeError" />

                    <AppSelectField TValue="string"
                                    Id="exam-content-language"
                                    Label="@L["Exams.Field.ContentLanguage"]"
                                    Value="_contentLanguage"
                                    ValueChanged="@((string? value) => OnContentLanguageChanged(value))"
                                    Options="LanguageOptions"
                                    Required="true"
                                    LeadingIcon="@AppIcons.Language"
                                    Hint="@L["Exams.Field.ContentLanguage.Hint"]"
                                    Error="@_contentLanguageError" />
                </AppFormGrid>
            </AppSectionCard>

            <AppSectionCard Id="exam-section-scope"
                            Title="@L["Exams.Section.Scope"]"
                            Icon="@AppIcons.Scope"
                            Subtitle="@L["Exams.Section.Scope.Subtitle"]">
                @* BR1 and UC2: the choice that changes the rest of the form is cards with a line each, not a
                   bare select — the reader decides before opening anything. *@
                <AppRadioCards TValue="ExamScope?"
                               Id="exam-scope"
                               Label="@L["Exams.Field.Scope"]"
                               Value="_scope"
                               ValueChanged="@((ExamScope? value) => OnScopeChanged(value))"
                               Options="ScopeCards"
                               Required="true"
                               Error="@_scopeError" />

                @* BR1: the detail only exists for the two scopes that need it, and clears itself when it
                   goes away, so a national exam never carries a stale place into the request. *@
                <AppConditionalField Visible="NeedsScopeDetail" OnHidden="ClearScopeDetail">
                    <AppTextField TValue="string"
                                  Id="exam-scope-detail"
                                  Label="@ScopeDetailLabel"
                                  Value="@_scopeDetail"
                                  ValueChanged="@((string? value) => OnScopeDetailChanged(value))"
                                  Required="true"
                                  MaxLength="CatalogLimits.ExamScopeDetailMaxLength"
                                  Autocomplete="off"
                                  LeadingIcon="@AppIcons.Place"
                                  Placeholder="@ScopeDetailPlaceholder"
                                  Hint="@L["Exams.Field.ScopeDetail.Hint"]"
                                  Error="@_scopeDetailError" />
                </AppConditionalField>
            </AppSectionCard>

            <AppFormActions Saving="_saving" HasChanges="HasChanges" OnSave="SaveAsync" OnCancel="Cancel" />
        </MudPaper>

        <AppFormAside Title="@L["Exams.Form.Aside.Title"]"
                      EmptyText="@L["Common.Summary.NotFilled"]"
                      Rows="AsideRows"
                      ChecklistTitle="@L["Exams.Form.Aside.Checklist"]"
                      DoneText="@L["Common.Checklist.Done"]"
                      PendingText="@L["Common.Checklist.Pending"]"
                      Checklist="AsideChecklist" />
    </div>

    @* F-35, Screen 1: the editions of the exam, in a card of their own below the whole layout and outside the
       exam form - the exam's Save never saves an edition, and the aside keeps summarising only the exam. In
       add mode the section only says to save the exam first (AC3). *@
    <MudPaper Class="app-form-card mt-4" Elevation="0">
        <ExamEditionsSection ExamId="@_saved?.Id" ExamName="@_saved?.Name" />
    </MudPaper>
}

@code {
    /// <summary>
    /// What the form offers before the reader chooses (BR9). It is the screen's default, not the Api's: the
    /// Api asks for the language explicitly, and `SupportedLanguages.Default` is the app's fallback UI
    /// language (en), which is the wrong guess for a catalog whose first market is Brazil.
    /// </summary>
    public const string DefaultContentLanguage = "pt-BR";

    private const string ErrorSummaryId = "exam-error-summary";

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>The exam being edited; absent on /admin/exams/new.</summary>
    [Parameter] public Guid? Id { get; set; }

    private IReadOnlyList<BreadcrumbItem> _breadcrumbs = [];
    private ExamResponse? _saved;
    private AppLookupOption? _authority;
    private string? _name;
    private AssessmentType? _assessmentType;
    private ExamScope? _scope;
    private string? _scopeDetail;
    private string? _contentLanguage = DefaultContentLanguage;
    private string? _authorityError;
    private string? _nameError;
    private string? _assessmentTypeError;
    private string? _scopeError;
    private string? _scopeDetailError;
    private string? _contentLanguageError;
    private string? _error;
    private bool _loading;
    private bool _notFound;
    private bool _saving;

    // F-43, UC3/AC5: the summary at the top of the card only shows after a save was attempted and refused
    // client-side; a business refusal (S7) stays on its own field and in the alert instead.
    private bool _showErrorSummary;

    private bool IsEdit => _saved is not null;

    private string Title => IsEdit ? L["Exams.Form.EditTitle"] : L["Exams.Form.AddTitle"];

    private bool NeedsScopeDetail => _scope is ExamScope.State or ExamScope.Municipal;

    private string ScopeDetailLabel =>
        _scope == ExamScope.Municipal ? L["Exams.Field.Municipality"] : L["Exams.Field.State"];

    private string ScopeDetailPlaceholder =>
        _scope == ExamScope.Municipal ? L["Exams.Field.Municipality.Placeholder"] : L["Exams.Field.State.Placeholder"];

    // F-43: the empty option is the placeholder itself, the way the mockup's native select shows it - not a
    // decoration the kit's AppSelectField would need a new parameter for.
    private IReadOnlyList<AppSelectOption<AssessmentType?>> AssessmentTypeOptions =>
    [
        new AppSelectOption<AssessmentType?>(null, L["Exams.Field.AssessmentType.Placeholder"]),
        .. ExamText.AssessmentTypeOrder(L).Select(value =>
            new AppSelectOption<AssessmentType?>(value, ExamText.AssessmentTypeName(L, value)))
    ];

    // The order is the reader's (B-15), and each card carries the one line that says what choosing it means.
    // Only State and Municipal get an icon: "the whole country" has no place to point at.
    private IReadOnlyList<AppRadioCardOption<ExamScope?>> ScopeCards =>
        [.. ExamText.ScopeOrder(L).Select(value => new AppRadioCardOption<ExamScope?>(
            value,
            ExamText.ScopeName(L, value),
            L[$"Exams.Scope.{value}.Description"],
            value == ExamScope.National ? null : AppIcons.Place))];

    // A language is shown in its own name (BR9): it does not depend on the reader's UI language, so it
    // needs no resource key. Lang marks it as written in that language, for a screen reader.
    private static IReadOnlyList<AppSelectOption<string>> LanguageOptions =>
        [.. SupportedCultures.All.Select(culture =>
            new AppSelectOption<string>(culture.Name, SupportedCultures.NativeName(culture), culture.Name))];

    private string? AssessmentTypeSummary =>
        _assessmentType is null ? null : ExamText.AssessmentTypeName(L, _assessmentType.Value);

    private string? ContentLanguageSummary =>
        LanguageOptions.FirstOrDefault(option => option.Value == _contentLanguage)?.Text;

    private string? ScopeSummary =>
        _scope is null
            ? null
            : NeedsScopeDetail && !string.IsNullOrWhiteSpace(_scopeDetail)
                ? $"{ExamText.ScopeName(L, _scope.Value)} · {Trimmed(_scopeDetail)}"
                : ExamText.ScopeName(L, _scope.Value);

    // F-43, UC5/AC7: what the read-only aside shows beside the form, without a button of its own (BR4).
    private IReadOnlyList<AppAsideRow> AsideRows =>
    [
        new(L["Exams.Field.IssuingAuthority"], _authority?.Text),
        new(L["Exams.Field.Name"], string.IsNullOrWhiteSpace(_name) ? null : Trimmed(_name)),
        new(L["Exams.Field.AssessmentType"], AssessmentTypeSummary),
        new(L["Exams.Field.Scope"], ScopeSummary),
        new(L["Exams.Field.ContentLanguage"], ContentLanguageSummary)
    ];

    private IReadOnlyList<AppChecklistItem> AsideChecklist
    {
        get
        {
            List<AppChecklistItem> items =
            [
                new(L["Exams.Field.IssuingAuthority"], _authority is not null),
                new(L["Exams.Field.Name"], Trimmed(_name).Length >= CatalogLimits.NameMinLength),
                new(L["Exams.Field.AssessmentType"], _assessmentType is not null),
                new(L["Exams.Field.Scope"], _scope is not null)
            ];

            if (NeedsScopeDetail)
            {
                items.Add(new AppChecklistItem(ScopeDetailLabel, Trimmed(_scopeDetail).Length > 0));
            }

            items.Add(new AppChecklistItem(L["Exams.Field.ContentLanguage"], _contentLanguage is not null));

            return items;
        }
    }

    // F-43, UC3/AC5: one line per field the reader has not fixed yet, in the order the form shows them.
    private IReadOnlyList<AppErrorSummaryItem> ErrorSummaryItems =>
    [
        .. new (string? Error, string FieldId, string Label)[]
        {
            (_authorityError, "exam-authority", L["Exams.Field.IssuingAuthority"]),
            (_nameError, "exam-name", L["Exams.Field.Name"]),
            (_assessmentTypeError, "exam-assessment-type", L["Exams.Field.AssessmentType"]),
            (_scopeError, "exam-scope", L["Exams.Field.Scope"]),
            (_scopeDetailError, "exam-scope-detail", ScopeDetailLabel),
            (_contentLanguageError, "exam-content-language", L["Exams.Field.ContentLanguage"])
        }.Where(item => item.Error is not null)
         .Select(item => new AppErrorSummaryItem(item.FieldId, item.Label))
    ];

    private bool HasChanges =>
        _authority?.Id != _saved?.IssuingAuthorityId
        || Trimmed(_name) != (_saved?.Name ?? string.Empty)
        || _assessmentType != _saved?.AssessmentType
        || _scope != _saved?.Scope
        || Trimmed(_scopeDetail) != (_saved?.ScopeDetail ?? string.Empty)
        || _contentLanguage != (_saved?.ContentLanguage ?? DefaultContentLanguage);

    protected override async Task OnParametersSetAsync()
    {
        BuildBreadcrumbs();
        if (Id is not { } id || _saved?.Id == id)
        {
            return;
        }

        _loading = true;
        var token = await TokenAsync();
        var result = token is null ? null : await Api.FindExamAsync(token, id);
        _loading = false;

        if (result is not { IsSuccess: true, Value: { } exam })
        {
            _notFound = true;
            return;
        }

        _saved = exam;
        _authority = new AppLookupOption(exam.IssuingAuthorityId, exam.IssuingAuthorityName);
        _name = exam.Name;
        _assessmentType = exam.AssessmentType;
        _scope = exam.Scope;
        _scopeDetail = exam.ScopeDetail ?? string.Empty;
        _contentLanguage = exam.ContentLanguage;
        BuildBreadcrumbs();
    }

    private void BuildBreadcrumbs() =>
        _breadcrumbs =
        [
            new BreadcrumbItem(L["Nav.Section.Content"], href: null, disabled: true),
            new BreadcrumbItem(L["Exams.Title"], href: "/admin/exams"),
            new BreadcrumbItem(_saved?.Name ?? L["Exams.Form.AddTitle"].Value, href: null, disabled: true)
        ];

    private static string Trimmed(string? value) => value?.Trim() ?? string.Empty;

    private void OnAuthorityChanged(AppLookupOption? value)
    {
        _authority = value;
        _authorityError = AuthorityError();
    }

    private void OnNameChanged(string? value)
    {
        _name = value;
        _nameError = NameError();
    }

    private void OnAssessmentTypeChanged(AssessmentType? value)
    {
        _assessmentType = value;
        _assessmentTypeError = null;
    }

    private void OnScopeChanged(ExamScope? value)
    {
        _scope = value;
        _scopeError = null;
    }

    // F-43, BR1: called once by AppConditionalField when the detail goes away, so a value the reader can no
    // longer see is never sent (the behaviour F-34 already had, now driven by the kit component).
    private Task ClearScopeDetail()
    {
        _scopeDetail = string.Empty;
        _scopeDetailError = null;
        return Task.CompletedTask;
    }

    private void OnScopeDetailChanged(string? value)
    {
        _scopeDetail = value;
        _scopeDetailError = ScopeDetailError();
    }

    private void OnContentLanguageChanged(string? value)
    {
        _contentLanguage = value;
        _contentLanguageError = null;
    }

    // Comfort only: the Api is the authority and runs the same checks (rule: ui-project).
    private string? AuthorityError() =>
        _authority is null ? Errors.For(CatalogErrorCodes.ExamIssuingAuthorityRequired) : null;

    private string? NameError() =>
        Trimmed(_name).Length < CatalogLimits.NameMinLength ? Errors.For(CatalogErrorCodes.ExamNameRequired) : null;

    private string? ScopeDetailError() =>
        NeedsScopeDetail && Trimmed(_scopeDetail).Length == 0
            ? Errors.For(CatalogErrorCodes.ExamScopeDetailRequired)
            : null;

    private async Task<IReadOnlyList<AppLookupOption>> SearchAuthoritiesAsync(string term, CancellationToken cancellationToken)
    {
        var token = await TokenAsync() ?? throw new InvalidOperationException("No session.");
        var result = await Api.ListIssuingAuthoritiesAsync(
            token,
            new IssuingAuthorityListQuery(0, AppLookupField.MaxCandidates, term),
            cancellationToken);

        if (!result.IsSuccess)
        {
            throw new InvalidOperationException($"Issuing authorities failed to load: {result.ErrorCode}.");
        }

        // v2: only bodies that publish notices are offered. A board is never a parent of an exam (BR2).
        return [.. result.Value!.Items.Select(authority => new AppLookupOption(
            authority.Id,
            authority.Name))];
    }

    private async Task SaveAsync()
    {
        _authorityError = AuthorityError();
        _nameError = NameError();
        _assessmentTypeError = _assessmentType is null ? Errors.For(CatalogErrorCodes.ExamAssessmentTypeInvalid) : null;
        _scopeError = _scope is null ? Errors.For(CatalogErrorCodes.ExamScopeInvalid) : null;
        _scopeDetailError = ScopeDetailError();
        _contentLanguageError = _contentLanguage is null ? Errors.For(CatalogErrorCodes.ExamContentLanguageInvalid) : null;

        if (_authorityError is not null || _nameError is not null || _assessmentTypeError is not null
            || _scopeError is not null || _scopeDetailError is not null || _contentLanguageError is not null)
        {
            // UC3, AC5, S6: one panel at the top lists every offending field, and focus moves there so the
            // reader does not have to hunt for what is wrong.
            _showErrorSummary = true;
            await JS.InvokeVoidAsync("simulabShell.focusElement", ErrorSummaryId);
            return;
        }

        _showErrorSummary = false;
        _saving = true;
        _error = null;

        var token = await TokenAsync();
        var request = new SaveExamRequest(
            _authority!.Id,
            Trimmed(_name),
            _assessmentType!.Value.ToString(),
            _scope!.Value.ToString(),
            NeedsScopeDetail ? Trimmed(_scopeDetail) : null,
            _contentLanguage);

        var result = token is null
            ? ApiResult.Failed<ExamResponse>(ErrorText.UnexpectedCode)
            : IsEdit
                ? await Api.UpdateExamAsync(token, _saved!.Id, request)
                : await Api.CreateExamAsync(token, request);

        _saving = false;
        if (result is { IsSuccess: true, Value: { } exam })
        {
            // The page stays open as the edit form of the exam that was just saved: adding its first
            // edition is the usual next step, and in F-35 that section is on this very page.
            var wasAdd = !IsEdit;
            _saved = exam;
            _scopeDetail = exam.ScopeDetail ?? string.Empty;
            BuildBreadcrumbs();
            Snackbar.Add(L["Exams.Saved"], Severity.Success);
            if (wasAdd)
            {
                Navigation.NavigateTo($"/admin/exams/{exam.Id}", replace: true);
            }

            return;
        }

        // A refusal belongs to the field that caused it, so the reader sees where to change something.
        switch (result.ErrorCode)
        {
            case CatalogErrorCodes.ExamNameTaken:
            case CatalogErrorCodes.ExamNameRequired:
            case CatalogErrorCodes.ExamNameTooLong:
                _nameError = Errors.For(result.ErrorCode);
                _error = Errors.For(result.ErrorCode);
                break;
            case CatalogErrorCodes.ExamScopeDetailRequired:
            case CatalogErrorCodes.ExamScopeDetailTooLong:
                _scopeDetailError = Errors.For(result.ErrorCode);
                break;
            case CatalogErrorCodes.IssuingAuthorityNotFound:
            case CatalogErrorCodes.ExamIssuingAuthorityRequired:
                // The body left the catalog since it was picked: clear it and make the reader choose again.
                _authority = null;
                _authorityError = Errors.For(CatalogErrorCodes.ExamIssuingAuthorityRequired);
                _error = Errors.For(result.ErrorCode);
                break;
            default:
                _error = Errors.For(result.ErrorCode);
                break;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/admin/exams");

    // B-3: through the accessor, which refreshes the token; never from the cookie.
    private async Task<string?> TokenAsync()
    {
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        return user is null ? null : await Tokens.GetAccessTokenAsync(user);
    }
}
