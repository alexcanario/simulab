                <AppLanguageField Id="gallery-language-filled" Label="@L["Gallery.Choices.Label.Language"]" Required="true"
                                  Value="@_languageFilled" ValueChanged="@(value => _languageFilled = value)" />
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Error"]</p>
                <AppLanguageField Id="gallery-language-error" Label="@L["Gallery.Choices.Label.Language"]"
                                  Error="@L["Gallery.TextKinds.SampleError"].Value" />
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Disabled"]</p>
                <AppLanguageField Id="gallery-language-disabled" Label="@L["Gallery.Choices.Label.Language"]" Value="pt-BR" Disabled="true" />
            </div>
            <div>
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gallery-kind-title">@L["Gallery.Choices.Level"]</MudText>
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Empty"]</p>
                <AppLevelField Id="gallery-level-empty" Label="@L["Gallery.Choices.Label.Difficulty"]" Names="@LevelNames"
                               Value="@_levelEmpty" ValueChanged="@(value => _levelEmpty = value)" />
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Filled"]</p>
                <AppLevelField Id="gallery-level-filled" Label="@L["Gallery.Choices.Label.Difficulty"]" Names="@LevelNames" Required="true"
                               Value="@_levelFilled" ValueChanged="@(value => _levelFilled = value)" />
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Error"]</p>
                <AppLevelField Id="gallery-level-error" Label="@L["Gallery.Choices.Label.Difficulty"]" Names="@LevelNames" Value="2"
                               Error="@L["Gallery.TextKinds.SampleError"].Value" />
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Disabled"]</p>
                <AppLevelField Id="gallery-level-disabled" Label="@L["Gallery.Choices.Label.Difficulty"]" Names="@LevelNames" Value="4" Disabled="true" />
                <p class="gallery-state-caption">@L["Gallery.Choices.State.ReadOnly"]</p>
                <AppLevelField Id="gallery-level-read-only" Label="@L["Gallery.Choices.Label.Difficulty"]" Names="@LevelNames" Value="3" ReadOnly="true" />

                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gallery-kind-title mt-4">@L["Gallery.Choices.LevelFilter"]</MudText>
                <AppLevelFilterField Id="gallery-level-filter" Label="@L["Gallery.Choices.Label.Difficulty"]" Names="@LevelNames"
                                     NotSetText="@L["Choice.NotSet"].Value" Selected="@_levelFilter" NotSetSelected="@_levelFilterNone"
                                     OnToggle="@ToggleLevelFilter" />

                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gallery-kind-title mt-4">@L["Gallery.Choices.Text"]</MudText>
                <p><AppLevelBadge Value="3" Names="@LevelNames" /></p>
                <p><AppLevelBadge Value="@((int?)null)" Names="@LevelNames" /></p>
