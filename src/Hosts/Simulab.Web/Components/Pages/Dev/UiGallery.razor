                               TrueText="@L["Questions.TrueFalse.True"].Value" FalseText="@L["Questions.TrueFalse.False"].Value"
                               Value="@_yesNoFilled" ValueChanged="@(value => _yesNoFilled = value)" />
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Error"]</p>
                <AppYesNoField Id="gallery-yes-no-error" Label="@L["Gallery.Choices.Label.Key"]"
                               Error="@L["Gallery.TextKinds.SampleError"].Value" />
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Disabled"]</p>
                <AppYesNoField Id="gallery-yes-no-disabled" Label="@L["Gallery.Choices.Label.Key"]" Value="true" Disabled="true" />

                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gallery-kind-title mt-4">@L["Gallery.Choices.Language"]</MudText>
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Empty"]</p>
                <AppLanguageField Id="gallery-language-empty" Label="@L["Gallery.Choices.Label.Language"]"
                                  Value="@_languageEmpty" ValueChanged="@(value => _languageEmpty = value)" />
