@page "/dev/ui"
@implements IDisposable
@using Simulab.Catalog.Contracts
@using Simulab.QuestionBank.Contracts
@inject IStringLocalizer<SharedResources> L
@inject IStringLocalizer<IdentityResources> I
@inject IHostEnvironment Environment
@inject NavigationManager Navigation
@inject IConfirmService Confirm
@inject ISnackbar Snackbar
@inject ErrorText ErrorText
@inject ThemeState ThemeState

@if (!_allowed)
{
    return;
}

@* F-36: TitleLang is for a title that is content (an exam's name); here the title is the app's own, in the reader's language. *@
<AppPageHeader Title="@L["Gallery.Title"]"
               TitleLang="@CultureInfo.CurrentUICulture.Name"
               Breadcrumbs="_breadcrumbs"
               PrimaryActionText="@L["Common.Add"]"
               PrimaryActionIcon="@AppIcons.Add"
               OnPrimaryAction="@(() => Done(L["Common.Add"]))" />

<MudText Typo="Typo.body1" Class="mb-6">@L["Gallery.Intro"]</MudText>

<section id="gallery-table" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Table"]</MudText>
    <MudRadioGroup T="GallerySourceMode" Value="_source.Mode" ValueChanged="ChangeModeAsync" aria-label="@L["Gallery.Table.Mode"]" Class="mb-2">
        <MudRadio Value="GallerySourceMode.Normal" Color="Color.Primary">@L["Gallery.Table.Mode.Normal"]</MudRadio>
        <MudRadio Value="GallerySourceMode.Empty" Color="Color.Primary">@L["Gallery.Table.Mode.Empty"]</MudRadio>
        <MudRadio Value="GallerySourceMode.Failing" Color="Color.Primary">@L["Gallery.Table.Mode.Failing"]</MudRadio>
    </MudRadioGroup>
    <AppDataTable @ref="_table"
                  TItem="GallerySample"
                  LoadAsync="_source.LoadAsync"
                  EmptyMessage="@L["Gallery.States.EmptyMessage"]"
                  EmptyActionText="@L["Common.Add"]"
                  OnEmptyAction="@(() => Done(L["Common.Add"]))">
        @* F-34: the filters a list offers beside its search box. They lay out as one row and keep the
           card's width; the wrapper is what gives them that, so it belongs in the gallery. *@
        <ToolBarContent>
            <div class="app-table-filters">
                <AppLookupField Id="gallery-filter-lookup" Label="@L["Exams.Filter.IssuingAuthority"]"
                                Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]"
                                SearchAsync="GalleryLookupAsync" Value="@_filterLookup"
                                ValueChanged="@(value => _filterLookup = value)" />
                <AppSelectField TValue="string" Id="gallery-filter-one" Label="@L["Exams.Filter.AssessmentType"]"
                                Options="@_filterOptions" Value="@_filterValue"
                                ValueChanged="@(value => _filterValue = value)" />
                <AppSelectField TValue="string" Id="gallery-filter-two" Label="@L["Exams.Filter.Scope"]"
                                Options="@_filterOptions" Value="@_filterValue"
                                ValueChanged="@(value => _filterValue = value)" />
            </div>
        </ToolBarContent>
        <Columns>
            <PropertyColumn T="GallerySample" TProperty="string" Property="x => x.Name" Title="@L["Gallery.Table.Name"]" Sortable="false" />
            <TemplateColumn T="GallerySample" Title="@L["Gallery.Table.Description"]" Sortable="false">
                <CellTemplate><AppTruncatedText Text="@context.Item.Description" MaxWidth="18rem" /></CellTemplate>
            </TemplateColumn>
            <AppNumberColumn TItem="GallerySample" TProperty="int" Property="x => x.Questions" Title="@L["Gallery.Table.Questions"]" />
            <AppNumberColumn TItem="GallerySample" TProperty="decimal" Property="x => x.Score" Format="N1" Title="@L["Gallery.Table.Score"]" />
            <AppDateColumn TItem="GallerySample" TProperty="DateTimeOffset" Property="x => x.UpdatedAt" Title="@L["Gallery.Table.UpdatedAt"]" />
        </Columns>
        <RowActions>
            <AppRowActions ItemName="@context.Name"
                           OnEdit="@(() => Done(L["Common.Edit"]))"
                           OnDelete="@(() => DeleteAsync(context))" />
        </RowActions>
    </AppDataTable>
</section>

<section id="gallery-row-actions" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.RowActions"]</MudText>
    <AppRowActions ItemName="@SampleName(1)"
                   OnEdit="@(() => Done(L["Common.Edit"]))"
                   OnDelete="@(() => DeleteAsync(_sample))"
                   MoreActions="_moreActions" />
    <AppRowActions ItemName="@SampleName(2)"
                   OnEdit="@(() => Done(L["Common.Edit"]))"
                   OnDelete="@(() => DeleteAsync(_sample))"
                   DeleteDisabledReason="@L["Gallery.RowActions.DeleteDisabledReason"]" />
    @* F-74: the move pair of a sortable list, before Edit and Delete. The first row cannot go up; the pair stays
       visible and the tooltip says why. *@
    <AppRowActions ItemName="@SampleName(3)"
                   IdPrefix="gallery-row-move"
                   OnMoveUp="@(() => Done(L["Common.MoveUp"]))"
                   MoveUpDisabledReason="@L["NoticeSubjects.MoveUp.DisabledFirst"]"
                   OnMoveDown="@(() => Done(L["Common.MoveDown"]))"
                   OnEdit="@(() => Done(L["Common.Edit"]))"
                   OnDelete="@(() => DeleteAsync(_sample))" />
</section>

<section id="gallery-states" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.States"]</MudText>
    <MudGrid>
        <MudItem xs="12" md="4"><MudPaper Outlined="true"><AppLoadingState /></MudPaper></MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Outlined="true">
                <AppEmptyState Message="@L["Gallery.States.EmptyMessage"]" ActionText="@L["Common.Add"]" OnAction="@(() => Done(L["Common.Add"]))" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4"><MudPaper Outlined="true"><AppErrorState OnRetry="@(() => Done(L["Common.TryAgain"]))" /></MudPaper></MudItem>
    </MudGrid>
    @* F-134, BR6: the state of a whole page - the error and not-found pages are this component with other texts and actions. *@
    <p class="gallery-state-caption">@L["Gallery.States.PageState"]</p>
    <MudPaper Outlined="true">
        <AppPageState Icon="@AppIcons.Error" IconColor="Color.Error" TitleLevel="2"
                      Title="@L["Gallery.States.PageStateTitle"]" Message="@L["Gallery.States.PageStateMessage"]">
            <Actions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@AppIcons.Retry" OnClick="@(() => Done(L["Common.TryAgain"]))">@L["Common.TryAgain"]</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@AppIcons.Home" Href="/">@L["Common.GoHome"]</MudButton>
            </Actions>
        </AppPageState>
    </MudPaper>
</section>

<section id="gallery-confirm" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Confirm"]</MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@AppIcons.Delete" OnClick="ConfirmSampleAsync">@L["Gallery.Confirm.Open"]</MudButton>
</section>

<section id="gallery-form" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Form"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.Form.Hint"]</MudText>
    <MudPaper Outlined="true" Class="pa-4 gallery-form">
        <MudTextField T="string" Label="@L["Gallery.Table.Name"]" Required="true" Variant="Variant.Outlined"
                      Value="_formName" ValueChanged="OnFormNameChanged" Immediate="true" />
        <AppFormActions Saving="_saving" HasChanges="_hasChanges" OnSave="SaveAsync" OnCancel="CancelForm" />
    </MudPaper>
    <AppLink Href="/" Class="mt-2 d-inline-block">@L["Gallery.Form.Leave"]</AppLink>
</section>

<section id="gallery-fields" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Fields"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.Fields.Hint"]</MudText>
    <MudPaper Outlined="true" Class="pa-4 gallery-form">
        <AppTextField TValue="string" Id="gallery-field-ok" Label="@I["SignUp.Email.Label"]"
                      Placeholder="@I["SignUp.Email.Placeholder"]" Hint="@I["SignUp.Password.Hint"]" Required="true"
                      Value="@_fieldValue" ValueChanged="@(value => _fieldValue = value)" />

        <AppTextField TValue="string" Id="gallery-field-error" Label="@I["SignUp.Email.Label"]" Required="true"
                      Error="@I["SignUp.Email.Required"].Value" Value="@("")" />

        <AppSelectField TValue="string" Id="gallery-select" Label="@L["Layout.LanguageSwitch.Label"]" Required="true"
                        Options="@_selectOptions" Value="@_selectValue" ValueChanged="@(value => _selectValue = value)" />

        <AppPasswordField Id="gallery-password" Autocomplete="PasswordAutocomplete.NewPassword" Label="@I["SignUp.Password.Label"]"
                          ShowLabel="@I["SignUp.Password.Show"]" HideLabel="@I["SignUp.Password.Hide"]"
                          Required="true" Value="@_passwordValue" ValueChanged="@(value => _passwordValue = value)" />
        <AppPasswordStrength Password="@_passwordValue" TextFor="@GalleryStrengthText" />

        <AppCheckbox Id="gallery-checkbox" Required="true" Value="@_checked"
                     ValueChanged="@(value => _checked = value)">@I["SignUp.Adult.Label"]</AppCheckbox>
        <AppCheckbox Id="gallery-checkbox-error" Required="true" Value="false"
                     Error="@L["registration.consent_required"].Value">@I["SignUp.Terms.Label"].Value</AppCheckbox>

        @if (_filterChipShown)
        {
            <AppFilterChip Text="@L["RoleHistory.Filter.User", "ana@exemplo.com"]" OnRemove="@(() => _filterChipShown = false)" />
        }
    </MudPaper>
</section>

@* F-114 BR1, BR8: the look says the action. One column per kind, each with the states it has; the fields are live, so
   "Open list" and "No results" are reached by focusing and typing the sample term beside the caption. *@
<section id="gallery-field-kinds" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.FieldKinds"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.FieldKinds.Hint"]</MudText>
    <MudPaper Outlined="true" Class="pa-4">
        <AppFormGrid Columns="3">
            <div>
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gallery-kind-title">@L["Gallery.FieldKinds.Select"]</MudText>

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Empty"]</p>
                <AppSelectField TValue="string" Id="gallery-kind-select-empty" Label="@L["Subjects.Field.Area"]"
                                Hint="@L["Subjects.Field.Area.Help"]" Options="@KindAreaOptions"
                                Value="@_kindSelectEmpty" ValueChanged="@(value => _kindSelectEmpty = value)" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.WithValue"]</p>
                <AppSelectField TValue="string" Id="gallery-kind-select-value" Label="@L["Subjects.Field.Area"]"
                                Hint="@L["Subjects.Field.Area.Help"]" Options="@KindAreaOptions"
                                Value="@_kindSelectValue" ValueChanged="@(value => _kindSelectValue = value)" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Disabled"]</p>
                <AppSelectField TValue="string" Id="gallery-kind-select-disabled" Label="@L["Subjects.Field.Area"]"
                                Hint="@L["Subjects.Field.Area.Help"]" Options="@KindAreaOptions"
                                Value="@KindAreaLaw" Disabled="true" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Error"]</p>
                <AppSelectField TValue="string" Id="gallery-kind-select-error" Label="@L["Subjects.Field.Area"]"
                                Hint="@L["Subjects.Field.Area.Help"]" Options="@KindAreaOptions"
                                Error="@L["subject.area_invalid"].Value" Value="@string.Empty" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.LongText"]</p>
                <AppSelectField TValue="string" Id="gallery-kind-select-long" Label="@L["Subjects.Field.Area"]"
                                Options="@KindAreaOptions" Error="@L["Exams.Field.IssuingAuthority.Hint"].Value"
                                Value="@KindAreaLong" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Loading"]</p>
                <AppSelectField TValue="string" Id="gallery-kind-select-loading" Label="@L["Subjects.Field.Area"]"
                                Hint="@L["Subjects.Field.Area.Help"]" Options="@KindAreaOptions"
                                Loading="true" Value="@string.Empty" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Open"] <code>Tab</code></p>
                <AppSelectField TValue="string" Id="gallery-kind-select-open" Label="@L["Subjects.Field.Area"]"
                                Hint="@L["Subjects.Field.Area.Help"]" Options="@KindAreaOptions"
                                Value="@_kindSelectOpen" ValueChanged="@(value => _kindSelectOpen = value)" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.NoResults"] <code>zzz</code></p>
                <AppSelectField TValue="string" Id="gallery-kind-select-noresults" Label="@L["Subjects.Field.Area"]"
                                Hint="@L["Subjects.Field.Area.Help"]" Options="@KindAreaOptions"
                                Value="@_kindSelectNoResults" ValueChanged="@(value => _kindSelectNoResults = value)" />

                @* BR5: the leading icon and the arrow together. *@
                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.LeadingIcon"]</p>
                <AppSelectField TValue="string" Id="gallery-kind-select-icon" Label="@L["Exams.Field.ContentLanguage"]"
                                LeadingIcon="@AppIcons.Language" Required="true" Options="@_selectOptions"
                                Value="@_selectValue" ValueChanged="@(value => _selectValue = value)" />
            </div>

            <div>
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gallery-kind-title">@L["Gallery.FieldKinds.Lookup"]</MudText>

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Empty"]</p>
                <AppLookupField Id="gallery-kind-lookup-empty" Label="@L["Exams.Field.IssuingAuthority"]"
                                Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]" Required="true"
                                SearchAsync="GalleryLookupAsync" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.WithValue"]</p>
                <AppLookupField Id="gallery-kind-lookup-value" Label="@L["Exams.Field.IssuingAuthority"]"
                                Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]" Required="true"
                                Hint="@L["Exams.Field.IssuingAuthority.Hint"]"
                                SearchAsync="GalleryLookupAsync" Value="@_kindLookupValue"
                                ValueChanged="@(value => _kindLookupValue = value)" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Disabled"]</p>
                <AppLookupField Id="gallery-kind-lookup-disabled" Label="@L["Exams.Field.IssuingAuthority"]"
                                Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]" Required="true"
                                SearchAsync="GalleryLookupAsync" Value="@GalleryLookupOptions[1]" Disabled="true" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Error"]</p>
                <AppLookupField Id="gallery-kind-lookup-error" Label="@L["Exams.Field.IssuingAuthority"]"
                                Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]" Required="true"
                                Error="@L["exam.issuing_authority_required"].Value" SearchAsync="GalleryLookupAsync" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.LongText"]</p>
                <AppLookupField Id="gallery-kind-lookup-long" Label="@L["Exams.Field.IssuingAuthority"]"
                                Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]" Required="true"
                                Error="@L["Exams.Field.IssuingAuthority.Hint"].Value"
                                SearchAsync="GalleryLookupAsync" Value="@GalleryLookupOptions[0]" />

                @* The server search takes a moment: the sample answers after 1.5 s so the wait can be seen. *@
                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Loading"] <code>fun</code></p>
                <AppLookupField Id="gallery-kind-lookup-loading" Label="@L["Exams.Field.IssuingAuthority"]"
                                Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]" Required="true"
                                SearchAsync="GallerySlowLookupAsync" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Open"] <code>fun</code></p>
                <AppLookupField Id="gallery-kind-lookup-open" Label="@L["Exams.Field.IssuingAuthority"]"
                                Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]" Required="true"
                                SearchAsync="GalleryLookupAsync" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.NoResults"] <code>zzz</code></p>
                <AppLookupField Id="gallery-kind-lookup-noresults" Label="@L["Exams.Field.IssuingAuthority"]"
                                Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]" Required="true"
                                SearchAsync="GalleryLookupAsync" />

                @* The parameter is ignored: the magnifier stays (AC7). *@
                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.LeadingIcon"]</p>
                <AppLookupField Id="gallery-kind-lookup-icon" Label="@L["Exams.Field.IssuingAuthority"]"
                                Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]"
                                LeadingIcon="@AppIcons.IssuingAuthorities" SearchAsync="GalleryLookupAsync" />
            </div>

            <div>
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gallery-kind-title">@L["Gallery.FieldKinds.Text"]</MudText>

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Empty"]</p>
                <AppTextField TValue="string" Id="gallery-kind-text-empty" Label="@L["Exams.Field.Name"]"
                              Placeholder="@L["Exams.Field.Name.Placeholder"]" Hint="@L["Exams.Field.Name.Hint"]"
                              Required="true" Autocomplete="off" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.WithValue"]</p>
                <AppTextField TValue="string" Id="gallery-kind-text-value" Label="@L["Exams.Field.Name"]"
                              Placeholder="@L["Exams.Field.Name.Placeholder"]" Hint="@L["Exams.Field.Name.Hint"]"
                              Required="true" Autocomplete="off"
                              Value="@_kindTextValue" ValueChanged="@(value => _kindTextValue = value)" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Disabled"]</p>
                <AppTextField TValue="string" Id="gallery-kind-text-disabled" Label="@L["Exams.Field.Name"]"
                              Hint="@L["Exams.Field.Name.Hint"]" Required="true" Autocomplete="off"
                              Value="@SampleName(1)" Disabled="true" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Error"]</p>
                <AppTextField TValue="string" Id="gallery-kind-text-error" Label="@L["Exams.Field.Name"]"
                              Placeholder="@L["Exams.Field.Name.Placeholder"]" Required="true" Autocomplete="off"
                              Error="@L["exam.name_required"].Value" Value="@string.Empty" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.LongText"]</p>
                <AppTextField TValue="string" Id="gallery-kind-text-long" Label="@L["Exams.Field.Name"]"
                              Required="true" Autocomplete="off" Error="@L["Exams.Field.IssuingAuthority.Hint"].Value"
                              Value="@KindTextLong" />

                @* F-105 AC18: the counter, empty, while typing, at the limit and over it (with the error beside it). *@
                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Counter"]</p>
                <AppTextField TValue="string" Id="gallery-kind-text-counter-empty" Label="@L["Questions.StatusReason.Label"]"
                              Hint="@L["Questions.StatusReason.Hint"]" Lines="3" MaxLength="QuestionLimits.ChangeReasonMaxLength" Counter="true"
                              Autocomplete="off" Value="@string.Empty" />
                <AppTextField TValue="string" Id="gallery-kind-text-counter-typing" Label="@L["Questions.StatusReason.Label"]"
                              Hint="@L["Questions.StatusReason.Hint"]" Lines="3" MaxLength="QuestionLimits.ChangeReasonMaxLength" Counter="true"
                              Autocomplete="off" Value="@KindTextCounter(137)" />
                <AppTextField TValue="string" Id="gallery-kind-text-counter-limit" Label="@L["Questions.StatusReason.Label"]"
                              Hint="@L["Questions.StatusReason.Hint"]" Lines="3" MaxLength="QuestionLimits.ChangeReasonMaxLength" Counter="true"
                              Autocomplete="off" Value="@KindTextCounter(500)" />
                <AppTextField TValue="string" Id="gallery-kind-text-counter-over" Label="@L["Questions.StatusReason.Label"]"
                              Lines="3" MaxLength="QuestionLimits.ChangeReasonMaxLength" Counter="true" Autocomplete="off"
                              Error="@L["question.review_reason_too_long"].Value" Value="@KindTextCounter(512)" />

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Loading"]</p>
                <p class="gallery-state-na">@L["Gallery.FieldKinds.State.NotApplicable"]</p>

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.Open"]</p>
                <p class="gallery-state-na">@L["Gallery.FieldKinds.State.NotApplicable"]</p>

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.NoResults"]</p>
                <p class="gallery-state-na">@L["Gallery.FieldKinds.State.NotApplicable"]</p>

                <p class="gallery-state-caption">@L["Gallery.FieldKinds.State.LeadingIcon"]</p>
                <AppTextField TValue="string" Id="gallery-kind-text-icon" Label="@L["Exams.Field.Name"]"
                              LeadingIcon="@AppIcons.Exams" Placeholder="@L["Exams.Field.Name.Placeholder"]"
                              Required="true" Autocomplete="off" />
            </div>
        </AppFormGrid>
    </MudPaper>
</section>

@* F-183 AC11: one control per kind of text, each in the states of the shared contract. *@
<section id="gallery-text-kinds" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.TextKinds"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.TextKinds.Hint"]</MudText>
    <MudPaper Outlined="true" Class="pa-4">
        <AppFormGrid Columns="3">
            <div>
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gallery-kind-title">@L["Gallery.TextKinds.TextArea"]</MudText>
                <p class="gallery-state-caption">@L["Gallery.TextKinds.State.Empty"]</p>
                <AppTextAreaField Id="gallery-text-area-empty" Label="@L["Gallery.TextKinds.Label.Description"]" MaxLength="CatalogLimits.OrganizerDescriptionMaxLength"
                                  Value="@_textAreaEmpty" ValueChanged="@(value => _textAreaEmpty = value)" />
                <p class="gallery-state-caption">@L["Gallery.TextKinds.State.Filled"]</p>
                <AppTextAreaField Id="gallery-text-area-filled" Label="@L["Gallery.TextKinds.Label.Description"]" MaxLength="CatalogLimits.OrganizerDescriptionMaxLength"
                                  Value="@_textAreaFilled" ValueChanged="@(value => _textAreaFilled = value)" />
                <p class="gallery-state-caption">@L["Gallery.TextKinds.State.Error"]</p>
                <AppTextAreaField Id="gallery-text-area-error" Label="@L["Gallery.TextKinds.Label.Description"]" MaxLength="CatalogLimits.OrganizerDescriptionMaxLength"
                                  Value="@TextKindSample" Error="@L["Gallery.TextKinds.SampleError"]" />
                <p class="gallery-state-caption">@L["Gallery.TextKinds.State.Disabled"]</p>
                <AppTextAreaField Id="gallery-text-area-disabled" Label="@L["Gallery.TextKinds.Label.Description"]" MaxLength="CatalogLimits.OrganizerDescriptionMaxLength"
                                  Value="@TextKindSample" Disabled="true" />
                <p class="gallery-state-caption">@L["Gallery.TextKinds.State.ReadOnly"]</p>
                <AppTextAreaField Id="gallery-text-area-read-only" Label="@L["Gallery.TextKinds.Label.Description"]" MaxLength="CatalogLimits.OrganizerDescriptionMaxLength"
                                  Value="@TextKindSample" ReadOnly="true" />
                <p class="gallery-state-caption">@L["Gallery.TextKinds.State.LongValue"]</p>
                <AppTextAreaField Id="gallery-text-area-long" Label="@L["Gallery.TextKinds.Label.Description"]" MaxLength="CatalogLimits.OrganizerDescriptionMaxLength"
                                  Value="@TextKindLongSample" />
            </div>
            <div>
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gallery-kind-title">@L["Gallery.TextKinds.Email"]</MudText>
                <p class="gallery-state-caption">@L["Gallery.TextKinds.State.Empty"]</p>
                <AppEmailField Id="gallery-email-empty" Label="@L["Gallery.TextKinds.Label.Email"]" Autocomplete="off"
                               Value="@_emailEmpty" ValueChanged="@(value => _emailEmpty = value)" />
                <p class="gallery-state-caption">@L["Gallery.TextKinds.State.Filled"]</p>
                <AppEmailField Id="gallery-email-filled" Label="@L["Gallery.TextKinds.Label.Email"]" Autocomplete="off"
                               Value="@_emailFilled" ValueChanged="@(value => _emailFilled = value)" />
                <p class="gallery-state-caption">@L["Gallery.TextKinds.State.Error"]</p>
                <AppEmailField Id="gallery-email-error" Label="@L["Gallery.TextKinds.Label.Email"]" Autocomplete="off"
                               Value="@("ana@")" Error="@L["Gallery.TextKinds.SampleError"]" />
                <p class="gallery-state-caption">@L["Gallery.TextKinds.State.Disabled"]</p>
                <AppEmailField Id="gallery-email-disabled" Label="@L["Gallery.TextKinds.Label.Email"]" Autocomplete="off"
                               Value="ana@exemplo.com" Disabled="true" />
                <p class="gallery-state-caption">@L["Gallery.TextKinds.State.ReadOnly"]</p>
                <AppEmailField Id="gallery-email-read-only" Label="@L["Gallery.TextKinds.Label.Email"]" Autocomplete="off"
                               Value="ana@exemplo.com" ReadOnly="true" />
