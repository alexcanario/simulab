                                   Options="@SegmentOptions" Value="@_segmentEmpty" ValueChanged="@(value => _segmentEmpty = value)" />
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Filled"]</p>
                <AppSegmentedField TValue="string" Id="gallery-segmented-filled" Label="@L["Gallery.Choices.Label.Period"]"
                                   Options="@SegmentOptions" Required="true" Value="@_segmentFilled" ValueChanged="@(value => _segmentFilled = value)" />
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Error"]</p>
                <AppSegmentedField TValue="string" Id="gallery-segmented-error" Label="@L["Gallery.Choices.Label.Period"]"
                                   Options="@SegmentOptions" Error="@L["Gallery.TextKinds.SampleError"].Value" />
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Disabled"]</p>
                <AppSegmentedField TValue="string" Id="gallery-segmented-disabled" Label="@L["Gallery.Choices.Label.Period"]"
                                   Options="@SegmentOptions" Value="@("week")" Disabled="true" />
            </div>
            <div>
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gallery-kind-title">@L["Gallery.Choices.YesNo"]</MudText>
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Empty"]</p>
