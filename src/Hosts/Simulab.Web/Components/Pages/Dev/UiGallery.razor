@* The section id never repeats a field id below it: two nodes with one id break every label and
   aria-describedby that points at it (found on screen, F-34). *@
<section id="gallery-lookups" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Lookup"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Exams.Field.IssuingAuthority.Hint"]</MudText>
    <MudPaper Outlined="true" Class="pa-4 gallery-form">
        @* F-34 BR16: idle, below the minimum, searching, results, no result, chosen and failed, all here. *@
        <AppLookupField Id="gallery-lookup" Label="@L["Exams.Field.IssuingAuthority"]"
                        Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]" Required="true"
                        SearchAsync="GalleryLookupAsync" Value="@_lookupValue"
                        ValueChanged="@(value => _lookupValue = value)" />

        <AppLookupField Id="gallery-lookup-error" Label="@L["Exams.Field.IssuingAuthority"]"
                        Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]" Required="true"
                        Error="@L["exam.issuing_authority_required"].Value"
                        SearchAsync="GalleryLookupAsync" />

        @* The search itself fails: the description says so and offers another go, and nothing is picked. *@
        <AppLookupField Id="gallery-lookup-failing" Label="@L["Exams.Field.IssuingAuthority"]"
                        Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]"
                        SearchAsync="GalleryFailingLookupAsync" />

        @* F-42: a short fixed list - no minimum of characters, the whole list opens on focus and none is cut off
           at 20. Focus it, type to narrow it, pick one, then focus it again: it still offers the state it holds. *@
        <AppLookupField Id="gallery-lookup-fixed-list" Label="@L["Exams.Field.State"]"
                        Placeholder="@L["Exams.Field.State.Placeholder"]" Hint="@L["Exams.Field.State.Hint"]"
                        LeadingIcon="@AppIcons.Place" Required="true"
                        MinChars="0" MaxItems="@Simulab.Catalog.Contracts.BrazilianStates.All.Count" OpenOnFocus="true"
                        SearchAsync="GalleryStatesAsync" Value="@_stateValue"
                        ValueChanged="@(value => _stateValue = value)" />
    </MudPaper>
</section>

@* F-74: free text that suggests what was typed before; a pick is never required. *@
<section id="gallery-suggest-field" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.SuggestField"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.SuggestField.Hint"]</MudText>
    <MudPaper Outlined="true" Class="pa-4 gallery-form">
        <AppSuggestField Id="gallery-suggest" Label="@L["NoticeSubjects.Field.Group"]"
                         Placeholder="@L["NoticeSubjects.Field.Group.Placeholder"]"
                         Hint="@L["NoticeSubjects.Field.Group.Hint"]"
                         Suggestions="@_suggestions"
                         SuggestionsLabel="@L["NoticeSubjects.Field.Group.Suggestions"]"
                         MaxLength="CatalogLimits.NoticeSubjectGroupMaxLength"
                         Value="@_suggestValue"
                         ValueChanged="@(value => _suggestValue = value)" />

        <AppSuggestField Id="gallery-suggest-error" Label="@L["NoticeSubjects.Field.Group"]"
                         Error="@L["notice_subject.group_too_long"].Value"
                         Suggestions="@_suggestions"
                         SuggestionsLabel="@L["NoticeSubjects.Field.Group.Suggestions"]"
                         Value="@("")" />
    </MudPaper>
</section>

@* F-89: the file field. Choosing changes the form and sends nothing; Save sends it. *@
<section id="gallery-file-field" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.FileField"]</MudText>
