    private IReadOnlyList<(string Role, string Colour)> PaletteRoles
    {
        get
        {
            Palette palette = ThemeState.IsDarkMode ? Identity.PaletteDark : Identity.PaletteLight;
            return
            [
                ("primary", palette.Primary.ToString()), ("info", palette.Info.ToString()),
                ("link", ThemeState.IsDarkMode ? SimulabTheme.DarkLink : SimulabTheme.LightLink), ("secondary", palette.Secondary.ToString()),
                ("tertiary", palette.Tertiary.ToString()), ("success", palette.Success.ToString()), ("warning", palette.Warning.ToString()),
                ("error", palette.Error.ToString()), ("background", palette.Background.ToString()), ("surface", palette.Surface.ToString()),
                ("background-gray", palette.BackgroundGray.ToString()), ("text-primary", palette.TextPrimary.ToString()),
                ("text-secondary", palette.TextSecondary.ToString()), ("lines-inputs", palette.LinesInputs.ToString()),
                ("divider", palette.Divider.ToString()), ("primary-lighten", palette.PrimaryLighten),
                ("appbar-background", palette.AppbarBackground.ToString()), ("drawer-background", palette.DrawerBackground.ToString()),
            ];
        }
    }

