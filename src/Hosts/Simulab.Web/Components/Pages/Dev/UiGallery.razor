@page "/dev/ui"
@inject IStringLocalizer<SharedResources> L
@inject IStringLocalizer<IdentityResources> I
@inject IHostEnvironment Environment
@inject NavigationManager Navigation
@inject IConfirmService Confirm
@inject ISnackbar Snackbar
@inject ErrorText ErrorText

@if (!_allowed)
{
    return;
}

<AppPageHeader Title="@L["Gallery.Title"]"
               Breadcrumbs="_breadcrumbs"
               PrimaryActionText="@L["Common.Add"]"
               PrimaryActionIcon="@AppIcons.Add"
               OnPrimaryAction="@(() => Done(L["Common.Add"]))" />

<MudText Typo="Typo.body1" Class="mb-6">@L["Gallery.Intro"]</MudText>

<section id="gallery-table" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Table"]</MudText>
    <MudRadioGroup T="GallerySourceMode" Value="_source.Mode" ValueChanged="ChangeModeAsync" aria-label="@L["Gallery.Table.Mode"]" Class="mb-2">
        <MudRadio Value="GallerySourceMode.Normal" Color="Color.Primary">@L["Gallery.Table.Mode.Normal"]</MudRadio>
        <MudRadio Value="GallerySourceMode.Empty" Color="Color.Primary">@L["Gallery.Table.Mode.Empty"]</MudRadio>
        <MudRadio Value="GallerySourceMode.Failing" Color="Color.Primary">@L["Gallery.Table.Mode.Failing"]</MudRadio>
    </MudRadioGroup>
    <AppDataTable @ref="_table"
                  TItem="GallerySample"
                  LoadAsync="_source.LoadAsync"
                  EmptyMessage="@L["Gallery.States.EmptyMessage"]"
                  EmptyActionText="@L["Common.Add"]"
                  OnEmptyAction="@(() => Done(L["Common.Add"]))">
        @* F-34: the filters a list offers beside its search box. They lay out as one row and keep the
           card's width; the wrapper is what gives them that, so it belongs in the gallery. *@
        <ToolBarContent>
            <div class="app-table-filters">
                <AppLookupField Id="gallery-filter-lookup" Label="@L["Exams.Filter.IssuingAuthority"]"
                                Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]"
                                SearchAsync="GalleryLookupAsync" Value="@_filterLookup"
                                ValueChanged="@(value => _filterLookup = value)" />
                <AppSelectField TValue="string" Id="gallery-filter-one" Label="@L["Exams.Filter.AssessmentType"]"
                                Options="@_filterOptions" Value="@_filterValue"
                                ValueChanged="@(value => _filterValue = value)" />
                <AppSelectField TValue="string" Id="gallery-filter-two" Label="@L["Exams.Filter.Scope"]"
                                Options="@_filterOptions" Value="@_filterValue"
                                ValueChanged="@(value => _filterValue = value)" />
            </div>
        </ToolBarContent>
        <Columns>
            <PropertyColumn T="GallerySample" TProperty="string" Property="x => x.Name" Title="@L["Gallery.Table.Name"]" Sortable="false" />
            <TemplateColumn T="GallerySample" Title="@L["Gallery.Table.Description"]" Sortable="false">
                <CellTemplate><AppTruncatedText Text="@context.Item.Description" MaxWidth="18rem" /></CellTemplate>
            </TemplateColumn>
            <AppNumberColumn TItem="GallerySample" TProperty="int" Property="x => x.Questions" Title="@L["Gallery.Table.Questions"]" />
            <AppNumberColumn TItem="GallerySample" TProperty="decimal" Property="x => x.Score" Format="N1" Title="@L["Gallery.Table.Score"]" />
            <AppDateColumn TItem="GallerySample" TProperty="DateTimeOffset" Property="x => x.UpdatedAt" Title="@L["Gallery.Table.UpdatedAt"]" />
        </Columns>
        <RowActions>
            <AppRowActions ItemName="@context.Name"
                           OnEdit="@(() => Done(L["Common.Edit"]))"
                           OnDelete="@(() => DeleteAsync(context))" />
        </RowActions>
    </AppDataTable>
</section>

<section id="gallery-row-actions" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.RowActions"]</MudText>
    <AppRowActions ItemName="@SampleName(1)"
                   OnEdit="@(() => Done(L["Common.Edit"]))"
                   OnDelete="@(() => DeleteAsync(_sample))"
                   MoreActions="_moreActions" />
    <AppRowActions ItemName="@SampleName(2)"
                   OnEdit="@(() => Done(L["Common.Edit"]))"
                   OnDelete="@(() => DeleteAsync(_sample))"
                   DeleteDisabledReason="@L["Gallery.RowActions.DeleteDisabledReason"]" />
</section>

<section id="gallery-states" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.States"]</MudText>
    <MudGrid>
        <MudItem xs="12" md="4"><MudPaper Outlined="true"><AppLoadingState /></MudPaper></MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Outlined="true">
                <AppEmptyState Message="@L["Gallery.States.EmptyMessage"]" ActionText="@L["Common.Add"]" OnAction="@(() => Done(L["Common.Add"]))" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4"><MudPaper Outlined="true"><AppErrorState OnRetry="@(() => Done(L["Common.TryAgain"]))" /></MudPaper></MudItem>
    </MudGrid>
</section>

<section id="gallery-confirm" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Confirm"]</MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@AppIcons.Delete" OnClick="ConfirmSampleAsync">@L["Gallery.Confirm.Open"]</MudButton>
</section>

<section id="gallery-form" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Form"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.Form.Hint"]</MudText>
    <MudPaper Outlined="true" Class="pa-4 gallery-form">
        <MudTextField T="string" Label="@L["Gallery.Table.Name"]" Required="true" Variant="Variant.Outlined"
                      Value="_formName" ValueChanged="OnFormNameChanged" Immediate="true" />
        <AppFormActions Saving="_saving" HasChanges="_hasChanges" OnSave="SaveAsync" OnCancel="CancelForm" />
    </MudPaper>
    <AppLink Href="/" Class="mt-2 d-inline-block">@L["Gallery.Form.Leave"]</AppLink>
</section>

<section id="gallery-fields" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Fields"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.Fields.Hint"]</MudText>
    <MudPaper Outlined="true" Class="pa-4 gallery-form">
        <AppTextField TValue="string" Id="gallery-field-ok" Label="@I["SignUp.Email.Label"]"
                      Placeholder="@I["SignUp.Email.Placeholder"]" Hint="@I["SignUp.Password.Hint"]" Required="true"
                      Value="@_fieldValue" ValueChanged="@(value => _fieldValue = value)" />

        <AppTextField TValue="string" Id="gallery-field-error" Label="@I["SignUp.Email.Label"]" Required="true"
                      Error="@I["SignUp.Email.Required"].Value" Value="@("")" />

        <AppSelectField TValue="string" Id="gallery-select" Label="@L["Layout.LanguageSwitch.Label"]" Required="true"
                        Options="@_selectOptions" Value="@_selectValue" ValueChanged="@(value => _selectValue = value)" />

        <AppPasswordField Id="gallery-password" Autocomplete="PasswordAutocomplete.NewPassword" Label="@I["SignUp.Password.Label"]"
                          ShowLabel="@I["SignUp.Password.Show"]" HideLabel="@I["SignUp.Password.Hide"]"
                          Required="true" Value="@_passwordValue" ValueChanged="@(value => _passwordValue = value)" />
        <AppPasswordStrength Password="@_passwordValue" TextFor="@GalleryStrengthText" />

        <AppCheckbox Id="gallery-checkbox" Required="true" Value="@_checked"
                     ValueChanged="@(value => _checked = value)">@I["SignUp.Adult.Label"]</AppCheckbox>
        <AppCheckbox Id="gallery-checkbox-error" Required="true" Value="false"
                     Error="@L["registration.consent_required"].Value">@I["SignUp.Terms.Label"].Value</AppCheckbox>

        @if (_filterChipShown)
        {
            <AppFilterChip Text="@L["RoleHistory.Filter.User", "ana@exemplo.com"]" OnRemove="@(() => _filterChipShown = false)" />
        }
    </MudPaper>
</section>

@* The section id never repeats a field id below it: two nodes with one id break every label and
   aria-describedby that points at it (found on screen, F-34). *@
<section id="gallery-lookups" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Lookup"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Exams.Field.IssuingAuthority.Hint"]</MudText>
    <MudPaper Outlined="true" Class="pa-4 gallery-form">
        @* F-34 BR16: idle, below the minimum, searching, results, no result, chosen and failed, all here. *@
        <AppLookupField Id="gallery-lookup" Label="@L["Exams.Field.IssuingAuthority"]"
                        Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]" Required="true"
                        SearchAsync="GalleryLookupAsync" Value="@_lookupValue"
                        ValueChanged="@(value => _lookupValue = value)" />

        <AppLookupField Id="gallery-lookup-error" Label="@L["Exams.Field.IssuingAuthority"]"
                        Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]" Required="true"
                        Error="@L["exam.issuing_authority_required"].Value"
                        SearchAsync="GalleryLookupAsync" />

        @* The search itself fails: the description says so and offers another go, and nothing is picked. *@
        <AppLookupField Id="gallery-lookup-failing" Label="@L["Exams.Field.IssuingAuthority"]"
                        Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]"
                        SearchAsync="GalleryFailingLookupAsync" />
    </MudPaper>
</section>

@* ---- Composition patterns (F-43, BR1). A screen mockup may use only what is shown here (rule: ui). ---- *@

<section id="gallery-section-card" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.SectionCard"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.SectionCard.Hint"]</MudText>
    <div class="gallery-form">
        <AppSectionCard Id="gallery-card-plain" Title="@L["Gallery.SectionCard.Title"]" Icon="@AppIcons.Exams">
            <MudText Typo="Typo.body2">@L["Gallery.SectionCard.Body"]</MudText>
        </AppSectionCard>
        <AppSectionCard Id="gallery-card-subtitled" Title="@L["Gallery.SectionCard.Title"]"
                        Icon="@AppIcons.IssuingAuthorities" Subtitle="@L["Gallery.SectionCard.Subtitle"]">
            <MudText Typo="Typo.body2">@L["Gallery.SectionCard.Body"]</MudText>
        </AppSectionCard>
    </div>
</section>

<section id="gallery-form-grid" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.FormGrid"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.FormGrid.Hint"]</MudText>
    <AppSectionCard Id="gallery-grid-card" Title="@L["Gallery.FormGrid.Title"]" Icon="@AppIcons.Exams">
        <AppFormGrid Columns="2">
            <AppTextField TValue="string" Id="gallery-grid-one" Label="@L["Gallery.FormGrid.First"]" Autocomplete="off" />
            <AppTextField TValue="string" Id="gallery-grid-two" Label="@L["Gallery.FormGrid.Second"]" Autocomplete="off" />
        </AppFormGrid>
        <AppFormGrid Columns="3" Class="mt-4">
            <AppTextField TValue="string" Id="gallery-grid-three" Label="@L["Gallery.FormGrid.First"]" Autocomplete="off" />
            <AppTextField TValue="string" Id="gallery-grid-four" Label="@L["Gallery.FormGrid.Second"]" Autocomplete="off" />
            <AppTextField TValue="string" Id="gallery-grid-five" Label="@L["Gallery.FormGrid.Third"]" Autocomplete="off" />
        </AppFormGrid>
    </AppSectionCard>
</section>

<section id="gallery-radio-cards" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.RadioCards"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.RadioCards.Hint"]</MudText>
    <div class="gallery-form">
        <AppRadioCards TValue="string" Id="gallery-scope" Label="@L["Exams.Field.Scope"]" Required="true"
                       Options="@ScopeCards" Value="@_scope" ValueChanged="@OnScopeChanged" />
        <AppRadioCards TValue="string" Id="gallery-scope-error" Label="@L["Exams.Field.Scope"]" Required="true"
                       Options="@ScopeCards" Error="@L["exam.scope_invalid"].Value" />
    </div>
</section>

<section id="gallery-conditional-field" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.ConditionalField"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.ConditionalField.Hint"]</MudText>
    <div class="gallery-form">
        @* Driven by the radio cards above: choosing State or Municipal reveals the detail, National clears it. *@
        <AppConditionalField Visible="@(_scope is "State" or "Municipal")" OnHidden="@(() => _scopeDetail = null)">
            <AppTextField TValue="string" Id="gallery-scope-detail"
                          Label="@(_scope == "Municipal" ? L["Exams.Field.Municipality"] : L["Exams.Field.State"])"
                          Hint="@L["Exams.Field.ScopeDetail.Hint"]" LeadingIcon="@AppIcons.Place"
                          Value="@_scopeDetail" ValueChanged="@(value => _scopeDetail = value)"
                          Required="true" Autocomplete="off" />
        </AppConditionalField>
        @if (_scope is not ("State" or "Municipal"))
        {
            <MudText Typo="Typo.body2">@L["Gallery.ConditionalField.Hidden"]</MudText>
        }
    </div>
</section>

<section id="gallery-leading-icons" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.LeadingIcons"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.LeadingIcons.Hint"]</MudText>
    <div class="gallery-form">
        <AppTextField TValue="string" Id="gallery-leading-text" Label="@L["Exams.Field.Name"]"
                      LeadingIcon="@AppIcons.Exams" Hint="@L["Exams.Field.Name.Hint"]" Autocomplete="off" />
        <AppSelectField TValue="string" Id="gallery-leading-select" Label="@L["Exams.Field.ContentLanguage"]"
                        LeadingIcon="@AppIcons.Language" Options="@_selectOptions" Value="@_selectValue"
                        ValueChanged="@(value => _selectValue = value)" />
        <AppLookupField Id="gallery-leading-lookup" Label="@L["Exams.Field.IssuingAuthority"]"
                        Placeholder="@L["Exams.Field.IssuingAuthority.Placeholder"]"
                        LeadingIcon="@AppIcons.IssuingAuthorities" SearchAsync="GalleryLookupAsync" />
    </div>
</section>

<section id="gallery-status-chips" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.StatusChips"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.StatusChips.Hint"]</MudText>
    <div class="gallery-icons">
        @foreach (var tone in Enum.GetValues<AppStatusTone>())
        {
            <div class="gallery-icon">
                <AppStatusChip Text="@L[$"Gallery.StatusChips.{tone}"]" Tone="tone" />
                <code>@($"AppStatusTone.{tone}")</code>
            </div>
        }
    </div>
</section>

<section id="gallery-error-summary" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.ErrorSummary"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.ErrorSummary.Hint"]</MudText>
    <div class="gallery-form">
        <AppErrorSummary Id="gallery-error-summary-sample" Title="@L["Common.ErrorSummary.Title"]"
                         Items="@SummaryItems" />
    </div>
</section>

<section id="gallery-form-aside" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.FormAside"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.FormAside.Hint"]</MudText>
    <div class="gallery-form">
        <AppFormAside Title="@L["Common.Summary.Title"]" EmptyText="@L["Common.Summary.NotFilled"]"
                      Rows="@AsideRows" ChecklistTitle="@L["Common.Summary.Checklist"]"
                      DoneText="@L["Common.Summary.Done"]" PendingText="@L["Common.Summary.Pending"]"
                      Checklist="@AsideChecklist" />
    </div>
</section>

<section id="gallery-item-rows" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.ItemRows"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.ItemRows.Hint"]</MudText>
    <div class="gallery-form">
        <AppItemRows TItem="string" Items="@_editions" EmptyMessage="@L["Gallery.ItemRows.Empty"]">
            <RowTemplate>@context</RowTemplate>
            <Actions>
                <AppRowActions ItemName="@context" OnEdit="@(() => Done(L["Common.Edit"]))" />
            </Actions>
        </AppItemRows>
        <AppItemRows TItem="string" Items="@(Array.Empty<string>())" EmptyMessage="@L["Gallery.ItemRows.Empty"]">
            <RowTemplate>@context</RowTemplate>
        </AppItemRows>
    </div>
</section>

<section id="gallery-alerts" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Alerts"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.Alerts.Hint"]</MudText>
    <AppAlert Severity="Severity.Info" Text="@L["Gallery.Alerts.Info"]" />
    <AppAlert Severity="Severity.Warning" Text="@I["Legal.DraftNotice"]" />
    <AppAlert Severity="Severity.Error" Text="@L["registration.rate_limited"]"
              ActionText="@L["Common.TryAgain"]" OnAction="@(() => { })" />
    <AppAlert Severity="Severity.Success" Text="@I["CheckEmail.Resend.Sent"]" />
</section>

<section id="gallery-sign-in" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.SignIn"]</MudText>
    <MudPaper Class="pa-4" Elevation="0" Outlined="true" Style="max-width: 420px">
        <AppDivider Text="@I["Auth.Or"]" />
        @* Here the button only reloads the gallery: the round trip is F-20's, behind its switch. *@
        <AppGoogleButton Text="@I["Auth.ContinueWithGoogle"]" StartPath="/dev/ui" />
    </MudPaper>
</section>

<section id="gallery-errors" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Errors"]</MudText>
    <AppAlert Severity="Severity.Error" Class="mb-2" Text="@($"{L["Gallery.Errors.Known"]}: {ErrorText.For("common.not_found")}")" />
    <AppAlert Severity="Severity.Error" Text="@($"{L["Gallery.Errors.Unknown"]}: {ErrorText.For("exam_board.does_not_exist_yet")}")" />
</section>

<section id="gallery-feedback" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Feedback"]</MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ShowSnackbar">@L["Gallery.Snackbar.Show"]</MudButton>
</section>

<section id="gallery-icons" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Icons"]</MudText>
    <div class="gallery-icons">
        @foreach (var (name, icon) in IconList)
        {
            <div class="gallery-icon">
                <MudIcon Icon="@icon" aria-hidden="true" />
                <code>@($"AppIcons.{name}")</code>
            </div>
        }
    </div>
</section>

@code {
    private string? _fieldValue;
    private string? _passwordValue;
    private bool _checked;
    private bool _filterChipShown = true;
    private string? _selectValue = SupportedCultures.Default;
    private static readonly IReadOnlyList<AppSelectOption<string>> _selectOptions =
        [.. SupportedCultures.All.Select(culture => new AppSelectOption<string>(culture.Name, SupportedCultures.NativeName(culture), culture.Name))];

    private string GalleryStrengthText(PasswordStrength strength) =>
        I["SignUp.Password.Strength", I[$"SignUp.Password.Strength.{strength}"]];

    // F-43: the composition patterns. The scope drives both the radio cards and the conditional field below.
    private string? _scope;
    private string? _scopeDetail;

    private static readonly IReadOnlyList<string> _editions = ["Edital 01/2026", "Edital 02/2023"];

    private IReadOnlyList<AppRadioCardOption<string>> ScopeCards =>
    [
        new("National", L["Exams.Scope.National"], L["Gallery.RadioCards.National"]),
        new("State", L["Exams.Scope.State"], L["Gallery.RadioCards.State"], AppIcons.Place),
        new("Municipal", L["Exams.Scope.Municipal"], L["Gallery.RadioCards.Municipal"], AppIcons.Place)
    ];

    private void OnScopeChanged(string? value) => _scope = value;

    private IReadOnlyList<AppErrorSummaryItem> SummaryItems =>
    [
        new("gallery-leading-text", L["Exams.Field.Name"]),
        new("gallery-scope", L["Exams.Field.Scope"])
    ];

    private IReadOnlyList<AppAsideRow> AsideRows =>
    [
        new(L["Exams.Field.IssuingAuthority"], "Prefeitura de Manaus"),
        new(L["Exams.Field.Name"], null)
    ];

    private IReadOnlyList<AppChecklistItem> AsideChecklist =>
    [
        new(L["Exams.Field.IssuingAuthority"], true),
        new(L["Exams.Field.Name"], false)
    ];

    private AppLookupOption? _lookupValue;
    private AppLookupOption? _filterLookup;
    private string? _filterValue;

    private IReadOnlyList<AppSelectOption<string>> _filterOptions =>
        [new(string.Empty, L["Common.Filter.All"]), new("a", SampleName(1)), new("b", SampleName(2))];

    // F-34: the gallery needs no server, so the candidates are sample rows filtered in memory. Every real
    // AppLookupField asks the Api instead (BR16).
    private static readonly IReadOnlyList<AppLookupOption> GalleryLookupOptions =
    [
        new(Guid.Parse("00000000-0000-0000-0000-000000000001"), "Centro Brasileiro de Pesquisa em Avaliacao (CEBRASPE)", "Exam board"),
        new(Guid.Parse("00000000-0000-0000-0000-000000000002"), "Fundacao Getulio Vargas (FGV)", "Exam board"),
        new(Guid.Parse("00000000-0000-0000-0000-000000000003"), "Prefeitura Municipal de Guarulhos (PMG)", "Public body"),
        new(Guid.Parse("00000000-0000-0000-0000-000000000004"), "Universidade de Sao Paulo (USP)", "University")
    ];

    private static Task<IReadOnlyList<AppLookupOption>> GalleryLookupAsync(string term, CancellationToken cancellationToken) =>
        Task.FromResult<IReadOnlyList<AppLookupOption>>(
            [.. GalleryLookupOptions.Where(option => option.Text.Contains(term, StringComparison.OrdinalIgnoreCase))]);

    private static Task<IReadOnlyList<AppLookupOption>> GalleryFailingLookupAsync(string term, CancellationToken cancellationToken) =>
        Task.FromException<IReadOnlyList<AppLookupOption>>(new HttpRequestException("gallery: the search failed on purpose"));

    private static readonly DateTimeOffset SampleBaseDate = new(2026, 9, 1, 12, 0, 0, TimeSpan.Zero);

    private static readonly IReadOnlyList<(string Name, string Icon)> IconList =
        [.. typeof(AppIcons).GetFields().Select(field => (field.Name, (string)field.GetRawConstantValue()!))];

    private bool _allowed;
    private GallerySource _source = default!;
    private AppDataTable<GallerySample> _table = default!;
    private GallerySample _sample = default!;
    private IReadOnlyList<BreadcrumbItem> _breadcrumbs = [];
    private IReadOnlyList<AppRowAction> _moreActions = [];
    private string? _formName;
    private bool _hasChanges;
    private bool _saving;

    /// <summary>Delay of the sample source, so the loading state is visible. Tests set it to zero.</summary>
    [Parameter] public TimeSpan SourceDelay { get; set; } = TimeSpan.FromMilliseconds(400);


    protected override void OnInitialized()
    {
        _allowed = Environment.IsDevelopment();
        if (!_allowed)
        {
            // Reached by in-app navigation outside Development: the request middleware never saw it.
            Navigation.NotFound();
            return;
        }

        _source = new GallerySource(CreateSample, SourceDelay);
        _sample = CreateSample(1);
        _breadcrumbs = [new BreadcrumbItem(L["Gallery.Breadcrumb.Dev"], href: null, disabled: true), new BreadcrumbItem(L["Gallery.Title"], href: null, disabled: true)];
        _moreActions =
        [
            new AppRowAction(L["Common.View"], AppIcons.View, () => Done(L["Common.View"])),
            new AppRowAction(L["Common.Duplicate"], AppIcons.Copy, () => Done(L["Common.Duplicate"])),
            new AppRowAction(L["Common.Archive"], AppIcons.Archive, () => Done(L["Common.Archive"])),
        ];
    }

    private string SampleName(int number) => L["Gallery.Table.SampleName", number];

    private GallerySample CreateSample(int number) => new(
        number,
        SampleName(number),
        L["Gallery.Table.SampleDescription"],
        Questions: 20 + number * 3 % 60,
        Score: 40m + number * 7 % 55 + 0.5m,
        UpdatedAt: SampleBaseDate.AddDays(-number));

    private Task ChangeModeAsync(GallerySourceMode mode)
    {
        _source.Mode = mode;
        return _table.ReloadAsync();
    }

    private Task Done(string action)
    {
        Snackbar.Add(L["Gallery.Done", action], Severity.Success);
        return Task.CompletedTask;
    }

    private async Task DeleteAsync(GallerySample item)
    {
        if (await Confirm.ConfirmDeleteAsync(L, item.Name, L["Gallery.Delete.Consequence"]))
            await Done(L["Common.Delete"]);
        else
            Snackbar.Add(L["Gallery.Cancelled"], Severity.Normal);
    }

    private Task ConfirmSampleAsync() =>
        DeleteAsync(_sample with { Name = L["Gallery.Confirm.SampleObject"] });

    private void OnFormNameChanged(string? value)
    {
        _formName = value;
        _hasChanges = !string.IsNullOrEmpty(value);
    }

    private async Task SaveAsync()
    {
        _saving = true;
        await Task.Delay(SourceDelay * 3);
        _saving = false;
        _hasChanges = false;
        Snackbar.Add(L["Gallery.Form.Saved"], Severity.Success);
    }

    private void CancelForm()
    {
        _formName = null;
        _hasChanges = false;
    }

    private void ShowSnackbar() => Snackbar.Add(L["Gallery.Snackbar.Message"], Severity.Success);

}
