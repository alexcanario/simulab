                           Value="@_switchOff" ValueChanged="@(value => _switchOff = value)" />
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Filled"]</p>
                <AppSwitch Id="gallery-switch-on" Label="@L["Gallery.Choices.Label.Reminders"]"
                           Value="@_switchOn" ValueChanged="@(value => _switchOn = value)" />
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Disabled"]</p>
                <AppSwitch Id="gallery-switch-disabled" Label="@L["Gallery.Choices.Label.Reminders"]" Value="true" Disabled="true" />

                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gallery-kind-title mt-4">@L["Gallery.Choices.Segmented"]</MudText>
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Empty"]</p>
