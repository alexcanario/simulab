<section id="gallery-type" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Type"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.Type.Hint"]</MudText>
    <dl class="gallery-type-scale">
        @foreach (var (step, typo) in TypeScale)
        {
            <dt><code>@step</code></dt>
            <dd><MudText Typo="typo" HtmlTag="p">@L["Gallery.Type.Sample"]</MudText></dd>
        }
        <dt><code>mono 14/22</code></dt>
        <dd><code>AppIcons.Edit</code></dd>
        <dt><code>mono grid 13/20</code></dt>
        <dd><code class="gallery-mono-grid">12.5 · 7.0 · 98.25</code></dd>
        <dt><code>mono kbd 12/16</code></dt>
        <dd><kbd>Ctrl</kbd> + <kbd>K</kbd> · @L["Gallery.Type.Shortcut"]</dd>
    </dl>
</section>

<section id="gallery-palette" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.Palette"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.Palette.Hint"]</MudText>
    <ul class="gallery-palette">
        @foreach (var (role, colour) in PaletteRoles)
        {
            <li class="gallery-swatch" data-role="@role">
                <span class="gallery-swatch-chip" style="background-color: @(role == "link" ? "var(--app-link)" : $"var(--mud-palette-{role})")" aria-hidden="true"></span>
                <code>@role</code>
                <code>@Hex(colour)</code>
            </li>
        }
    </ul>
</section>

