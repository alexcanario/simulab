    private void TogglePick(string key)
    {
        if (_pickItems.Remove(key, out var removed))
        {
            _pickAnnouncement = L["NoticeSubjects.Covers.Removed", removed.Name];
            return;
        }

        foreach (var sample in _pickSamples)
        {
            if (key == GalleryWholeKey(sample.Name))
            {
                _pickItems[key] = new AppMultiPickItem(
                    key, sample.Name, sample.Name, AppIcons.Subjects, Secondary: L["NoticeSubjects.Covers.WholeMarker"].Value);
            }
            else if (sample.Topics.FirstOrDefault(topic => GalleryTopicKey(sample.Name, topic) == key) is { } picked)
            {
                _pickItems[key] = GalleryTopicItem(sample.Name, picked);
            }
            else
            {
                continue;
            }

            _pickAnnouncement = L["NoticeSubjects.Covers.Added", _pickItems[key].Name];
            return;
        }
    }

    private void RemovePick(string key) => TogglePick(key);

    private void ClearPicks()
    {
        _pickItems.Clear();
        _pickAnnouncement = L["NoticeSubjects.Covers.Cleared"];
    }

