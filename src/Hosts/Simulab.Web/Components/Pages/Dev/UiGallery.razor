@* F-75: search a short local list, grouped, and pick several. The first field is live; the others are its states: the
   taxonomy loading, failing to load, empty, and a refusal under the field. *@
<section id="gallery-multi-pick-field" class="gallery-section">
    <MudText Typo="Typo.h2">@L["Gallery.Section.MultiPickField"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Gallery.MultiPickField.Hint"]</MudText>
    <MudPaper Outlined="true" Class="pa-4 gallery-form">
        <AppMultiPickField Id="gallery-pick"
                           Label="@L["Gallery.MultiPickField.Label"]"
                           Placeholder="@L["NoticeSubjects.Field.Covers.Placeholder"]"
                           OptionsLabel="@L["NoticeSubjects.Field.Covers.Options"]"
                           PickedLabel="@L["NoticeSubjects.Field.Covers.Picked"]"
                           CountText="@L["NoticeSubjects.Field.Covers.Count", _pickItems.Count, GalleryPickMax]"
                           ClearText="@L["Lookup.Clear"]"
                           NoneText="@L["NoticeSubjects.Field.Covers.None"]"
                           RemoveLabelFor="@(item => L["Common.RemoveItem", item.Name].Value)"
                           Groups="@GalleryPickGroups()"
                           Picked="@GalleryPickPicked()"
                           OnToggle="@TogglePick"
                           OnRemove="@RemovePick"
                           OnClear="@ClearPicks"
                           Hint="@L["NoticeSubjects.Field.Covers.Hint"]"
                           Announcement="@_pickAnnouncement" />

        <AppMultiPickField Id="gallery-pick-loading"
                           Label="@L["Gallery.MultiPickField.Label"]"
                           Placeholder="@L["NoticeSubjects.Field.Covers.Placeholder"]"
                           OptionsLabel="@L["NoticeSubjects.Field.Covers.Options"]"
                           PickedLabel="@L["NoticeSubjects.Field.Covers.Picked"]"
                           CountText="@L["NoticeSubjects.Field.Covers.Count", 0, GalleryPickMax]"
                           ClearText="@L["Lookup.Clear"]"
                           NoneText="@L["NoticeSubjects.Field.Covers.None"]"
                           RemoveLabelFor="@(item => L["Common.RemoveItem", item.Name].Value)"
                           Groups="@(Array.Empty<AppMultiPickGroup>())"
                           Picked="@(Array.Empty<AppMultiPickItem>())"
                           OnToggle="@TogglePick"
                           OnRemove="@RemovePick"
                           OnClear="@ClearPicks"
                           State="AppMultiPickState.Loading"
                           LoadingText="@L["NoticeSubjects.Field.Covers.Loading"]" />

        <AppMultiPickField Id="gallery-pick-failed"
                           Label="@L["Gallery.MultiPickField.Label"]"
                           Placeholder="@L["NoticeSubjects.Field.Covers.Placeholder"]"
                           OptionsLabel="@L["NoticeSubjects.Field.Covers.Options"]"
                           PickedLabel="@L["NoticeSubjects.Field.Covers.Picked"]"
                           CountText="@L["NoticeSubjects.Field.Covers.Count", 0, GalleryPickMax]"
                           ClearText="@L["Lookup.Clear"]"
                           NoneText="@L["NoticeSubjects.Field.Covers.None"]"
                           RemoveLabelFor="@(item => L["Common.RemoveItem", item.Name].Value)"
                           Groups="@(Array.Empty<AppMultiPickGroup>())"
                           Picked="@(Array.Empty<AppMultiPickItem>())"
                           OnToggle="@TogglePick"
                           OnRemove="@RemovePick"
                           OnClear="@ClearPicks"
                           State="AppMultiPickState.LoadFailed"
