        <AppFormGrid Columns="3">
            <div>
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="gallery-kind-title">@L["Gallery.Choices.Switch"]</MudText>
                <p class="gallery-state-caption">@L["Gallery.Choices.State.Empty"]</p>
