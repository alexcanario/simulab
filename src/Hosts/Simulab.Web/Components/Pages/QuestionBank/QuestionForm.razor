@page "/admin/questions/new"
@page "/admin/questions/{Id:guid}"
@attribute [Authorize(Policy = PermissionPolicy.Prefix + QuestionBankPermissions.Manage)]
@layout MainLayout
@using Simulab.Catalog.Contracts
@using Simulab.QuestionBank.Contracts
@using Simulab.Web.Services
@inject QuestionBankApiClient Api
@inject CatalogApiClient CatalogApi
@inject Simulab.Web.Services.Auth.WebSessionTokenAccessor Tokens
@inject IStringLocalizer<SharedResources> L
@inject ISnackbar Snackbar
@inject ErrorText Errors
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject IJSRuntime JS

@* F-95, UC1 to UC4 and UC6: the question is written on a page of its own (rule: ui-project): classification,
   statement, base text, options, explanation, and a publish checklist beside the form. Save is the only primary
   button of the page and never publishes (BR12); publishing, unpublishing and the preview sit in a card of their
   own below the form, because they act on what is stored (the ExamEditionsSection pattern). *@
<AppPageHeader Title="@Title" Breadcrumbs="_breadcrumbs" />

@if (_loading)
{
    <AppLoadingState />
}
else if (_loadFailed)
{
    <AppErrorState OnRetry="ReloadAsync" />
}
else if (_notFound)
{
    <MudPaper Class="app-form-card" Elevation="0">
        <AppAlert Severity="Severity.Error" Text="@Errors.For(QuestionBankErrorCodes.QuestionNotFound)" Class="mb-4" />
        <AppLink Href="/admin/questions">@L["Questions.BackToList"]</AppLink>
    </MudPaper>
}
else
{
    <div class="app-form-layout">
        <MudPaper Class="app-form-card" Elevation="0">
            <AppErrorSummary Id="@ErrorSummaryId"
                             Title="@L["Common.ErrorSummary.Title"]"
                             Items="@(_showErrorSummary ? ErrorSummaryItems : Array.Empty<AppErrorSummaryItem>())" />

            @if (_error is not null)
            {
                <AppAlert Severity="Severity.Error" Text="@_error" Class="mb-4" />
            }

            <AppSectionCard Id="question-section-classification"
                            Title="@L["Questions.Section.Classification"]"
                            Icon="@AppIcons.Topics"
                            Subtitle="@L["Questions.Section.Classification.Subtitle"]">
                <AppFormGrid Columns="2">
                    @* The question stores only the topic, so the Api does not ask for the subject; the screen does,
                       because the topic cannot be picked without it. *@
                    <AppLookupField Id="question-subject"
                                    Label="@L["Questions.Field.Subject"]"
                                    Placeholder="@L["Questions.Field.Subject.Placeholder"]"
                                    LeadingIcon="@AppIcons.Subjects"
                                    SearchAsync="SearchSubjectsAsync"
                                    Value="_subject"
                                    ValueChanged="OnSubjectChanged"
                                    Required="true"
                                    Hint="@L["Questions.Field.Subject.Hint"]" />

                    <AppLookupField Id="question-topic"
                                    Label="@L["Questions.Field.Topic"]"
                                    Placeholder="@L["Questions.Field.Topic.Placeholder"]"
                                    LeadingIcon="@AppIcons.Topics"
                                    SearchAsync="SearchTopicsAsync"
                                    MinChars="0"
                                    OpenOnFocus="true"
                                    Value="_topic"
                                    ValueChanged="OnTopicChanged"
                                    Required="true"
                                    Disabled="@(_subject is null)"
                                    Hint="@(_subject is null ? L["Questions.Field.Topic.DisabledHint"].Value : L["Questions.Field.Topic.Hint"].Value)"
                                    Error="@_topicError" />

                    <AppSelectField TValue="string"
                                    Id="question-content-language"
                                    Label="@L["Questions.Field.ContentLanguage"]"
                                    Value="_contentLanguage"
                                    ValueChanged="@((string? value) => OnContentLanguageChanged(value))"
                                    Options="LanguageOptions"
                                    Required="true"
                                    LeadingIcon="@AppIcons.Language"
                                    Hint="@L["Questions.Field.ContentLanguage.Hint"]"
                                    Error="@_languageError" />

                    <AppSelectField TValue="int?"
                                    Id="question-difficulty"
                                    Label="@L["Questions.Field.Difficulty"]"
                                    Value="_difficulty"
                                    ValueChanged="@((int? value) => OnDifficultyChanged(value))"
                                    Options="DifficultyOptions"
                                    Hint="@L["Questions.Field.Difficulty.Hint"]"
                                    Error="@_difficultyError" />
                </AppFormGrid>
            </AppSectionCard>

            <AppSectionCard Id="question-section-statement"
                            Title="@L["Questions.Section.Statement"]"
                            Icon="@AppIcons.Questions"
                            Subtitle="@L["Questions.Section.Statement.Subtitle"]">
                <AppRichTextField Id="question-statement"
                                  Label="@L["Questions.Field.Statement"]"
                                  Placeholder="@L["Questions.Field.Statement.Placeholder"]"
                                  Hint="@L["Questions.Field.Statement.Hint"]"
                                  Required="true"
                                  Lang="@_contentLanguage"
                                  Value="@_statement"
                                  ValueChanged="@((string? value) => OnStatementChanged(value))"
                                  Error="@_statementError" />
            </AppSectionCard>

            <AppSectionCard Id="question-section-base-text"
                            Title="@L["Questions.Section.BaseText"]"
                            Icon="@AppIcons.BaseText"
                            Subtitle="@L["Questions.Section.BaseText.Subtitle"]">
                <AppRichTextField Id="question-base-text"
                                  Label="@L["Questions.Field.BaseText"]"
                                  Placeholder="@L["Questions.Field.BaseText.Placeholder"]"
                                  Hint="@L["Questions.Field.BaseText.Hint"]"
                                  Lang="@_contentLanguage"
                                  Value="@_baseText"
                                  ValueChanged="@((string? value) => OnBaseTextChanged(value))"
                                  Error="@_baseTextError" />
            </AppSectionCard>

            <AppSectionCard Id="question-section-options"
                            Title="@L["Questions.Section.Options"]"
                            Icon="@AppIcons.Options"
                            Subtitle="@L["Questions.Section.Options.Subtitle"]">
                @* The group's value is the position of the correct option: exactly one can be checked (BR4) and a
                   draft may have none (BR3). *@
                <MudRadioGroup T="int?"
                               Value="CorrectPosition"
                               ValueChanged="OnCorrectChanged"
                               aria-label="@L["Questions.Options.Correct.Label"].Value"
                               aria-describedby="question-options-description">
                    <AppItemRows TItem="OptionDraft"
                                 Items="_options"
                                 EmptyMessage="@L["Questions.Options.Empty"]"
                                 AriaLabelledBy="question-section-options-title">
                        <RowTemplate Context="option">
                            @{
                                var position = _options.IndexOf(option);
                                var letter = QuestionText.Letter(position);
                            }
                            <div class="app-option-row">
                                <span class="app-option-letter">@letter</span>
                                <span class="app-option-radio">
                                    <MudRadio T="int?" Value="@((int?)position)" Color="Color.Primary">
                                        <span class="app-visually-hidden">@L["Questions.Options.MarkCorrect", letter]</span>
                                    </MudRadio>
                                </span>
                                <AppRichTextField Id="@OptionId(position)"
                                                  Label="@L["Questions.Options.Field", letter]"
                                                  LabelVisuallyHidden="true"
                                                  Placeholder="@L["Questions.Options.Field.Placeholder"]"
                                                  Compact="true"
                                                  AutoFocus="@option.FocusOnRender"
                                                  Lang="@_contentLanguage"
                                                  Value="@option.Html"
                                                  ValueChanged="@((string? value) => OnOptionChanged(option, value))"
                                                  Error="@option.Error" />
                            </div>
                        </RowTemplate>
                        <Actions Context="option">
                            @{
                                var index = _options.IndexOf(option);
                            }
                            <AppRowActions ItemName="@L["Questions.Options.Letter", QuestionText.Letter(index)]"
                                           IdPrefix="@ActionsId(index)"
                                           OnMoveUp="@(() => Move(index, -1))"
                                           MoveUpDisabledReason="@(index == 0 ? L["Questions.Options.MoveUp.DisabledFirst"].Value : null)"
                                           OnMoveDown="@(() => Move(index, 1))"
                                           MoveDownDisabledReason="@(index == _options.Count - 1 ? L["Questions.Options.MoveDown.DisabledLast"].Value : null)"
                                           OnDelete="@(() => Remove(index))" />
                        </Actions>
                    </AppItemRows>
                </MudRadioGroup>

                @* A section-level refusal (count, key, or an option error the problem did not place) is under the list
                   and described to the group, so it is read with it. *@
                <span id="question-options-description" class="app-field-description">
                    @if (_optionsError is not null)
                    {
                        <span class="app-field-error-text" aria-live="polite">@_optionsError</span>
                    }
                </span>

                <div class="app-options-footer">
                    @if (AtMaxOptions)
                    {
                        <MudTooltip Text="@L["Questions.Options.Add.DisabledMax"].Value">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@AppIcons.Add"
                                       Disabled="true"
                                       id="@AddOptionId">@L["Questions.Options.Add"]</MudButton>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@AppIcons.Add"
                                   OnClick="AddOption"
                                   id="@AddOptionId">@L["Questions.Options.Add"]</MudButton>
                    }

                    @* The limit is never told by a tooltip alone: a disabled button is not focusable. *@
                    <span class="app-options-count">@L["Questions.Options.Count", _options.Count]</span>
                </div>

                <div class="app-visually-hidden" role="status" aria-live="polite">@_announcement</div>
            </AppSectionCard>

            <AppSectionCard Id="question-section-explanation"
                            Title="@L["Questions.Section.Explanation"]"
                            Icon="@AppIcons.Explanation"
                            Subtitle="@L["Questions.Section.Explanation.Subtitle"]">
                <AppRichTextField Id="question-explanation"
                                  Label="@L["Questions.Field.Explanation"]"
                                  Placeholder="@L["Questions.Field.Explanation.Placeholder"]"
                                  Hint="@L["Questions.Field.Explanation.Hint"]"
                                  Lang="@_contentLanguage"
                                  Value="@_explanation"
                                  ValueChanged="@((string? value) => OnExplanationChanged(value))"
                                  Error="@_explanationError" />
            </AppSectionCard>

            <AppFormActions Saving="_saving" HasChanges="HasChanges" OnSave="SaveAsync" OnCancel="Cancel" />
        </MudPaper>

        <AppFormAside Title="@L["Questions.Form.Aside.Title"]"
                      EmptyText="@L["Common.Summary.NotFilled"]"
                      Rows="AsideRows"
                      ChecklistTitle="@L["Questions.Form.Aside.Checklist"]"
                      DoneText="@L["Common.Checklist.Done"]"
                      PendingText="@L["Common.Checklist.Pending"]"
                      Checklist="AsideChecklist" />
    </div>

    @* Publication: outside the form. Save never publishes and Publish never saves (BR12); both act on what is
       stored, so a change that is not saved blocks Publish and the preview says it shows the saved version. *@
    <MudPaper Class="app-form-card mt-4" Elevation="0">
        <AppSectionCard Id="question-section-publication"
                        Title="@L["Questions.Section.Publication"]"
                        Icon="@AppIcons.Publish"
                        Subtitle="@L["Questions.Section.Publication.Subtitle"]">
            @if (_saved is null)
            {
                <MudText Typo="Typo.body2">@L["Questions.Publication.SaveFirst"]</MudText>
            }
            else
            {
                @if (_publicationError is not null)
                {
                    <AppAlert Severity="Severity.Error" Text="@_publicationError" Class="mb-4" />
                }

                <div class="app-publication-row">
                    <AppStatusChip Text="@QuestionText.StatusName(L, _saved.Status)" Tone="QuestionText.StatusTone(_saved.Status)" />
                    <span>@(IsPublished ? L["Questions.Publication.Published"] : L["Questions.Publication.Draft"])</span>
                </div>

                <div class="app-publication-actions">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@AppIcons.View"
                               Disabled="_publishing"
                               OnClick="PreviewAsync"
                               id="@PreviewButtonId">@L["Questions.Action.Preview"]</MudButton>

                    @if (IsPublished)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@(_publishing ? null : AppIcons.Unpublish)"
                                   Disabled="_publishing"
                                   OnClick="UnpublishAsync"
                                   id="question-unpublish">
                            @if (_publishing)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" aria-hidden="true" />
                            }
                            @L["Questions.Action.Unpublish"]
                        </MudButton>
                    }
                    else
                    {
                        <MudTooltip Text="@(PublishDisabledReason ?? L["Questions.Action.Publish"].Value)">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@(_publishing ? null : AppIcons.Publish)"
                                       Disabled="@(_publishing || PublishDisabledReason is not null)"
                                       OnClick="PublishAsync"
                                       aria-describedby="@(PublishDisabledReason is null ? null : "question-publication-reason")"
                                       id="question-publish">
                                @if (_publishing)
                                {
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" aria-hidden="true" />
                                }
                                @L["Questions.Action.Publish"]
                            </MudButton>
                        </MudTooltip>
                    }
                </div>

                @* The reason is visible text, not a tooltip alone: a disabled button is not focusable. *@
                @if (!IsPublished && PublishDisabledReason is not null)
                {
                    <p id="question-publication-reason" class="app-publication-reason">@PublishDisabledReason</p>
                }
            }
        </AppSectionCard>
    </MudPaper>
}

@code {
    private const string ErrorSummaryId = "question-error-summary";
    private const string AddOptionId = "question-option-add";
    private const string PreviewButtonId = "question-preview";

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>The question being edited; absent on /admin/questions/new.</summary>
    [Parameter] public Guid? Id { get; set; }

    private IReadOnlyList<BreadcrumbItem> _breadcrumbs = [];
    private QuestionResponse? _saved;
    private AppLookupOption? _subject;
    private AppLookupOption? _topic;
    private string? _contentLanguage;
    private int? _difficulty;
    private string _statement = string.Empty;
    private string _baseText = string.Empty;
    private string _explanation = string.Empty;
    private List<OptionDraft> _options = [];

    private string? _topicError;
    private string? _languageError;
    private string? _difficultyError;
    private string? _statementError;
    private string? _baseTextError;
    private string? _optionsError;
    private string? _explanationError;
    private string? _error;
    private string? _publicationError;
    private string? _announcement;
    private string? _pendingFocus;

    private bool _loading;
    private bool _loadFailed;
    private bool _notFound;
    private bool _saving;
    private bool _publishing;
    private bool _showErrorSummary;

    private bool IsEdit => _saved is not null;

    private bool IsPublished => _saved?.Status == QuestionStatus.Published;

    private bool AtMaxOptions => _options.Count >= QuestionLimits.OptionsMax;

    private string Title => IsEdit || Id is not null ? L["Questions.Form.EditTitle"] : L["Questions.Form.AddTitle"];

    private static string OptionId(int position) => $"question-option-{position}";

    private static string ActionsId(int position) => $"question-option-actions-{position}";

    // A language is shown in its own name: it does not depend on the reader's UI language.
    private static IReadOnlyList<AppSelectOption<string>> LanguageOptions =>
        [.. SupportedCultures.All.Select(culture =>
            new AppSelectOption<string>(culture.Name, SupportedCultures.NativeName(culture), culture.Name))];

    private IReadOnlyList<AppSelectOption<int?>> DifficultyOptions =>
    [
        new(null, L["Questions.Difficulty.NotSet"]),
        .. Enumerable.Range(QuestionLimits.DifficultyMin, QuestionLimits.DifficultyMax - QuestionLimits.DifficultyMin + 1)
            .Select(value => new AppSelectOption<int?>(value, value.ToString(CultureInfo.CurrentCulture)))
    ];

    private int? CorrectPosition
    {
        get
        {
            var index = _options.FindIndex(option => option.IsCorrect);
            return index >= 0 ? index : null;
        }
    }

    // BR3 then BR4, in the order the aside lists them. The first three are also what a draft needs.
    private bool TopicDone => _topic is not null;

    private bool LanguageDone => !string.IsNullOrWhiteSpace(_contentLanguage);

    private bool StatementDone => !QuestionHtml.IsBlank(_statement);

    private bool OptionsCountDone =>
        _options.Count >= QuestionLimits.OptionsMin && _options.Count <= QuestionLimits.OptionsMax;

    private bool OptionsTextDone => _options.Count > 0 && _options.All(option => !QuestionHtml.IsBlank(option.Html));

    private bool KeyDone => _options.Count(option => option.IsCorrect) == 1;

    private bool ChecklistComplete =>
        TopicDone && LanguageDone && StatementDone && OptionsCountDone && OptionsTextDone && KeyDone;

    private IReadOnlyList<AppChecklistItem> AsideChecklist =>
    [
        new(L["Questions.Checklist.Topic"], TopicDone),
        new(L["Questions.Checklist.Language"], LanguageDone),
        new(L["Questions.Checklist.Statement"], StatementDone),
        new(L["Questions.Checklist.OptionsCount"], OptionsCountDone),
        new(L["Questions.Checklist.OptionsText"], OptionsTextDone),
        new(L["Questions.Checklist.Key"], KeyDone)
    ];

    private IReadOnlyList<AppAsideRow> AsideRows =>
    [
        new(L["Questions.Form.Aside.Status"], _saved is null ? null : QuestionText.StatusName(L, _saved.Status)),
        new(L["Questions.Field.Subject"], _subject?.Text),
        new(L["Questions.Field.Topic"], _topic?.Text),
        new(L["Questions.Field.ContentLanguage"], LanguageDone ? QuestionText.LanguageName(_contentLanguage!) : null),
        new(L["Questions.Field.Difficulty"], _difficulty?.ToString(CultureInfo.CurrentCulture)),
        new(L["Questions.Form.Aside.Options"], L["Questions.Options.Count", _options.Count].Value)
    ];

    // The reason Publish is disabled, said in words. Unsaved changes come first: publishing acts on what is stored.
    private string? PublishDisabledReason =>
        HasChanges
            ? L["Questions.Publication.Publish.DisabledUnsaved"].Value
            : !ChecklistComplete
                ? L["Questions.Publication.Publish.DisabledIncomplete"].Value
                : null;

    // One line per field the Api or the form refused, in the order the form shows them.
    private IReadOnlyList<AppErrorSummaryItem> ErrorSummaryItems
    {
        get
        {
            List<AppErrorSummaryItem> items = [];
            AddIfRefused(items, _topicError, "question-topic", L["Questions.Field.Topic"]);
            AddIfRefused(items, _languageError, "question-content-language", L["Questions.Field.ContentLanguage"]);
            AddIfRefused(items, _difficultyError, "question-difficulty", L["Questions.Field.Difficulty"]);
            AddIfRefused(items, _statementError, "question-statement", L["Questions.Field.Statement"]);
            AddIfRefused(items, _baseTextError, "question-base-text", L["Questions.Field.BaseText"]);
            for (var index = 0; index < _options.Count; index++)
            {
                AddIfRefused(items, _options[index].Error, OptionId(index), L["Questions.Options.Field", QuestionText.Letter(index)]);
            }

            AddIfRefused(items, _optionsError, AddOptionId, L["Questions.Section.Options"]);
            AddIfRefused(items, _explanationError, "question-explanation", L["Questions.Field.Explanation"]);
            return items;
        }
    }

    private static void AddIfRefused(List<AppErrorSummaryItem> items, string? error, string fieldId, string label)
    {
        if (error is not null)
        {
            items.Add(new AppErrorSummaryItem(fieldId, label));
        }
    }

    // What the form holds against what is stored. A new question is compared with an empty one.
    private bool HasChanges =>
        _topic?.Id != _saved?.TopicId
        || (_contentLanguage ?? string.Empty) != (_saved?.ContentLanguage ?? DefaultLanguage)
        || _difficulty != _saved?.Difficulty
        || Normalized(_statement) != Normalized(_saved?.StatementHtml)
        || Normalized(_baseText) != Normalized(_saved?.BaseTextHtml)
        || Normalized(_explanation) != Normalized(_saved?.ExplanationHtml)
        || OptionsChanged();

    private string DefaultLanguage => QuestionText.DefaultContentLanguage();

    private static string Normalized(string? html) => QuestionHtml.IsBlank(html) ? string.Empty : html!;

    private bool OptionsChanged()
    {
        var stored = _saved?.Options.OrderBy(option => option.Position).ToList() ?? [];
        if (stored.Count != _options.Count)
        {
            return true;
        }

        for (var index = 0; index < stored.Count; index++)
        {
            if (stored[index].IsCorrect != _options[index].IsCorrect
                || Normalized(stored[index].TextHtml) != Normalized(_options[index].Html))
            {
                return true;
            }
        }

        return false;
    }

    protected override void OnInitialized() => _contentLanguage = DefaultLanguage;

    protected override async Task OnParametersSetAsync()
    {
        BuildBreadcrumbs();
        if (Id is not { } id || _saved?.Id == id)
        {
            return;
        }

        await LoadAsync(id);
    }

    private Task ReloadAsync() => Id is { } id ? LoadAsync(id) : Task.CompletedTask;

    private async Task LoadAsync(Guid id)
    {
        _loading = true;
        _loadFailed = false;
        _notFound = false;
        var token = await TokenAsync();
        var result = token is null ? null : await Api.FindQuestionAsync(token, id);
        _loading = false;

        if (result is { IsSuccess: true, Value: { } question })
        {
            Apply(question);
            BuildBreadcrumbs();
            return;
        }

        // 404 is the answer "this question is not here"; anything else is a broken call the reader may retry.
        _notFound = result?.ErrorCode == QuestionBankErrorCodes.QuestionNotFound;
        _loadFailed = !_notFound;
    }

    // The form shows what was stored: the sanitized HTML replaces what the editors held (BR8).
    private void Apply(QuestionResponse question)
    {
        _saved = question;
        _subject = new AppLookupOption(question.SubjectId, question.SubjectName);
        _topic = new AppLookupOption(question.TopicId, question.TopicName);
        _contentLanguage = question.ContentLanguage;
        _difficulty = question.Difficulty;
        _statement = question.StatementHtml;
        _baseText = question.BaseTextHtml ?? string.Empty;
        _explanation = question.ExplanationHtml ?? string.Empty;
        _options =
        [
            .. question.Options.OrderBy(option => option.Position)
                .Select(option => new OptionDraft { Html = option.TextHtml, IsCorrect = option.IsCorrect })
        ];
        ClearErrors();
    }

    private void ClearErrors()
    {
        _topicError = _languageError = _difficultyError = _statementError = null;
        _baseTextError = _explanationError = _optionsError = _error = null;
        _showErrorSummary = false;
        foreach (var option in _options)
        {
            option.Error = null;
        }
    }

    private void BuildBreadcrumbs() =>
        _breadcrumbs =
        [
            new BreadcrumbItem(L["Nav.Section.Content"], href: null, disabled: true),
            new BreadcrumbItem(L["Questions.Title"], href: "/admin/questions"),
            new BreadcrumbItem(Title, href: null, disabled: true)
        ];

    // -- classification ---------------------------------------------------------------------------------------

    private async Task<IReadOnlyList<AppLookupOption>> SearchSubjectsAsync(string term, CancellationToken cancellationToken)
    {
        var token = await TokenAsync() ?? throw new InvalidOperationException("No session.");
        var result = await CatalogApi.ListSubjectsAsync(
            token,
            new SubjectListQuery(0, AppLookupField.MaxCandidates, term),
            cancellationToken);

        if (!result.IsSuccess)
        {
            throw new InvalidOperationException($"Subjects failed to load: {result.ErrorCode}.");
        }

        return [.. result.Value!.Items.Select(subject => new AppLookupOption(subject.Id, subject.Name))];
    }

    // A subject has a short topic list: the Api answers all of it and the term narrows it here, ignoring case and accents.
    private async Task<IReadOnlyList<AppLookupOption>> SearchTopicsAsync(string term, CancellationToken cancellationToken)
    {
        if (_subject is not { } subject)
        {
            return [];
        }

        var token = await TokenAsync() ?? throw new InvalidOperationException("No session.");
        var result = await CatalogApi.ListTopicsAsync(token, subject.Id, cancellationToken);
        if (!result.IsSuccess)
        {
            throw new InvalidOperationException($"Topics failed to load: {result.ErrorCode}.");
        }

        var wanted = AppSuggestField.Normalize(term);
        return
        [
            .. result.Value!
                .Where(topic => wanted.Length == 0 || AppSuggestField.Normalize(topic.Name).Contains(wanted, StringComparison.Ordinal))
                .Select(topic => new AppLookupOption(topic.Id, topic.Name))
                .Take(AppLookupField.MaxCandidates)
        ];
    }

    // Changing or clearing the subject clears the topic: a topic belongs to one subject.
    private void OnSubjectChanged(AppLookupOption? value)
    {
        if (value?.Id != _subject?.Id)
        {
            _topic = null;
            _topicError = null;
        }

        _subject = value;
    }

    private void OnTopicChanged(AppLookupOption? value)
    {
        _topic = value;
        _topicError = TopicError();
    }

    private void OnContentLanguageChanged(string? value)
    {
        _contentLanguage = value;
        _languageError = null;
    }

    private void OnDifficultyChanged(int? value)
    {
        _difficulty = value;
        _difficultyError = null;
    }

    // -- the rich texts ---------------------------------------------------------------------------------------

    private void OnStatementChanged(string? value)
    {
        _statement = value ?? string.Empty;
        _statementError = StatementError();
    }

    private void OnBaseTextChanged(string? value)
    {
        _baseText = value ?? string.Empty;
        _baseTextError = BaseTextError();
    }

    private void OnExplanationChanged(string? value)
    {
        _explanation = value ?? string.Empty;
        _explanationError = ExplanationError();
    }

    private void OnOptionChanged(OptionDraft option, string? value)
    {
        option.Html = value ?? string.Empty;
        option.Error = OptionError(option, required: IsPublished);
        _optionsError = null;
    }

    // -- the options ------------------------------------------------------------------------------------------

    private void OnCorrectChanged(int? position)
    {
        for (var index = 0; index < _options.Count; index++)
        {
            _options[index].IsCorrect = index == position;
        }

        _optionsError = null;
    }

    private void AddOption()
    {
        if (AtMaxOptions)
        {
            return;
        }

        // Only the row added now takes the focus once its editor is ready.
        foreach (var existing in _options)
        {
            existing.FocusOnRender = false;
        }

        _options.Add(new OptionDraft { FocusOnRender = true });
        _optionsError = null;
        _announcement = null;
    }

    // A move is client-side: the order is sent with Save. The focus stays on the pressed button, or on its pair
    // when the move made it disabled (the NoticeSubjectsSection rule).
    private void Move(int index, int direction)
    {
        var target = index + direction;
        if (target < 0 || target >= _options.Count)
        {
            return;
        }

        (_options[index], _options[target]) = (_options[target], _options[index]);
        _announcement = L["Questions.Options.Moved", target + 1, _options.Count];

        var pressedStillEnabled = direction < 0 ? target > 0 : target < _options.Count - 1;
        var key = (direction < 0) == pressedStillEnabled ? AppRowActions.MoveUpKey : AppRowActions.MoveDownKey;
        _pendingFocus = $"{ActionsId(target)}-{key}";
    }

    // No confirmation: nothing is saved until Save, and leaving the page without saving discards the change.
    private void Remove(int index)
    {
        if (index < 0 || index >= _options.Count)
        {
            return;
        }

        _options.RemoveAt(index);
        _optionsError = null;
        _announcement = L["Questions.Options.Removed", _options.Count];
        _pendingFocus = index < _options.Count ? $"{ActionsId(index)}-{AppRowActions.DeleteKey}" : AddOptionId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocus is not { } target)
        {
            return;
        }

        _pendingFocus = null;
        await JS.InvokeVoidAsync("simulabShell.focusElement", target);
    }

    // -- comfort checks: the Api is the authority and runs the same ones (rule: ui-project) --------------------

    private string? TopicError() =>
        _topic is null ? L["Questions.Field.Topic.Required"].Value : null;

    private string? StatementError() =>
        QuestionHtml.IsBlank(_statement)
            ? Errors.For(QuestionBankErrorCodes.QuestionStatementRequired)
            : _statement.Length > QuestionLimits.StatementMaxLength
                ? Errors.For(QuestionBankErrorCodes.QuestionStatementTooLong)
                : null;

    private string? BaseTextError() =>
        _baseText.Length > QuestionLimits.BaseTextMaxLength
            ? Errors.For(QuestionBankErrorCodes.QuestionBaseTextTooLong)
            : null;

    private string? ExplanationError() =>
        _explanation.Length > QuestionLimits.ExplanationMaxLength
            ? Errors.For(QuestionBankErrorCodes.QuestionExplanationTooLong)
            : null;

    private string? OptionError(OptionDraft option, bool required) =>
        option.Html.Length > QuestionLimits.OptionMaxLength
            ? Errors.For(QuestionBankErrorCodes.QuestionOptionTooLong)
            : required && QuestionHtml.IsBlank(option.Html)
                ? Errors.For(QuestionBankErrorCodes.QuestionOptionTextRequired)
                : null;

    // The section-level rule of a published question (BR4): a count, then the key.
    private string? PublishedOptionsError()
    {
        if (!OptionsCountDone)
        {
            return Errors.For(QuestionBankErrorCodes.QuestionOptionsCount);
        }

        return KeyDone ? null : Errors.For(QuestionBankErrorCodes.QuestionKeyInvalid);
    }

    // -- save -------------------------------------------------------------------------------------------------

    private async Task SaveAsync()
    {
        var published = IsPublished;

        _topicError = TopicError();
        _languageError = LanguageDone ? null : Errors.For(QuestionBankErrorCodes.QuestionContentLanguageInvalid);
        _difficultyError = null;
        _statementError = StatementError();
        _baseTextError = BaseTextError();
        _explanationError = ExplanationError();
        foreach (var option in _options)
        {
            option.Error = OptionError(option, required: published);
        }

        _optionsError = published ? PublishedOptionsError() : null;

        if (HasClientRefusal())
        {
            // The summary lists every refused field at once and takes the focus, so the reader does not hunt.
            _showErrorSummary = true;
            await JS.InvokeVoidAsync("simulabShell.focusElement", ErrorSummaryId);
            return;
        }

        _showErrorSummary = false;
        _saving = true;
        _error = null;

        var token = await TokenAsync();
        var request = new SaveQuestionRequest(
            _topic!.Id,
            _contentLanguage,
            _statement,
            QuestionHtml.NullIfBlank(_baseText),
            QuestionHtml.NullIfBlank(_explanation),
            _difficulty,
            [.. _options.Select(option => new SaveQuestionOptionRequest(QuestionHtml.NullIfBlank(option.Html), option.IsCorrect))]);

        var result = token is null
            ? QuestionBankResult.Failed<QuestionResponse>(ErrorText.UnexpectedCode)
            : IsEdit
                ? await Api.UpdateQuestionAsync(token, _saved!.Id, request)
                : await Api.CreateQuestionAsync(token, request);

        _saving = false;
        if (result is { IsSuccess: true, Value: { } question })
        {
            var wasAdd = !IsEdit;
            Apply(question);
            _publicationError = null;
            BuildBreadcrumbs();
            Snackbar.Add(L["Questions.Saved"], Severity.Success);
            if (wasAdd)
            {
                // The page stays open as the edit form of the question that was just saved: previewing and
                // publishing it are the usual next steps. The render comes first: the NavigationLock of the form
                // actions reads HasChanges from the last render and would otherwise ask to discard what was
                // just saved (F-35).
                StateHasChanged();
                await Task.Yield();
                Navigation.NavigateTo($"/admin/questions/{question.Id}", replace: true);
            }

            return;
        }

        await ShowRefusalAsync(result);
    }

    private bool HasClientRefusal() =>
        _topicError is not null || _languageError is not null || _statementError is not null
        || _baseTextError is not null || _explanationError is not null || _optionsError is not null
        || _options.Any(option => option.Error is not null);

    // A refusal belongs to the field that caused it, so the reader sees where to change something (BR16).
    private async Task ShowRefusalAsync(QuestionBankResult<QuestionResponse> result)
    {
        var code = result.ErrorCode;
        var text = Errors.For(code);
        var fieldRefused = true;

        switch (code)
        {
            case QuestionBankErrorCodes.QuestionStatementRequired:
            case QuestionBankErrorCodes.QuestionStatementTooLong:
                _statementError = text;
                break;
            case QuestionBankErrorCodes.QuestionBaseTextTooLong:
                _baseTextError = text;
                break;
            case QuestionBankErrorCodes.QuestionExplanationTooLong:
                _explanationError = text;
                break;
            case QuestionBankErrorCodes.QuestionOptionTextRequired:
            case QuestionBankErrorCodes.QuestionOptionTooLong:
                // The problem names the option when it can; otherwise the section says it (decision of 2026-10-10).
                if (result.OptionPosition is { } position && position >= 0 && position < _options.Count)
                {
                    _options[position].Error = text;
                }
                else
                {
                    _optionsError = text;
                }

                break;
            case QuestionBankErrorCodes.QuestionOptionsCount:
            case QuestionBankErrorCodes.QuestionKeyInvalid:
                _optionsError = text;
                break;
            case QuestionBankErrorCodes.QuestionDifficultyInvalid:
                _difficultyError = text;
                break;
            case QuestionBankErrorCodes.QuestionContentLanguageInvalid:
                _languageError = text;
                break;
            case QuestionBankErrorCodes.QuestionTopicNotFound:
                // The topic left the catalog since it was picked: clear it and make the reader choose again.
                _topic = null;
                _topicError = L["Questions.Field.Topic.Required"].Value;
                _error = text;
                break;
            default:
                _error = text;
                fieldRefused = false;
                break;
        }

        if (fieldRefused)
        {
            _showErrorSummary = true;
            await JS.InvokeVoidAsync("simulabShell.focusElement", ErrorSummaryId);
        }
    }

    private void Cancel() => Navigation.NavigateTo("/admin/questions");

    // -- publication and preview -------------------------------------------------------------------------------

    private Task PublishAsync() => SetPublicationAsync(publish: true);

    private Task UnpublishAsync() => SetPublicationAsync(publish: false);

    // BR12: only the status changes. The form keeps what the reader has typed; the stored content is the same,
    // so the saved question is replaced without touching the fields.
    private async Task SetPublicationAsync(bool publish)
    {
        if (_saved is not { } current)
        {
            return;
        }

        _publicationError = null;
        _publishing = true;

        var token = await TokenAsync();
        var result = token is null
            ? QuestionBankResult.Failed<QuestionResponse>(ErrorText.UnexpectedCode)
            : publish
                ? await Api.PublishQuestionAsync(token, current.Id)
                : await Api.UnpublishQuestionAsync(token, current.Id);

        _publishing = false;
        if (result is { IsSuccess: true, Value: { } question })
        {
            _saved = question;
            Snackbar.Add(publish ? L["Questions.Published"] : L["Questions.Unpublished"], Severity.Success);
            return;
        }

        // 400 while incomplete (BR4), 409 when it is already in that state, 404 when it is gone.
        _publicationError = Errors.For(result.ErrorCode);
    }

    private async Task PreviewAsync()
    {
        if (_saved is not { } question)
        {
            return;
        }

        var parameters = new DialogParameters<QuestionPreviewDialog>
        {
            { dialog => dialog.Question, question },
            { dialog => dialog.UnsavedChanges, HasChanges }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };

        var reference = await Dialogs.ShowAsync<QuestionPreviewDialog>(L["Questions.Preview.Title"], parameters, options);
        await reference.Result;

        // Closed: the focus goes back to the button that opened it.
        _pendingFocus = PreviewButtonId;
        StateHasChanged();
    }

    // B-3: through the accessor, which refreshes the token; never from the cookie.
    private async Task<string?> TokenAsync()
    {
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        return user is null ? null : await Tokens.GetAccessTokenAsync(user);
    }
}
