    private void OnBaseTextChanged(AppLookupOption? value)
    {
        _baseText = value;
        _baseTextLanguage = value is null ? null : _contentLanguage;
        _baseTextError = null;
        _baseTextCleared = null;
        _baseTextPreviewFailed = false;
    }

    // The stored link carries its text; a text picked now is read once, the first time it is shown.
    private string? BaseTextHtmlOf(Guid id) =>
        _saved?.BaseText is { } stored && stored.Id == id
            ? stored.TextHtml
            : _baseTextHtmls.GetValueOrDefault(id);

    private void RequestBaseTextPreview(Guid id)
    {
        if (_baseTextPreviewRequested == id || _baseTextHtmls.ContainsKey(id))
        {
            return;
        }

        _baseTextPreviewRequested = id;
        _ = LoadBaseTextPreviewAsync(id);
    }

    private async Task LoadBaseTextPreviewAsync(Guid id)
    {
        _baseTextPreviewFailed = false;
        var token = await TokenAsync();
        var result = token is null ? null : await Api.FindBaseTextAsync(token, id);
        if (result is { IsSuccess: true, Value: { } baseText })
        {
            _baseTextHtmls[id] = baseText.TextHtml;
        }
        else
