        _noticeSubjectId = value;
        _noticeSubjectError = null;
    }

    // The notice subjects of the chosen edition, in display order. A failure leaves the select empty and says so;
    // the curator can still save without one (it is optional).
    private async Task LoadNoticeSubjectsAsync(Guid? editionId)
    {
        if (editionId is null)
        {
            _noticeSubjects = [];
            _noticeSubjectsFor = null;
            return;
        }

        if (_noticeSubjectsFor == editionId)
        {
            return;
        }

        _noticeSubjectsLoading = true;
        var token = await TokenAsync();
        var result = token is null ? null : await Api.ListNoticeSubjectsAsync(token, editionId.Value);
        _noticeSubjectsLoading = false;

        _noticeSubjects = result is { IsSuccess: true, Value: { } subjects } ? subjects : [];
        _noticeSubjectsFor = editionId;
    }

