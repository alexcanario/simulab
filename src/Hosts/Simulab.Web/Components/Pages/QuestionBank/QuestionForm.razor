@page "/admin/questions/new"
@page "/admin/questions/{Id:guid}"
@page "/admin/questions/transcribe"
@attribute [Authorize(Policy = PermissionPolicy.Prefix + QuestionBankPermissions.Manage)]
@layout MainLayout
@using Simulab.QuestionBank.Contracts
@using Simulab.Web.Services
@using Simulab.Web.Services.QuestionBank
@inject QuestionBankApiClient Api
@inject Simulab.Web.Services.Auth.WebSessionTokenAccessor Tokens
@inject IStringLocalizer<SharedResources> L
@inject ISnackbar Snackbar
@inject ErrorText Errors
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject IJSRuntime JS

@* F-95, UC1 to UC4 and UC6: the question is written on a page of its own (rule: ui-project): classification,
   statement, base text, options, explanation, and a publish checklist beside the form. Save is the only primary
   button of the page and never publishes (BR12); publishing, unpublishing and the preview sit in a card of their
   own below the form, because they act on what is stored (the ExamEditionsSection pattern). *@
<AppPageHeader Title="@Title" Breadcrumbs="_breadcrumbs" />

@if (_loading)
{
    <AppLoadingState />
}
else if (_loadFailed)
{
    <AppErrorState OnRetry="ReloadAsync" />
}
else if (_notFound)
{
    <MudPaper Class="app-form-card" Elevation="0">
        <AppAlert Severity="Severity.Error" Text="@Errors.For(QuestionBankErrorCodes.QuestionNotFound)" Class="mb-4" />
        <AppLink Href="@ListHref">@L["Questions.BackToList"]</AppLink>
    </MudPaper>
}
else if (_transcribeEditionMissing)
{
    @* F-99 AC10: an edition that is unknown or deleted leaves Finish as the only action. *@
    <MudPaper Class="app-form-card" Elevation="0" id="question-transcribe-edition-missing">
        <AppAlert Severity="Severity.Error" Text="@Errors.For(QuestionBankErrorCodes.QuestionExamEditionNotFound)" Class="mb-4" />
        <AppLink Href="@FinishHref">@L["Questions.Transcribe.Finish"]</AppLink>
    </MudPaper>
}
else
{
    @* F-99: transcription mode is this form with the edition locked; the batch counter lives only here (BR6). *@
    @if (IsTranscribing)
    {
        <MudPaper Class="app-form-card mb-4" Elevation="0" id="question-transcribe-header">
            @if (_transcribeSaved)
            {
                <AppAlert Severity="Severity.Success" Text="@L["Questions.Transcribe.Saved"]" Class="mb-4" />
            }

            <MudText Typo="Typo.subtitle1" id="question-transcribe-edition">@(_edition?.Text)</MudText>
            <MudText Typo="Typo.body2" id="question-transcribe-counter">@L["Questions.Transcribe.Counter", _batchNumber]</MudText>
            <div class="app-form-actions">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="Finish"
                           id="question-transcribe-finish">@L["Questions.Transcribe.Finish"]</MudButton>
            </div>
        </MudPaper>
    }

    <div class="app-form-layout">
        <MudPaper Class="app-form-card" Elevation="0">
            <AppErrorSummary Id="@ErrorSummaryId"
                             Title="@L["Common.ErrorSummary.Title"]"
                             Items="@(_showErrorSummary ? ErrorSummaryItems : Array.Empty<AppErrorSummaryItem>())" />

            @if (_error is not null)
            {
                <AppAlert Severity="Severity.Error" Text="@_error" Class="mb-4" />
            }

            @* F-101 BR5: an annulled question is frozen; the way out is the Reinstate button of the card below. *@
            @if (IsAnnulled)
            {
                <div id="question-annulled-alert">
                    <AppAlert Severity="Severity.Warning" Text="@L["Questions.Annulled.Alert"]" Class="mb-4" />
                </div>
            }

            @* F-105 BR3: a question in review is frozen too; the way out is the Withdraw button of the card below. *@
            @if (IsInReview)
            {
                <div id="question-in-review-alert" role="status">
                    <AppAlert Severity="Severity.Warning" Text="@L["Questions.InReview.Alert"]" Class="mb-4" />
                </div>
            }

            <AppSectionCard Id="question-section-classification"
                            Title="@L["Questions.Section.Classification"]"
                            Icon="@AppIcons.Topics"
                            Subtitle="@L["Questions.Section.Classification.Subtitle"]">
                @* F-97, UC1 and BR2: the type is the first field. It is chosen when the question is created and read
                   only afterwards: changing it would drop options or a key without saying so. *@
                @if (IsEdit)
                {
                    <div class="app-field mb-4">
                        <span class="app-field-label" id="question-type-label">@L["Questions.Field.Type"]</span>
                        <span class="app-field-value" id="question-type-value">@QuestionText.TypeName(L, _type)</span>
                        <span class="app-field-description"><span class="app-field-hint">@L["Questions.Type.ReadOnlyHint"]</span></span>
                    </div>
                }
                else
                {
                    <AppRadioCards TValue="QuestionType?"
                                   Id="question-type"
                                   Label="@L["Questions.Field.Type"]"
                                   Value="_type"
                                   ValueChanged="@((QuestionType? value) => OnTypeChanged(value))"
                                   Options="TypeCards"
                                   Columns="3"
                                   Required="true" />
                }

                <AppFormGrid Columns="2">
                    @* The question stores only the topic, so the Api does not ask for the subject; the screen does,
                       because the topic cannot be picked without it. *@
                    <AppLookupField Id="question-subject"
                                    Label="@L["Questions.Field.Subject"]"
                                    Placeholder="@L["Questions.Field.Subject.Placeholder"]"
                                    LeadingIcon="@AppIcons.Subjects"
                                    SearchAsync="SearchSubjectsAsync"
                                    Value="_subject"
                                    ValueChanged="OnSubjectChanged"
                                    Required="true"
                                    Disabled="IsFrozen"
                                    Hint="@L["Questions.Field.Subject.Hint"]" />

                    <AppLookupField Id="question-topic"
                                    Label="@L["Questions.Field.Topic"]"
                                    Placeholder="@L["Questions.Field.Topic.Placeholder"]"
                                    LeadingIcon="@AppIcons.Topics"
                                    SearchAsync="SearchTopicsAsync"
                                    MinChars="0"
                                    OpenOnFocus="true"
                                    Value="_topic"
                                    ValueChanged="OnTopicChanged"
                                    Required="true"
                                    Disabled="@(_subject is null || IsFrozen)"
                                    Hint="@(_subject is null ? L["Questions.Field.Topic.DisabledHint"].Value : L["Questions.Field.Topic.Hint"].Value)"
                                    Error="@_topicError" />

                    <AppSelectField TValue="string"
                                    Id="question-content-language"
                                    Label="@L["Questions.Field.ContentLanguage"]"
                                    Value="_contentLanguage"
                                    ValueChanged="@((string? value) => OnContentLanguageChanged(value))"
                                    Options="LanguageOptions"
                                    Required="true"
                                    Disabled="IsFrozen"
                                    LeadingIcon="@AppIcons.Language"
                                    Hint="@L["Questions.Field.ContentLanguage.Hint"]"
                                    Error="@_languageError" />

                    <AppSelectField TValue="int?"
                                    Id="question-difficulty"
                                    Label="@L["Questions.Field.Difficulty"]"
                                    Value="_difficulty"
                                    ValueChanged="@((int? value) => OnDifficultyChanged(value))"
                                    Options="DifficultyOptions"
                                    Disabled="IsFrozen"
                                    Hint="@L["Questions.Field.Difficulty.Hint"]"
                                    Error="@_difficultyError" />
                </AppFormGrid>
            </AppSectionCard>

            @* F-96, UC1 and UC2: where a past-exam question came from. All three fields are optional together: an
               empty section is an authored question. The lookups are routes of the question bank, so a curator
               needs no catalog permission to fill them (BR9). *@
            <AppSectionCard Id="question-section-origin"
                            Title="@L["Questions.Section.Origin"]"
                            Icon="@AppIcons.Editions"
                            Subtitle="@L["Questions.Section.Origin.Subtitle"]">
                <AppFormGrid Columns="2">
                    <AppLookupField Id="question-edition"
                                    Label="@L["Questions.Field.Edition"]"
                                    Placeholder="@L["Questions.Field.Edition.Placeholder"]"
                                    LeadingIcon="@AppIcons.Editions"
                                    SearchAsync="SearchEditionsAsync"
                                    MinChars="0"
                                    OpenOnFocus="true"
                                    Value="_edition"
                                    ValueChanged="OnEditionChangedAsync"
                                    Disabled="@(IsFrozen || IsTranscribing)"
                                    Hint="@(IsTranscribing ? L["Questions.Transcribe.EditionLocked"].Value : L["Questions.Field.Edition.Hint"].Value)"
                                    Error="@_editionError" />

                    <AppTextField TValue="int?"
                                  Id="question-paper-number"
                                  Label="@L["Questions.Field.PaperNumber"]"
                                  InputType="InputType.Number"
                                  Value="_paperNumber"
                                  ValueChanged="@((int? value) => OnPaperNumberChanged(value))"
                                  Required="@(_edition is not null)"
                                  Disabled="@(_edition is null || IsFrozen)"
                                  Hint="@(_edition is null ? L["Questions.Field.PaperNumber.DisabledHint"].Value : L["Questions.Field.PaperNumber.Hint"].Value)"
                                  Error="@_paperNumberError" />

                    <AppSelectField TValue="Guid?"
                                    Id="question-notice-subject"
                                    Label="@L["Questions.Field.NoticeSubject"]"
                                    Value="_noticeSubjectId"
                                    ValueChanged="@((Guid? value) => OnNoticeSubjectChanged(value))"
                                    Options="NoticeSubjectOptions"
                                    Disabled="@(_edition is null || IsFrozen)"
                                    Loading="_noticeSubjectsLoading"
                                    Hint="@(_edition is null ? L["Questions.Field.NoticeSubject.DisabledHint"].Value : L["Questions.Field.NoticeSubject.Hint"].Value)"
                                    Error="@_noticeSubjectError" />
                </AppFormGrid>
            </AppSectionCard>

            <AppSectionCard Id="question-section-statement"
                            Title="@L["Questions.Section.Statement"]"
                            Icon="@AppIcons.Questions"
                            Subtitle="@L["Questions.Section.Statement.Subtitle"]">
                <AppRichTextField Id="question-statement"
                                  Label="@L["Questions.Field.Statement"]"
                                  Placeholder="@L["Questions.Field.Statement.Placeholder"]"
                                  Hint="@L["Questions.Field.Statement.Hint"]"
                                  Required="true"
                                  Disabled="IsFrozen"
                                  Lang="@_contentLanguage"
                                  Images="ImageOptions"
                                  Value="@_statement"
                                  ValueChanged="@((string? value) => OnStatementChanged(value))"
                                  Error="@_statementError" />
            </AppSectionCard>

            <AppSectionCard Id="question-section-base-text"
                            Title="@L["Questions.Section.BaseText"]"
                            Icon="@AppIcons.BaseText"
                            Subtitle="@L["Questions.Section.BaseText.Subtitle"]">
                @* F-102: the base text is picked, never typed here: it has a page of its own, so there is one way to
                   edit it (rule: ui-project). The lookup is the server's search over the texts in the question's
                   language (BR3); nothing is cached, so a text created in another tab is listed at once. *@
                <AppLookupField Id="question-base-text"
                                Label="@L["Questions.Field.BaseText"]"
                                Placeholder="@L["Questions.Field.BaseText.Placeholder"]"
                                SearchAsync="SearchBaseTextsAsync"
                                MinChars="0"
                                OpenOnFocus="true"
                                Value="_baseText"
                                ValueChanged="OnBaseTextChanged"
                                Disabled="IsFrozen"
                                Hint="@BaseTextHint"
                                Error="@_baseTextError" />

                @if (_baseTextCleared is not null)
                {
                    <div id="question-base-text-cleared">
                        <AppAlert Severity="Severity.Info" Text="@_baseTextCleared" Class="mb-4" />
                    </div>
                }

                @if (_baseText is { } chosen)
                {
                    @* Reading stays allowed on an annulled question; the link opens in a new tab so this form stays as it is. *@
                    <div class="app-base-text-links" id="question-base-text-chosen">
                        <AppLink Href="@($"/admin/base-texts/{chosen.Id}")"
                                 target="_blank"
                                 rel="noopener"
                                 aria-label="@(L["Common.LinkOpensNewTab", L["Questions.BaseText.Open"].Value].Value)"
                                 id="question-base-text-open">
                            @L["Questions.BaseText.Open"]
                            <MudIcon Icon="@AppIcons.OpenInNew" aria-hidden="true" Style="width: 16px; height: 16px; vertical-align: text-bottom" />
                        </AppLink>
                    </div>

                    <AppDisclosure Id="question-base-text-preview"
                                   ShowText="@L["Questions.BaseText.Show"]"
                                   HideText="@L["Questions.BaseText.Hide"]">
                        @{
                            var previewHtml = BaseTextHtmlOf(chosen.Id);
                        }
                        @if (previewHtml is not null)
                        {
                            <div class="app-base-text-preview">
                                <div class="app-question-content" lang="@_baseTextLanguage" id="question-base-text-preview-html">@((MarkupString)previewHtml)</div>
                                <span class="app-field-hint app-base-text-note">@L["Questions.BaseText.ReadOnlyNote"]</span>
                            </div>
                        }
                        else if (_baseTextPreviewFailed)
                        {
                            <AppErrorState OnRetry="@(() => LoadBaseTextPreviewAsync(chosen.Id))" />
                        }
                        else
                        {
                            <AppLoadingState />
                            // First time it is opened: the text is read once (this renders only while the block is open).
                            RequestBaseTextPreview(chosen.Id);
                        }
                    </AppDisclosure>
                }

                @if (!IsFrozen)
                {
                    <div class="app-base-text-create" id="question-base-text-create">
                        <span>@L["Questions.BaseText.Create.Lead"]</span>
                        <AppLink Href="@CreateBaseTextHref"
                                 target="_blank"
                                 rel="noopener"
                                 aria-label="@(L["Common.LinkOpensNewTab", L["Questions.BaseText.Create"].Value].Value)"
                                 aria-describedby="question-base-text-create-help"
                                 id="question-base-text-create-link">
                            @L["Questions.BaseText.Create"]
                            <MudIcon Icon="@AppIcons.OpenInNew" aria-hidden="true" Style="width: 16px; height: 16px; vertical-align: text-bottom" />
                        </AppLink>
                        <p class="app-base-text-create-help" id="question-base-text-create-help">@L["Questions.BaseText.Create.Help"]</p>
                    </div>
                }
            </AppSectionCard>

            @* F-97, BR9: the section that edits the answer is the one the type declares. The options typed for
               single choice stay in the form while the other type is shown, and only the chosen type's are sent. *@
            @if (IsTrueFalse)
            {
                <AppSectionCard Id="question-section-true-false-key"
                                Title="@L["Questions.Section.TrueFalseKey"]"
                                Icon="@AppIcons.Verified"
                                Subtitle="@L["Questions.Section.TrueFalseKey.Subtitle"]">
                    @* F-101: the radio cards have no disabled state, so a frozen key is read as a value, as the type is. *@
                    @if (IsFrozen)
                    {
                        <div class="app-field mb-4">
                            <span class="app-field-label" id="question-true-false-key-label">@L["Questions.TrueFalseKey.Label"]</span>
                            <span class="app-field-value" id="question-true-false-key-value">@(_trueFalseKey == true ? L["Questions.TrueFalse.True"] : L["Questions.TrueFalse.False"])</span>
                        </div>
                    }
                    else
                    {
                        <AppRadioCards TValue="bool?"
                                       Id="question-true-false-key"
                                       Label="@L["Questions.TrueFalseKey.Label"]"
                                       Value="_trueFalseKey"
                                       ValueChanged="@((bool? value) => OnTrueFalseKeyChanged(value))"
                                       Options="TrueFalseCards"
                                       Columns="2"
                                       Hint="@L["Questions.TrueFalseKey.Hint"]"
                                       Error="@_trueFalseKeyError" />
                    }

                    @* F-98 BR5, AC16: the same reason field as the options section has. *@
                    @if (ShowChangeReason)
                    {
                        @ChangeReasonField
                    }
                </AppSectionCard>
            }
            else
            {
            <AppSectionCard Id="question-section-options"
                            Title="@L["Questions.Section.Options"]"
                            Icon="@AppIcons.Options"
                            Subtitle="@(IsMultiple ? L["Questions.Section.Options.Multiple.Subtitle"] : L["Questions.Section.Options.Subtitle"])">
                @* Single choice: the group's value is the position of the correct option, exactly one can be checked
                   (BR4) and a draft may have none (BR3). Multiple answer (F-104): one checkbox per option, any
                   marking is a draft; the publish rule is two or more correct and one wrong. *@
                @{
                    RenderFragment rows = @<AppItemRows TItem="OptionDraft"
                                 Items="_options"
                                 EmptyMessage="@L["Questions.Options.Empty"]"
                                 AriaLabelledBy="question-section-options-title">
                        <RowTemplate Context="option">
                            @{
                                var position = _options.IndexOf(option);
                                var letter = QuestionText.Letter(position);
                            }
                            <div class="app-option-row">
                                <span class="app-option-letter">@letter</span>
                                <span class="app-option-radio">
                                    @if (IsMultiple)
                                    {
                                        <AppCheckbox Id="@($"question-option-correct-{position}")"
                                                     Value="option.IsCorrect"
                                                     ValueChanged="@((bool value) => OnCorrectToggled(option, value))"
                                                     Disabled="IsFrozen">
                                            <span class="app-visually-hidden">@L["Questions.Options.MarkCorrect", letter]</span>
                                        </AppCheckbox>
                                    }
                                    else
                                    {
                                        <MudRadio T="int?" Value="@((int?)position)" Color="Color.Primary" Disabled="IsFrozen">
                                            <span class="app-visually-hidden">@L["Questions.Options.MarkCorrect", letter]</span>
                                        </MudRadio>
                                    }
                                </span>
                                <AppRichTextField Id="@OptionId(position)"
                                                  Label="@L["Questions.Options.Field", letter]"
                                                  LabelVisuallyHidden="true"
                                                  Placeholder="@L["Questions.Options.Field.Placeholder"]"
                                                  Compact="true"
                                                  Disabled="IsFrozen"
                                                  AutoFocus="@option.FocusOnRender"
                                                  Lang="@_contentLanguage"
                                                  Images="ImageOptions"
                                                  Value="@option.Html"
                                                  ValueChanged="@((string? value) => OnOptionChanged(option, value))"
                                                  Error="@option.Error" />
                            </div>
                        </RowTemplate>
                        <Actions Context="option">
                            @{
                                var index = _options.IndexOf(option);
                            }
                            @if (!IsFrozen)
                            {
                                <AppRowActions ItemName="@L["Questions.Options.Letter", QuestionText.Letter(index)]"
                                               IdPrefix="@ActionsId(index)"
                                               OnMoveUp="@(() => Move(index, -1))"
                                               MoveUpDisabledReason="@(index == 0 ? L["Questions.Options.MoveUp.DisabledFirst"].Value : null)"
                                               OnMoveDown="@(() => Move(index, 1))"
                                               MoveDownDisabledReason="@(index == _options.Count - 1 ? L["Questions.Options.MoveDown.DisabledLast"].Value : null)"
                                               OnDelete="@(() => Remove(index))" />
                            }
                        </Actions>
                    </AppItemRows>;
                }
                @if (IsMultiple)
                {
                    <div role="group"
                         aria-label="@L["Questions.Options.Correct.Multiple.Label"].Value"
                         aria-describedby="question-options-description">
                        @rows
                    </div>
                }
                else
                {
                    <MudRadioGroup T="int?"
                                   Value="CorrectPosition"
                                   ValueChanged="OnCorrectChanged"
                                   aria-label="@L["Questions.Options.Correct.Label"].Value"
                                   aria-describedby="question-options-description">
                        @rows
                    </MudRadioGroup>
                }

                @* A section-level refusal (count, key, or an option error the problem did not place) is under the list
                   and described to the group, so it is read with it. *@
                <span id="question-options-description" class="app-field-description">
                    @if (_optionsError is not null)
                    {
                        <span class="app-field-error-text" aria-live="polite">@_optionsError</span>
                    }
                </span>

                <div class="app-options-footer">
                    @if (IsFrozen)
                    {
                        @* F-101: frozen; no button, only the count below. *@
                    }
                    else if (AtMaxOptions)
                    {
                        <MudTooltip Text="@L["Questions.Options.Add.DisabledMax"].Value">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@AppIcons.Add"
                                       Disabled="true"
                                       id="@AddOptionId">@L["Questions.Options.Add"]</MudButton>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@AppIcons.Add"
                                   OnClick="AddOption"
                                   id="@AddOptionId">@L["Questions.Options.Add"]</MudButton>
                    }

                    @* The limit is never told by a tooltip alone: a disabled button is not focusable. *@
                    <span class="app-options-count">@L["Questions.Options.Count", _options.Count]</span>
                </div>

                <div class="app-visually-hidden" role="status" aria-live="polite">@_announcement</div>

                @* F-98 BR5, AC16: a published question whose key is changing says why; the reason goes with Save. *@
                @if (ShowChangeReason)
                {
                    @ChangeReasonField
                }
            </AppSectionCard>
            }

            <AppSectionCard Id="question-section-explanation"
                            Title="@L["Questions.Section.Explanation"]"
                            Icon="@AppIcons.Explanation"
                            Subtitle="@L["Questions.Section.Explanation.Subtitle"]">
                <AppRichTextField Id="question-explanation"
                                  Label="@L["Questions.Field.Explanation"]"
                                  Placeholder="@L["Questions.Field.Explanation.Placeholder"]"
                                  Hint="@L["Questions.Field.Explanation.Hint"]"
                                  Disabled="IsFrozen"
                                  Lang="@_contentLanguage"
                                  Value="@_explanation"
                                  ValueChanged="@((string? value) => OnExplanationChanged(value))"
                                  Error="@_explanationError" />
            </AppSectionCard>

            @* F-101 BR5: a frozen form has nothing to save; Cancel's job is the "Back" of the page header. *@
            @if (!IsFrozen)
            {
                <AppFormActions Saving="_saving"
                                HasChanges="HasChanges"
                                SaveText="@(IsTranscribing ? L["Questions.Transcribe.SaveAndContinue"].Value : null)"
                                OnSave="SaveAsync"
                                OnCancel="Cancel" />
            }
        </MudPaper>

        <AppFormAside Title="@L["Questions.Form.Aside.Title"]"
                      EmptyText="@L["Common.Summary.NotFilled"]"
                      Rows="AsideRows"
                      ChecklistTitle="@L["Questions.Form.Aside.Checklist"]"
                      DoneText="@L["Common.Checklist.Done"]"
                      PendingText="@L["Common.Checklist.Pending"]"
                      Checklist="AsideChecklist" />
    </div>

    @* Publication: outside the form. Save never publishes and Publish never saves (BR12); both act on what is
       stored, so a change that is not saved blocks Publish and the preview says it shows the saved version. *@
    @if (!IsTranscribing)
    {
    <MudPaper Class="app-form-card mt-4" Elevation="0">
        <AppSectionCard Id="question-section-publication"
                        Title="@L["Questions.Section.Publication"]"
                        Icon="@AppIcons.Publish"
                        Subtitle="@L["Questions.Section.Publication.Subtitle"]">
            @if (_saved is null)
            {
                <MudText Typo="Typo.body2">@L["Questions.Publication.SaveFirst"]</MudText>
            }
            else
            {
                @if (_publicationError is not null)
                {
                    <AppAlert Severity="Severity.Error" Text="@_publicationError" Class="mb-4" />
                }

                @* F-105 UC6: why the last review sent it back, while the latest entry is that rejection; the next send ends it. *@
                @if (LatestRejection is { } rejection)
                {
                    <div id="question-rejected-alert">
                        <AppAlert Severity="Severity.Info"
                                  Text="@L["Questions.Publication.Rejected", rejection.At.ToString("g", CultureInfo.CurrentCulture), rejection.Reason ?? string.Empty]"
                                  Class="mb-4" />
                    </div>
                }

                <div class="app-publication-row">
                    <AppStatusChip Text="@QuestionText.StatusName(L, _saved.Status)" Tone="QuestionText.StatusTone(_saved.Status)" />
                    <span>@PublicationText</span>
                </div>

                @* F-101 UC3: when and why it was annulled, from the version that recorded it. *@
                @if (IsAnnulled && _saved?.Annulment is { } annulment)
                {
                    <div class="app-publication-annulment">
                        <p id="question-annulment-date">@L["Questions.Annulment.Date", annulment.AnnulledAt.ToString("g", CultureInfo.CurrentCulture)]</p>
                        <p id="question-annulment-reason">@L["Questions.Annulment.Reason", annulment.Reason]</p>
                    </div>
                }

                <div class="app-publication-actions">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@AppIcons.View"
                               Disabled="_publishing"
                               OnClick="PreviewAsync"
                               id="@PreviewButtonId">@L["Questions.Action.Preview"]</MudButton>

                    @if (IsAnnulled)
                    {
                        @* F-101 BR6: the only way out of the frozen state; the reason is asked in a dialog. *@
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@AppIcons.Retry"
                                   OnClick="ReinstateAsync"
                                   id="question-reinstate">@L["Questions.Action.Reinstate"]</MudButton>
                    }
                    else if (IsInReview)
                    {
                        @* F-105 BR4: the way out for a curator; it asks no reason and no confirmation (it is reversible,
                           as Unpublish is). *@
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@(_publishing ? null : AppIcons.Withdraw)"
                                   Disabled="_publishing"
                                   OnClick="WithdrawAsync"
                                   id="question-withdraw">
                            @if (_publishing)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" aria-hidden="true" />
                            }
                            @L["Questions.Action.Withdraw"]
                        </MudButton>
                    }
                    else if (IsPublished)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@(_publishing ? null : AppIcons.Unpublish)"
                                   Disabled="_publishing"
                                   OnClick="UnpublishAsync"
                                   id="question-unpublish">
                            @if (_publishing)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" aria-hidden="true" />
                            }
                            @L["Questions.Action.Unpublish"]
                        </MudButton>

                        @* F-101 UC1: annulling acts on what is stored, so unsaved changes block it, with the reason said below. *@
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   StartIcon="@AppIcons.Archive"
                                   Disabled="@(_publishing || HasChanges)"
                                   OnClick="AnnulAsync"
                                   aria-describedby="@(HasChanges ? "question-annul-reason-hint" : null)"
                                   id="question-annul">@L["Questions.Action.Annul"]</MudButton>
                    }
                    else
                    {
                        @* F-105 UC1: a second way to publish, through a reviewer. It is disabled for the same reasons as
                           Publish, in the same order; the one visible reason below describes both buttons. *@
                        <MudTooltip Text="@(PublishDisabledReason ?? L["Questions.Action.SendForReview"].Value)">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@(_publishing ? null : AppIcons.Send)"
                                       Disabled="@(_publishing || PublishDisabledReason is not null)"
                                       OnClick="SubmitForReviewAsync"
                                       aria-describedby="@(PublishDisabledReason is null ? null : "question-publication-reason")"
                                       id="question-send-for-review">@L["Questions.Action.SendForReview"]</MudButton>
                        </MudTooltip>

                        <MudTooltip Text="@(PublishDisabledReason ?? L["Questions.Action.Publish"].Value)">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@(_publishing ? null : AppIcons.Publish)"
                                       Disabled="@(_publishing || PublishDisabledReason is not null)"
                                       OnClick="PublishAsync"
                                       aria-describedby="@(PublishDisabledReason is null ? null : "question-publication-reason")"
                                       id="question-publish">
                                @if (_publishing)
                                {
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" aria-hidden="true" />
                                }
                                @L["Questions.Action.Publish"]
                            </MudButton>
                        </MudTooltip>
                    }
                </div>

                @* The reason is visible text, not a tooltip alone: a disabled button is not focusable. *@
                @if (!IsPublished && !IsAnnulled && !IsInReview && PublishDisabledReason is not null)
                {
                    <p id="question-publication-reason" class="app-publication-reason">@PublishDisabledReason</p>
                }
                else if (IsPublished && HasChanges)
                {
                    <p id="question-annul-reason-hint" class="app-publication-reason">@L["Questions.Publication.Publish.DisabledUnsaved"]</p>
                }

                @* F-98 BR5, AC16: a draft whose publish would record a key change asks for the reason here, after
                   the Api refused the first click; the second click sends it. *@
                @if (!IsPublished && !IsAnnulled && !IsInReview && _publishReasonRequired)
                {
                    <div class="app-publication-change-reason">
                        <AppTextField TValue="string"
                                      Id="@PublishReasonId"
                                      Label="@L["Questions.ChangeReason.Label"]"
                                      Hint="@L["Questions.ChangeReason.Hint"]"
                                      Value="_publishReason"
                                      ValueChanged="@((string? value) => OnPublishReasonChanged(value))"
                                      Lines="3"
                                      MaxLength="QuestionLimits.ChangeReasonMaxLength"
                                      Required="true"
                                      Error="@_publishReasonError" />
                    </div>
                }
            }
        </AppSectionCard>
    </MudPaper>
    }

    @* F-105 UC6, BR7: every send, withdrawal, approval and rejection, newest first. No card while there is nothing
       to show, unless the entries failed to load: then the failure is shown, never silent. The person is stored and
       not shown (no contract resolves a name). *@
    @if (_saved is not null && !IsTranscribing && (_reviewsFailed || _reviews.Count > 0))
    {
        <MudPaper Class="app-form-card mt-4" Elevation="0">
            <AppSectionCard Id="question-section-review-history"
                            Title="@L["Questions.Section.ReviewHistory"]"
                            Icon="@AppIcons.Review"
                            Subtitle="@L["Questions.Section.ReviewHistory.Subtitle"]">
                @if (_reviewsFailed)
                {
                    <AppErrorState OnRetry="ReloadReviewsAsync" />
                }
                else
                {
                    <AppDataTable @ref="_reviewHistory"
                                  TItem="QuestionReviewEntryResponse"
                                  LoadAsync="LoadReviewHistoryAsync"
                                  Searchable="false"
                                  EmptyMessage="@L["Questions.History.Empty"]">
                        <Columns>
                            <TemplateColumn T="QuestionReviewEntryResponse" Title="@L["Questions.ReviewHistory.Column.Date"]" Sortable="false">
                                <CellTemplate>
                                    <span class="app-cell-nowrap">@context.Item.At.ToString("g", CultureInfo.CurrentCulture)</span>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn T="QuestionReviewEntryResponse" Title="@L["Questions.ReviewHistory.Column.Event"]" Sortable="false">
                                <CellTemplate>
                                    <AppStatusChip Text="@QuestionText.ReviewKindName(L, context.Item.Kind)" Tone="QuestionText.ReviewKindTone(context.Item.Kind)" />
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn T="QuestionReviewEntryResponse" Title="@L["Questions.ReviewHistory.Column.Reason"]" Sortable="false">
                                <CellTemplate>
                                    @if (string.IsNullOrWhiteSpace(context.Item.Reason))
                                    {
                                        <span aria-hidden="true">—</span>
                                        <span class="app-visually-hidden">@L["Questions.History.NoReason"]</span>
                                    }
                                    else
                                    {
                                        <AppTruncatedText Text="@context.Item.Reason" MaxWidth="24rem" />
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </AppDataTable>
                }
            </AppSectionCard>
        </MudPaper>
    }

    @* F-98 UC5, AC15: every version the question has had, newest first. A version opens read only in the preview
       dialog. The author is stored and not shown: no contract resolves a name. *@
    @if (_saved is not null)
    {
        <MudPaper Class="app-form-card mt-4" Elevation="0">
            <AppSectionCard Id="question-section-history"
                            Title="@L["Questions.Section.History"]"
                            Icon="@AppIcons.History"
                            Subtitle="@L["Questions.Section.History.Subtitle"]">
                @if (_historyError is not null)
                {
                    <AppAlert Severity="Severity.Error" Text="@_historyError" Class="mb-4" />
                }

                <AppDataTable @ref="_history"
                              TItem="QuestionVersionListItemResponse"
                              LoadAsync="LoadHistoryAsync"
                              Searchable="false"
                              EmptyMessage="@L["Questions.History.Empty"]">
                    <Columns>
                        <TemplateColumn T="QuestionVersionListItemResponse" Title="@L["Questions.History.Column.Version"]" Sortable="false">
                            <CellTemplate>
                                <span class="app-cell-nowrap">
                                    <span>@context.Item.Number.ToString(CultureInfo.CurrentCulture)</span>
                                    @if (context.Item.IsCurrent)
                                    {
                                        <AppStatusChip Text="@L["Questions.History.Current"]" Tone="AppStatusTone.Info" />
                                    }
                                </span>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="QuestionVersionListItemResponse" Title="@L["Questions.History.Column.Date"]" Sortable="false">
                            <CellTemplate>
                                <span class="app-cell-nowrap">@context.Item.CreatedAt.ToString("g", CultureInfo.CurrentCulture)</span>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="QuestionVersionListItemResponse" Title="@L["Questions.History.Column.Change"]" Sortable="false">
                            <CellTemplate>
                                <AppStatusChip Text="@ChangeLabel(context.Item)" Tone="ChangeTone(context.Item)" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="QuestionVersionListItemResponse" Title="@L["Questions.History.Column.Reason"]" Sortable="false">
                            <CellTemplate>
                                @if (string.IsNullOrWhiteSpace(context.Item.Reason))
                                {
                                    @* The dash is a symbol, not a word: a screen reader skips it and reads the hidden text instead. *@
                                    <span aria-hidden="true">—</span>
                                    <span class="app-visually-hidden">@L["Questions.History.NoReason"]</span>
                                }
                                else
                                {
                                    <AppTruncatedText Text="@context.Item.Reason" MaxWidth="24rem" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <RowActions>
                        <AppRowActions ItemName="@L["Questions.History.Row.Name", context.Number]"
                                       IdPrefix="@HistoryActionsId(context.Number)"
                                       MoreActions="@HistoryActions(context)" />
                    </RowActions>
                </AppDataTable>
            </AppSectionCard>
        </MudPaper>
    }
}

@code {
    private const string ErrorSummaryId = "question-error-summary";
    private const string AddOptionId = "question-option-add";
    private const string PreviewButtonId = "question-preview";
    private const string ChangeReasonId = "question-change-reason";
    private const string PublishReasonId = "question-publish-reason";

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>The question being edited; absent on /admin/questions/new.</summary>
    [Parameter] public Guid? Id { get; set; }

    /// <summary>The edition chosen on the new form when it opens from the edition page (F-96, "Add question").</summary>
    [SupplyParameterFromQuery(Name = "examEditionId")] public Guid? PreselectedEditionId { get; set; }

    private IReadOnlyList<BreadcrumbItem> _breadcrumbs = [];
    private QuestionResponse? _saved;
    private AppLookupOption? _subject;
    private AppLookupOption? _topic;
    private string? _contentLanguage;
    private int? _difficulty;
    private string _statement = string.Empty;
    private string _explanation = string.Empty;

    // F-102: the question links one base text or none. The language the link was made in is kept because the
    // option carries only an id and a title: a language change clears a text of another language (BR3, BR13).
    private AppLookupOption? _baseText;
    private string? _baseTextLanguage;
    private string? _baseTextCleared;
    private readonly Dictionary<Guid, string> _baseTextHtmls = [];
    private Guid? _baseTextPreviewRequested;
    private bool _baseTextPreviewFailed;
    private List<OptionDraft> _options = [];
    private QuestionType _type = QuestionType.SingleChoice;
    private bool? _trueFalseKey;
    private string? _trueFalseKeyError;

    // F-96: the origin. The number and the notice subject only exist with an edition (BR2).
    private AppLookupOption? _edition;
    private int? _paperNumber;
    private Guid? _noticeSubjectId;
    private IReadOnlyList<NoticeSubjectLookupResponse> _noticeSubjects = [];
    private bool _noticeSubjectsLoading;
    private string? _editionError;
    private string? _paperNumberError;
    private string? _noticeSubjectError;
    private Guid? _noticeSubjectsFor;
    private bool _preselected;

    private string? _topicError;
    private string? _languageError;
    private string? _difficultyError;
    private string? _statementError;
    private string? _baseTextError;
    private string? _optionsError;
    private string? _explanationError;
    private string? _error;
    private string? _publicationError;
    private string? _announcement;
    private string? _pendingFocus;

    // F-98: the reason of an answer key change, sent with Save (BR5), and the one a refused publish asks for.
    private string _changeReason = string.Empty;
    private string? _changeReasonError;
    private bool _changeReasonForced;
    private string _publishReason = string.Empty;
    private string? _publishReasonError;
    private bool _publishReasonRequired;
    private AppDataTable<QuestionVersionListItemResponse>? _history;
    private string? _historyError;

    // F-105 UC6: the review history, oldest first as the Api answers it; the card shows it newest first.
    private IReadOnlyList<QuestionReviewEntryResponse> _reviews = [];
    private bool _reviewsFailed;
    private AppDataTable<QuestionReviewEntryResponse>? _reviewHistory;

    private bool _loading;
    private bool _loadFailed;
    private bool _notFound;
    private bool _saving;
    private bool _publishing;
    private bool _showErrorSummary;

    private bool IsEdit => _saved is not null;

    private bool IsPublished => _saved?.Status == QuestionStatus.Published;

    // F-101 BR5: an annulled question is frozen; the fields, the options and Save give way to Reinstate.
    private bool IsAnnulled => _saved?.Status == QuestionStatus.Annulled;

    // F-105 BR3: a question in review is frozen too; the fields, the options and Save give way to Withdraw.
    private bool IsInReview => _saved?.Status == QuestionStatus.InReview;

    // One condition for both frozen states: the fields are read as values, the options cannot be added or removed.
    private bool IsFrozen => IsAnnulled || IsInReview;

    private string PublicationText =>
        IsAnnulled
            ? L["Questions.Publication.Annulled"]
            : IsInReview
                ? L["Questions.Publication.InReview", SubmittedAtText]
                : IsPublished ? L["Questions.Publication.Published"] : L["Questions.Publication.Draft"];

    private string SubmittedAtText =>
        _saved?.SubmittedAt?.ToString("g", CultureInfo.CurrentCulture) ?? string.Empty;

    // F-105 UC6: the rejection that sent the draft back, shown while it is the latest thing that happened.
    private QuestionReviewEntryResponse? LatestRejection =>
        _saved is { Status: QuestionStatus.Draft } && _reviews.Count > 0 && _reviews[^1].Kind == QuestionReviewKind.Rejected
            ? _reviews[^1]
            : null;

    private bool AtMaxOptions => _options.Count >= QuestionLimits.OptionsMax;

    private bool IsTrueFalse => _type == QuestionType.TrueFalse;

    private bool IsMultiple => _type == QuestionType.MultipleAnswer;

    private IReadOnlyList<AppRadioCardOption<QuestionType?>> TypeCards =>
    [
        new(QuestionType.SingleChoice, L["Questions.Type.SingleChoice"], L["Questions.Type.SingleChoice.Description"], AppIcons.Options),
        new(QuestionType.TrueFalse, L["Questions.Type.TrueFalse"], L["Questions.Type.TrueFalse.Description"], AppIcons.Verified),
        new(QuestionType.MultipleAnswer, L["Questions.Type.MultipleAnswer"], L["Questions.Type.MultipleAnswer.Description"], AppIcons.MultipleAnswer)
    ];

    private IReadOnlyList<AppRadioCardOption<bool?>> TrueFalseCards =>
    [
        new(true, L["Questions.TrueFalse.True"], string.Empty),
        new(false, L["Questions.TrueFalse.False"], string.Empty)
    ];

    // F-99: the transcription route opens this form with the edition locked and a batch counter (BR2, BR6).
    private bool IsTranscribing =>
        Id is null
        && Navigation.ToBaseRelativePath(Navigation.Uri)
            .StartsWith("admin/questions/transcribe", StringComparison.OrdinalIgnoreCase);

    private int _batchNumber = 1;
    private bool _transcribeSaved;
    private bool _transcribeEditionMissing;

    private string Title =>
        IsTranscribing
            ? L["Questions.Transcribe.Title"]
            : IsEdit || Id is not null ? L["Questions.Form.EditTitle"] : L["Questions.Form.AddTitle"];

    private static string OptionId(int position) => $"question-option-{position}";

    private static string ActionsId(int position) => $"question-option-actions-{position}";

    // A language is shown in its own name: it does not depend on the reader's UI language.
    private static IReadOnlyList<AppSelectOption<string>> LanguageOptions =>
        [.. SupportedCultures.All.Select(culture =>
            new AppSelectOption<string>(culture.Name, SupportedCultures.NativeName(culture), culture.Name))];

    private IReadOnlyList<AppSelectOption<int?>> DifficultyOptions =>
    [
        new(null, L["Questions.Difficulty.NotSet"]),
        .. Enumerable.Range(QuestionLimits.DifficultyMin, QuestionLimits.DifficultyMax - QuestionLimits.DifficultyMin + 1)
            .Select(value => new AppSelectOption<int?>(value, value.ToString(CultureInfo.CurrentCulture)))
    ];

    private int? CorrectPosition
    {
        get
        {
            var index = _options.FindIndex(option => option.IsCorrect);
            return index >= 0 ? index : null;
        }
    }

    // BR3 then BR4, in the order the aside lists them. The first three are also what a draft needs.
    private bool TopicDone => _topic is not null;

    private bool LanguageDone => !string.IsNullOrWhiteSpace(_contentLanguage);

    private bool StatementDone => !QuestionHtml.IsBlank(_statement);

    // F-104 BR4: a multiple-answer question is published with three to five options, not two to five.
    private bool OptionsCountDone =>
        _options.Count >= (IsMultiple ? QuestionLimits.MultipleAnswerOptionsMin : QuestionLimits.OptionsMin)
        && _options.Count <= QuestionLimits.OptionsMax;

    private bool OptionsTextDone => _options.Count > 0 && _options.All(option => !QuestionHtml.IsBlank(option.Html));

    // Single choice: exactly one correct. Multiple answer: two or more correct and at least one wrong (F-104 BR4).
    private bool KeyDone =>
        IsMultiple
            ? _options.Count(option => option.IsCorrect) is var correct
                && correct >= QuestionLimits.MultipleAnswerCorrectMin && correct < _options.Count
            : _options.Count(option => option.IsCorrect) == 1;

    // F-97: a true/false question has one key and no options, so the three option items are one.
    private bool TrueFalseKeyDone => _trueFalseKey is not null;

    private bool ChecklistComplete =>
        TopicDone && LanguageDone && StatementDone
        && (IsTrueFalse ? TrueFalseKeyDone : OptionsCountDone && OptionsTextDone && KeyDone);

    private IReadOnlyList<AppChecklistItem> AsideChecklist =>
    [
        new(L["Questions.Checklist.Topic"], TopicDone),
        new(L["Questions.Checklist.Language"], LanguageDone),
        new(L["Questions.Checklist.Statement"], StatementDone),
        .. IsTrueFalse
            ? [new AppChecklistItem(L["Questions.Checklist.TrueFalseKey"], TrueFalseKeyDone)]
            : new List<AppChecklistItem>
            {
                new(IsMultiple ? L["Questions.Checklist.OptionsCount.Multiple"] : L["Questions.Checklist.OptionsCount"], OptionsCountDone),
                new(L["Questions.Checklist.OptionsText"], OptionsTextDone),
                new(IsMultiple ? L["Questions.Checklist.Key.Multiple"] : L["Questions.Checklist.Key"], KeyDone)
            }
    ];

    private IReadOnlyList<AppAsideRow> AsideRows =>
    [
        new(L["Questions.Form.Aside.Status"], _saved is null ? null : QuestionText.StatusName(L, _saved.Status)),
        new(L["Questions.Field.Subject"], _subject?.Text),
        new(L["Questions.Field.Topic"], _topic?.Text),
        new(L["Questions.Field.ContentLanguage"], LanguageDone ? QuestionText.LanguageName(_contentLanguage!) : null),
        new(L["Questions.Field.Difficulty"], _difficulty?.ToString(CultureInfo.CurrentCulture)),
        new(L["Questions.Field.BaseText"], _baseText?.Text),
        new(L["Questions.Form.Aside.Source"], _edition is null ? L["Questions.Source.Authored"].Value : _edition.Text),
        IsTrueFalse
            ? new(L["Questions.Form.Aside.Type"], QuestionText.TypeName(L, _type))
            : new(L["Questions.Form.Aside.Options"], L["Questions.Options.Count", _options.Count].Value),
        .. IsMultiple ? [new AppAsideRow(L["Questions.Form.Aside.Type"], QuestionText.TypeName(L, _type))] : Array.Empty<AppAsideRow>()
    ];

    // The notice subject select: the group is part of the text, since the kit select has no group headings.
    private IReadOnlyList<AppSelectOption<Guid?>> NoticeSubjectOptions =>
    [
        new(null, L["Questions.NoticeSubject.None"]),
        .. _noticeSubjects.Select(subject => new AppSelectOption<Guid?>(
            subject.Id,
            string.IsNullOrWhiteSpace(subject.Group) ? subject.Label : $"{subject.Group} · {subject.Label}"))
    ];

    // The reason Publish is disabled, said in words. Unsaved changes come first: publishing acts on what is stored.
    private string? PublishDisabledReason =>
        HasChanges
            ? L["Questions.Publication.Publish.DisabledUnsaved"].Value
            : !ChecklistComplete
                ? L["Questions.Publication.Publish.DisabledIncomplete"].Value
                : null;

    // One line per field the Api or the form refused, in the order the form shows them.
    private IReadOnlyList<AppErrorSummaryItem> ErrorSummaryItems
    {
        get
        {
            List<AppErrorSummaryItem> items = [];
            AddIfRefused(items, _topicError, "question-topic", L["Questions.Field.Topic"]);
            AddIfRefused(items, _languageError, "question-content-language", L["Questions.Field.ContentLanguage"]);
            AddIfRefused(items, _difficultyError, "question-difficulty", L["Questions.Field.Difficulty"]);
            AddIfRefused(items, _editionError, "question-edition", L["Questions.Field.Edition"]);
            AddIfRefused(items, _paperNumberError, "question-paper-number", L["Questions.Field.PaperNumber"]);
            AddIfRefused(items, _noticeSubjectError, "question-notice-subject", L["Questions.Field.NoticeSubject"]);
            AddIfRefused(items, _statementError, "question-statement", L["Questions.Field.Statement"]);
            AddIfRefused(items, _baseTextError, "question-base-text", L["Questions.Field.BaseText"]);
            for (var index = 0; index < _options.Count; index++)
            {
                AddIfRefused(items, _options[index].Error, OptionId(index), L["Questions.Options.Field", QuestionText.Letter(index)]);
            }

            AddIfRefused(items, _optionsError, AddOptionId, L["Questions.Section.Options"]);
            AddIfRefused(items, _trueFalseKeyError, "question-true-false-key", L["Questions.TrueFalseKey.Label"]);
            AddIfRefused(items, _changeReasonError, ChangeReasonId, L["Questions.ChangeReason.Label"]);
            AddIfRefused(items, _explanationError, "question-explanation", L["Questions.Field.Explanation"]);
            return items;
        }
    }

    private static void AddIfRefused(List<AppErrorSummaryItem> items, string? error, string fieldId, string label)
    {
        if (error is not null)
        {
            items.Add(new AppErrorSummaryItem(fieldId, label));
        }
    }

    // What the form holds against what is stored. A new question is compared with an empty one.
    // F-99: in transcription mode the origin and the language are the session's, so only what is typed counts.
    private bool HasChanges =>
        _topic?.Id != _saved?.TopicId
        || (!IsTranscribing && (_contentLanguage ?? string.Empty) != (_saved?.ContentLanguage ?? DefaultLanguage))
        || _difficulty != _saved?.Difficulty
        || (!IsTranscribing && _edition?.Id != _saved?.Origin?.ExamEditionId)
        || (!IsTranscribing && _edition is not null && _paperNumber != _saved?.Origin?.PaperNumber)
        || (!IsTranscribing && _edition is not null && _noticeSubjectId != _saved?.Origin?.NoticeSubjectId)
        || Normalized(_statement) != Normalized(_saved?.StatementHtml)
        || (!IsTranscribing && _baseText?.Id != _saved?.BaseText?.Id)
        || Normalized(_explanation) != Normalized(_saved?.ExplanationHtml)
        || AnswerChanged();

    // The answer of the chosen type against what is stored; the other type's answer is not part of the question.
    private bool AnswerChanged() =>
        IsTrueFalse
            ? _saved is null || _trueFalseKey != _saved.TrueFalseKey
            : OptionsChanged();

    // F-98 BR4: the key of a published question differs from the stored one when the correct option moved (a
    // reorder counts) or the true/false value did. Version 1 and drafts never need a reason.
    private bool KeyChangeNeedsReason =>
        IsPublished
        && _saved is not null
        && (IsTrueFalse ? _trueFalseKey != _saved.TrueFalseKey : !CorrectPositions.SequenceEqual(StoredCorrectPositions));

    // F-104 BR7: the whole set of correct positions, so moving the second correct option counts as well.
    private IEnumerable<int> CorrectPositions =>
        _options.Select((option, index) => (option, index)).Where(pair => pair.option.IsCorrect).Select(pair => pair.index);

    private IEnumerable<int> StoredCorrectPositions =>
        (_saved?.Options.OrderBy(option => option.Position).ToList() ?? [])
            .Select((option, index) => (option, index)).Where(pair => pair.option.IsCorrect).Select(pair => pair.index);

    // The field also shows when the Api asked for a reason the form did not expect (the stored key moved meanwhile).
    private bool ShowChangeReason => KeyChangeNeedsReason || _changeReasonForced;

    private RenderFragment ChangeReasonField =>
        @<div class="app-change-reason">
            <AppTextField TValue="string"
                          Id="@ChangeReasonId"
                          Label="@L["Questions.ChangeReason.Label"]"
                          Hint="@L["Questions.ChangeReason.Hint"]"
                          Value="_changeReason"
                          ValueChanged="@((string? value) => OnChangeReasonChanged(value))"
                          Lines="3"
                          MaxLength="QuestionLimits.ChangeReasonMaxLength"
                          Required="true"
                          Error="@_changeReasonError" />
        </div>;

    private void OnChangeReasonChanged(string? value)
    {
        _changeReason = value ?? string.Empty;
        _changeReasonError = null;
    }

    private void OnPublishReasonChanged(string? value)
    {
        _publishReason = value ?? string.Empty;
        _publishReasonError = null;
    }

    // The comfort check of the reason (BR5); the Api is the authority and runs the same one.
    private string? ChangeReasonValidation()
    {
        if (!ShowChangeReason)
        {
            return null;
        }

        var reason = _changeReason.Trim();

        return reason.Length == 0
            ? Errors.For(QuestionBankErrorCodes.QuestionKeyChangeReasonRequired)
            : reason.Length > QuestionLimits.ChangeReasonMaxLength
                ? Errors.For(QuestionBankErrorCodes.QuestionChangeReasonTooLong)
                : null;
    }

    private string DefaultLanguage => QuestionText.DefaultContentLanguage();

    private static string Normalized(string? html) => QuestionHtml.IsBlank(html) ? string.Empty : html!;

    private bool OptionsChanged()
    {
        var stored = _saved?.Options.OrderBy(option => option.Position).ToList() ?? [];
        if (stored.Count != _options.Count)
        {
            return true;
        }

        for (var index = 0; index < stored.Count; index++)
        {
            if (stored[index].IsCorrect != _options[index].IsCorrect
                || Normalized(stored[index].TextHtml) != Normalized(_options[index].Html))
            {
                return true;
            }
        }

        return false;
    }

    protected override void OnInitialized() => _contentLanguage = DefaultLanguage;

    protected override async Task OnParametersSetAsync()
    {
        BuildBreadcrumbs();
        if (Id is not { } id)
        {
            await PreselectEditionAsync();
            return;
        }

        if (_saved?.Id == id)
        {
            return;
        }

        await LoadAsync(id);
    }

    // The edition page's "Add question" opens the new form with its edition already chosen (UC3). An edition that
    // cannot be read just leaves the field empty: the curator picks one, nothing breaks.
    private async Task PreselectEditionAsync()
    {
        if (IsTranscribing && PreselectedEditionId is null)
        {
            _transcribeEditionMissing = true;
            return;
        }

        if (PreselectedEditionId is not { } editionId || _edition is not null || _preselected)
        {
            return;
        }

        _preselected = true;
        var token = await TokenAsync();
        var result = token is null ? null : await Api.FindEditionAsync(token, editionId);
        if (result is { IsSuccess: true, Value: { } edition })
        {
            _edition = EditionOption(edition);
            await LoadNoticeSubjectsAsync(edition.Id);
            if (IsTranscribing)
            {
                _paperNumber = await NextPaperNumberAsync(token!, edition.Id);
            }
        }
        else if (IsTranscribing && result?.ErrorCode == QuestionBankErrorCodes.QuestionExamEditionNotFound)
        {
            _transcribeEditionMissing = true;
        }
    }

    // F-99 BR4: the suggestion is read from the Api after every save; a failed read leaves the number to the curator.
    private async Task<int?> NextPaperNumberAsync(string token, Guid editionId)
    {
        var next = await Api.GetNextPaperNumberAsync(token, editionId);

        return next is { IsSuccess: true, Value: { } value } ? value.PaperNumber : null;
    }

    // F-99 AC3: everything but the edition, the notice subject, the content language and (F-102 BR13) the chosen
    // base text is blank for the next one.
    private async Task ContinueTranscriptionAsync(Guid editionId)
    {
        _batchNumber++;
        _transcribeSaved = true;
        _saved = null;
        _topic = null;
        _subject = null;
        _difficulty = null;
        _statement = string.Empty;
        _explanation = string.Empty;
        _options = [];
        _type = QuestionType.SingleChoice;
        _trueFalseKey = null;
        _changeReason = string.Empty;
        _changeReasonForced = false;
        ClearErrors();

        var token = await TokenAsync();
        _paperNumber = token is null ? null : await NextPaperNumberAsync(token, editionId);
    }

    private string FinishHref =>
        PreselectedEditionId is { } editionId ? $"/admin/questions?edition={editionId}" : "/admin/questions";

    private void Finish() => Navigation.NavigateTo(FinishHref);

    private Task ReloadAsync() => Id is { } id ? LoadAsync(id) : Task.CompletedTask;

    private async Task LoadAsync(Guid id)
    {
        _loading = true;
        _loadFailed = false;
        _notFound = false;
        var token = await TokenAsync();
        var result = token is null ? null : await Api.FindQuestionAsync(token, id);
        _loading = false;

        if (result is { IsSuccess: true, Value: { } question })
        {
            Apply(question);
            BuildBreadcrumbs();
            await LoadNoticeSubjectsAsync(question.Origin?.ExamEditionId);
            await LoadReviewsAsync(question.Id);
            return;
        }

        // 404 is the answer "this question is not here"; anything else is a broken call the reader may retry.
        _notFound = result?.ErrorCode == QuestionBankErrorCodes.QuestionNotFound;
        _loadFailed = !_notFound;
    }

    // The form shows what was stored: the sanitized HTML replaces what the editors held (BR8).
    private void Apply(QuestionResponse question)
    {
        _saved = question;
        _type = question.Type;
        _trueFalseKey = question.TrueFalseKey;
        _subject = new AppLookupOption(question.SubjectId, question.SubjectName);
        _topic = new AppLookupOption(question.TopicId, question.TopicName);
        _contentLanguage = question.ContentLanguage;
        _difficulty = question.Difficulty;
        _edition = question.Origin is { } origin ? EditionOption(origin) : null;
        _paperNumber = question.Origin?.PaperNumber;
        _noticeSubjectId = question.Origin?.NoticeSubjectId;
        _statement = question.StatementHtml;
        _baseText = question.BaseText is { } linked ? new AppLookupOption(linked.Id, linked.Title) : null;
        _baseTextLanguage = question.BaseText is null ? null : question.ContentLanguage;
        _baseTextPreviewFailed = false;
        _explanation = question.ExplanationHtml ?? string.Empty;
        _options =
        [
            .. question.Options.OrderBy(option => option.Position)
                .Select(option => new OptionDraft { Html = option.TextHtml, IsCorrect = option.IsCorrect })
        ];
        // F-98: what was typed as a reason belonged to the save that just came back.
        _changeReason = string.Empty;
        _changeReasonForced = false;
        ClearErrors();
    }

    private void ClearErrors()
    {
        _changeReasonError = null;
        _topicError = _languageError = _difficultyError = _statementError = null;
        _baseTextError = _explanationError = _optionsError = _error = _trueFalseKeyError = null;
        _baseTextCleared = null;
        _editionError = _paperNumberError = _noticeSubjectError = null;
        _showErrorSummary = false;
        foreach (var option in _options)
        {
            option.Error = null;
        }
    }

    private void BuildBreadcrumbs() =>
        _breadcrumbs =
        [
            new BreadcrumbItem(L["Nav.Section.Content"], href: null, disabled: true),
            new BreadcrumbItem(L["Questions.Title"], href: ListHref),
            new BreadcrumbItem(Title, href: null, disabled: true)
        ];

    // -- history (F-98) ---------------------------------------------------------------------------------------

    private static string HistoryActionsId(int number) => $"question-version-actions-{number}";

    // F-101: an annulment and a reinstatement are told before the F-98 labels; they are never a key change.
    private string ChangeLabel(QuestionVersionListItemResponse version) =>
        version.Annulled
            ? L["Questions.History.Change.Annulled"]
            : version.Reinstated
                ? L["Questions.History.Change.Reinstated"]
                : version.Number == 1
                    ? L["Questions.History.Change.First"]
                    : version.AnswerKeyChanged
                        ? L["Questions.History.Change.KeyChanged"]
                        : L["Questions.History.Change.Edited"];

    // The annulment and the key change are the rows a reader must notice; the rest are plain labels.
    private static AppStatusTone ChangeTone(QuestionVersionListItemResponse version) =>
        version.Annulled
            ? AppStatusTone.Error
            : version.Number > 1 && version.AnswerKeyChanged ? AppStatusTone.Warning : AppStatusTone.Neutral;

    private IReadOnlyList<AppRowAction> HistoryActions(QuestionVersionListItemResponse version) =>
    [
        new AppRowAction(L["Questions.History.Action.View"], AppIcons.View, () => ViewVersionAsync(version), Key: "view")
    ];

    // A question has few versions: the Api answers all of them and the table pages them here.
    private async Task<AppTablePage<QuestionVersionListItemResponse>> LoadHistoryAsync(
        AppTableQuery query,
        CancellationToken cancellationToken)
    {
        var token = await TokenAsync() ?? throw new InvalidOperationException("No session.");
        var result = await Api.ListVersionsAsync(token, _saved!.Id, cancellationToken);
        if (!result.IsSuccess)
        {
            throw new InvalidOperationException($"Versions failed to load: {result.ErrorCode}.");
        }

        var all = result.Value!;

        return new AppTablePage<QuestionVersionListItemResponse>(
            [.. all.Skip(query.Page * query.PageSize).Take(query.PageSize)],
            all.Count);
    }

    private Task ReloadHistoryAsync() => _history is null ? Task.CompletedTask : _history.ReloadAsync();

    // -- review history (F-105) -------------------------------------------------------------------------------

    // Read with the question and after every send and withdrawal. A failure is kept and shown in the card (never
    // silent); the rejected alert and the "waiting since" time then fall back to what the question itself carries.
    private async Task LoadReviewsAsync(Guid questionId)
    {
        var token = await TokenAsync();
        var result = token is null ? null : await Api.ListReviewsAsync(token, questionId);
        _reviewsFailed = result is not { IsSuccess: true };
        _reviews = result is { IsSuccess: true, Value: { } entries } ? entries : [];
        if (_reviewHistory is not null)
        {
            await _reviewHistory.ReloadAsync();
        }
    }

    private Task ReloadReviewsAsync() => _saved is { } current ? LoadReviewsAsync(current.Id) : Task.CompletedTask;

    // The entries are all in memory (a question has few): the table pages them here, newest first.
    private Task<AppTablePage<QuestionReviewEntryResponse>> LoadReviewHistoryAsync(
        AppTableQuery query,
        CancellationToken cancellationToken)
    {
        var newestFirst = _reviews.Reverse().ToList();

        return Task.FromResult(new AppTablePage<QuestionReviewEntryResponse>(
            [.. newestFirst.Skip(query.Page * query.PageSize).Take(query.PageSize)],
            newestFirst.Count));
    }

    // UC5: the version opens in the preview dialog, read only, from what was recorded then.
    private async Task ViewVersionAsync(QuestionVersionListItemResponse row)
    {
        if (_saved is not { } current)
        {
            return;
        }

        var token = await TokenAsync();
        var result = token is null ? null : await Api.GetVersionAsync(token, current.Id, row.Number);
        if (result is not { IsSuccess: true, Value: { } version })
        {
            // The refusal belongs to the History card the curator acted in, not to the Publication card.
            _historyError = Errors.For(result?.ErrorCode);

            // The row button calls this delegate itself, not an EventCallback of the page: say it changed.
            await InvokeAsync(StateHasChanged);
            return;
        }

        _historyError = null;

        // The dialog draws a question: the version fills its content and the question's catalog data stays as
        // it is (it is not part of a version, BR1).
        var asQuestion = new QuestionResponse(
            version.QuestionId,
            version.Type,
            QuestionStatus.Published,
            current.TopicId,
            current.TopicName,
            current.SubjectId,
            current.SubjectName,
            version.ContentLanguage,
            version.StatementHtml,
            null,
            version.ExplanationHtml,
            current.Difficulty,
            version.Options,
            TrueFalseKey: version.TrueFalseKey,
            CurrentVersion: version.Number);
        var parameters = new DialogParameters<QuestionPreviewDialog>
        {
            { dialog => dialog.Question, asQuestion },
            { dialog => dialog.VersionRecordedAt, version.CreatedAt },
            // A version records the base text HTML and no id (F-98 BR1): it travels apart from the question.
            { dialog => dialog.VersionBaseTextHtml, version.BaseTextHtml }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };

        var reference = await Dialogs.ShowAsync<QuestionPreviewDialog>(
            L["Questions.History.Version.Title", version.Number], parameters, options);
        await reference.Result;

        _pendingFocus = $"{HistoryActionsId(row.Number)}-view";
        StateHasChanged();
    }

    // -- classification ---------------------------------------------------------------------------------------

    private async Task<IReadOnlyList<AppLookupOption>> SearchSubjectsAsync(string term, CancellationToken cancellationToken)
    {
        var token = await TokenAsync() ?? throw new InvalidOperationException("No session.");
        var result = await Api.SearchSubjectsAsync(token, term, cancellationToken);

        if (!result.IsSuccess)
        {
            throw new InvalidOperationException($"Subjects failed to load: {result.ErrorCode}.");
        }

        return [.. result.Value!.Select(subject => new AppLookupOption(subject.Id, subject.Name))];
    }

    // A subject has a short topic list: the Api answers all of it and the term narrows it here, ignoring case and accents.
    private async Task<IReadOnlyList<AppLookupOption>> SearchTopicsAsync(string term, CancellationToken cancellationToken)
    {
        if (_subject is not { } subject)
        {
            return [];
        }

        var token = await TokenAsync() ?? throw new InvalidOperationException("No session.");
        var result = await Api.ListTopicsAsync(token, subject.Id, cancellationToken);
        if (!result.IsSuccess)
        {
            throw new InvalidOperationException($"Topics failed to load: {result.ErrorCode}.");
        }

        var wanted = AppSuggestField.Normalize(term);
        return
        [
            .. result.Value!
                .Where(topic => wanted.Length == 0 || AppSuggestField.Normalize(topic.Name).Contains(wanted, StringComparison.Ordinal))
                .Select(topic => new AppLookupOption(topic.Id, topic.Name))
                .Take(AppLookupField.MaxCandidates)
        ];
    }

    // Changing or clearing the subject clears the topic: a topic belongs to one subject.
    private void OnSubjectChanged(AppLookupOption? value)
    {
        if (value?.Id != _subject?.Id)
        {
            _topic = null;
            _topicError = null;
        }

        _subject = value;
    }

    private void OnTopicChanged(AppLookupOption? value)
    {
        _topic = value;
        _topicError = TopicError();
    }

    private void OnContentLanguageChanged(string? value)
    {
        _contentLanguage = value;
        _languageError = null;

        // F-102 BR3 and BR13: a question and its base text share one language, so a text of the old language is
        // unlinked here and the reader is told, instead of meeting a 409 on save.
        if (_baseText is { } linked
            && !string.Equals(_baseTextLanguage, value, StringComparison.OrdinalIgnoreCase))
        {
            _baseTextCleared = L[
                "Questions.BaseText.Cleared",
                linked.Text,
                QuestionText.LanguageName(_baseTextLanguage ?? string.Empty),
                QuestionText.LanguageName(value ?? string.Empty)].Value;
            _baseText = null;
            _baseTextLanguage = null;
            _baseTextError = null;
        }
    }

    private void OnDifficultyChanged(int? value)
    {
        _difficulty = value;
        _difficultyError = null;
    }

    // F-97 BR2: the type is a choice of a new question. The answers typed for the other type are kept, so a
    // curator who picks the wrong card loses nothing, and only the chosen type's are sent.
    private void OnTypeChanged(QuestionType? value)
    {
        if (value is not { } type || IsEdit)
        {
            return;
        }

        _type = type;
        _optionsError = null;
        _trueFalseKeyError = null;

        // F-104: single choice has one correct option, so going back to it keeps the first mark only.
        if (type == QuestionType.SingleChoice && _options.Count(option => option.IsCorrect) > 1)
        {
            OnCorrectChanged(CorrectPosition);
        }
    }

    private void OnTrueFalseKeyChanged(bool? value)
    {
        _trueFalseKey = value;
        _trueFalseKeyError = null;
    }

