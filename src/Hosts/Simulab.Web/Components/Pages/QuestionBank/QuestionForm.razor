    private string CreateBaseTextHref =>
        $"/admin/base-texts/new?language={Uri.EscapeDataString(_contentLanguage ?? DefaultLanguage)}";

    // In transcription the choice stays across saves, and the hint says so (BR13).
    private string BaseTextHint =>
        IsTranscribing && _baseText is not null
            ? L["Questions.BaseText.Kept"].Value
            : L["Questions.Field.BaseText.Hint", QuestionText.LanguageName(_contentLanguage ?? DefaultLanguage)].Value;

    // Only the texts in the question's language are offered; the term narrows by title on the server (BR3, BR11).
    private async Task<IReadOnlyList<AppLookupOption>> SearchBaseTextsAsync(string term, CancellationToken cancellationToken)
    {
        var token = await TokenAsync() ?? throw new InvalidOperationException("No session.");
        var result = await Api.ListBaseTextsAsync(
