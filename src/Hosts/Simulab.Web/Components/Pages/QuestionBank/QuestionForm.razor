    private void OnExplanationChanged(string? value)
    {
        _explanation = value ?? string.Empty;
        _explanationError = ExplanationError();
    }

    private void OnOptionChanged(OptionDraft option, string? value)
    {
        option.Html = value ?? string.Empty;
        option.Error = OptionError(option, required: IsPublished);
        _optionsError = null;
    }

    // -- the options ------------------------------------------------------------------------------------------

    private void OnCorrectChanged(int? position)
    {
        for (var index = 0; index < _options.Count; index++)
        {
            _options[index].IsCorrect = index == position;
        }

        _optionsError = null;
    }

    // F-104: a checkbox changes only its own option; the others keep their marks.
    private void OnCorrectToggled(OptionDraft option, bool value)
    {
        option.IsCorrect = value;
        _optionsError = null;
    }

    private void AddOption()
    {
        if (AtMaxOptions)
        {
            return;
        }

        // Only the row added now takes the focus once its editor is ready.
        foreach (var existing in _options)
        {
            existing.FocusOnRender = false;
        }

        _options.Add(new OptionDraft { FocusOnRender = true });
        _optionsError = null;
        _announcement = null;
    }

    // A move is client-side: the order is sent with Save. The focus stays on the pressed button, or on its pair
    // when the move made it disabled (the NoticeSubjectsSection rule).
    private void Move(int index, int direction)
    {
        var target = index + direction;
        if (target < 0 || target >= _options.Count)
        {
            return;
        }

        (_options[index], _options[target]) = (_options[target], _options[index]);
        _announcement = L["Questions.Options.Moved", target + 1, _options.Count];

        var pressedStillEnabled = direction < 0 ? target > 0 : target < _options.Count - 1;
        var key = (direction < 0) == pressedStillEnabled ? AppRowActions.MoveUpKey : AppRowActions.MoveDownKey;
        _pendingFocus = $"{ActionsId(target)}-{key}";
    }

    // No confirmation: nothing is saved until Save, and leaving the page without saving discards the change.
    private void Remove(int index)
    {
        if (index < 0 || index >= _options.Count)
        {
            return;
        }

        _options.RemoveAt(index);
        _optionsError = null;
        _announcement = L["Questions.Options.Removed", _options.Count];
        _pendingFocus = index < _options.Count ? $"{ActionsId(index)}-{AppRowActions.DeleteKey}" : AddOptionId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocus is not { } target)
        {
            return;
        }

        _pendingFocus = null;
        await JS.InvokeVoidAsync("simulabShell.focusElement", target);
    }

    // -- comfort checks: the Api is the authority and runs the same ones (rule: ui-project) --------------------

    private string? TopicError() =>
        _topic is null ? L["Questions.Field.Topic.Required"].Value : null;

    private string? StatementError() =>
        QuestionHtml.IsBlank(_statement)
            ? Errors.For(QuestionBankErrorCodes.QuestionStatementRequired)
            : _statement.Length > QuestionLimits.StatementMaxLength
                ? Errors.For(QuestionBankErrorCodes.QuestionStatementTooLong)
                : null;

    // BR2: an edition needs a whole number from 1 to 500. Without an edition there is nothing to check.
    private string? PaperNumberError() =>
        _edition is null
            ? null
            : _paperNumber is not { } number
                ? Errors.For(QuestionBankErrorCodes.QuestionPaperNumberRequired)
                : number < QuestionLimits.PaperNumberMin || number > QuestionLimits.PaperNumberMax
                    ? Errors.For(QuestionBankErrorCodes.QuestionPaperNumberInvalid)
                    : null;

    private string? ExplanationError() =>
        _explanation.Length > QuestionLimits.ExplanationMaxLength
            ? Errors.For(QuestionBankErrorCodes.QuestionExplanationTooLong)
            : null;

    private string? OptionError(OptionDraft option, bool required) =>
        option.Html.Length > QuestionLimits.OptionMaxLength
            ? Errors.For(QuestionBankErrorCodes.QuestionOptionTooLong)
            : required && QuestionHtml.IsBlank(option.Html)
                ? Errors.For(QuestionBankErrorCodes.QuestionOptionTextRequired)
                : null;

    // The section-level rule of a published question (BR4): a count, then the key.
    private string? PublishedOptionsError()
    {
        if (!OptionsCountDone)
        {
            return Errors.For(IsMultiple
                ? QuestionBankErrorCodes.QuestionMultipleOptionsCount
                : QuestionBankErrorCodes.QuestionOptionsCount);
        }

        return KeyDone
            ? null
            : Errors.For(IsMultiple ? QuestionBankErrorCodes.QuestionMultipleKeyInvalid : QuestionBankErrorCodes.QuestionKeyInvalid);
    }

    // -- save -------------------------------------------------------------------------------------------------

    private async Task SaveAsync()
    {
        var published = IsPublished;

        _topicError = TopicError();
        _languageError = LanguageDone ? null : Errors.For(QuestionBankErrorCodes.QuestionContentLanguageInvalid);
        _difficultyError = null;
        _editionError = null;
        _paperNumberError = PaperNumberError();
        _noticeSubjectError = null;
        _statementError = StatementError();
        _baseTextError = null;
        _explanationError = ExplanationError();
        // F-97: only the answer of the chosen type is judged; the other type's stays in the form, unsent.
        foreach (var option in _options)
        {
            option.Error = IsTrueFalse ? null : OptionError(option, required: published);
        }

        _optionsError = published && !IsTrueFalse ? PublishedOptionsError() : null;
        _trueFalseKeyError = published && IsTrueFalse && !TrueFalseKeyDone
            ? Errors.For(QuestionBankErrorCodes.QuestionTrueFalseKeyRequired)
            : null;
        _changeReasonError = ChangeReasonValidation();

        if (HasClientRefusal())
        {
            // The summary lists every refused field at once and takes the focus, so the reader does not hunt.
            _showErrorSummary = true;
            await JS.InvokeVoidAsync("simulabShell.focusElement", ErrorSummaryId);
            return;
        }

        _showErrorSummary = false;
        _saving = true;
        _error = null;
        _transcribeSaved = false;

        var token = await TokenAsync();
        var request = new SaveQuestionRequest(
            _topic!.Id,
            _contentLanguage,
            _statement,
            _baseText?.Id,
            QuestionHtml.NullIfBlank(_explanation),
            _difficulty,
            IsTrueFalse
                ? []
                : [.. _options.Select(option => new SaveQuestionOptionRequest(QuestionHtml.NullIfBlank(option.Html), option.IsCorrect))],
            _edition?.Id,
            _edition is null ? null : _paperNumber,
            _edition is null ? null : _noticeSubjectId,
            _type,
            IsTrueFalse ? _trueFalseKey : null,
            ShowChangeReason ? QuestionHtml.NullIfBlank(_changeReason.Trim()) : null);

        var result = token is null
            ? QuestionBankResult.Failed<QuestionResponse>(ErrorText.UnexpectedCode)
            : IsEdit
                ? await Api.UpdateQuestionAsync(token, _saved!.Id, request)
                : await Api.CreateQuestionAsync(token, request);

        _saving = false;
        if (result is { IsSuccess: true } && IsTranscribing && !IsEdit && _edition is { } locked)
        {
            // F-99 AC3: the question is stored as the regular form stores it; the form stays for the next one.
            await ContinueTranscriptionAsync(locked.Id);
            return;
        }

        if (result is { IsSuccess: true, Value: { } question })
        {
            var wasAdd = !IsEdit;
            Apply(question);
            _publicationError = null;
            BuildBreadcrumbs();
            await LoadNoticeSubjectsAsync(question.Origin?.ExamEditionId);
            Snackbar.Add(L["Questions.Saved"], Severity.Success);
            await ReloadHistoryAsync();
            if (wasAdd)
            {
                // The page stays open as the edit form of the question that was just saved: previewing and
                // publishing it are the usual next steps. The render comes first: the NavigationLock of the form
                // actions reads HasChanges from the last render and would otherwise ask to discard what was
                // just saved (F-35).
                StateHasChanged();
                await Task.Yield();
                Navigation.NavigateTo($"/admin/questions/{question.Id}{QuestionListQueryString.Carried(Navigation.Uri)}", replace: true);
            }

            return;
        }

        await ShowRefusalAsync(result);
    }

    private bool HasClientRefusal() =>
        _topicError is not null || _languageError is not null || _statementError is not null
        || _paperNumberError is not null || _explanationError is not null || _optionsError is not null
        || _trueFalseKeyError is not null || _changeReasonError is not null
        || _options.Any(option => option.Error is not null);

    // A refusal belongs to the field that caused it, so the reader sees where to change something (BR16).
    private async Task ShowRefusalAsync(QuestionBankResult<QuestionResponse> result)
    {
        var code = result.ErrorCode;
        var text = Errors.For(code);
        var fieldRefused = true;

        switch (code)
        {
            case QuestionBankErrorCodes.QuestionStatementRequired:
            case QuestionBankErrorCodes.QuestionStatementTooLong:
                _statementError = text;
                break;
            case QuestionBankErrorCodes.QuestionBaseTextNotFound:
                // F-102 BR7: the text was deleted since it was picked: the choice goes, so the reader picks again.
                _baseText = null;
                _baseTextLanguage = null;
                _baseTextError = text;
                break;
            case QuestionBankErrorCodes.QuestionBaseTextLanguageMismatch:
                // The choice stays, so the reader sees which text was refused.
                _baseTextError = text;
                break;
            case QuestionBankErrorCodes.QuestionExplanationTooLong:
                _explanationError = text;
                break;
            case QuestionBankErrorCodes.QuestionOptionTextRequired:
            case QuestionBankErrorCodes.QuestionOptionTooLong:
                // The problem names the option when it can; otherwise the section says it (decision of 2026-10-10).
                if (result.OptionPosition is { } position && position >= 0 && position < _options.Count)
                {
                    _options[position].Error = text;
                }
                else
                {
                    _optionsError = text;
                }

                break;
            case QuestionBankErrorCodes.QuestionOptionsCount:
            case QuestionBankErrorCodes.QuestionKeyInvalid:
            case QuestionBankErrorCodes.QuestionMultipleOptionsCount:
            case QuestionBankErrorCodes.QuestionMultipleKeyInvalid:
                _optionsError = text;
                break;
            case QuestionBankErrorCodes.QuestionTrueFalseKeyRequired:
                _trueFalseKeyError = text;
                break;
            case QuestionBankErrorCodes.QuestionKeyChangeReasonRequired:
            case QuestionBankErrorCodes.QuestionChangeReasonTooLong:
                // F-98: the field is shown even when the form did not expect to need it (the key moved meanwhile).
                _changeReasonForced = true;
                _changeReasonError = text;
                break;
            case QuestionBankErrorCodes.QuestionVersionConflict:
                // BR10: another save recorded the next version first; the curator reloads and tries again.
                _error = text;
                fieldRefused = false;
                break;
            case QuestionBankErrorCodes.QuestionDifficultyInvalid:
                _difficultyError = text;
                break;
            case QuestionBankErrorCodes.QuestionContentLanguageInvalid:
                _languageError = text;
                break;
            case QuestionBankErrorCodes.QuestionExamEditionNotFound:
                // The edition left the catalog since it was picked: clear it and the fields that hung from it.
                _edition = null;
                _paperNumber = null;
                _noticeSubjectId = null;
                _noticeSubjects = [];
                _noticeSubjectsFor = null;
                _editionError = text;
                break;
            case QuestionBankErrorCodes.QuestionNoticeSubjectNotFound:
                _noticeSubjectId = null;
                _noticeSubjectError = text;
                break;
            case QuestionBankErrorCodes.QuestionPaperNumberRequired:
            case QuestionBankErrorCodes.QuestionPaperNumberInvalid:
            case QuestionBankErrorCodes.QuestionOriginRequiresEdition:
            case QuestionBankErrorCodes.QuestionPaperNumberTaken:
                _paperNumberError = text;
                break;
            case QuestionBankErrorCodes.QuestionTopicNotFound:
                // The topic left the catalog since it was picked: clear it and make the reader choose again.
                _topic = null;
                _topicError = L["Questions.Field.Topic.Required"].Value;
                _error = text;
                break;
            default:
                _error = text;
                fieldRefused = false;
                break;
        }

        if (fieldRefused)
        {
            _showErrorSummary = true;
            await JS.InvokeVoidAsync("simulabShell.focusElement", ErrorSummaryId);
        }
    }

    // F-100 AC9: the list's own keys came with the address the form was opened on; they go back with the curator.
    private string ListHref => "/admin/questions" + QuestionListQueryString.Carried(Navigation.Uri);

    private void Cancel() => Navigation.NavigateTo(ListHref);

    // -- publication and preview -------------------------------------------------------------------------------

    private Task PublishAsync() => SetPublicationAsync(publish: true);

    private Task UnpublishAsync() => SetPublicationAsync(publish: false);

    // BR12: only the status changes. The form keeps what the reader has typed; the stored content is the same,
    // so the saved question is replaced without touching the fields.
    private async Task SetPublicationAsync(bool publish)
    {
        if (_saved is not { } current)
        {
            return;
        }

        _publicationError = null;
        _publishReasonError = null;
        _publishing = true;

        // F-98 BR5: the reason goes along only once the Api asked for it (the field is visible then).
        var reason = _publishReasonRequired ? QuestionHtml.NullIfBlank(_publishReason.Trim()) : null;
        var token = await TokenAsync();
        var result = token is null
            ? QuestionBankResult.Failed<QuestionResponse>(ErrorText.UnexpectedCode)
            : publish
                ? await Api.PublishQuestionAsync(token, current.Id, reason)
                : await Api.UnpublishQuestionAsync(token, current.Id);

        _publishing = false;
        if (result is { IsSuccess: true, Value: { } question })
        {
            _saved = question;
            _publishReason = string.Empty;
            _publishReasonRequired = false;
            Snackbar.Add(publish ? L["Questions.Published"] : L["Questions.Unpublished"], Severity.Success);
            await ReloadHistoryAsync();
            return;
        }

        // F-98 BR5, AC16: the key differs from the latest version's and no reason (or an over-long one) came:
        // the card shows the field, focused, and the second click sends it.
        if (result.ErrorCode is QuestionBankErrorCodes.QuestionKeyChangeReasonRequired
            or QuestionBankErrorCodes.QuestionChangeReasonTooLong)
        {
            _publishReasonRequired = true;
            _publishReasonError = Errors.For(result.ErrorCode);
            _pendingFocus = PublishReasonId;
            return;
        }

        // 400 while incomplete (BR4), 409 when it is already in that state, 404 when it is gone.
        _publicationError = Errors.For(result.ErrorCode);
    }

    private Task SubmitForReviewAsync() => ChangeReviewAsync(submit: true);

    private Task WithdrawAsync() => ChangeReviewAsync(submit: false);

    // F-105 UC1 and UC2: a send acts on what is stored, as Publish does, and a withdrawal asks no reason. The card
    // switches to the new state and the history is read again; a refusal is shown in the card's own alert.
    private async Task ChangeReviewAsync(bool submit)
    {
        if (_saved is not { } current)
        {
            return;
        }

        _publicationError = null;
        _publishing = true;

        var token = await TokenAsync();
        var result = token is null
            ? QuestionBankResult.Failed<QuestionResponse>(ErrorText.UnexpectedCode)
            : submit
                ? await Api.SubmitQuestionAsync(token, current.Id)
                : await Api.WithdrawQuestionAsync(token, current.Id);

        _publishing = false;
        if (result is { IsSuccess: true, Value: { } question })
        {
            _saved = question;
            _publishReason = string.Empty;
            _publishReasonRequired = false;
            Snackbar.Add(submit ? L["Questions.SentForReview"] : L["Questions.Withdrawn"], Severity.Success);
            await LoadReviewsAsync(question.Id);
            await ReloadHistoryAsync();
            _pendingFocus = PreviewButtonId;
            return;
        }

        // 400 while incomplete, 409 when it is in another state (decided or withdrawn meanwhile), 404 when gone.
        _publicationError = Errors.For(result.ErrorCode);
        if (!submit && result.ErrorCode is QuestionBankErrorCodes.QuestionNotInReview or QuestionBankErrorCodes.QuestionVersionConflict)
        {
            await ReloadAfterRaceAsync(current.Id);
        }
    }

    // The question changed under the page (a reviewer decided meanwhile): read it again so the card tells the truth.
    private async Task ReloadAfterRaceAsync(Guid id)
    {
        var token = await TokenAsync();
        var result = token is null ? null : await Api.FindQuestionAsync(token, id);
        if (result is { IsSuccess: true, Value: { } question })
        {
            Apply(question);
            await LoadReviewsAsync(id);
            await ReloadHistoryAsync();
        }
    }

    private Task AnnulAsync() => ChangeAnnulmentAsync(annul: true);

    private Task ReinstateAsync() => ChangeAnnulmentAsync(annul: false);

    // F-101 UC1 and UC2: the reason is asked in a dialog that sends it itself, so a refusal of the Api is read
    // where the curator is typing; only an accepted change closes it. The form keeps what was typed.
    private async Task ChangeAnnulmentAsync(bool annul)
    {
        if (_saved is not { } current)
        {
            return;
        }

        _publicationError = null;
        QuestionResponse? changed = null;
        Task<string?>? inFlight = null;

        // The dialog may be closed (Esc, backdrop) while the call is still running; the answer of that call is
        // awaited below, so a change the Api made is never lost to the screen (review finding 1).
        Task<string?> Send(string reason) => inFlight = SubmitAsync(reason);

        async Task<string?> SubmitAsync(string reason)
        {
            var token = await TokenAsync();
            var result = token is null
                ? QuestionBankResult.Failed<QuestionResponse>(ErrorText.UnexpectedCode)
                : annul
                    ? await Api.AnnulQuestionAsync(token, current.Id, reason)
                    : await Api.ReinstateQuestionAsync(token, current.Id, reason);
            if (result is { IsSuccess: true, Value: { } question })
            {
                changed = question;

                return null;
            }

            return result.ErrorCode ?? ErrorText.UnexpectedCode;
        }

        var parameters = new DialogParameters<QuestionStatusReasonDialog>
        {
            { dialog => dialog.Message, annul ? L["Questions.Annul.Dialog.Message"].Value : L["Questions.Reinstate.Dialog.Message"].Value },
            { dialog => dialog.ConfirmText, annul ? L["Questions.Action.Annul"].Value : L["Questions.Action.Reinstate"].Value },
            { dialog => dialog.Destructive, annul },
            { dialog => dialog.Submit, Send }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

        var reference = await Dialogs.ShowAsync<QuestionStatusReasonDialog>(
            annul ? L["Questions.Annul.Dialog.Title"] : L["Questions.Reinstate.Dialog.Title"], parameters, options);
        await reference.Result;
        if (inFlight is not null)
        {
            await inFlight;
        }

        if (changed is { } question)
        {
            _saved = question;
            Snackbar.Add(annul ? L["Questions.Annulled"] : L["Questions.Reinstated"], Severity.Success);
            await ReloadHistoryAsync();
        }

        // Closed: the focus goes back to the button that opened the dialog, or to Preview when that one is gone.
        _pendingFocus = changed is null ? (annul ? "question-annul" : "question-reinstate") : PreviewButtonId;
        StateHasChanged();
    }

    private async Task PreviewAsync()
    {
        if (_saved is not { } question)
        {
            return;
        }

        var parameters = new DialogParameters<QuestionPreviewDialog>
        {
            { dialog => dialog.Question, question },
            { dialog => dialog.UnsavedChanges, HasChanges }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };

        var reference = await Dialogs.ShowAsync<QuestionPreviewDialog>(L["Questions.Preview.Title"], parameters, options);
        await reference.Result;

        // Closed: the focus goes back to the button that opened it.
        _pendingFocus = PreviewButtonId;
        StateHasChanged();
    }

    // B-3: through the accessor, which refreshes the token; never from the cookie.
    private async Task<string?> TokenAsync()
    {
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        return user is null ? null : await Tokens.GetAccessTokenAsync(user);
    }

    // F-103: the statement and the options take pictures; the explanation does not (BR1).
    private RichTextImageOptions? _imageOptions;

    private RichTextImageOptions ImageOptions => _imageOptions ??= QuestionImageUpload.Options(UploadImageAsync);

    private async Task<RichTextImageUpload> UploadImageAsync(RichTextImageFile file) =>
        QuestionImageUpload.Answer(
            await TokenAsync() is { } token ? await Api.UploadImageAsync(token, file.Name, file.ContentType, file.Content) : null,
            Errors);
}
