@* F-95 UC6, AC12: the question as a student will read it, from the stored (sanitized) HTML, with the key and the
   explanation hidden until "show answer". The Web never renders HTML the Api has not sanitized: the question comes
   from a read, never from the editors. *@
@using Simulab.QuestionBank.Contracts
@inject IStringLocalizer<SharedResources> L

<MudDialog>
    <DialogContent>
        @if (UnsavedChanges)
        {
            @* The preview shows what is stored: the editors' text is not sanitized until the Api has it. *@
            <AppAlert Severity="Severity.Info" Text="@L["Questions.Preview.UnsavedNote"]" Class="mb-4" />
        }

        @* F-98 UC5: a version of the history opens here, read only, from what was recorded then. *@
        @if (VersionRecordedAt is { } recordedAt)
        {
            <AppAlert Severity="Severity.Info"
                      Text="@L["Questions.History.Version.Note", recordedAt.ToString("g", CultureInfo.CurrentCulture)].Value"
                      Class="mb-4" />
        }

        @* F-101 UC3: an annulled question says when and why before anything else is read. *@
        @if (Question.Annulment is { } annulment)
        {
            <div id="question-preview-annulment">
                <AppAlert Severity="Severity.Warning"
                          Text="@L["Questions.Preview.Annulled", annulment.AnnulledAt.ToString("g", CultureInfo.CurrentCulture), annulment.Reason].Value"
                          Class="mb-4" />
            </div>
        }

        @* The question and its answer section are the shared content (F-105: the review screen renders it too,
           with the answer always shown); this dialog adds the Show/Hide answer button between the two. *@
        <QuestionPreviewContent Question="@Question" BaseTextHtml="@BaseTextHtml" Revealed="@_revealed">
            <Controls>
                <div class="app-preview-actions">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               id="question-preview-toggle"
                               aria-expanded="@(_revealed ? "true" : "false")"
                               aria-controls="question-preview-answer"
                               OnClick="Toggle">@(_revealed ? L["Questions.Preview.HideAnswer"] : L["Questions.Preview.ShowAnswer"])</MudButton>
                </div>
            </Controls>
        </QuestionPreviewContent>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Close" Class="app-preview-close">@L["Common.Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The stored question: its HTML has been sanitized by the Api (BR8).</summary>
    [Parameter, EditorRequired] public QuestionResponse Question { get; set; } = default!;

    /// <summary>True when the form holds changes that are not saved: the dialog says the preview is the saved version.</summary>
    [Parameter] public bool UnsavedChanges { get; set; }

    /// <summary>F-98: when the version shown was recorded; set only when the dialog shows a version of the history.</summary>
    [Parameter] public DateTimeOffset? VersionRecordedAt { get; set; }

    /// <summary>
    /// F-102 AC11: the base text of a version of the history, as it was recorded (F-98 BR1). A version carries the
    /// HTML and no id, so it travels here and not as a base text of the question. Used only with
    /// <see cref="VersionRecordedAt"/>.
    /// </summary>
    [Parameter] public string? VersionBaseTextHtml { get; set; }

    private bool _revealed;

    // F-102 BR9: the linked text comes from the stored question; a version shows what it recorded.
    private string? BaseTextHtml => VersionRecordedAt is null ? Question.BaseText?.TextHtml : VersionBaseTextHtml;

    private void Toggle() => _revealed = !_revealed;

    private void Close() => Dialog.Close();
}
