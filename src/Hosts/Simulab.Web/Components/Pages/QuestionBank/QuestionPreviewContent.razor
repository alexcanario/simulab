@* The question as a student reads it, from the stored (sanitized) HTML, and the answer section (the key and the
   explanation) below it. Shared by the preview dialog (F-95 UC6, which hides the answer until "show answer") and by
   the review screen (F-105 BR9, which always shows it). The Web never renders HTML the Api has not sanitized: the
   question comes from a read, never from the editors. *@
@using System.Net
@using Simulab.QuestionBank.Contracts
@inject IStringLocalizer<SharedResources> L

@* F-96 BR7: where the question came from, above the statement. A question without an edition shows nothing,
   and so does one whose edition no longer resolves (BR11). *@
@if (QuestionText.SourceLine(Question.Origin) is { } sourceLine)
{
    <p class="app-question-source" id="question-preview-source">
        <span class="app-question-source-line">@sourceLine</span>
        <span class="app-question-source-number">@L["Questions.Preview.Number", Question.Origin!.PaperNumber]</span>
    </p>
}

<div class="app-question-paper" lang="@Question.ContentLanguage">
    @if (!QuestionHtml.IsBlank(BaseTextHtml))
    {
        <div class="app-question-base app-question-content" id="question-preview-base-text">@((MarkupString)BaseTextHtml!)</div>
    }

    <div class="app-question-content" id="question-preview-statement">@((MarkupString)StatementHtml)</div>

    @if (IsFillIn)
    {
        @* F-107 BR15: the task, not the answer; the boxes give no hint of the answer's length. *@
        <p class="app-question-select-count" id="question-preview-blanks-instruction">@L["Questions.Preview.BlanksInstruction"]</p>
    }
    else if (IsTrueFalse)
    {
        @* F-97 BR7: the two answers a student judges between, as inert labelled text. *@
        <ul class="app-question-options" id="question-preview-true-false" aria-label="@L["Questions.Preview.Answers"]">
            @foreach (var answer in new[] { true, false })
            {
                var marked = Shown && Question.TrueFalseKey == answer;
                <li class="@(marked ? "app-question-option is-correct" : "app-question-option")">
                    <div class="app-question-option-body">
                        <div class="app-question-content">@(answer ? L["Questions.TrueFalse.True"] : L["Questions.TrueFalse.False"])</div>
                        @if (marked)
                        {
                            <span class="app-correct-label">
                                <MudIcon Icon="@AppIcons.Verified" Size="Size.Small" Color="Color.Success" aria-hidden="true" />
                                @L["Questions.Preview.CorrectAnswer"]
                            </span>
                        }
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        @* F-104 BR6: how many options to mark, from the count of correct ones; nothing more of the key shows. *@
        @if (Question.Type == QuestionType.MultipleAnswer && CorrectCount > 0)
        {
            <p class="app-question-select-count" id="question-preview-select-count">@L["Questions.Preview.SelectCount", CorrectCount]</p>
        }

        @* F-106 BR13: the task, not the answer; then the numbered items, in authored order. Each number's letter
           shows only after "show answer". *@
        @if (IsMatching)
        {
            <p class="app-question-select-count" id="question-preview-match-instruction">@L["Questions.Preview.MatchInstruction"]</p>
            <ol class="app-question-options" id="question-preview-match-items" aria-label="@L["Questions.Preview.MatchItems"]">
                @foreach (var item in _matchItems)
                {
                    <li class="app-question-option">
                        <span class="app-match-number">@Number(item.Position)</span>
                        <div class="app-question-option-body">
                            <div class="app-question-content">@((MarkupString)item.TextHtml)</div>
                            @if (Shown && item.MatchPosition is { } match)
                            {
                                <span class="app-correct-label app-match-key">@MatchText(item.Position, match)</span>
                            }
                        </div>
                    </li>
                }
            </ol>
        }

        <ol class="app-question-options" aria-label="@L["Questions.Preview.Options"]">
            @foreach (var option in _options)
            {
                var marked = Shown && IsKey(option);
                <li class="@(marked ? "app-question-option is-correct" : "app-question-option")">
                    @* The letter is text, so a screen reader reads it. *@
                    <span class="app-option-letter">@QuestionText.Letter(option.Position)</span>
                    <div class="app-question-option-body">
                        <div class="app-question-content">@((MarkupString)option.TextHtml)</div>
                        @if (marked)
                        {
                            @* Icon, text and border: the key is never colour alone. *@
                            <span class="app-correct-label">
                                <MudIcon Icon="@AppIcons.Verified" Size="Size.Small" Color="Color.Success" aria-hidden="true" />
                                @L["Questions.Preview.CorrectAnswer"]
                            </span>
                        }
                    </div>
                </li>
            }
        </ol>
    }
</div>

@Controls

@* The live region is in the page from the start, empty: only its content changes on the first reveal. When the
   answer is always shown there is nothing to announce, so the wrapper carries no id and no live region. *@
<div id="@(AlwaysRevealed ? null : "question-preview-answer")" aria-live="@(AlwaysRevealed ? null : "polite")">
    @if (Shown)
    {
        <section class="app-preview-answer" role="region" aria-labelledby="question-preview-answer-heading">
            <h3 class="app-preview-heading" id="question-preview-answer-heading">@L["Questions.Preview.Answer"]</h3>
            @if (IsFillIn)
            {
                @* F-107: every accepted answer of each blank, in statement order; icon and text, never colour alone. *@
                <span class="app-correct-label">
                    <MudIcon Icon="@AppIcons.Verified" Size="Size.Small" Color="Color.Success" aria-hidden="true" />
                    @L["Questions.Preview.CorrectAnswer"]
                </span>
                <ul class="app-preview-blanks" id="question-preview-blanks-key">
                    @foreach (var blank in _blanks)
                    {
                        <li>@(blank.AcceptedAnswers.Count == 0
                                ? L["Questions.Preview.BlankNoKey", blank.Number]
                                : L["Questions.Preview.BlankKey", blank.Number, string.Join(", ", blank.AcceptedAnswers)])</li>
                    }
                </ul>
            }
            else if (IsTrueFalse ? Question.TrueFalseKey is null : !_options.Any(IsKey))
            {
                <p class="app-preview-no-key">@NoKeyText</p>
            }
            else
            {
                @* F-105 screen 2: the heading carries the key in words, the letters or True/False, not the marked options alone. *@
                <p class="app-preview-key" id="question-preview-key">@KeyText</p>
            }

            <h4 class="app-preview-heading">@L["Questions.Preview.Explanation"]</h4>
            @if (QuestionHtml.IsBlank(Question.ExplanationHtml))
            {
                <p class="app-muted">@L["Questions.Preview.NoExplanation"]</p>
            }
            else
            {
                <div class="app-question-content" lang="@Question.ContentLanguage" id="question-preview-explanation">@((MarkupString)Question.ExplanationHtml!)</div>
            }
        </section>
    }
</div>

@code {
    /// <summary>The stored question: its HTML has been sanitized by the Api (BR8).</summary>
    [Parameter, EditorRequired] public QuestionResponse Question { get; set; } = default!;

    /// <summary>The base text to show above the statement; the caller decides where it comes from (the question or a version).</summary>
    [Parameter] public string? BaseTextHtml { get; set; }

    /// <summary>True once the reader asked for the answer (the dialog's Show answer).</summary>
    [Parameter] public bool Revealed { get; set; }

    /// <summary>F-105 BR9: the key and the explanation are always shown (the review screen); <see cref="Revealed"/> is then ignored.</summary>
    [Parameter] public bool AlwaysRevealed { get; set; }

    /// <summary>What sits between the question and its answer section (the dialog's Show/Hide answer button).</summary>
    [Parameter] public RenderFragment? Controls { get; set; }

    private IReadOnlyList<QuestionOptionResponse> _options = [];
    private IReadOnlyList<MatchItemResponse> _matchItems = [];
    private IReadOnlyList<BlankResponse> _blanks = [];

    private bool Shown => AlwaysRevealed || Revealed;

    private bool IsFillIn => Question.Type == QuestionType.FillInTheBlanks;

    // F-107 BR15: each marker of the stored statement is drawn as a numbered empty box named "Blank n"; after "show
    // answer" the box holds the blank's first accepted answer. Only the number and encoded texts go into the markup.
    private string StatementHtml =>
        IsFillIn ? StatementBlanks.Replace(Question.StatementHtml, BlankBox) : Question.StatementHtml;

    private string BlankBox(int number)
    {
        var first = Shown ? _blanks.FirstOrDefault(blank => blank.Number == number)?.AcceptedAnswers.FirstOrDefault() : null;
        var text = first ?? number.ToString(CultureInfo.CurrentCulture);
        var label = first is null
            ? L["Questions.Blanks.Blank", number].Value
            : L["Questions.Preview.BlankKey", number, first].Value;

        return $"<span class=\"app-blank\" role=\"img\" aria-label=\"{WebUtility.HtmlEncode(label)}\">{WebUtility.HtmlEncode(text)}</span>";
    }

    private bool IsTrueFalse => Question.Type == QuestionType.TrueFalse;

    private bool IsMatching => Question.Type == QuestionType.Matching;

    private int CorrectCount => _options.Count(option => option.IsCorrect);

    // F-106: a matching question marks the options some item matches; an extra one shows nothing.
    private bool IsKey(QuestionOptionResponse option) =>
        IsMatching ? _matchItems.Any(item => item.MatchPosition == option.Position) : option.IsCorrect;

    private string NoKeyText =>
        IsTrueFalse ? L["Questions.Preview.NoKey.TrueFalse"] : IsMatching ? L["Questions.Preview.NoKey.Matching"] : L["Questions.Preview.NoKey"];

    // The key in words: True or False, the letters of the correct options, or each number with its letter.
    private string KeyText =>
        IsTrueFalse
            ? (Question.TrueFalseKey == true ? L["Questions.TrueFalse.True"] : L["Questions.TrueFalse.False"])
            : IsMatching
                ? string.Join(", ", _matchItems
                    .Where(item => item.MatchPosition is not null)
                    .Select(item => MatchText(item.Position, item.MatchPosition!.Value)))
                : string.Join(", ", _options.Where(option => option.IsCorrect).Select(option => QuestionText.Letter(option.Position)));

    private static string Number(int position) => (position + 1).ToString(CultureInfo.CurrentCulture);

    private string MatchText(int position, int match) => L["Questions.Preview.MatchKey", Number(position), QuestionText.Letter(match)];

    protected override void OnParametersSet()
    {
        _options = [.. Question.Options.OrderBy(option => option.Position)];
        _matchItems = [.. (Question.MatchItems ?? []).OrderBy(item => item.Position)];
        _blanks = Question.Blanks ?? [];
    }
}
