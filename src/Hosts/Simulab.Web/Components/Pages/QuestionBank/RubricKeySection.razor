@* F-109: the key section of an open-answer or essay question: up to ten criteria, each a name, a description and points,
   then the optional size limit of the type. The question stores the rows as its rubric; the form owns the rows, the
   errors and Save, and this component only draws the fields and tells the form that something changed. *@
@using Simulab.QuestionBank.Contracts
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS

@* The wrapper carries the section's id: the kit card names only its title. *@
<div id="question-section-rubric">
<AppSectionCard Id="question-section-rubric"
                Title="@L["Questions.Section.Rubric"]"
                Icon="@AppIcons.OpenAnswer"
                Number="SectionNumber"
                Subtitle="@L["Questions.Section.Rubric.Subtitle"]">
    <div role="group" aria-describedby="question-rubric-description">
        @for (var index = 0; index < Criteria.Count; index++)
        {
            var position = index;
            var criterion = Criteria[position];
            var number = position + 1;
            <div class="app-criterion-row">
                <div class="app-criterion-name">
                    <AppTextField TValue="string"
                                  Id="@FieldId(position, "name")"
                                  Label="@L["Questions.Rubric.Criterion.Name", number]"
                                  MaxLength="QuestionLimits.CriterionNameMaxLength"
                                  Disabled="Frozen"
                                  Value="@criterion.Name"
                                  ValueChanged="@((string? value) => OnNameChanged(criterion, value))"
                                  Error="@criterion.NameError" />
                </div>
                <div class="app-criterion-description">
                    <AppTextField TValue="string"
                                  Id="@FieldId(position, "description")"
                                  Label="@L["Questions.Rubric.Criterion.Description", number]"
                                  MaxLength="QuestionLimits.CriterionDescriptionMaxLength"
                                  Disabled="Frozen"
                                  Value="@criterion.Description"
                                  ValueChanged="@((string? value) => OnDescriptionChanged(criterion, value))"
                                  Error="@criterion.DescriptionError" />
                </div>
                <div class="app-criterion-points">
                    <AppTextField TValue="int?"
                                  Id="@FieldId(position, "points")"
                                  Label="@L["Questions.Rubric.Criterion.Points", number]"
                                  InputType="InputType.Number"
                                  Disabled="Frozen"
                                  Value="@criterion.Points"
                                  ValueChanged="@((int? value) => OnPointsChanged(criterion, value))"
                                  Error="@criterion.PointsError" />
                </div>
                @if (!Frozen)
                {
                    <AppRowActions ItemName="@L["Questions.Rubric.Criterion.ItemName", number]"
                                   IdPrefix="@($"{FieldId(position, "actions")}")"
                                   OnDelete="@(() => RemoveCriterion(criterion))" />
                }
            </div>
        }

        <div class="app-options-footer">
            @if (!Frozen)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@AppIcons.Add"
                           OnClick="AddCriterion"
                           Disabled="@(Criteria.Count >= QuestionLimits.RubricCriteriaMax)"
                           aria-describedby="question-rubric-count"
                           id="@AddId">@L["Questions.Rubric.Add"]</MudButton>
            }
            @* The limit is never told by a disabled button alone: the count says it. *@
            <span class="app-options-count" id="question-rubric-count">@L["Questions.Rubric.Count", Criteria.Count]</span>
            <span class="app-options-count" id="question-rubric-total">@L["Questions.Rubric.Total", Total]</span>
        </div>
    </div>

    @* A refusal about the rubric or the size is under the fields and described to the group. *@
    <span id="question-rubric-description" class="app-field-description">
        @if (Error is not null)
        {
            <span class="app-field-error-text app-rubric-error" aria-live="polite">@Error</span>
        }
    </span>

    <div class="app-answer-size" role="group" aria-labelledby="question-answer-size-title">
        <h3 class="app-blank-title" id="question-answer-size-title">@L["Questions.Section.AnswerSize"]</h3>
        <AppFormGrid Columns="2">
            @if (IsEssay)
            {
                <AppTextField TValue="int?"
                              Id="question-answer-size-min"
                              Label="@L["Questions.AnswerSize.MinLines"]"
                              InputType="InputType.Number"
                              Disabled="Frozen"
                              Value="@SizeMin"
                              ValueChanged="@((int? value) => OnSizeMinChanged(value))" />
            }

            <AppTextField TValue="int?"
                          Id="question-answer-size-max"
                          Label="@(IsEssay ? L["Questions.AnswerSize.MaxLines"] : L["Questions.AnswerSize.MaxCharacters"])"
                          InputType="InputType.Number"
                          Disabled="Frozen"
                          Value="@SizeMax"
                          ValueChanged="@((int? value) => OnSizeMaxChanged(value))" />
        </AppFormGrid>
    </div>

    <div class="app-visually-hidden" role="status" aria-live="polite">@_announcement</div>

    @ChildContent
</AppSectionCard>
</div>

@code {
    /// <summary>The "Add criterion" button's id; the error summary points at it.</summary>
    public const string AddId = "question-criterion-add";

    /// <summary>The criteria typed, owned by the form and kept across a change of type.</summary>
    [Parameter, EditorRequired] public List<CriterionDraft> Criteria { get; set; } = [];

    /// <summary>True for an essay (limit in lines, a minimum and a maximum); false for an open answer (characters, a maximum).</summary>
    [Parameter] public bool IsEssay { get; set; }

    [Parameter] public int? SizeMin { get; set; }

    [Parameter] public EventCallback<int?> SizeMinChanged { get; set; }

    [Parameter] public int? SizeMax { get; set; }

    [Parameter] public EventCallback<int?> SizeMaxChanged { get; set; }

    /// <summary>The step number the page gives the section (5), drawn by the section card.</summary>
    [Parameter] public int? SectionNumber { get; set; }

    /// <summary>F-101, F-105: an annulled question or one in review is read only.</summary>
    [Parameter] public bool Frozen { get; set; }

    /// <summary>The refusal about the rubric as a whole or the size limit, already translated.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>Called after any change, so the form clears the refusal and redraws its checklist.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>What follows the fields: the reason of a key change, when the form asks for one.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? _announcement;
    private string? _pendingFocus;

    /// <summary>The sum of the points typed so far; a row with no points counts as zero.</summary>
    private int Total => Criteria.Sum(criterion => criterion.Points ?? 0);

    /// <summary>The id of a field of criterion <paramref name="index"/> (from 0): name, description, points or actions.</summary>
    public static string FieldId(int index, string field) => $"question-criterion-{index}-{field}";

    private Task OnNameChanged(CriterionDraft criterion, string? value)
    {
        criterion.Name = value ?? string.Empty;
        criterion.NameError = null;

        return OnChanged.InvokeAsync();
    }

    private Task OnDescriptionChanged(CriterionDraft criterion, string? value)
    {
        criterion.Description = value ?? string.Empty;
        criterion.DescriptionError = null;

        return OnChanged.InvokeAsync();
    }

    private Task OnPointsChanged(CriterionDraft criterion, int? value)
    {
        criterion.Points = value;
        criterion.PointsError = null;

        return OnChanged.InvokeAsync();
    }

    private async Task OnSizeMinChanged(int? value)
    {
        await SizeMinChanged.InvokeAsync(value);
        await OnChanged.InvokeAsync();
    }

    private async Task OnSizeMaxChanged(int? value)
    {
        await SizeMaxChanged.InvokeAsync(value);
        await OnChanged.InvokeAsync();
    }

    private Task AddCriterion()
    {
        if (Criteria.Count >= QuestionLimits.RubricCriteriaMax)
        {
            return Task.CompletedTask;
        }

        Criteria.Add(new CriterionDraft());
        _announcement = null;
        _pendingFocus = FieldId(Criteria.Count - 1, "name");

        return OnChanged.InvokeAsync();
    }

    private Task RemoveCriterion(CriterionDraft criterion)
    {
        var index = Criteria.IndexOf(criterion);
        if (index < 0)
        {
            return Task.CompletedTask;
        }

        Criteria.RemoveAt(index);
        _announcement = L["Questions.Rubric.Criterion.Removed", Criteria.Count];
        _pendingFocus = index < Criteria.Count ? $"{FieldId(index, "actions")}-{AppRowActions.DeleteKey}" : AddId;

        return OnChanged.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocus is not { } target)
        {
            return;
        }

        _pendingFocus = null;
        await JS.InvokeVoidAsync("simulabShell.focusElement", target);
    }
}
