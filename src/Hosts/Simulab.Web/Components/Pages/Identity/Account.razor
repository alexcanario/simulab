@page "/account"
@layout MainLayout
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Simulab.Identity.Contracts
@using Simulab.Web.Services.Auth
@inject IStringLocalizer<IdentityResources> I
@inject IStringLocalizer<SharedResources> L
@inject IdentityApiClient Api
@inject WebSessionTokenAccessor Tokens
@inject ErrorText Errors
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>@I["Account.Title"] — @L["App.Name"]</PageTitle>

@* F-8 UC1-UC2: the signed-in user's own profile. Reached from the user menu. *@
<AppPageHeader Title="@I["Account.Title"]" />

@if (_profile is null && !_loadFailed)
{
    <AppLoadingState />
}
else if (_profile is null)
{
    <AppErrorState Message="@I["Account.LoadFailed"]" OnRetry="LoadAsync" />
}
else
{
    <MudPaper Class="app-form-card pa-6" Elevation="0" Outlined="true" MaxWidth="560px">
        @if (Saved == true && _error is null)
        {
            <AppAlert Severity="Severity.Success" Text="@I["Account.Saved"]" />
        }
        else if (_error is not null)
        {
            <AppAlert Severity="Severity.Error" Text="@Errors.For(_error)" ActionText="@L["Common.TryAgain"]" OnAction="SaveAsync" />
        }

        <AppTextField TValue="string"
                      Id="account-email"
                      Label="@I["Account.Email.Label"]"
                      Hint="@I["Account.Email.Hint"]"
                      ReadOnly="true"
                      Value="@_profile.Email" />

        <AppTextField TValue="string"
                      Id="account-full-name"
                      Label="@I["Account.FullName.Label"]"
                      Hint="@I["Account.FullName.Hint"]"
                      Autocomplete="name"
                      Disabled="_saving"
                      Error="@_fullNameError"
                      Value="@_fullName"
                      ValueChanged="OnFullNameChanged" />

        <AppSelectField TValue="string"
                        Id="account-preferred-language"
                        Label="@I["Account.PreferredLanguage.Label"]"
                        Hint="@I["Account.PreferredLanguage.Hint"]"
                        Required="true"
                        Disabled="_saving"
                        Options="LanguageOptions"
                        Value="@_language"
                        ValueChanged="@(value => { _language = value ?? _profile.PreferredLanguage; _error = null; })" />

        <AppLink Href="/account/password" Class="app-account-password d-inline-block mb-4">@I["ChangePassword.Title"]</AppLink>
        @if (_securityAvailable)
        {
            <AppLink Href="/account/security" Class="app-account-security d-inline-block mb-4 ml-6">@I["Security.Title"]</AppLink>
        }

        <AppFormActions Saving="_saving" Disabled="@(_fullNameError is not null)" HasChanges="HasChanges" OnSave="SaveAsync" OnCancel="Cancel" />
    </MudPaper>

    @* F-16, UC1: between the profile and the danger zone; the file is built on request and never stored. *@
    <MudPaper Class="app-form-card app-data-card pa-6 mt-6" Elevation="0" Outlined="true" MaxWidth="560px">
        <h2 class="app-data-title">@I["Account.Data.Title"]</h2>
        <MudText Typo="Typo.body2" Class="mb-4">@I["Account.Data.Explanation"]</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@AppIcons.Download" OnClick="DownloadAsync" Class="app-download-open">
            @I["Account.Data.Action"]
        </MudButton>
    </MudPaper>

    @* F-10, UC1: set apart from the profile card, because nothing here can be undone. *@
    <MudPaper Class="app-danger-zone pa-6 mt-6" Elevation="0" Outlined="true" MaxWidth="560px">
        <h2 class="app-danger-zone-title">@I["Account.Erase.Title"]</h2>
        <MudText Typo="Typo.body2" Class="mb-4">@I["Account.Erase.Explanation"]</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="EraseAsync" Class="app-erase-open">
            @I["Account.Erase.Action"]
        </MudButton>
    </MudPaper>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Set by the reload that follows a save (BR8): the success alert shows in the new language.</summary>
    [SupplyParameterFromQuery] public bool? Saved { get; set; }

    private static readonly IReadOnlyList<AppSelectOption<string>> LanguageOptions =
        [.. SupportedCultures.All.Select(culture => new AppSelectOption<string>(culture.Name, SupportedCultures.NativeName(culture), culture.Name))];

    private ProfileResponse? _profile;
    private bool _loadFailed;
    private bool _securityAvailable;
    private string? _fullName;
    private string? _language;
    private string? _fullNameError;
    private string? _error;
    private bool _saving;
    private bool _leaving;

    private bool HasChanges => !_leaving && _profile is not null
        && ((_fullName ?? string.Empty).Trim() != (_profile.FullName ?? string.Empty) || _language != _profile.PreferredLanguage);

    protected override async Task OnInitializedAsync()
    {
        // Signed-in users only, as on /account/password: an anonymous visitor signs in first.
        if (AuthState is null || (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/sign-in", forceLoad: true);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadFailed = false;
        var accessToken = await AccessTokenAsync();
        var result = accessToken is null ? null : await Api.GetProfileAsync(accessToken);
        if (result?.Value is null)
        {
            _loadFailed = true;
            return;
        }

        _profile = result.Value;

        // F-29 BR14 (supersedes F-11 BR12): the Security page exists while either two-factor or Google is on,
        // so the link follows the same rule. Gated on two-factor alone, v1's own configuration — Google on,
        // two-factor off — would ship a page with nothing leading to it.
        _securityAvailable = (await Api.GetTotpStatusAsync(accessToken!)).IsSuccess
            || (await Api.GetGoogleLinkAsync(accessToken!)).IsSuccess;
        Cancel();
    }

    private void OnFullNameChanged(string? value)
    {
        _fullName = value;
        _error = null;

        // BR2: validated as it is typed, so Save is disabled while the name is too long (AC13).
        _fullNameError = (value ?? string.Empty).Trim().Length > AccountLimits.FullNameMaxLength
            ? L[IdentityErrorCodes.ProfileFullNameTooLong].Value
            : null;
    }

    private async Task SaveAsync()
    {
        if (_profile is null || _fullNameError is not null || _language is null)
        {
            return;
        }

        _saving = true;
        _error = null;
        var accessToken = await AccessTokenAsync();
        var result = accessToken is null
            ? ApiResult.Failed<bool>(ErrorText.UnexpectedCode)
            : await Api.UpdateProfileAsync(accessToken, _fullName, _language);
        _saving = false;

        if (!result.IsSuccess)
        {
            if (result.ErrorCode == IdentityErrorCodes.ProfileFullNameTooLong)
            {
                _fullNameError = Errors.For(result.ErrorCode);
            }
            else
            {
                _error = result.ErrorCode;
            }

            return;
        }

        // BR8: a full page load through the Web, which writes the name and the culture into the cookies.
        // The unsaved-changes guard must see the saved state first: yielding lets the pending render run.
        _leaving = true;
        StateHasChanged();
        await Task.Yield();
        var target = Uri.EscapeDataString("/account?saved=true");
        Navigation.NavigateTo($"/account/profile-applied?redirectUri={target}", forceLoad: true);
    }

    /// <summary>
    /// F-10 UC2: the dialog owns the password and the failures; a success ends the session through the
    /// Web's own sign-out, because a circuit cannot clear the auth cookie (same reason as the save above).
    /// </summary>
    private async Task EraseAsync()
    {
        var parameters = new DialogParameters<EraseAccountDialog>
        {
            { dialog => dialog.Erase, EraseOnApiAsync }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialog = await Dialogs.ShowAsync<EraseAccountDialog>(I["Account.Erase.Dialog.Title"], parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled != false)
        {
            return;
        }

        _leaving = true;
        StateHasChanged();
        await Task.Yield();
        Navigation.NavigateTo($"/account/sign-out?reason={AccountEndpoints.AccountErasedReason}", forceLoad: true);
    }

    /// <summary>
    /// F-16 UC2: the dialog owns the password and the failures; on success the circuit streams the file to the
    /// browser (it cannot answer an HTTP request itself) and says the confirmation email is on its way.
    /// </summary>
    private async Task DownloadAsync()
    {
        var parameters = new DialogParameters<DownloadDataDialog>
        {
            { dialog => dialog.Export, ExportOnApiAsync }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialog = await Dialogs.ShowAsync<DownloadDataDialog>(I["Account.Data.Dialog.Title"], parameters, options);
        var result = await dialog.Result;

        if (result is not { Canceled: false, Data: DataExportResult { Content: { } content, FileName: { } fileName } })
        {
            return;
        }

        using var stream = new MemoryStream(content);
        using var reference = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync(DownloadFunction, fileName, "application/json", reference);
        Snackbar.Add(I["Account.Data.Started"], Severity.Success);
    }

    /// <summary>The browser function that saves the streamed file (wwwroot/js/shell.js).</summary>
    internal const string DownloadFunction = "simulabShell.downloadFile";

    private async Task<DataExportResult> ExportOnApiAsync(string currentPassword)
    {
        var accessToken = await AccessTokenAsync();
        return accessToken is null
            ? new DataExportResult(ErrorText.UnexpectedCode, null)
            : await Api.ExportDataAsync(accessToken, currentPassword);
    }

    private async Task<AccountErasureResult> EraseOnApiAsync(string currentPassword)
    {
        var accessToken = await AccessTokenAsync();
        return accessToken is null
            ? new AccountErasureResult(ErrorText.UnexpectedCode, null)
            : await Api.EraseAccountAsync(accessToken, currentPassword);
    }

    private void Cancel()
    {
        _fullName = _profile?.FullName;
        _language = _profile?.PreferredLanguage;
        _fullNameError = null;
        _error = null;
    }

    private async Task<string?> AccessTokenAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        return user is null ? null : await Tokens.GetAccessTokenAsync(user);
    }
}
