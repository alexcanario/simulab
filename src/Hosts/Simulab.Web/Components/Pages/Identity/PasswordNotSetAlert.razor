@* F-20 BR11: the account was created with Google and has no password to confirm with. One message for the four places
   that ask for the current password, with the way to create one: "forgot password" gives a first password too. *@
@using Simulab.Identity.Contracts
@inject IStringLocalizer<IdentityResources> I
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager Navigation

<AppAlert Severity="Severity.Info"
          Text="@L[IdentityErrorCodes.PasswordNotSet]"
          ActionText="@I["PasswordNotSet.CreatePassword"]"
          OnAction="CreatePassword"
          Class="@Class" />

@code {
    /// <summary>The route of the page that sends the link.</summary>
    public const string ForgotPasswordPath = "/forgot-password";

    [Parameter] public string? Class { get; set; }

    /// <summary>A full load: a dialog may be open, and the page it leaves should not keep it.</summary>
    private void CreatePassword() => Navigation.NavigateTo(ForgotPasswordPath, forceLoad: true);
}
