@page "/forgot-password"
@layout AuthLayout
@implements IDisposable
@inject IStringLocalizer<IdentityResources> I
@inject IStringLocalizer<SharedResources> L
@inject IdentityApiClient Api
@inject ErrorText Errors
@inject TimeProvider Clock

<PageTitle>@I["ForgotPassword.Title"] — @L["App.Name"]</PageTitle>

@* F-7 UC1: the answer is the same whether the address has an account or not (BR1). *@
<div class="app-auth-card">
    <h1 class="app-auth-title">@I["ForgotPassword.Title"]</h1>
    <p class="app-auth-subtitle">@I["ForgotPassword.Subtitle"]</p>

    @if (_sent)
    {
        <AppAlert Severity="Severity.Success" Text="@I["ForgotPassword.Sent"]" />
    }
    else if (_error is not null)
    {
        <AppAlert Severity="Severity.Error" Text="@Errors.For(_error)" />
    }

    <AppTextField TValue="string"
                  Id="forgot-password-email"
                  Label="@I["ForgotPassword.Email.Label"]"
                  Placeholder="@I["SignUp.Email.Placeholder"]"
                  InputType="InputType.Email"
                  Autocomplete="username"
                  MaxLength="254"
                  Required="true"
                  Disabled="_sending"
                  Error="@_emailError"
                  Value="@_email"
                  ValueChanged="@(value => { _email = value; _emailError = null; })" />

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Size="Size.Large"
               Disabled="@(_sending || _cooldown.IsRunning)"
               OnClick="SendAsync"
               Class="app-forgot-password-submit">
        @if (_sending)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" aria-hidden="true" />
            <span role="status">@I["ForgotPassword.Sending"]</span>
        }
        else
        {
            @I["ForgotPassword.Submit"]
        }
    </MudButton>

    @if (_cooldown.IsRunning)
    {
        <p class="app-auth-cooldown" aria-live="polite">@string.Format(System.Globalization.CultureInfo.CurrentCulture, I["ForgotPassword.Cooldown"], _cooldown.Announced)</p>
    }
</div>

<p class="app-auth-footer-line"><a href="/sign-in">@I["ForgotPassword.BackToSignIn"]</a></p>

@code {
    /// <summary>The cooldown the button shows. The server keeps its own, silent one (BR3).</summary>
    private static readonly TimeSpan Cooldown = TimeSpan.FromSeconds(60);

    private Countdown _cooldown = default!;
    private string? _email;
    private string? _emailError;
    private bool _sending;
    private bool _sent;
    private string? _error;

    protected override void OnInitialized() => _cooldown = new Countdown(Clock, () => InvokeAsync(StateHasChanged));

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            _emailError = I["SignIn.Email.Required"];
            return;
        }

        _sending = true;
        _error = null;
        var result = await Api.RequestPasswordResetAsync(_email.Trim());
        _sending = false;

        if (result.IsSuccess)
        {
            _sent = true;
            _cooldown.Start(Cooldown);
        }
        else
        {
            _sent = false;
            _error = result.ErrorCode;
        }
    }

    public void Dispose() => _cooldown.Dispose();
}
