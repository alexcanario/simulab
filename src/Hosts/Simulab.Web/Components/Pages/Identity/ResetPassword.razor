@page "/reset-password"
@layout AuthLayout
@implements IDisposable
@using Simulab.Identity.Contracts
@inject IStringLocalizer<IdentityResources> I
@inject IStringLocalizer<SharedResources> L
@inject IdentityApiClient Api
@inject ErrorText Errors
@inject NavigationManager Navigation
@inject TimeProvider Clock

<PageTitle>@Title — @L["App.Name"]</PageTitle>

@* F-7 UC2-UC4. The token comes from the link's query string and never appears on screen. *@
<div class="app-auth-card">
    @switch (_state)
    {
        case State.Checking:
            <div class="app-auth-result">
                <span class="app-auth-badge app-auth-badge-info">
                    <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" aria-hidden="true" />
                </span>
                <h1 class="app-auth-title" role="status">@I["ResetPassword.Checking"]</h1>
            </div>
            break;

        case State.Ready:
            <h1 class="app-auth-title">@I["ResetPassword.Title"]</h1>

            @if (_error is not null)
            {
                <AppAlert Severity="Severity.Error" Text="@Errors.For(_error)" />
            }

            <AppPasswordField Id="reset-password-new"
                              Autocomplete="PasswordAutocomplete.NewPassword"
                              Label="@I["ResetPassword.NewPassword.Label"]"
                              Hint="@I["SignUp.Password.Hint"]"
                              ShowLabel="@I["SignUp.Password.Show"]"
                              HideLabel="@I["SignUp.Password.Hide"]"
                              Required="true"
                              Disabled="_submitting"
                              Error="@_passwordError"
                              Value="@_password"
                              ValueChanged="@(value => { _password = value; _passwordError = null; })" />

            <AppPasswordStrength Password="@_password" TextFor="StrengthText" />

            <AppPasswordField Id="reset-password-confirm"
                              Autocomplete="PasswordAutocomplete.NewPassword"
                              Label="@I["ResetPassword.ConfirmPassword.Label"]"
                              ShowLabel="@I["SignUp.Password.Show"]"
                              HideLabel="@I["SignUp.Password.Hide"]"
                              Required="true"
                              Disabled="_submitting"
                              Error="@_confirmError"
                              Value="@_confirm"
                              ValueChanged="@(value => { _confirm = value; _confirmError = null; })" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="_submitting"
                       OnClick="SubmitAsync"
                       Class="app-reset-password-submit">
                @if (_submitting)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" aria-hidden="true" />
                    <span role="status">@I["ResetPassword.Submitting"]</span>
                }
                else
                {
                    @I["ResetPassword.Submit"]
                }
            </MudButton>
            break;

        case State.Expired:
            <div class="app-auth-result">
                <span class="app-auth-badge app-auth-badge-warning">
                    <MudIcon Icon="@AppIcons.Expired" Size="Size.Large" Color="Color.Warning" aria-hidden="true" />
                </span>
                <h1 class="app-auth-title">@I["ResetPassword.Expired.Title"]</h1>
                <p>@I["ResetPassword.Expired.Message"]</p>
            </div>

            @if (_sent)
            {
                <AppAlert Severity="Severity.Success" Text="@I["ForgotPassword.Sent"]" />
            }
            else if (_error is not null)
            {
                <AppAlert Severity="Severity.Error" Text="@Errors.For(_error)" />
            }

            <AppTextField TValue="string"
                          Id="reset-password-email"
                          Label="@I["ForgotPassword.Email.Label"]"
                          Placeholder="@I["SignUp.Email.Placeholder"]"
                          InputType="InputType.Email"
                          Autocomplete="username"
                          MaxLength="AccountLimits.EmailMaxLength"
                          Required="true"
                          Disabled="_sending"
                          Error="@_emailError"
                          Value="@_email"
                          ValueChanged="@(value => { _email = value; _emailError = null; })" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Disabled="@(_sending || _cooldown.IsRunning)" OnClick="SendNewLinkAsync"
                       Class="app-reset-password-new-link">
                @I["ResetPassword.SendNewLink"]
            </MudButton>

            @if (_cooldown.IsRunning)
            {
                @* The seconds on screen; a hidden live region speaks them only every ten (F-4 accessibility rule). *@
                <p class="app-auth-cooldown" aria-hidden="true">@string.Format(System.Globalization.CultureInfo.CurrentCulture, I["ForgotPassword.Cooldown"], _cooldown.Remaining)</p>
                <span class="app-visually-hidden" aria-live="polite">@string.Format(System.Globalization.CultureInfo.CurrentCulture, I["ForgotPassword.Cooldown"], _cooldown.Announced)</span>
            }
            break;

        case State.Invalid:
            <div class="app-auth-result">
                <span class="app-auth-badge app-auth-badge-error">
                    <MudIcon Icon="@AppIcons.Error" Size="Size.Large" Color="Color.Error" aria-hidden="true" />
                </span>
                <h1 class="app-auth-title">@I["ResetPassword.Invalid.Title"]</h1>
                <p>@I["ResetPassword.Invalid.Message"]</p>
                <p><a href="/forgot-password">@I["ResetPassword.AskNewLink"]</a></p>
            </div>
            break;

        case State.Failed:
            <div class="app-auth-result">
                <h1 class="app-auth-title">@I["ResetPassword.Title"]</h1>
                <AppAlert Severity="Severity.Error"
                          Text="@Errors.For(_error)"
                          ActionText="@L["Common.TryAgain"]"
                          OnAction="CheckAsync" />
            </div>
            break;
    }
</div>

@code {
    /// <summary>After a successful reset, sign-in shows its "password changed" alert (UC2). No personal data in the URL.</summary>
    public const string SignInAfterResetPath = "/sign-in?password=changed";

    private static readonly TimeSpan Cooldown = TimeSpan.FromSeconds(60);

    private enum State { Checking, Ready, Expired, Invalid, Failed }

    [SupplyParameterFromQuery] public string? Token { get; set; }

    private State _state = State.Checking;
    private Countdown _cooldown = default!;
    private string? _password;
    private string? _confirm;
    private string? _passwordError;
    private string? _confirmError;
    private string? _email;
    private string? _emailError;
    private string? _error;
    private bool _submitting;
    private bool _sending;
    private bool _sent;

    private string Title => _state switch
    {
        State.Expired => I["ResetPassword.Expired.Title"],
        State.Invalid => I["ResetPassword.Invalid.Title"],
        _ => I["ResetPassword.Title"]
    };

    protected override async Task OnInitializedAsync()
    {
        _cooldown = new Countdown(Clock, () => InvokeAsync(StateHasChanged));
        await CheckAsync();
    }

    /// <summary>The link is checked before the visitor types anything (decision, 2026-09-19).</summary>
    private async Task CheckAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _state = State.Invalid;
            return;
        }

        _state = State.Checking;
        _error = null;
        var result = await Api.CheckPasswordResetTokenAsync(Token);
        _state = StateFor(result.IsSuccess ? null : result.ErrorCode);
        if (_state == State.Failed)
        {
            _error = result.ErrorCode;
        }
    }

    private async Task SubmitAsync()
    {
        _passwordError = string.IsNullOrEmpty(_password) ? I["SignUp.Password.Required"].Value : null;
        _confirmError = string.IsNullOrEmpty(_confirm)
            ? I["SignUp.ConfirmPassword.Required"].Value
            : _confirm != _password ? I["SignUp.ConfirmPassword.Mismatch"].Value : null;
        if (_passwordError is not null || _confirmError is not null)
        {
            return;
        }

        _submitting = true;
        _error = null;
        var result = await Api.ResetPasswordAsync(Token!, _password!);
        _submitting = false;

        if (result.IsSuccess)
        {
            Navigation.NavigateTo(SignInAfterResetPath);
            return;
        }

        switch (result.ErrorCode)
        {
            case IdentityErrorCodes.PasswordResetTooWeak or IdentityErrorCodes.PasswordResetSameAsCurrent:
                _passwordError = Errors.For(result.ErrorCode);
                _password = null;
                _confirm = null;
                break;
            case IdentityErrorCodes.PasswordResetExpired or IdentityErrorCodes.PasswordResetInvalid:
                _state = StateFor(result.ErrorCode);
                break;
            default:
                _error = result.ErrorCode;
                break;
        }
    }

    private async Task SendNewLinkAsync()
    {
        _emailError = EmailRules.Check(_email, I["SignIn.Email.Required"], Errors.For(IdentityErrorCodes.EmailInvalid));
        if (_emailError is not null)
        {
            return;
        }

        _sending = true;
        _error = null;
        var result = await Api.RequestPasswordResetAsync(_email!.Trim());
        _sending = false;

        if (result.IsSuccess)
        {
            _sent = true;
            _cooldown.Start(Cooldown);
        }
        else
        {
            _error = result.ErrorCode;
        }
    }

    private static State StateFor(string? code) => code switch
    {
        null => State.Ready,
        IdentityErrorCodes.PasswordResetExpired => State.Expired,
        IdentityErrorCodes.PasswordResetInvalid => State.Invalid,
        _ => State.Failed
    };

    private string StrengthText(PasswordStrength strength) =>
        I["SignUp.Password.Strength", I[$"SignUp.Password.Strength.{strength}"]];

    public void Dispose() => _cooldown?.Dispose();
}
