@page "/sign-in"
@layout AuthLayout
@using Microsoft.AspNetCore.Components.Authorization
@using Simulab.Identity.Contracts
@using Simulab.Web.Services.Auth
@inject IStringLocalizer<IdentityResources> I
@inject IStringLocalizer<SharedResources> L
@inject ErrorText Errors
@inject AuthClient Auth
@inject IdentityApiClient IdentityApi
@inject SignInHandOff HandOff
@inject GoogleSignInSettings Google
@inject CodeStepTickets CodeSteps
@inject NavigationManager Navigation

<PageTitle>@I["SignIn.Title"] — @L["App.Name"]</PageTitle>

<div class="app-auth-card">
    <h1 class="app-auth-title">@I["SignIn.Title"]</h1>
    <p class="app-auth-subtitle">@(_challenge is null ? I["SignIn.Subtitle"] : _useRecoveryCode ? I["SignIn.RecoveryCode.Subtitle"] : I["SignIn.Code.Subtitle"])</p>

    @if (_challenge is not null)
    {
        @* F-11 UC3, UC4: the second step. The challenge lives in this page's state, never in the URL. *@
        <AppTextField TValue="string"
                      Id="sign-in-code"
                      Label="@(_useRecoveryCode ? I["SignIn.RecoveryCode.Label"] : I["SignIn.Code.Label"])"
                      Hint="@(_useRecoveryCode ? I["SignIn.RecoveryCode.Hint"] : I["SignIn.Code.Hint"])"
                      Autocomplete="one-time-code"
                      MaxLength="AccountLimits.TotpCodeMaxLength"
                      Required="true"
                      Disabled="_submitting"
                      Error="@_codeError"
                      Value="@_code"
                      ValueChanged="@(value => { _code = value; _codeError = null; })" />

        <p class="app-sign-in-forgot">
            <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="_submitting" OnClick="ToggleRecoveryCode" Class="app-sign-in-code-mode">
                @(_useRecoveryCode ? I["SignIn.Code.UseApp"] : I["SignIn.Code.UseRecoveryCode"])
            </MudButton>
        </p>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   Disabled="_submitting"
                   OnClick="SubmitCodeAsync"
                   Class="app-sign-in-code-submit">
            @if (_submitting)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" aria-hidden="true" />
                <span role="status">@I["SignIn.Submitting"]</span>
            }
            else
            {
                @I["SignIn.Submit"]
            }
        </MudButton>

        <MudButton Variant="Variant.Text" FullWidth="true" Disabled="_submitting" OnClick="CancelCode" Class="app-sign-in-code-cancel mt-2">
            @L["Common.Cancel"]
        </MudButton>
    }
    else
    {
    @if (_serverError is not null)
    {
        <AppAlert Severity="Severity.Error" Text="@Errors.For(_serverError)" />
    }
    else if (_codeFailure is not null)
    {
        @* F-11 BR9: the code step spent its challenge, so the next try starts from the password. *@
        <AppAlert Severity="Severity.Error" Text="@_codeFailure" />
    }
    else if (_locked)
    {
        <AppAlert Severity="Severity.Error" Text="@L["identity.account_locked", _lockedFor]" />
    }
    else if (_resent)
    {
        <AppAlert Severity="Severity.Success" Text="@I["CheckEmail.Resend.Sent"]" />
    }
    else if (_unverified)
    {
        <AppAlert Severity="Severity.Warning"
                  Text="@L["identity.email_not_verified"]"
                  ActionText="@I["SignIn.ResendVerification"]"
                  OnAction="ResendAsync" />
    }
    else if (_passwordChanged)
    {
        @* F-7 UC2: back from a successful reset. *@
        <AppAlert Severity="Severity.Success" Text="@I["SignIn.PasswordReset"]" />
    }
    else if (_sessionEnded)
    {
        @* B-3, BR5: the session ended elsewhere (sign-out, password reset) while a page was open. *@
        <AppAlert Severity="Severity.Info" Text="@I["SignIn.SessionEnded"]" />
    }
    else if (_accountErased)
    {
        @* F-10, AC13: the account this browser was signed in with no longer exists. *@
        <AppAlert Severity="Severity.Info" Text="@I["SignIn.AccountErased"]" />
    }

    <AppTextField TValue="string"
                  Id="sign-in-email"
                  Label="@I["SignIn.Email.Label"]"
                  Placeholder="@I["SignIn.Email.Placeholder"]"
                  InputType="InputType.Email"
                  Autocomplete="username"
                  MaxLength="AccountLimits.EmailMaxLength"
                  Required="true"
                  Disabled="_submitting"
                  Error="@_emailError"
                  Value="@_email"
                  ValueChanged="@(value => { _email = value; _emailError = null; })" />

    <AppPasswordField Id="sign-in-password"
                      Autocomplete="PasswordAutocomplete.CurrentPassword"
                      Label="@I["SignIn.Password.Label"]"
                      ShowLabel="@I["SignIn.Password.Show"]"
                      HideLabel="@I["SignIn.Password.Hide"]"
                      Required="true"
                      Disabled="_submitting"
                      Error="@_passwordError"
                      Value="@_password"
                      ValueChanged="@(value => { _password = value; _passwordError = null; })" />

    <p class="app-sign-in-forgot"><a href="/forgot-password">@I["SignIn.ForgotPassword"]</a></p>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Size="Size.Large"
               Disabled="_submitting"
               OnClick="SubmitAsync"
               Class="app-sign-in-submit">
        @if (_submitting)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" aria-hidden="true" />
            <span role="status">@I["SignIn.Submitting"]</span>
        }
        else
        {
            @I["SignIn.Submit"]
        }
    </MudButton>

    @if (Google.Enabled)
    {
        @* F-20: the other way in, under the form (Screens and API). *@
        <AppDivider Text="@I["Auth.Or"]" />
        <AppGoogleButton Text="@I["Auth.ContinueWithGoogle"]" StartPath="@GoogleAccountEndpoints.StartPath" Disabled="_submitting" />
    }
    }
</div>

<p class="app-auth-footer-line">@Footer()</p>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromQuery] public string? Error { get; set; }

    [SupplyParameterFromQuery] public string? Email { get; set; }

    /// <summary>F-20 BR6: a Google sign-in that needs the two-factor code arrives here with the ticket of its challenge.</summary>
    [SupplyParameterFromQuery(Name = GoogleAccountEndpoints.CodeStepQuery)] public string? CodeStep { get; set; }

    private string? _email;
    private string? _password;
    private string? _emailError;
    private string? _passwordError;
    private string? _serverError;
    private bool _locked;
    private string _lockedFor = "0:00";
    private bool _unverified;
    private bool _resent;
    private bool _submitting;
    private bool _sessionEnded;
    private bool _accountErased;
    private bool _passwordChanged;

    // F-11: the code step.
    private string? _challenge;
    private string? _code;
    private string? _codeError;
    private string? _codeFailure;
    private bool _useRecoveryCode;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated == true)
        {
            // Screen decision 4: an already signed-in visitor never sees the form again.
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        _email = Email;
        var path = Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out var uri) ? uri.PathAndQuery : string.Empty;
        _sessionEnded = path == AccountEndpoints.SessionEndedSignInPath;
        _accountErased = path == AccountEndpoints.AccountErasedSignInPath;
        _passwordChanged = path == ResetPassword.SignInAfterResetPath;
        ApplyServerCode(Error);

        // F-20 BR6: straight to the code step, as after a password. Read, not spent: the page initializes twice (prerender,
        // then the circuit), and the Api spends the challenge itself on the first code. An expired ticket leaves the form.
        if (CodeStep is not null && CodeSteps.TryPeek(CodeStep, out var codeStep))
        {
            _challenge = codeStep.Challenge;
        }
    }

    private void ApplyServerCode(string? code)
    {
        _serverError = null;
        _locked = code == IdentityErrorCodes.AccountLocked;
        _unverified = code == IdentityErrorCodes.EmailNotVerified;
        if (code is not null && !_locked && !_unverified)
        {
            _serverError = code;
        }
    }

    private async Task SubmitAsync()
    {
        _serverError = null;
        _codeFailure = null;
        _locked = false;
        _unverified = false;
        _resent = false;
        if (!Validate())
        {
            return;
        }

        _submitting = true;
        _sessionEnded = false;
        _passwordChanged = false;
        var result = await Auth.SignInAsync(_email!.Trim(), _password!);
        _submitting = false;
        _password = null;

        if (result.NeedsTotpCode)
        {
            // F-11 BR9: the password was right; the code step takes over.
            _challenge = result.Challenge;
            _code = null;
            _codeError = null;
            _useRecoveryCode = false;
            return;
        }

        if (!result.IsSuccess)
        {
            ShowFailure(result);
            return;
        }

        await FinishAsync(result);
    }

    /// <summary>
    /// F-11 UC3, UC4, BR9: trades the challenge and the code for the tokens. The challenge is spent whatever the
    /// answer, so any failure goes back to the password with the reason.
    /// </summary>
    private async Task SubmitCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(_code))
        {
            _codeError = _useRecoveryCode ? I["SignIn.RecoveryCode.Required"].Value : I["SignIn.Code.Required"].Value;
            return;
        }

        _submitting = true;
        var result = await Auth.CompleteTotpSignInAsync(_challenge!, _code.Trim());
        _submitting = false;

        if (result.IsSuccess)
        {
            await FinishAsync(result);
            return;
        }

        _challenge = null;
        _code = null;
        switch (result.ErrorCode)
        {
            case IdentityErrorCodes.TotpCodeInvalid:
                _codeFailure = I["SignIn.Code.Rejected"].Value;
                break;
            case IdentityErrorCodes.TotpChallengeInvalid:
                _codeFailure = I["SignIn.Code.Expired"].Value;
                break;
            default:
                ShowFailure(result);
                break;
        }
    }

    private void ToggleRecoveryCode()
    {
        _useRecoveryCode = !_useRecoveryCode;
        _code = null;
        _codeError = null;
    }

    /// <summary>Back to the password form. The challenge is simply dropped; it expires on its own (BR9).</summary>
    private void CancelCode()
    {
        _challenge = null;
        _code = null;
        _codeError = null;
        _codeFailure = null;
    }

    private void ShowFailure(TokenResult result)
    {
        if (result.ErrorCode == IdentityErrorCodes.AccountLocked)
        {
            _locked = true;
            _lockedFor = FormatSeconds(result.ErrorDescription);
        }
        else if (result.ErrorCode == IdentityErrorCodes.EmailNotVerified)
        {
            _unverified = true;
        }
        else
        {
            _serverError = result.ErrorCode;
        }
    }

    private async Task FinishAsync(TokenResult result)
    {
        var completion = await HandOff.CompletionPathAsync(result);
        if (completion is null)
        {
            _serverError = Components.Ui.ErrorText.UnexpectedCode;
            return;
        }

        // A real browser navigation (BR1's constraint): only this can carry a Set-Cookie response header.
        Navigation.NavigateTo(completion, forceLoad: true);
    }

    /// <summary>Screen decision 1: resend right here, with the address already at hand.</summary>
    private async Task ResendAsync()
    {
        await IdentityApi.ResendVerificationAsync(_email?.Trim() ?? string.Empty);
        _unverified = false;
        _resent = true;
    }

    private bool Validate()
    {
        _emailError = string.IsNullOrWhiteSpace(_email) ? I["SignIn.Email.Required"].Value : null;
        _passwordError = string.IsNullOrWhiteSpace(_password) ? I["SignIn.Password.Required"].Value : null;
        return _emailError is null && _passwordError is null;
    }

    private static string FormatSeconds(string? raw) =>
        int.TryParse(raw, out var seconds) && seconds > 0
            ? TimeSpan.FromSeconds(seconds).ToString(@"mm\:ss")
            : "0:00";

    private RenderFragment Footer() => builder =>
    {
        var parts = I["SignIn.NoAccount"].Value.Split("{0}");
        builder.AddContent(0, parts[0]);
        builder.OpenElement(1, "a");
        builder.AddAttribute(2, "href", "/sign-up");
        builder.AddContent(3, I["SignIn.CreateAccount"].Value);
        builder.CloseElement();
        if (parts.Length > 1)
        {
            builder.AddContent(4, parts[1]);
        }
    };
}
