@page "/account/password"
@layout MainLayout
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Simulab.Identity.Contracts
@using Simulab.Web.Services.Auth
@inject IStringLocalizer<IdentityResources> I
@inject IStringLocalizer<SharedResources> L
@inject IdentityApiClient Api
@inject WebSessionTokenAccessor Tokens
@inject ErrorText Errors
@inject NavigationManager Navigation
@inject TimeProvider Clock

<PageTitle>@I["ChangePassword.Title"] — @L["App.Name"]</PageTitle>

@* F-7 UC6: the signed-in user's own password. Reached from the user menu; F-8 links it from "My account". *@
<AppPageHeader Title="@I["ChangePassword.Title"]" />

<MudPaper Class="app-form-card pa-6" Elevation="0" Outlined="true" MaxWidth="560px">
    @if (_changed)
    {
        <AppAlert Severity="Severity.Success" Text="@I["ChangePassword.Changed"]" />
    }
    else if (_lockout.IsRunning)
    {
        <div aria-live="polite">
            <AppAlert Severity="Severity.Error" Text="@L["identity.account_locked", FormatSeconds(_lockout.Announced)]" />
        </div>
    }
    else if (_error is not null)
    {
        <AppAlert Severity="Severity.Error" Text="@Errors.For(_error)" ActionText="@L["Common.TryAgain"]" OnAction="SaveAsync" />
    }

    <AppPasswordField Id="change-password-current"
                      Label="@I["ChangePassword.CurrentPassword.Label"]"
                      ShowLabel="@I["SignUp.Password.Show"]"
                      HideLabel="@I["SignUp.Password.Hide"]"
                      Autocomplete="current-password"
                      Required="true"
                      Disabled="_saving"
                      Error="@_currentError"
                      Value="@_current"
                      ValueChanged="@(value => { _current = value; _currentError = null; })" />

    <AppPasswordField Id="change-password-new"
                      Label="@I["ChangePassword.NewPassword.Label"]"
                      Hint="@I["SignUp.Password.Hint"]"
                      ShowLabel="@I["SignUp.Password.Show"]"
                      HideLabel="@I["SignUp.Password.Hide"]"
                      Required="true"
                      Disabled="_saving"
                      Error="@_newError"
                      Value="@_new"
                      ValueChanged="@(value => { _new = value; _newError = null; })" />

    <AppPasswordStrength Password="@_new" TextFor="StrengthText" />

    <AppPasswordField Id="change-password-confirm"
                      Label="@I["ChangePassword.ConfirmPassword.Label"]"
                      ShowLabel="@I["SignUp.Password.Show"]"
                      HideLabel="@I["SignUp.Password.Hide"]"
                      Required="true"
                      Disabled="_saving"
                      Error="@_confirmError"
                      Value="@_confirm"
                      ValueChanged="@(value => { _confirm = value; _confirmError = null; })" />

    <AppFormActions Saving="_saving" Disabled="_lockout.IsRunning" OnSave="SaveAsync" OnCancel="Cancel" />
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Countdown _lockout = default!;
    private string? _current;
    private string? _new;
    private string? _confirm;
    private string? _currentError;
    private string? _newError;
    private string? _confirmError;
    private string? _error;
    private bool _saving;
    private bool _changed;

    protected override async Task OnInitializedAsync()
    {
        _lockout = new Countdown(Clock, () => InvokeAsync(StateHasChanged));

        // BR12: signed-in users only. An anonymous visitor signs in first; this is no secret page, so it
        // is not the Not Found of a permission page (F-6 BR7).
        if (AuthState is null || (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/sign-in", forceLoad: true);
        }
    }

    private async Task SaveAsync()
    {
        _changed = false;
        _currentError = string.IsNullOrEmpty(_current) ? I["ChangePassword.CurrentPassword.Required"].Value : null;
        _newError = string.IsNullOrEmpty(_new) ? I["SignUp.Password.Required"].Value : null;
        _confirmError = string.IsNullOrEmpty(_confirm)
            ? I["SignUp.ConfirmPassword.Required"].Value
            : _confirm != _new ? I["SignUp.ConfirmPassword.Mismatch"].Value : null;
        if (_currentError is not null || _newError is not null || _confirmError is not null)
        {
            return;
        }

        _saving = true;
        _error = null;
        var user = AuthState is null ? null : (await AuthState).User;
        var accessToken = user is null ? null : await Tokens.GetAccessTokenAsync(user);
        var result = accessToken is null
            ? new PasswordChangeResult(ErrorText.UnexpectedCode, null)
            : await Api.ChangePasswordAsync(accessToken, _current!, _new!);
        _saving = false;

        if (result.IsSuccess)
        {
            _changed = true;
            _current = _new = _confirm = null;
            return;
        }

        switch (result.ErrorCode)
        {
            case IdentityErrorCodes.PasswordChangeCurrentInvalid:
                _currentError = Errors.For(result.ErrorCode);
                _current = null;
                break;
            case IdentityErrorCodes.PasswordChangeTooWeak or IdentityErrorCodes.PasswordChangeSameAsCurrent:
                _newError = Errors.For(result.ErrorCode);
                _new = _confirm = null;
                break;
            case IdentityErrorCodes.AccountLocked:
                _current = null;
                _lockout.Start(TimeSpan.FromSeconds(Math.Max(1, result.RetryAfterSeconds ?? 0)));
                break;
            default:
                _error = result.ErrorCode;
                break;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/");

    private static string FormatSeconds(int seconds) => TimeSpan.FromSeconds(seconds).ToString(@"mm\:ss");

    private string StrengthText(PasswordStrength strength) =>
        I["SignUp.Password.Strength", I[$"SignUp.Password.Strength.{strength}"]];

    public void Dispose() => _lockout?.Dispose();
}
