@* One list field everywhere (F-114): the page holds the whole list, the arrow at the end says it opens before the reader
   types, and typing narrows it in memory. Laid out like AppTextField: label above, required marker, hint or error
   below (rule: ui). A list that needs typing first, answered by the server, is AppLookupField. *@
@typeparam TValue
@inject IStringLocalizer<SharedResources> L

<div class="app-field @(HasError ? "app-field-error" : null)">
    <label class="app-field-label" id="@LabelId" for="@Id">
        @Label
        @if (Required)
        {
            <span class="app-field-required" aria-hidden="true">*</span>
        }
    </label>
    @* Esc closes the list and stops here, so a dialog around the field stays open; with the list closed it goes on
       to the dialog as usual. The handler is empty on purpose: the modifier needs one to take effect. *@
    <div class="app-select @(LeadingIcon is null ? null : "app-select-has-icon") @(Loading ? "app-select-loading" : null) @(Disabled ? "app-select-disabled" : null)"
         @onkeydown="OnKeyDown" @onkeydown:stopPropagation="_open">
        @if (LeadingIcon is not null)
        {
            @* BR5: drawn by the kit over the input's left padding; the library has one adornment slot and the arrow uses it. *@
            <MudIcon Icon="@LeadingIcon" Class="app-select-leading" aria-hidden="true" />
        }
        <MudAutocomplete T="AppSelectOption<TValue>"
                         Value="SelectedOption"
                         ValueChanged="OnValueChanged"
                         SearchFunc="SearchOptionsAsync"
                         ToStringFunc="TextOf"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         MinCharacters="0"
                         MaxItems="@Math.Max(Options.Count, 1)"
                         OpenOnFocus="true"
                         Clearable="false"
                         CoerceText="true"
                         Disabled="Disabled"
                         Error="HasError"
                         OpenChanged="OnOpenChanged"
                         Adornment="@(Loading ? Adornment.None : Adornment.End)"
                         AdornmentIcon="@(_open ? AppIcons.Collapse : AppIcons.Expand)"
                         OpenIcon="@AppIcons.Expand"
                         CloseIcon="@AppIcons.Collapse"
                         AdornmentAriaLabel="@(_open ? L["SelectField.Collapse"] : L["SelectField.Expand"])"
                         UserAttributes="@Attributes">
            <ItemTemplate>
                <span class="app-select-option" lang="@context.Lang">@context.Text</span>
            </ItemTemplate>
            <NoItemsTemplate>
                <div class="app-select-message">@(Loading ? L["SelectField.Loading"] : L["SelectField.NoResults", _lastTerm])</div>
            </NoItemsTemplate>
        </MudAutocomplete>
        @if (Loading)
        {
            @* Page still fetching the options: a small progress where the arrow would be (AC14). *@
            <span class="app-select-progress" aria-hidden="true">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
            </span>
        }
    </div>
    <span id="@DescriptionId" class="app-field-description">
        @if (HasError)
        {
            <span class="app-field-error-text">@Error</span>
        }
        else if (!string.IsNullOrEmpty(Hint))
        {
            <span class="app-field-hint">@Hint</span>
        }
    </span>
    <span class="app-visually-hidden" aria-live="polite">@_announcement</span>
</div>

@code {
    /// <summary>Id of the input; the label and the description point at it.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired] public IReadOnlyList<AppSelectOption<TValue>> Options { get; set; } = [];

    [Parameter] public TValue? Value { get; set; }

    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter] public string? Hint { get; set; }

    /// <summary>The validation message. While it is set, the field is in error and the hint is replaced.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>F-43 BR1: a decorative <see cref="AppIcons"/> constant at the start of the field. It never carries
    /// meaning of its own; the label does.</summary>
    [Parameter] public string? LeadingIcon { get; set; }

    /// <summary>F-114 AC14: the page is still fetching the options. A progress takes the arrow's place and the list
    /// says so. Default false: no call site has to change.</summary>
    [Parameter] public bool Loading { get; set; }

    private string _lastTerm = string.Empty;
    private bool _open;
    private string _announcement = string.Empty;

    private bool HasError => !string.IsNullOrEmpty(Error);

    private string LabelId => $"{Id}-label";

    private string DescriptionId => $"{Id}-description";

    private AppSelectOption<TValue>? SelectedOption =>
        Options.FirstOrDefault(option => EqualityComparer<TValue>.Default.Equals(option.Value, Value));

    // The same set AppLookupField writes: MudBlazor 9.9 renders a plain text input for the autocomplete, so the
    // combobox role and its state are written here, once, and every picker announces itself the same way (rule: ui).
    // aria-controls is left out: the library draws the list in its own popover and gives it no id to point at.
    private Dictionary<string, object?> Attributes => new()
    {
        ["id"] = Id,
        ["role"] = "combobox",
        ["aria-expanded"] = _open ? "true" : "false",
        ["aria-autocomplete"] = "list",
        ["aria-haspopup"] = "listbox",
        ["aria-labelledby"] = LabelId,
        ["aria-describedby"] = DescriptionId,
        ["aria-invalid"] = HasError ? "true" : null,
        ["aria-required"] = Required ? "true" : null,
        ["autocomplete"] = "off"
    };

    private static string TextOf(AppSelectOption<TValue>? option) => option?.Text ?? string.Empty;

    private Task OnOpenChanged(bool open)
    {
        _open = open;

        return Task.CompletedTask;
    }

    private static void OnKeyDown(KeyboardEventArgs _)
    {
    }

    // In memory, ignoring case and accents. BR4: while the input still shows the selected option's text (the "All"
    // of a filter), that text is not a term, so focusing the field lists every option.
    private Task<IEnumerable<AppSelectOption<TValue>>> SearchOptionsAsync(string? term, CancellationToken cancellationToken)
    {
        _lastTerm = term ?? string.Empty;

        if (Loading)
        {
            _announcement = L["SelectField.Loading"];

            return Task.FromResult<IEnumerable<AppSelectOption<TValue>>>([]);
        }

        var narrows = _lastTerm.Length > 0 && !string.Equals(_lastTerm, SelectedOption?.Text, StringComparison.Ordinal);
        IReadOnlyList<AppSelectOption<TValue>> found = Options;
        if (narrows)
        {
            var folded = Fold(_lastTerm);
            found = [.. Options.Where(option => Fold(option.Text).Contains(folded, StringComparison.OrdinalIgnoreCase))];
        }

        _announcement = found.Count == 0
            ? L["SelectField.NoResults", _lastTerm]
            : L["SelectField.Results", found.Count];

        // The library re-renders its own list when the search returns, not this wrapper: without this the live
        // region keeps the count of the previous term (found on screen, typing "MATEMA": it kept "Options: 12").
        _ = InvokeAsync(StateHasChanged);

        return Task.FromResult<IEnumerable<AppSelectOption<TValue>>>(found);
    }

    private static string Fold(string text)
    {
        var decomposed = text.Normalize(System.Text.NormalizationForm.FormD);
        var builder = new System.Text.StringBuilder(decomposed.Length);
        foreach (var character in decomposed)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(character) != System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                builder.Append(character);
            }
        }

        return builder.ToString();
    }

    // One pick, one ValueChanged. A null option is the library clearing the text, not a choice: the empty choice of
    // a filter is a real first option with a null value.
    private Task OnValueChanged(AppSelectOption<TValue>? option)
    {
        if (option is null)
        {
            return Task.CompletedTask;
        }

        Value = option.Value;

        return ValueChanged.InvokeAsync(option.Value);
    }
}
