@* F-181 BR2: a whole number (a count of questions). A text input with the numeric keyboard, never type=number; a text
   that is not a whole number keeps what was typed and shows the error. The page's own range message wins. *@

<AppNumberInput Id="@Id"
                Label="@Label"
                Class="@("app-integer-field " + Class)"
                Value="@(Value is null ? null : (decimal?)Value)"
                ValueChanged="OnValueChanged"
                InvalidChanged="InvalidChanged"
                Decimals="0"
                Min="@Min"
                Max="@Max"
                Unit="@Unit"
                Stepper="Stepper"
                Placeholder="@Placeholder"
                Hint="@Hint"
                Error="@Error"
                Required="Required"
                Disabled="Disabled"
                ReadOnly="ReadOnly"
                MaxLength="MaxLength" />

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>A class on the field's root, so a kit control built on this one can be found and styled.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter] public int? Value { get; set; }

    [Parameter] public EventCallback<int?> ValueChanged { get; set; }

    /// <summary>True while the text does not parse or is out of range: the page treats it as blocking.</summary>
    [Parameter] public EventCallback<bool> InvalidChanged { get; set; }

    [Parameter] public int? Min { get; set; }

    [Parameter] public int? Max { get; set; }

    /// <summary>A suffix after the number ("questions"), localized by the page.</summary>
    [Parameter] public string? Unit { get; set; }

    /// <summary>Minus and plus buttons beside the input.</summary>
    [Parameter] public bool Stepper { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string? Hint { get; set; }

    /// <summary>The page's message; while it is set it replaces the field's own.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public int? MaxLength { get; set; } = 9;

    private Task OnValueChanged(decimal? value)
    {
        Value = value is null ? null : (int)value.Value;
        return ValueChanged.InvokeAsync(Value);
    }
}
