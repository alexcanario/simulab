@* Fields side by side inside a section (F-43, BR1). Collapses to one column at phone width; a page never
   writes its own grid. *@

<div class="@($"app-form-grid app-form-grid-{Columns} {Class}")">
    @ChildContent
</div>

@code {
    /// <summary>1, 2 or 3. How many fit on a row depends on how long they are, which the page knows.</summary>
    [Parameter, EditorRequired] public int Columns { get; set; }

    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    [Parameter] public string? Class { get; set; }

    protected override void OnParametersSet()
    {
        if (Columns is < 1 or > 3)
        {
            throw new ArgumentOutOfRangeException(nameof(Columns), Columns, "A form grid has 1, 2 or 3 columns.");
        }
    }
}
