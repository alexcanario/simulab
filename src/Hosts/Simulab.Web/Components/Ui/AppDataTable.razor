@typeparam TItem
@inject IStringLocalizer<SharedResources> L
@inject ILogger<AppDataTable<TItem>> Logger

<MudDataGrid @ref="_grid"
             T="TItem"
             ServerData="LoadServerDataAsync"
             RowsPerPage="_rowsPerPage"
             RowsPerPageChanged="OnRowsPerPageChanged"
             CurrentPage="_currentPage"
             CurrentPageChanged="OnCurrentPageChanged"
             Hover="true"
             SortMode="SortMode.Single"
             Filterable="false"
             Culture="CultureInfo.CurrentCulture"
             Class="app-data-table">
    <ToolBarContent>
        @if (Searchable)
        {
            <MudTextField T="string"
                          Value="_search"
                          ValueChanged="OnSearchChangedAsync"
                          Placeholder="@(SearchPlaceholder ?? L["Common.Search"])"
                          aria-label="@L["Common.Search"]"
                          aria-describedby="@(HasSearchHint ? _hintId : null)"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@AppIcons.Search"
                          Immediate="true"
                          DebounceInterval="300"
                          Clearable="true"
                          Class="app-table-search" />
        }
        <MudSpacer />
        @ToolBarContent
    </ToolBarContent>
    <Columns>
        @Columns
        @if (RowActions is not null)
        {
            <TemplateColumn T="TItem" Title="@L["Common.Actions"]" Sortable="false" CellClass="app-cell-actions" HeaderClass="app-cell-actions">
                <CellTemplate>@RowActions(context.Item)</CellTemplate>
            </TemplateColumn>
        }
    </Columns>
    <LoadingContent>
        <AppLoadingState />
    </LoadingContent>
    <NoRecordsContent>
        @if (_failed)
        {
            <AppErrorState OnRetry="ReloadAsync" />
        }
        else
        {
            <AppEmptyState Message="@(_search is not null && EmptySearchMessage is not null ? EmptySearchMessage(_search) : EmptyMessage)"
                           ActionText="@EmptyActionText" ActionIcon="@EmptyActionIcon" OnAction="OnEmptyAction" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="TItem"
                          PageSizeOptions="PageSizes"
                          RowsPerPageString="@L["Common.Table.RowsPerPage"]"
                          InfoFormat="@L["Common.Table.PageInfo"]" />
    </PagerContent>
</MudDataGrid>
@* F-50: the live region is in the page from the first render, empty; only its text changes. *@
<div id="@_statusId" class="app-visually-hidden" role="status" aria-live="polite">@_announcement</div>
@if (HasSearchHint)
{
    <span id="@_hintId" class="app-visually-hidden">@SearchPlaceholder</span>
}

@code {
    public const int DefaultPageSize = 25;
    public static readonly int[] PageSizes = [10, 25, 50];

    private MudDataGrid<TItem> _grid = default!;
    private string? _search;
    private bool _failed;
    private int _rowsPerPage = DefaultPageSize;
    private int _currentPage;

    // F-50: ids are per instance, so two tables on one page never repeat one.
    private readonly string _hintId = $"app-table-hint-{Guid.NewGuid():N}";
    private readonly string _statusId = $"app-table-status-{Guid.NewGuid():N}";
    private bool _announcePending;
    private string? _announcement;

    // The hint repeats the placeholder only when it says more than the box's name ("Search"): else the reader says it twice.
    private bool HasSearchHint => Searchable
        && !string.IsNullOrWhiteSpace(SearchPlaceholder)
        && SearchPlaceholder != L["Common.Search"];

    /// <summary>Column definitions (PropertyColumn, TemplateColumn, AppNumberColumn, AppDateColumn).</summary>
    [Parameter, EditorRequired] public RenderFragment Columns { get; set; } = default!;

    /// <summary>Loads one page from the server.</summary>
    [Parameter, EditorRequired] public Func<AppTableQuery, CancellationToken, Task<AppTablePage<TItem>>> LoadAsync { get; set; } = default!;

    /// <summary>Row actions, always rendered as the last column. Use AppRowActions.</summary>
    [Parameter] public RenderFragment<TItem>? RowActions { get; set; }

    [Parameter] public bool Searchable { get; set; } = true;

    [Parameter] public RenderFragment? ToolBarContent { get; set; }

    [Parameter] public string? EmptyMessage { get; set; }

    /// <summary>What the search box says when empty; the kit's "Search" by default.</summary>
    [Parameter] public string? SearchPlaceholder { get; set; }

    /// <summary>The empty message while a search term is typed, given the term (F-9: "No user matches ...").</summary>
    [Parameter] public Func<string, string>? EmptySearchMessage { get; set; }

    [Parameter] public string? EmptyActionText { get; set; }

    [Parameter] public string? EmptyActionIcon { get; set; }

    [Parameter] public EventCallback OnEmptyAction { get; set; }

    /// <summary>F-36, BR13: the text the search box starts with, and what the first load sends. Blank is none. Read once, when
    /// the table is created: a page that keeps its state in the address passes what the address said.</summary>
    [Parameter] public string? InitialSearch { get; set; }

    /// <summary>F-36, BR13: the page the first load asks for, 0-based. A page past the last one falls back to page 0.</summary>
    [Parameter] public int InitialPage { get; set; }

    /// <summary>F-36, BR13: the rows per page of the first load when it is one of <see cref="PageSizes"/>; otherwise <see cref="DefaultPageSize"/>.</summary>
    [Parameter] public int? InitialPageSize { get; set; }

    protected override void OnInitialized()
    {
        _search = string.IsNullOrWhiteSpace(InitialSearch) ? null : InitialSearch.Trim();
        _currentPage = Math.Max(InitialPage, 0);
        _rowsPerPage = InitialPageSize is { } size && PageSizes.Contains(size) ? size : DefaultPageSize;
    }

    public Task ReloadAsync() => _grid.ReloadServerData();

    private void OnRowsPerPageChanged(int size) => _rowsPerPage = size;

    private void OnCurrentPageChanged(int page) => _currentPage = page;

    /// <summary>Reloads from the first page: after a filter outside the table changes (F-9: the role filter), as the search box does.</summary>
    public async Task ReloadFromFirstPageAsync()
    {
        ExpectAnnouncement();
        if (_grid.CurrentPage != 0)
            _grid.NavigateTo(Page.First);
        await _grid.ReloadServerData();
    }

    private async Task<GridData<TItem>> LoadServerDataAsync(GridState<TItem> state, CancellationToken cancellationToken)
    {
        _failed = false;
        var sort = state.SortDefinitions.FirstOrDefault();
        var query = new AppTableQuery(state.Page, state.PageSize, _search, sort?.SortBy, sort?.Descending ?? false);

        try
        {
            var page = await LoadAsync(query, cancellationToken);

            // F-36, BR13: a page past the last one (a stale address, or rows deleted meanwhile) shows page 0
            // instead of an empty table that still says there are rows.
            if (page.Items.Count == 0 && page.TotalItems > 0 && state.Page > 0)
            {
                page = await LoadAsync(query with { Page = 0 }, cancellationToken);
                _ = InvokeAsync(ShowFirstPageAsync);
            }

            Announce(page.TotalItems, cancellationToken);
            return new GridData<TItem> { Items = page.Items, TotalItems = page.TotalItems };
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Table data for {ItemType} failed to load", typeof(TItem).Name);
            _failed = true;
            _announcePending = false; // the error state has role="alert"; no count is spoken
            return new GridData<TItem> { Items = [], TotalItems = 0 };
        }
    }

    /// <summary>F-50, BR1: a search change or a reload from the first page is followed by a count. The text is cleared
    /// first so that the same count twice in a row still changes the region.</summary>
    private void ExpectAnnouncement()
    {
        _announcePending = true;
        _announcement = null;
    }

    /// <summary>F-50, BR1-BR3: says the total after the load that follows a search or filter change; a cancelled
    /// load says nothing (the newer one will).</summary>
    private void Announce(int total, CancellationToken cancellationToken)
    {
        if (!_announcePending || cancellationToken.IsCancellationRequested)
            return;

        _announcePending = false;
        _announcement = total switch
        {
            0 => L["Common.Table.Results.None"],
            1 => L["Common.Table.Results.One"],
            _ => string.Format(CultureInfo.CurrentCulture, L["Common.Table.Results.Many"].Value, total)
        };
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ShowFirstPageAsync()
    {
        // The grid still counts the page that was past the end; it is told to sit on page 0, where the rows now are.
        // It runs after the data callback returns (awaiting it there would wait on itself), so a failure is
        // logged here: nobody observes this task.
        try
        {
            await Task.Yield();
            if (_grid.CurrentPage != 0)
            {
                _grid.NavigateTo(Page.First);
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Table for {ItemType} could not return to its first page", typeof(TItem).Name);
        }
    }

    private async Task OnSearchChangedAsync(string? value)
    {
        _search = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        ExpectAnnouncement();
        if (_grid.CurrentPage != 0)
            _grid.NavigateTo(Page.First);
        await _grid.ReloadServerData();
    }
}
