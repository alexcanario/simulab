@* F-134, BR6: the state of a whole page (an error, a page that was not found): icon, title, message and an actions slot.
   The page picks the icon, the texts and the actions; the shape is the kit's. The title is the page's heading (h1), or
   a second-level one where the page already has its own (the gallery). *@
<div class="@($"app-page-state {Class}")">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="@IconColor" aria-hidden="true" />
    @Heading
    <p class="app-page-state-message">@Message</p>
    @if (Actions is not null)
    {
        <div class="app-page-state-actions">@Actions</div>
    }
    @ChildContent
</div>

@code {
    /// <summary>An <see cref="AppIcons"/> constant: what happened decides it, so the page must choose it.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;

    /// <summary>The state's name, already translated.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>One sentence that says what happened, already translated.</summary>
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;

    /// <summary>What the user can do next. Optional; the page decides which action is primary.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Extra detail under the actions, for example the request ID of an error.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>1 for a page whose heading this is; 2 where the page already has its own h1.</summary>
    [Parameter] public int TitleLevel { get; set; } = 1;

    [Parameter] public Color IconColor { get; set; } = Color.Default;

    [Parameter] public string? Class { get; set; }

    private RenderFragment Heading => builder =>
    {
        builder.OpenElement(0, TitleLevel == 1 ? "h1" : "h2");
        builder.AddAttribute(1, "class", "app-page-state-title");
        builder.AddContent(2, Title);
        builder.CloseElement();
    };
}
