@* F-184 BR3: yes, no and, when the page wants it, "not set" (a filter's "All"). The segmented field with two words; a
   page that asks "true or false" gives its own words. *@
@inject IStringLocalizer<SharedResources> L

<AppSegmentedField TValue="bool?"
                   Id="@Id"
                   Label="@Label"
                   Class="@("app-yes-no-field " + Class)"
                   Options="Options"
                   Value="@Value"
                   ValueChanged="ValueChanged"
                   Hint="@Hint"
                   Error="@Error"
                   Required="Required"
                   Disabled="Disabled" />

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>The word for true; "Yes" when not set.</summary>
    [Parameter] public string? TrueText { get; set; }

    /// <summary>The word for false; "No" when not set.</summary>
    [Parameter] public string? FalseText { get; set; }

    /// <summary>Adds a first option that means "no value" (a filter's "All"). Without it, an unset value shows no option chosen.</summary>
    [Parameter] public string? NotSetText { get; set; }

    [Parameter] public bool? Value { get; set; }

    [Parameter] public EventCallback<bool?> ValueChanged { get; set; }

    [Parameter] public string? Hint { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Class { get; set; }

    private IReadOnlyList<AppSegmentOption<bool?>> Options =>
    [
        .. (string.IsNullOrEmpty(NotSetText) ? Array.Empty<AppSegmentOption<bool?>>() : [new AppSegmentOption<bool?>(null, NotSetText)]),
        new AppSegmentOption<bool?>(true, TrueText ?? L["Choice.Yes"].Value),
        new AppSegmentOption<bool?>(false, FalseText ?? L["Choice.No"].Value)
    ];
}
