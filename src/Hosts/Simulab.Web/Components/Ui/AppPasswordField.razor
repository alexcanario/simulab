@* A text field that can be revealed. The reveal is a real button with a name that changes (rule: ui). *@

<AppTextField TValue="string"
              Id="@Id"
              Label="@Label"
              Value="@Value"
              ValueChanged="@(value => ValueChanged.InvokeAsync(value))"
              InputType="@(_revealed ? InputType.Text : InputType.Password)"
              Placeholder="@Placeholder"
              Hint="@Hint"
              Error="@Error"
              Required="@Required"
              Disabled="@Disabled"
              MaxLength="128"
              Autocomplete="new-password"
              Adornment="Adornment.End"
              AdornmentIcon="@(_revealed ? AppIcons.Hide : AppIcons.View)"
              AdornmentAriaLabel="@RevealLabel"
              OnAdornmentClick="Toggle" />

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string? Hint { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible name of the reveal button, in both states. The page passes both texts.</summary>
    [Parameter, EditorRequired] public string ShowLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string HideLabel { get; set; } = string.Empty;

    private bool _revealed;

    private string RevealLabel => _revealed ? HideLabel : ShowLabel;

    private void Toggle() => _revealed = !_revealed;
}
