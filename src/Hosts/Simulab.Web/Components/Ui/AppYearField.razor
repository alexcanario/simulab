@* F-181 BR5: a calendar year. Four digits at most, shown plain ("2026", never "2.026"), inside 1950 to the current year
   plus two unless the page says another range. *@
@inject TimeProvider Clock

<AppIntegerField Id="@Id"
                 Label="@Label"
                 Class="@("app-year-field " + Class)"
                 Value="@Value"
                 ValueChanged="ValueChanged"
                 InvalidChanged="InvalidChanged"
                 Min="@(Min ?? DefaultMin)"
                 Max="@(Max ?? Clock.GetLocalNow().Year + DefaultMaxYearsAhead)"
                 Placeholder="@Placeholder"
                 Hint="@Hint"
                 Error="@Error"
                 Required="Required"
                 Disabled="Disabled"
                 ReadOnly="ReadOnly"
                 MaxLength="4" />

@code {
    public const int DefaultMin = 1950;

    public const int DefaultMaxYearsAhead = 2;

    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public string? Class { get; set; }

    [Parameter] public int? Value { get; set; }

    [Parameter] public EventCallback<int?> ValueChanged { get; set; }

    /// <summary>True while the text is not a year in the range: the page treats it as blocking.</summary>
    [Parameter] public EventCallback<bool> InvalidChanged { get; set; }

    /// <summary>The first year accepted; 1950 when not set.</summary>
    [Parameter] public int? Min { get; set; }

    /// <summary>The last year accepted; the current year plus two when not set.</summary>
    [Parameter] public int? Max { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string? Hint { get; set; }

    /// <summary>The page's message; while it is set it replaces the field's own.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool ReadOnly { get; set; }
}
