@* One text field everywhere: label above, required marker, hint or error below, both announced (rule: ui). *@
@typeparam TValue
@inject IStringLocalizer<SharedResources> L

<div class="app-field @Class @(HasError ? "app-field-error" : null) @(EndContent is null ? null : "app-field-has-end")">
    <label class="app-field-label" for="@Id">
        @Label
        @if (Required)
        {
            <span class="app-field-required" aria-hidden="true">*</span>
        }
    </label>
    @if (EndContent is null)
    {
        @Input
    }
    else
    {
        @* F-183: an action over the end of the input (the URL field's "open link"). *@
        <div class="app-field-control">
            @Input
            @EndContent
        </div>
    }
    <span id="@DescriptionId" class="app-field-description @(Counter ? "app-field-description-counter" : null)">
        @if (HasError)
        {
            <span class="app-field-error-text">@Error</span>
        }
        else if (!string.IsNullOrEmpty(Hint))
        {
            <span class="app-field-hint">@Hint</span>
        }
        @if (Counter)
        {
            @* F-105 AC18: the count is text beside the message, never colour, and part of the description the input
               points at; it never replaces the error text. *@
            <span class="app-field-counter">@CounterText</span>
        }
    </span>
    @if (Counter)
    {
        @* The change is announced politely, after the typing pauses (the input is debounced), so a screen reader is
           never interrupted while the user types. *@
        <span class="app-visually-hidden" role="status" aria-live="polite" aria-atomic="true">@CounterSpokenText</span>
    }
</div>

@code {
    /// <summary>Id of the input; the label and the description point at it.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public TValue? Value { get; set; }

    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter] public InputType InputType { get; set; } = InputType.Text;

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string? Hint { get; set; }

    /// <summary>The validation message. While it is set, the field is in error and the hint is replaced.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public int? MaxLength { get; set; }

    /// <summary>
    /// F-105 AC18: shows "{n}/{max}" under the field while the user types (off by default). It needs
    /// <see cref="MaxLength"/>; the value then follows the typing, after a short pause, instead of the blur.
    /// </summary>
    [Parameter] public bool Counter { get; set; }

    /// <summary>Rows of the input. Above 1 it becomes a text area that grows with its content (F-33).</summary>
    [Parameter] public int Lines { get; set; } = 1;

    [Parameter] public string? Autocomplete { get; set; }

    [Parameter] public Adornment Adornment { get; set; } = Adornment.None;

    /// <summary>F-43 BR1: a decorative <see cref="AppIcons"/> constant at the start of the field. It never carries
    /// meaning of its own; the label does. Ignored when the page already set its own adornment.</summary>
    [Parameter] public string? LeadingIcon { get; set; }

    [Parameter] public string? AdornmentIcon { get; set; }

    [Parameter] public string? AdornmentAriaLabel { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnAdornmentClick { get; set; }

    /// <summary>F-183: a class on the field's root, so a kit control built on this field can be found and styled.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>F-183: more attributes of the input (<c>inputmode</c>, <c>spellcheck</c>, <c>pattern</c>), set by a kit
    /// control; they never replace the ones this field owns (id, description, invalid, required, autocomplete).</summary>
    [Parameter] public IReadOnlyDictionary<string, object?>? InputAttributes { get; set; }

    /// <summary>F-183: the keyboard a phone shows (MudBlazor writes the <c>inputmode</c> attribute itself).</summary>
    [Parameter] public InputMode InputMode { get; set; } = InputMode.text;

    /// <summary>F-183: the characters the input takes, as the <c>pattern</c> attribute (MudBlazor writes it itself).</summary>
    [Parameter] public string? Pattern { get; set; }

    /// <summary>F-183: with <see cref="Lines"/> above 1, the text area grows with its content up to this many lines,
    /// then scrolls. 0 keeps the fixed height.</summary>
    [Parameter] public int MaxLines { get; set; }

    /// <summary>F-183: content placed over the end of the input, such as a link that opens the value.</summary>
    [Parameter] public RenderFragment? EndContent { get; set; }

    private RenderFragment Input => @<MudTextField T="TValue"
                                                   Value="Value"
                                                   ValueChanged="OnValueChanged"
                                                   InputType="InputType"
                                                   InputMode="InputMode"
                                                   Pattern="@Pattern"
                                                   Placeholder="@Placeholder"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   MaxLength="@(MaxLength ?? 524288)"
                                                   Lines="@Lines"
                                                   Sizing="@(MaxLines > 0 ? InputSizing.Auto : InputSizing.Fixed)"
                                                   MaxLines="@MaxLines"
                                                   Immediate="@Counter"
                                                   DebounceInterval="@(Counter ? CounterDebounceMilliseconds : 0)"
                                                   Disabled="Disabled"
                                                   ReadOnly="ReadOnly"
                                                   Error="HasError"
                                                   UserAttributes="@Attributes"
                                                   Adornment="@(EffectiveAdornment)"
                                                   AdornmentIcon="@(EffectiveAdornmentIcon)"
                                                   AdornmentAriaLabel="@AdornmentAriaLabel"
                                                   OnAdornmentClick="OnAdornmentClick" />;

    private bool HasError => !string.IsNullOrEmpty(Error);

    private bool ShowsLeadingIcon => LeadingIcon is not null && Adornment == Adornment.None;

    private Adornment EffectiveAdornment => ShowsLeadingIcon ? Adornment.Start : Adornment;

    private string? EffectiveAdornmentIcon => ShowsLeadingIcon ? LeadingIcon : AdornmentIcon;

    private string DescriptionId => $"{Id}-description";

    /// <summary>The pause after the last keystroke before the count follows (and is announced).</summary>
    private const int CounterDebounceMilliseconds = 250;

    private int CounterLength => Value?.ToString()?.Length ?? 0;

    private string CounterText => string.Format(CultureInfo.CurrentCulture, L["Common.Counter"].Value, CounterLength, MaxLength);

    private string CounterSpokenText =>
        string.Format(CultureInfo.CurrentCulture, L["Common.Counter.Spoken"].Value, CounterLength, MaxLength);

    private Dictionary<string, object?> Attributes
    {
        get
        {
            var attributes = new Dictionary<string, object?>(InputAttributes ?? new Dictionary<string, object?>());
            attributes["id"] = Id;
            attributes["aria-describedby"] = DescriptionId;
            attributes["aria-invalid"] = HasError ? "true" : null;
            attributes["aria-required"] = Required ? "true" : null;
            attributes["autocomplete"] = Autocomplete;
            return attributes;
        }
    }

    private Task OnValueChanged(TValue? value)
    {
        Value = value;
        return ValueChanged.InvokeAsync(value);
    }
}
