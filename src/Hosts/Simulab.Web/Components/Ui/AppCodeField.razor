@* F-183 BR3: a code, reference or recovery code. Spaces never belong to it, so they are dropped; the characters are
   shown in monospace, so a 0 and an O are told apart. *@

<AppTextField TValue="string"
              Id="@Id"
              Label="@Label"
              Class="app-code-field"
              Value="@Value"
              ValueChanged="OnValueChanged"
              InputAttributes="InputAttributes"
              Autocomplete="@Autocomplete"
              Placeholder="@Placeholder"
              Hint="@Hint"
              Error="@Error"
              Required="Required"
              Disabled="Disabled"
              ReadOnly="ReadOnly"
              MaxLength="MaxLength" />

@code {
    private static readonly IReadOnlyDictionary<string, object?> InputAttributes = new Dictionary<string, object?>
    {
        ["spellcheck"] = "false",
        ["autocapitalize"] = "off"
    };

    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary><c>one-time-code</c> for a sign-in code, <c>off</c> for a reference. No default (rule: ui-project, B-5).</summary>
    [Parameter, EditorRequired] public string Autocomplete { get; set; } = string.Empty;

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string? Hint { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public int? MaxLength { get; set; }

    /// <summary>Raises the letters, for a code that is only upper case.</summary>
    [Parameter] public bool UpperCase { get; set; }

    /// <summary>The code as kept: no white space anywhere, upper case when asked.</summary>
    public static string? Normalize(string? value, bool upperCase)
    {
        if (value is null)
        {
            return null;
        }

        var code = new string(value.Where(character => !char.IsWhiteSpace(character)).ToArray());
        return upperCase ? code.ToUpperInvariant() : code;
    }

    private Task OnValueChanged(string? value)
    {
        Value = Normalize(value, UpperCase);
        return ValueChanged.InvokeAsync(Value);
    }
}
