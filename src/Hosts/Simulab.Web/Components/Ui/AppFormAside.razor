@* The read-only summary beside a long form (F-43, BR1, UC5): what is filled, and what is still missing.
   It is also the detail summary of a read-only page (F-36: the facts of an exam beside its editions): with
   no checklist it is a titled list of label and value pairs, and every row has a value.
   By default it carries no button — the only primary action on the page is Save, at the bottom right of the form
   (F-43, BR4). F-126 (BR3) changes that: a content slot after the checklist, with a divider, a heading and a subtitle
   the kit draws, holds a block of the page (the publication block of the question form), actions included. Save stays
   the only navy primary of the page. A button or amber key that is a direct child of the slot is styled by the kit:
   beside the form it takes the full width of the aside, stacked; stacked under the form it returns to its natural
   width, in one wrapping row. Beside the form the aside is capped at the viewport and scrolls
   inside itself (app.css); with a slot it is focusable so text below the fold is reachable by keyboard.
   It is not a live region: the error summary is what announces a failed save, and an aside that spoke on every
   keystroke would talk over the reader. *@

<aside class="@($"app-form-aside {Class}")" aria-labelledby="@TitleId" tabindex="@(ChildContent is null ? null : "0")">
    <h2 class="app-form-aside-title" id="@TitleId">@Title</h2>
    <dl class="app-form-aside-rows">
        @foreach (var row in Rows)
        {
            <div class="app-form-aside-row">
                <dt class="app-form-aside-row-label">@row.Label</dt>
                <dd class="app-form-aside-row-value @(row.Value is null ? "app-form-aside-row-empty" : null)">
                    @(row.Value ?? EmptyText)
                </dd>
            </div>
        }
    </dl>
    @if (Checklist.Count > 0)
    {
        <p class="app-form-aside-checklist-title">@ChecklistTitle</p>
        <ul class="app-form-aside-checklist">
            @foreach (var item in Checklist)
            {
                <li class="@(item.Done ? "app-checklist-done" : "app-checklist-pending")">
                    <MudIcon Icon="@(item.Done ? AppIcons.Verified : AppIcons.Pending)" Size="Size.Small"
                             Color="@(item.Done ? Color.Success : Color.Default)" aria-hidden="true" />
                    <span>@item.Label</span>
                    <span class="app-visually-hidden">@(item.Done ? DoneText : PendingText)</span>
                </li>
            }
        </ul>
    }
    @if (ChildContent is not null)
    {
        <section class="app-form-aside-content" id="@ContentId" aria-labelledby="@ContentTitleId">
            <h2 class="app-form-aside-title" id="@ContentTitleId">@ContentTitle</h2>
            @if (!string.IsNullOrWhiteSpace(ContentSubtitle))
            {
                <p class="app-form-aside-content-subtitle">@ContentSubtitle</p>
            }
            @ChildContent
        </section>
    }
</aside>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>What the form holds, one row per field. Which fields are worth summarising is the page's choice.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<AppAsideRow> Rows { get; set; } = [];

    /// <summary>The text of an empty row, already translated (for example "Not filled").</summary>
    [Parameter, EditorRequired] public string EmptyText { get; set; } = string.Empty;

    [Parameter] public string? ChecklistTitle { get; set; }

    [Parameter] public IReadOnlyList<AppChecklistItem> Checklist { get; set; } = [];

    /// <summary>What a screen reader hears for a done item; the tick alone is not a word.</summary>
    [Parameter] public string? DoneText { get; set; }

    [Parameter] public string? PendingText { get; set; }

    [Parameter] public string? Class { get; set; }

    /// <summary>F-126, BR3: a block after the checklist; absent when null. Its divider, heading and subtitle are drawn here.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The block's heading, already translated; it names the block's <c>section</c>.</summary>
    [Parameter] public string? ContentTitle { get; set; }

    [Parameter] public string? ContentSubtitle { get; set; }

    /// <summary>The id of the block's <c>section</c>; its heading carries <c>&lt;ContentId&gt;-title</c>.</summary>
    [Parameter] public string? ContentId { get; set; }

    private string TitleId => "app-form-aside-title";

    private string ContentTitleId => $"{ContentId ?? "app-form-aside-content"}-title";
}
