@* How strong a password looks, as a bar and as a word: colour alone fails WCAG (rule: ui). *@

@* Nothing to measure before the visitor types: an empty field is not a weak password. *@
@if (!string.IsNullOrEmpty(Password))
{
<div class="app-password-strength">
    <MudProgressLinear Value="@Percentage" Color="@Color" Rounded="true" Class="app-password-strength-bar" aria-hidden="true" />
    <span class="app-password-strength-text" aria-live="polite">@Text</span>
</div>
}

@code {
    /// <summary>The password being typed. Never stored and never sent anywhere by this component.</summary>
    [Parameter] public string? Password { get; set; }

    /// <summary>Texts for the three levels, in order: weak, fair, strong.</summary>
    [Parameter, EditorRequired] public Func<PasswordStrength, string> TextFor { get; set; } = _ => string.Empty;

    private PasswordStrength Level => PasswordStrengthRules.Of(Password);

    private string Text => TextFor(Level);

    private double Percentage => Level switch
    {
        PasswordStrength.Weak => 30,
        PasswordStrength.Fair => 65,
        _ => 100
    };

    private Color Color => Level switch
    {
        PasswordStrength.Weak => MudBlazor.Color.Error,
        PasswordStrength.Fair => MudBlazor.Color.Warning,
        _ => MudBlazor.Color.Success
    };
}
