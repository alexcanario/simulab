@* F-181 BR4: points and scores are the decimal field with the unit "points". `Decimals` stays required: it comes from
   the exam rule (CatalogLimits.ScoreDecimalPlaces today), not from a default here. *@
@inject IStringLocalizer<SharedResources> L

<AppDecimalField Id="@Id"
                 Label="@Label"
                 Class="@("app-score-field " + Class)"
                 Decimals="Decimals"
                 Value="@Value"
                 ValueChanged="ValueChanged"
                 InvalidChanged="InvalidChanged"
                 Min="@Min"
                 Max="@Max"
                 Unit="@L["Number.Unit.Points"].Value"
                 Placeholder="@Placeholder"
                 Hint="@Hint"
                 Error="@Error"
                 Required="Required"
                 Disabled="Disabled"
                 ReadOnly="ReadOnly" />

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired] public int Decimals { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public decimal? Value { get; set; }

    [Parameter] public EventCallback<decimal?> ValueChanged { get; set; }

    /// <summary>True while the text does not parse or is out of range: the page treats it as blocking.</summary>
    [Parameter] public EventCallback<bool> InvalidChanged { get; set; }

    [Parameter] public decimal? Min { get; set; }

    [Parameter] public decimal? Max { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string? Hint { get; set; }

    /// <summary>The page's message; while it is set it replaces the field's own.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool ReadOnly { get; set; }
}
