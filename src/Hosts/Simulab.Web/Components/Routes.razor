<CascadingValue Value="Preferences" IsFixed="true">
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            @* BR7: a page whose permission the visitor lacks looks exactly like one that does not exist. *@
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <NotFoundContent />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingValue>

@inject VisitorContext Visitor

@code {
    /// <summary>Theme and menu state from the cookies, read by App at the first request.</summary>
    [Parameter] public ShellPreferences Preferences { get; set; } = ShellPreferences.Default;

    /// <summary>B-4: the visitor's address, read by App at the first request, for the Api's per-client limits.</summary>
    [Parameter] public string? VisitorAddress { get; set; }

    protected override void OnParametersSet() => Visitor.Address = VisitorAddress;
}
