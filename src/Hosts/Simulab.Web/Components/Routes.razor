<CascadingValue Value="Preferences" IsFixed="true">
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            @* BR7: a page whose permission the visitor lacks looks exactly like one that does not exist. *@
            @* F-85 BR6: a user who owes an acceptance of the legal documents is sent to /accept-terms before the page renders. *@
            <LegalAcceptanceGate RouteData="routeData" Context="allowed">
                <AuthorizeRouteView RouteData="allowed" DefaultLayout="typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        <NotFoundContent />
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="allowed" Selector="h1" />
            </LegalAcceptanceGate>
        </Found>
    </Router>
</CascadingValue>

@inject VisitorContext Visitor

@code {
    /// <summary>Theme and menu state from the cookies, read by App at the first request.</summary>
    [Parameter] public ShellPreferences Preferences { get; set; } = ShellPreferences.Default;

    /// <summary>B-4: the visitor's address, read by App at the first request, for the Api's per-client limits.</summary>
    [Parameter] public string? VisitorAddress { get; set; }

    /// <summary>F-20 BR8: the secret of this browser's waiting Google sign-up, read by App at the first request.</summary>
    [Parameter] public string? GoogleSignUpBinding { get; set; }

    protected override void OnParametersSet()
    {
        Visitor.Address = VisitorAddress;
        Visitor.GoogleSignUpBinding = GoogleSignUpBinding;
    }
}
